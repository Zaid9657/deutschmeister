{
  "$schema": "course-v2/rubric@1",
  "id": "course-micro",
  "kind": "writing",
  "lane": null,
  "method": "ai",
  "max": 5,
  "examMax": 5,
  "criteria": [
    {
      "id": "task",
      "label": "Aufgabe erfüllt",
      "per": "task",
      "levels": [2, 1, 0],
      "scoredBy": "ai",
      "descriptors": [
        {
          "points": 2,
          "de": "Alles, was die Mini-Aufgabe verlangt, steht im Text, und er passt zur Situation und zur Person, an die Sie schreiben."
        },
        {
          "points": 1,
          "de": "Ein Teil der Mini-Aufgabe fehlt, oder der Text passt nur teilweise zur Situation."
        },
        {
          "points": 0,
          "de": "Der Text passt nicht zur Mini-Aufgabe, oder es steht fast nichts da."
        }
      ]
    },
    {
      "id": "target",
      "label": "Zielstruktur benutzt (nur bei Mikro-Aufgaben mit Zielstruktur)",
      "per": "task",
      "levels": [1, 0],
      "scoredBy": "ai",
      "appliesIf": "targets",
      "descriptors": [
        {
          "points": 1,
          "de": "Die Struktur, die Sie in diesem Lernschritt geübt haben, steht mindestens einmal richtig gebildet im Text."
        },
        {
          "points": 0,
          "de": "Die geübte Struktur fehlt, oder sie ist so gebildet, dass man sie nicht erkennt."
        }
      ]
    },
    {
      "id": "clear",
      "label": "verständlich",
      "per": "task",
      "levels": [2, 1, 0],
      "scoredBy": "ai",
      "descriptors": [
        {
          "points": 2,
          "de": "Man versteht Ihre Nachricht beim ersten Lesen. Kleine Fehler stören nicht."
        },
        {
          "points": 1,
          "de": "Man versteht das Wichtigste, muss aber an einzelnen Stellen raten."
        },
        {
          "points": 0,
          "de": "Man versteht nicht, was Sie mitteilen wollen."
        }
      ]
    }
  ],
  "errorPolicy": {
    "a1": {
      "v2-inv": "flag",
      "verb-final": "flag",
      "satzklammer": "flag",
      "case-np": "flag",
      "case-pp": "flag",
      "gender-article": "flag",
      "adj-ending": "flag",
      "perfekt-aux-participle": "flag",
      "connector-position": "flag",
      "n-dekl": "flag",
      "reflexive": "flag",
      "register": "score",
      "spelling-meaning": "score"
    },
    "a2": {
      "verb-final": "flag",
      "adj-ending": "flag",
      "case-np": "flag",
      "n-dekl": "flag"
    },
    "b1": {
      "v2-inv": "flag",
      "adj-ending": "flag",
      "n-dekl": "flag"
    },
    "b2": {}
  },
  "zeroRules": [],
  "capRules": [],
  "spelling": "only-if-meaning-suffers",
  "feedbackLanguage": ["de-a1", "de-a2", "de", "en"],
  "modelId": "config:micro",
  "splitVerified": false,
  "calibration": {
    "status": "pending",
    "rangeBands": 1
  },
  "source": "https://github.com/Zaid9657/deutschmeister/blob/main/docs/course-v2/BLUEPRINT.md#43-writing-rubric-profiles-registriesrubricswritingjson"
}
