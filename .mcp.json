{
  "mcpServers": {
    "dataforseo": {
      "command": "npx",
      "args": [
        "-y",
        "dataforseo-mcp-server@3.1.1"
      ],
      "env": {
        "DATAFORSEO_USERNAME": "${DATAFORSEO_USERNAME}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}",
        "ENABLED_MODULES": "SERP,KEYWORDS_DATA,DATAFORSEO_LABS,ONPAGE,AI_OPTIMIZATION"
      }
    },
    "gsc": {
      "command": "uvx",
      "args": [
        "mcp-search-console@0.4.1"
      ],
      "env": {
        "GSC_CREDENTIALS_PATH": "${HOME}/.gsc-credentials.json",
        "GSC_SKIP_OAUTH": "true"
      }
    },
    "executeautomation-playwright-server": {
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/playwright-mcp-server@1.0.12"
      ]
    },
    "rea": {
      "command": "node",
      "args": [
        "-e",
        "const w = process.platform === 'win32', a = ['npx', '-y', 'rea-agents@6.4.0', 'mcp']; require('child_process').spawn(w ? 'cmd.exe' : a[0], w ? ['/d', '/c', ...a] : a.slice(1), {stdio: 'inherit'}).on('exit', c => process.exit(c ?? 1))"
      ]
    }
  }
}
