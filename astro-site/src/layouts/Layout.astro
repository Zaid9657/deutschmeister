---
import { NAV_GROUPS, FOOTER_GROUPS, LEGAL_LINKS, SOCIAL_LINKS, SUPPORT_LINK } from '../data/navigation.js';
import { fontPreloads, color, nacht, linie } from '../data/design-tokens.js';
import Showtime from '../components/Showtime.astro';
import Motion from '../components/concept/Motion.astro';
import '../styles/concept4.css';
import { onsiteHref, surfaceForPath } from '../lib/onsiteLinks.js';
import { STATIONS, FREE_COURSE_HREF } from '../data/offers.js';
import 'atropos/css';
import '../styles/showtime.css';
import '../styles/linie.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  keywords?: string;
  lang?: string;
  /** 'nacht' renders the night nav (pages whose first screen is a nacht ground). */
  tone?: 'paper' | 'nacht';
  /** Font files to preload; defaults to the token list. Pages that set signs above the fold add signFontPreloads. */
  preloads?: string[];
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = 'https://deutsch-meister.de/og-image.png',
  jsonLd,
  noindex = false,
  keywords,
  lang = 'en',
  preloads = fontPreloads,
} = Astro.props;
// The sign face (Archivo) is for the pages that preload it — the marketing and
// commerce pages. Everywhere else (grammar, guides, exams …) the chrome sets its
// labels in the body face, so a library page never fetches a 55 KB font for its
// nav alone (it cost ~450 ms of lab FCP there; linie.css `data-sign="off"`).
const signOn = false;

// `canonical={null}` means emit none. Only 404.html uses it: the page is served
// at /404.html and as the fallback body for arbitrary unknown paths, so there is
// no URL it could honestly point at — it previously claimed the homepage, and
// self-referencing would claim a /404/ route that does not exist.
const canonicalUrl = canonical === null ? null : (canonical ?? Astro.url.href);
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Nav links come from THE navigation registry (src/data/navigation.js — the
// byte-identical twin of the SPA's copy; scripts/check-duplicates.mjs guards
// the pair). Root-relative hrefs so deploy previews and local serving work;
// the old absolute https://deutsch-meister.de/... links broke both.
// auth visibility: items marked 'authed' start hidden and an inline script
// below reveals them (and hides 'anon' items) when a Supabase session token
// exists — crawlers and logged-out visitors see the logged-out nav.
// Inline display:none (not the `hidden` attribute) — Tailwind's `.block`
// utility outranks the UA/preflight [hidden] rule in the cascade.
const navItems = NAV_GROUPS.flatMap((g) => g.items);

// The nav's trial button is the first signup door on every page. On a grammar
// lesson or a guide it carries the surface (src/lib/onsiteLinks.js), so a
// visitor who arrived with no referrer is no longer "untracked" when they sign
// up from the nav. Everywhere else it stays the bare route.
const surface = surfaceForPath(Astro.url.pathname);
const navSignupHref = surface ? onsiteHref('signup', surface, 'nav') : '/signup';
// v3 chrome ("Die Linie"): Courses and Pricing sit in the bar itself — the two
// doors a buyer looks for — and leave their groups so no link appears twice.
const PROMOTED = ['ai-practice', 'how-it-works', 'pricing'];
const promoted = PROMOTED.map((key) => navItems.find((i) => i.key === key)).filter(Boolean);
const navGroups = NAV_GROUPS.map((g) => ({ ...g, items: g.items.filter((i) => !PROMOTED.includes(i.key)) })).filter((g) => g.items.length);
const night = false;
// theme-color matches the top of the page (mobile-native: status bar = header).
const themeColor = night ? nacht.DEFAULT : color.paper;
// Token values for the two inline scripts below (they cannot import modules):
// one place, so the course return bar never carries its own hex again.
const rootVars = `:root{--dm-siegel:${color.siegel};--dm-siegel-edge:${color.siegelEdge};--dm-edge:${color.edge};--dm-graphite:${color.graphite};--dm-linie:${linie.DEFAULT};--dm-nacht:${nacht.DEFAULT}}`;
const authAttrs = (item) =>
  item.auth === 'authed'
    ? { 'data-auth-only': '', style: 'display:none' }
    : item.auth === 'anon'
      ? { 'data-anon-only': '' }
      : {};
---

<!doctype html>
<html lang={lang} data-sign={signOn ? undefined : 'off'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Stamped before first paint: the .reveal hidden state (showtime.css)
         exists only under html.js, so no-JS visitors and crawlers see everything. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Analytics is loaded only after cookie consent — see /consent.js -->
    <script src="/consent.js" defer></script>
    <!-- Which link brought this visitor (utm_* / ?ref= / social referrer) — see /attribution.js -->
    <script src="/attribution.js" defer></script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Meister-Siegel seal beside the words “Learn German grammar, listening and speaking — A1 to B2”" />
    <meta property="og:site_name" content="DeutschMeister" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Fonts: self-hosted from /fonts/ (root public/, merged into dist/ like
         /consent.js); the @font-face rules ship in this site's stylesheet via
         tailwind.config.mjs. Preloads come from the token, same list as the
         SPA shell (design-tokens.js `fontPreloads`). -->
    {preloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    <!-- JSON-LD Structured Data -->
    {jsonLdArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <style is:global set:html={`${rootVars}:focus-visible{outline:3px solid var(--dm-siegel);outline-offset:2px}`}></style>
  </head>

  <body class="font-body bg-paper text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow"
    >
      Skip to content
    </a>
    <nav class="c4-site-nav" aria-label="Main" data-ground="paper">
      <div class="c4-wrap c4-nav-inner">
        <a href="/" class="c4-brand" aria-label="DeutschMeister home"><span class="c4-brand-mark" aria-hidden="true">DM</span><span>DeutschMeister</span></a>
        <div class="c4-desktop-nav">
          <details class="c4-nav-dropdown"><summary>Courses <span aria-hidden="true">⌄</span></summary><div class="c4-dropdown-panel"><a href="/courses/">All courses →</a>{navGroups.map((group) => <div><p>{group.labelEn}</p>{group.items.filter((i) => i.key !== 'courses').map((item) => <a href={item.href} {...authAttrs(item)}>{item.labelEn}</a>)}</div>)}</div></details>
          {promoted.map((item) => <a href={item.href} {...authAttrs(item)} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.labelEn}</a>)}
        </div>
        <div class="c4-nav-account">
          <a href="/login" data-anon-only data-login-next>Log in</a>
          <a href={FREE_COURSE_HREF} data-anon-only class="c4-button" data-track="course_selected" data-track-level="a1.1" data-track-surface="nav">Start Learning</a>
          <a href={FREE_COURSE_HREF} data-auth-only data-continue-course style="display:none" class="c4-button">Continue learning</a>
          <a href="/pricing/" data-upgrade style="display:none">Upgrade</a>
        </div>
        <details class="c4-mobile-menu"><summary aria-label="Menu"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg></summary><div class="c4-mobile-panel">
          <a href="/courses/" class="c4-menu-heading">Courses</a>
          <ol class="c4-mobile-levels" aria-label="Courses by level">{STATIONS.map((st) => <li><a href={st.coursePage}><strong>{st.code}</strong><span>{st.status === 'free' ? 'Free' : st.status === 'building' ? 'Coming next' : st.priceLabel}</span></a></li>)}</ol>
          {promoted.map((item) => <a href={item.href} {...authAttrs(item)}>{item.labelEn}</a>)}
          <details><summary>More ways to learn</summary>{navItems.filter((item) => !PROMOTED.includes(item.key) && item.key !== 'courses').map((item) => <a href={item.href} {...authAttrs(item)}>{item.labelEn}</a>)}</details>
          <a href={FREE_COURSE_HREF} data-anon-only class="c4-button c4-button-coral">Start A1.1 free →</a><a href={FREE_COURSE_HREF} data-auth-only data-continue-course style="display:none" class="c4-button">Continue learning →</a>
          <a href={navSignupHref} data-anon-only>Create a free account</a><a href="/pricing/" data-upgrade style="display:none">Upgrade</a><a href="/login" data-anon-only data-login-next>Log in</a><a href={SUPPORT_LINK.href}>{SUPPORT_LINK.labelEn}</a>
        </div></details>
      </div>
    </nav>

    <!-- Page content -->
    <main id="main" class="pt-[calc(4rem+env(safe-area-inset-top))]">
      <slot />
    </main>

    <footer class="c4-site-footer">
      <div class="c4-wrap c4-footer-grid">
        <div class="c4-footer-brand"><a href="/" class="c4-brand"><span class="c4-brand-mark" aria-hidden="true">DM</span><span>DeutschMeister</span></a><p>Practical German for real life in Germany.</p><a href={SUPPORT_LINK.href}>{SUPPORT_LINK.labelEn}</a></div>
        {FOOTER_GROUPS.map((group) => <div class="c4-footer-group"><h2>{group.titleEn}</h2><ul>{group.items.slice(0, 4).map((item) => <li><a href={item.href}>{item.labelEn}</a></li>)}</ul>{group.items.length > 4 && <details><summary>More resources</summary><ul>{group.items.slice(4).map((item) => <li><a href={item.href}>{item.labelEn}</a></li>)}</ul></details>}</div>)}
        <ul class="c4-footer-socials">{SOCIAL_LINKS.map((item) => <li><a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.labelEn}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          {item.key === 'youtube' && <><rect x="2" y="5" width="20" height="14" rx="4" /><path d="m10 9 5 3-5 3z" /></>}
          {item.key === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17 7h.01" /></>}
          {item.key === 'facebook' && <path d="M14 22v-9h3l1-4h-4V7a1 1 0 0 1 1-1h3V2h-3a5 5 0 0 0-5 5v2H7v4h3v9" />}
          {item.key === 'telegram' && <><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></>}
        </svg></a></li>)}</ul>
      </div>
      <div class="c4-wrap c4-footer-legal">{LEGAL_LINKS.map((item) => <a href={item.href}>{item.labelEn}</a>)}<span>© {new Date().getFullYear()} DeutschMeister</span></div>
    </footer>
    <!-- Language: the SPA navbar's EN/DE toggle stores `dm_lang`, but these
         static pages are prerendered in German and used to ignore it entirely,
         so an English speaker following the "Grammar" nav link landed on an
         all-German page. German stays the default (it is what crawlers index
         and what these pages rank for); elements carrying data-en swap to
         English when the visitor has chosen it. Only what is translated is
         marked English: the page keeps the language it declares. Switching the
         whole document to English labelled German guides, comparisons and exam
         hubs (none of which carries a data-en element) as English, and screen
         readers read the German in an English voice. -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('dm_lang') !== 'en') return;
          document.querySelectorAll('[data-en]').forEach(function (el) {
            el.textContent = el.getAttribute('data-en');
            el.setAttribute('lang', 'en');
          });
        } catch (e) { /* storage blocked — keep the German default */ }
      })();
    </script>
    <!-- Auth-aware nav: these static pages used to greet a LOGGED-IN user with
         "Get started / Log in" — the app identity vanished on ~75 of ~93 pages.
         Same cheap sb-*-auth-token check as src/lib/grammarProgress.js: when a
         Supabase session token exists, reveal [data-auth-only] links (Speaking,
         Dashboard) and hide [data-anon-only] ones (Get started, Log in,
         Pricing). Crawlers and logged-out visitors see the logged-out nav. -->
    <script is:inline>
      (function () {
        try {
          // A static page cannot hand /login its place in router state, so its
          // "Log in" links name the page in ?next= (LoginPage honours only the
          // learning pages: src/lib/loginReturn.js nextPath).
          var next = '/login?next=' + encodeURIComponent(location.pathname);
          document.querySelectorAll('[data-login-next]').forEach(function (el) {
            el.setAttribute('href', next);
          });
          var authed = false;
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && /^sb-.*-auth-token$/.test(k)) { authed = true; break; }
          }
          if (!authed) return;
          document.querySelectorAll('[data-auth-only]').forEach(function (el) {
            el.style.display = '';
          });
          document.querySelectorAll('[data-anon-only]').forEach(function (el) {
            el.style.display = 'none';
          });
        } catch (e) { /* storage blocked — keep the logged-out default */ }
      })();
    </script>
    <!-- Idle timeout: the app signs a learner out after 30 minutes without
         activity in ANY tab — it reads the last activity from localStorage
         (src/hooks/useSessionTimeout.js, same key, same 5-second throttle).
         Activity on these static pages counts too: without this, an idle app
         tab signed out a learner who was working through a grammar lesson. -->
    <script is:inline>
      (function () {
        try {
          var authed = false;
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && /^sb-.*-auth-token$/.test(k)) { authed = true; break; }
          }
          if (!authed) return;
          var ACTIVITY_KEY = 'dm_last_activity';
          var THROTTLE_MS = 5000;
          var last = 0;
          var record = function () {
            var now = Date.now();
            if (now - last < THROTTLE_MS) return;
            last = now;
            try { localStorage.setItem(ACTIVITY_KEY, String(now)); } catch (e) { /* storage full or blocked */ }
          };
          record();
          ['mousemove', 'keydown', 'scroll', 'touchstart'].forEach(function (name) {
            window.addEventListener(name, record, { passive: true });
          });
        } catch (e) { /* storage blocked — the app falls back to its own tab's activity */ }
      })();
    </script>
    <!-- Course return bar: when a lesson was opened from a guided course
         (/course/<level>/<item>, SPA), the lesson page stored a context in
         sessionStorage; render the same bar the SPA shows, so the learner never
         has to find the way back. Mirrors src/components/CourseReturnBar.jsx,
         and its two shapes: the legacy per-item course stores position/total
         and finishes through "Done → next" (?done=1); the rebuilt lesson engine
         (SpeakingStage) stores `returnTo`, the stage the learner left, and no
         position. This copy knew only the first, so after a speaking hand-off
         it printed "undefined/undefined" and its "Done → next" opened a legacy
         lesson URL that redirects to the course overview. -->
    <script is:inline>
      (function () {
        try {
          var raw = sessionStorage.getItem('dm_course_ctx');
          if (!raw) return;
          var ctx = JSON.parse(raw);
          if (!ctx || !ctx.level || !ctx.itemId) return;
          var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
          // Only a same-site path is a destination ("//host" is not).
          var sitePath = function (p) { return typeof p === 'string' && /^\/(?![\/\\])/.test(p) ? p : null; };
          var home = sitePath(ctx.homeHref) || '/course/' + ctx.level;
          var returnTo = sitePath(ctx.returnTo);
          var KEY = 'background:var(--dm-siegel);color:white;font-weight:700;font-size:.875rem;padding:.5rem 1rem;border-radius:.75rem;text-decoration:none;border:1px solid transparent;white-space:nowrap';
          var action = returnTo
            ? '<a href="' + esc(returnTo) + '" style="' + KEY + '">' + esc(ctx.returnLabel || 'Zurück zur Lektion') + ' &#8594;</a>'
            : '<a href="/course/' + esc(ctx.level) + '/' + encodeURIComponent(ctx.itemId) + '?done=1" style="' + KEY + '">&#10003; Done &#8594; next</a>';
          var bar = document.createElement('div');
          bar.setAttribute('data-course-return-bar', '');
          bar.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:40;background:rgba(255,255,255,.95);border-top:1px solid var(--dm-edge);backdrop-filter:blur(6px);padding-bottom:env(safe-area-inset-bottom);';
          bar.innerHTML =
            '<div style="max-width:48rem;margin:0 auto;display:flex;align-items:center;gap:.75rem;padding:.625rem 1rem;font-family:inherit">' +
            '<a href="' + esc(home) + '" style="font-weight:700;color:var(--dm-siegel);text-decoration:none;font-size:.875rem;white-space:nowrap">&#8592; ' + esc(ctx.code || ctx.level.toUpperCase()) + '</a>' +
            '<p style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.8125rem;color:var(--dm-graphite);margin:0">' + (ctx.position ? esc(ctx.position) + '/' + esc(ctx.total) + ' &middot; ' : '') + esc(ctx.title || '') + '</p>' +
            action +
            '</div>';
          document.body.appendChild(bar);
          document.body.style.paddingBottom = '4rem';
        } catch (e) { /* storage blocked — no bar */ }
      })();
    </script>
    <Showtime />
    <Motion />
    <script>
      // Funnel events for the static pages (src/data/events.js). Consent-gated
      // inside track(); before Accept every call is a no-op.
      import { autoTrack } from '../lib/track.js';
      import { courseHomeFor } from '../../../src/lib/courseEntry.js';
      import { subscriptionStatus } from '../../../src/lib/subscriptionStatus.js';
      import { courseAccessReason } from '../../../src/lib/levelEntitlement.js';

      // What the account opens, from the three rows updateContinueLinks reads.
      // An admin's premium grant (profiles.subscription_tier 'premium') is AI Practice
      // with no subscription or purchase row behind it, and the server keeps it
      // through every reconciliation (netlify/functions/_shared/
      // subscriptionEntitlement.mjs); is_subscribed alone can be stale.
      function accountAccess({ profile, subscription, purchases = [] }, now = Date.now()) {
        const trialOpen = Boolean(profile?.trial_started_at && !profile.is_subscribed && Date.parse(profile.trial_ends_at) > now);
        // Owned products only: a kept AI Practice-day grant window ('pro_days', pricing.js
        // GRANT_WINDOW_PRODUCT) opens AI Practice while its access_until is ahead and is
        // never a bought course. Spelled out: these helpers also run in tests
        // that inject only the imports above.
        const activePurchases = purchases.filter((purchase) => purchase.status === 'active' && purchase.product_key !== 'pro_days');
        const premiumGrant = profile?.subscription_tier === 'premium';
        const proOpen = premiumGrant || subscriptionStatus(subscription, now).isActive || purchases.some((purchase) => purchase.status === 'active' && Date.parse(purchase.access_until) > now);
        return { trialOpen, proOpen, activePurchases };
      }

      // A bought course beats a missing or lower placement (courseHomeFor).
      function continueCourseHref(account, now = Date.now()) {
        const { activePurchases } = accountAccess(account, now);
        return courseHomeFor({
          level: account.profile?.current_level,
          purchases: activePurchases,
          hasLevelAccess: (level) => Boolean(courseAccessReason(account, level, now)),
        });
      }

      // The SPA navbar's Upgrade chip: no live trial, no live AI Practice, no course.
      function showsUpgrade(account, now = Date.now()) {
        const { trialOpen, proOpen, activePurchases } = accountAccess(account, now);
        return !trialOpen && !proOpen && activePurchases.length === 0;
      }

      async function updateContinueLinks() {
        const links = document.querySelectorAll('[data-continue-course]');
        if (!links.length) return;
        const storedSession = Array.from({ length: localStorage.length }, (_, i) => localStorage.key(i)).some((key) => key && /^sb-.*-auth-token$/.test(key));
        if (!storedSession) return;
        const { supabase } = await import('../lib/supabase.js');
        const { data: { user } = {} } = await supabase.auth.getUser();
        if (!user) return;
        const [profile, subscription, purchases] = await Promise.all([
          supabase.from('profiles').select('current_level, is_subscribed, trial_started_at, trial_ends_at, subscription_tier').eq('id', user.id).maybeSingle(),
          supabase.from('subscriptions').select('status, plan_type, subscription_start, created_at, subscription_end').eq('user_id', user.id).order('subscription_end', { ascending: false, nullsFirst: false }).limit(1).maybeSingle(),
          // created_at: courseHomeFor resumes the NEWEST course, as the SPA does
          // (getPurchases selects the same column); without it the two front
          // ends sent a two-course buyer to different courses.
          supabase.from('purchases').select('product_key, status, access_until, created_at').eq('user_id', user.id).eq('status', 'active').order('created_at', { ascending: false }),
        ]);
        if (profile.error || subscription.error || purchases.error) return;
        const account = { profile: profile.data, subscription: subscription.data, purchases: purchases.data || [] };
        const href = continueCourseHref(account);
        links.forEach((link) => { link.href = href; });
        if (showsUpgrade(account)) document.querySelectorAll('[data-upgrade]').forEach((link) => { link.style.display = ''; });
      }

      updateContinueLinks().catch(() => { /* keep the free course when account data is unavailable */ });
      autoTrack();
    </script>
  </body>
</html>
