---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  keywords?: string;
  lang?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = 'https://deutsch-meister.de/og-image.png',
  jsonLd,
  noindex = false,
  keywords,
  lang = 'en',
} = Astro.props;

const canonicalUrl = canonical ?? Astro.url.href;
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Analytics is loaded only after cookie consent — see /consent.js -->
    <script src="/consent.js" defer></script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DeutschMeister logo beside the words “Learn German Grammar from A1 to B2”" />
    <meta property="og:site_name" content="DeutschMeister" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Fonts: preload pattern (non-render-blocking), mirrors the SPA shell -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito+Sans:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- JSON-LD Structured Data -->
    {jsonLdArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <style is:global>
      :focus-visible {
        outline: 2px solid #0d9488;
        outline-offset: 2px;
      }
    </style>
  </head>

  <body class="font-body bg-slate-50 text-slate-800 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow"
    >
      Skip to content
    </a>
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo — the Meister-Siegel seal, same mark as the app (src/components/Logo.jsx) -->
          <a href="https://deutsch-meister.de/" class="flex items-center gap-2.5">
            <svg width="40" height="40" viewBox="0 0 64 64" role="img" aria-label="DeutschMeister">
              <defs>
                <linearGradient id="dmSealNav" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#0F766E" />
                  <stop offset="1" stop-color="#0D9488" />
                </linearGradient>
              </defs>
              <circle cx="32" cy="32" r="30" fill="url(#dmSealNav)" />
              <circle cx="32" cy="32" r="26" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1.2" stroke-dasharray="1.5 4" />
              <circle cx="32" cy="8.5" r="3.4" fill="#FBBF24" />
              <text x="32" y="45" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="700" font-size="34" fill="#fff">M</text>
            </svg>
            <span class="font-display font-semibold text-xl text-ink hidden sm:block">
              Deutsch<span class="text-siegel-lift">Meister</span>
            </span>
          </a>

          <!-- Desktop nav -->
          <div class="hidden md:flex items-center gap-1">
            <a href="/grammar/" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-colors">
              Grammar
            </a>
            <a href="https://deutsch-meister.de/video-library" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-colors">
              Videos
            </a>
            <a href="https://deutsch-meister.de/podcasts/" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-colors">
              Podcasts
            </a>
            <div class="w-px h-5 bg-slate-200 mx-1"></div>
            <a href="https://deutsch-meister.de/analyze/" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-colors">
              X-Ray
            </a>
            <a href="https://deutsch-meister.de/level-test/" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-colors">
              Level Test
            </a>
            <div class="w-px h-5 bg-slate-200 mx-1"></div>
            <a
              href="https://deutsch-meister.de/signup"
              class="px-4 py-2 rounded-lg bg-gradient-to-r from-teal-600 to-teal-500 text-white text-sm font-semibold hover:from-teal-700 hover:to-teal-600 transition-all"
            >
              Get started
            </a>
            <a
              href="https://deutsch-meister.de/login"
              class="px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
            >
              Log in
            </a>
          </div>

          <!-- Mobile: CTA + full menu (pure HTML disclosure, no client JS) -->
          <div class="md:hidden flex items-center gap-2">
            <a href="https://deutsch-meister.de/signup" class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-teal-600 to-teal-500 text-white text-sm font-semibold">
              Start
            </a>
            <details class="relative">
              <summary
                class="list-none cursor-pointer p-2 rounded-lg hover:bg-slate-100 flex items-center [&::-webkit-details-marker]:hidden"
                aria-label="Menu"
              >
                <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
              </summary>
              <div class="absolute right-0 top-full mt-2 w-56 bg-white rounded-xl border border-slate-200 shadow-lg py-2 z-50">
                <a href="/grammar/" class="block px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Grammar</a>
                <a href="https://deutsch-meister.de/video-library" class="block px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Videos</a>
                <a href="https://deutsch-meister.de/podcasts/" class="block px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Podcasts</a>
                <a href="https://deutsch-meister.de/analyze/" class="block px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">X-Ray</a>
                <a href="https://deutsch-meister.de/level-test/" class="block px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Level Test</a>
                <div class="my-2 border-t border-slate-100"></div>
                <a href="https://deutsch-meister.de/login" class="block px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Log in</a>
                <a href="https://deutsch-meister.de/signup" class="block px-4 py-2 text-sm font-semibold text-rose-600 hover:bg-slate-50">Get started</a>
              </div>
            </details>
          </div>
        </div>
      </div>
    </nav>

    <!-- Page content -->
    <main id="main" class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 mb-8">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <svg width="32" height="32" viewBox="0 0 64 64" role="img" aria-label="DeutschMeister">
                <defs>
                  <linearGradient id="dmSealFoot" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#0F766E" />
                    <stop offset="1" stop-color="#0D9488" />
                  </linearGradient>
                </defs>
                <circle cx="32" cy="32" r="30" fill="url(#dmSealFoot)" />
                <circle cx="32" cy="32" r="26" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1.2" stroke-dasharray="1.5 4" />
                <circle cx="32" cy="8.5" r="3.4" fill="#FBBF24" />
                <text x="32" y="45" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="700" font-size="34" fill="#fff">M</text>
              </svg>
              <span class="font-display font-semibold text-white">Deutsch<span class="text-teal-400">Meister</span></span>
            </div>
            <p class="text-sm leading-relaxed">
              Learn German with AI — from A1.1 to B2.2. Grammar, speaking, listening, and reading.
            </p>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm mb-3">Grammar</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/grammar/a1.1/" class="hover:text-white transition-colors">A1.1 Grammar</a></li>
              <li><a href="/grammar/a1.2/" class="hover:text-white transition-colors">A1.2 Grammar</a></li>
              <li><a href="/grammar/a2.1/" class="hover:text-white transition-colors">A2.1 Grammar</a></li>
              <li><a href="/grammar/b1.1/" class="hover:text-white transition-colors">B1.1 Grammar</a></li>
              <li><a href="/grammar/" class="hover:text-white transition-colors">All levels →</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm mb-3">Learn</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="https://deutsch-meister.de/speaking/" class="hover:text-white transition-colors">AI Speaking Practice</a></li>
              <li><a href="https://deutsch-meister.de/analyze/" class="hover:text-white transition-colors">Sentence X-Ray</a></li>
              <li><a href="https://deutsch-meister.de/listening/" class="hover:text-white transition-colors">Listening Practice</a></li>
              <li><a href="https://deutsch-meister.de/reading/" class="hover:text-white transition-colors">Reading Lessons</a></li>
              <li><a href="https://deutsch-meister.de/podcasts/" class="hover:text-white transition-colors">Podcasts</a></li>
              <li><a href="https://deutsch-meister.de/level-test/" class="hover:text-white transition-colors">Level Test</a></li>
              <li><a href="https://deutsch-meister.de/pricing/" class="hover:text-white transition-colors">Pricing</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm mb-3">Guides</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/leitfaden/" class="hover:text-white transition-colors">Alle Prüfungsleitfäden</a></li>
              <li><a href="/leitfaden/telc-b1/" class="hover:text-white transition-colors">telc B1</a></li>
              <li><a href="/leitfaden/goethe-b1/" class="hover:text-white transition-colors">Goethe-Zertifikat B1</a></li>
              <li><a href="/leitfaden/telc-b2/" class="hover:text-white transition-colors">telc B2</a></li>
              <li><a href="/leitfaden/dtz/" class="hover:text-white transition-colors">DTZ</a></li>
              <li><a href="/vergleich/" class="hover:text-white transition-colors">Plattform-Vergleich</a></li>
              <li><a href="https://deutsch-meister.de/faq" class="hover:text-white transition-colors">FAQ</a></li>
              <li><a href="https://deutsch-meister.de/ueber-uns" class="hover:text-white transition-colors">Über uns</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-slate-800 pt-6 text-center text-xs">
          <p class="mb-2">
            <a href="/privacy/" class="hover:text-white transition-colors">Privacy Policy</a>
            <span class="mx-2">·</span>
            <a href="/impressum/" class="hover:text-white transition-colors">Impressum</a>
          </p>
          © {new Date().getFullYear()} DeutschMeister · All rights reserved
        </div>
      </div>
    </footer>
    <!-- Language: the SPA navbar's EN/DE toggle stores `dm_lang`, but these
         static pages are prerendered in German and used to ignore it entirely,
         so an English speaker following the "Grammar" nav link landed on an
         all-German page. German stays the default (it is what crawlers index
         and what these pages rank for); elements carrying data-en swap to
         English when the visitor has chosen it. -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('dm_lang') !== 'en') return;
          document.documentElement.lang = 'en';
          document.querySelectorAll('[data-en]').forEach(function (el) {
            el.textContent = el.getAttribute('data-en');
          });
        } catch (e) { /* storage blocked — keep the German default */ }
      })();
    </script>
  </body>
</html>
