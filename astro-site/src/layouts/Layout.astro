---
import { NAV_GROUPS, FOOTER_GROUPS, LEGAL_LINKS, SOCIAL_LINKS, SUPPORT_LINK } from '../data/navigation.js';
import { fontPreloads, signFontPreloads, arabicFontPreloads, color, nacht, linie } from '../data/design-tokens.js';
import Showtime from '../components/Showtime.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { AR_CHROME, AR_COURSE_HREF } from '../data/i18n/ar.js';
import { onsiteHref, surfaceForPath } from '../lib/onsiteLinks.js';
import { TRIAL_DAYS } from '../data/marketing.js';
import { STATIONS, FREE_COURSE_HREF } from '../data/offers.js';
import 'atropos/css';
import '../styles/showtime.css';
import '../styles/linie.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  keywords?: string;
  lang?: string;
  /** 'nacht' renders the night nav (pages whose first screen is a nacht ground). */
  tone?: 'paper' | 'nacht';
  /** Font files to preload; defaults to the token list. Pages that set signs above the fold add signFontPreloads. */
  preloads?: string[];
  /** The page's twin in the other language (root-relative paths, trailing slash). Only real equivalents. */
  alternates?: { en: string; ar: string } | null;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = 'https://deutsch-meister.de/og-image.png',
  jsonLd,
  noindex = false,
  keywords,
  lang = 'en',
  tone = 'paper',
  preloads = fontPreloads,
  alternates = null,
} = Astro.props;
// The sign face (Archivo) is for the pages that preload it — the marketing and
// commerce pages. Everywhere else (grammar, guides, exams …) the chrome sets its
// labels in the body face, so a library page never fetches a 55 KB font for its
// nav alone (it cost ~450 ms of lab FCP there; linie.css `data-sign="off"`).
const signOn = signFontPreloads.every((href) => preloads.includes(href));

// `canonical={null}` means emit none. Only 404.html uses it: the page is served
// at /404.html and as the fallback body for arbitrary unknown paths, so there is
// no URL it could honestly point at — it previously claimed the homepage, and
// self-referencing would claim a /404/ route that does not exist.
const canonicalUrl = canonical === null ? null : (canonical ?? Astro.url.href);
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// The Arabic edition (docs/arabic/README.md). An Arabic page is right-to-left,
// its chrome comes from data/i18n/ar.js, its nav prefers each item's Arabic twin
// (`hrefAr`) and labels the rest with the language they open in, and it preloads
// the Arabic face instead of the Latin display face it does not set (linie.css
// sets Arabic headings in the body face). `alternates` pairs a page with its
// twin: reciprocal hreflang (en, ar, x-default = English) and the switch.
const isArabic = lang === 'ar';
const SITE = 'https://deutsch-meister.de';
const abs = (path) => new URL(path, SITE).href;
const OG_LOCALE = { en: 'en_US', de: 'de_DE', ar: 'ar_AR' };
const ogAlternates = isArabic ? ['en_US'] : [lang === 'de' ? 'en_US' : 'de_DE', ...(alternates ? ['ar_AR'] : [])];
const label = (item) => (isArabic && (item.labelAr || item.titleAr)) || item.labelEn || item.titleEn;
const hrefFor = (item) => (isArabic && item.hrefAr) || item.href;
const freeHref = isArabic ? AR_COURSE_HREF : FREE_COURSE_HREF;
const stationHref = (st) => (isArabic && st.status === 'free' ? '/ar/courses/a1-1/' : st.coursePage);
const fontLinks = isArabic && preloads === fontPreloads ? [...arabicFontPreloads, ...fontPreloads.filter((f) => f.includes('nunito'))] : preloads;

// Nav links come from THE navigation registry (src/data/navigation.js — the
// byte-identical twin of the SPA's copy; scripts/check-duplicates.mjs guards
// the pair). Root-relative hrefs so deploy previews and local serving work;
// the old absolute https://deutsch-meister.de/... links broke both.
// auth visibility: items marked 'authed' start hidden and an inline script
// below reveals them (and hides 'anon' items) when a Supabase session token
// exists — crawlers and logged-out visitors see the logged-out nav.
// Inline display:none (not the `hidden` attribute) — Tailwind's `.block`
// utility outranks the UA/preflight [hidden] rule in the cascade.
const navItems = NAV_GROUPS.flatMap((g) => g.items);

// The nav's trial button is the first signup door on every page. On a grammar
// lesson or a guide it carries the surface (src/lib/onsiteLinks.js), so a
// visitor who arrived with no referrer is no longer "untracked" when they sign
// up from the nav. Everywhere else it stays the bare route.
const surface = surfaceForPath(Astro.url.pathname);
const navSignupHref = surface ? onsiteHref('signup', surface, 'nav') : '/signup';
// From an Arabic page the app doors carry the language (an explicit choice: the
// visitor is reading Arabic), so sign-up and sign-in open in Arabic too.
const signupHref = lang === 'ar' ? '/signup?lang=ar' : navSignupHref;
const loginHref = lang === 'ar' ? '/login?lang=ar' : '/login';
// v3 chrome ("Die Linie"): Courses and Pricing sit in the bar itself — the two
// doors a buyer looks for — and leave their groups so no link appears twice.
const PROMOTED = ['courses', 'pricing'];
const promoted = PROMOTED.map((key) => navItems.find((i) => i.key === key)).filter(Boolean);
const navGroups = NAV_GROUPS.map((g) => ({ ...g, items: g.items.filter((i) => !PROMOTED.includes(i.key)) })).filter((g) => g.items.length);
const night = tone === 'nacht';
// theme-color matches the top of the page (mobile-native: status bar = header).
const themeColor = night ? nacht.DEFAULT : color.paper;
// Token values for the two inline scripts below (they cannot import modules):
// one place, so the course return bar never carries its own hex again.
const rootVars = `:root{--dm-siegel:${color.siegel};--dm-siegel-edge:${color.siegelEdge};--dm-edge:${color.edge};--dm-graphite:${color.graphite};--dm-linie:${linie.DEFAULT};--dm-nacht:${nacht.DEFAULT}}`;
const authAttrs = (item) =>
  item.auth === 'authed'
    ? { 'data-auth-only': '', style: 'display:none' }
    : item.auth === 'anon'
      ? { 'data-anon-only': '' }
      : {};
---

<!doctype html>
<html lang={lang} dir={isArabic ? 'rtl' : undefined} data-sign={signOn ? undefined : 'off'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Stamped before first paint: the .reveal hidden state (showtime.css)
         exists only under html.js, so no-JS visitors and crawlers see everything. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Analytics is loaded only after cookie consent — see /consent.js -->
    <script src="/consent.js" defer></script>
    <!-- Which link brought this visitor (utm_* / ?ref= / social referrer) — see /attribution.js -->
    <script src="/attribution.js" defer></script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternates && <link rel="alternate" hreflang="en" href={abs(alternates.en)} />}
    {alternates && <link rel="alternate" hreflang="ar" href={abs(alternates.ar)} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={isArabic ? AR_CHROME.ogImageAlt : 'The Meister-Siegel seal beside the words “Learn German grammar, listening and speaking — A1 to B2”'} />
    <meta property="og:site_name" content="DeutschMeister" />
    <meta property="og:locale" content={OG_LOCALE[lang] || 'en_US'} />
    {ogAlternates.map((loc) => <meta property="og:locale:alternate" content={loc} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Fonts: self-hosted from /fonts/ (root public/, merged into dist/ like
         /consent.js); the @font-face rules ship in this site's stylesheet via
         tailwind.config.mjs. Preloads come from the token, same list as the
         SPA shell (design-tokens.js `fontPreloads`); an Arabic page swaps the
         display face for the Arabic one (`arabicFontPreloads`). -->
    {fontLinks.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    <!-- JSON-LD Structured Data -->
    {jsonLdArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <style is:global set:html={`${rootVars}:focus-visible{outline:3px solid var(--dm-siegel);outline-offset:2px}`}></style>
  </head>

  <body class="font-body bg-paper text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:start-2 focus:z-[60] focus:bg-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow"
    >
      {isArabic ? AR_CHROME.skip : 'Skip to content'}
    </a>
    <!-- Navbar — v3 "Die Linie": the bar is a station sign. Paper by default;
         night (`tone="nacht"`) on pages whose first screen is a nacht ground,
         so the top of the page reads as one surface. -->
    <nav
      class:list={[
        'fixed top-0 left-0 right-0 z-50 border-b backdrop-blur-md pt-[env(safe-area-inset-top)]',
        night ? 'bg-nacht/90 border-nacht-rule text-nacht-text' : 'bg-paper/90 border-rule text-ink',
      ]}
      data-ground={night ? 'nacht' : 'paper'}
      aria-label={isArabic ? AR_CHROME.mainNav : 'Main'}
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 2xl:max-w-[1536px]">
        <div class="flex items-center justify-between h-16">
          <!-- Logo — the Meister-Siegel seal, same mark as the app (src/components/Logo.jsx); colours from the tokens -->
          <a href="/" class="flex items-center gap-2.5">
            <svg width="38" height="38" viewBox="0 0 64 64" role="img" aria-label="DeutschMeister">
              <defs>
                <linearGradient id="dmSealNav" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color={color.siegel} />
                  <stop offset="1" stop-color={color.siegelLift} />
                </linearGradient>
              </defs>
              <circle cx="32" cy="32" r="30" fill="url(#dmSealNav)" />
              <circle cx="32" cy="32" r="26" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1.2" stroke-dasharray="1.5 4" />
              <circle cx="32" cy="8.5" r="3.4" fill={color.gold} />
              <text x="32" y="45" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="700" font-size="34" fill={color.white}>M</text>
            </svg>
            {night ? (
              <span class="sign-label hidden text-[1.1875rem] text-nacht-text sm:block">Deutsch<span class="text-linie">Meister</span></span>
            ) : (
              <span class="sign-label hidden text-[1.1875rem] text-ink sm:block">Deutsch<span class="text-siegel-deep">Meister</span></span>
            )}
          </a>

          <!-- Desktop nav — rendered from the shared navigation registry -->
          <div class="hidden lg:flex items-center gap-1">
            {promoted.map((item) => (
              <a
                href={hrefFor(item)}
                {...authAttrs(item)}
                class:list={['sign-label flex min-h-11 items-center whitespace-nowrap rounded-pill px-3.5 py-2 text-[0.9375rem] transition-colors', night ? 'text-nacht-text hover:bg-nacht-raised' : 'text-ink hover:bg-paper-sunk']}
              >
                {label(item)}
              </a>
            ))}
            {NAV_GROUPS.map((group) => navGroups.some((g) => g.key === group.key) && (
              <details class="group relative">
                <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 whitespace-nowrap rounded-pill px-3.5 py-2 text-[0.9375rem] sign-label text-graphite transition-colors hover:bg-paper-sunk hover:text-ink [&::-webkit-details-marker]:hidden [[data-ground=nacht]_&]:text-nacht-muted [[data-ground=nacht]_&]:hover:bg-nacht-raised [[data-ground=nacht]_&]:hover:text-nacht-text">
                  {label(group)}
                  <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                </summary>
                <div class="dm-sheet absolute start-0 top-full z-50 mt-1 min-w-56 rounded-clay border border-rule bg-white p-2 text-ink shadow-overlay">
                  {navGroups.find((g) => g.key === group.key).items.map((item) => (
                    <a
                      href={hrefFor(item)}
                      {...authAttrs(item)}
                      class="flex min-h-11 items-center whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold text-graphite transition-colors hover:bg-siegel-wash hover:text-siegel-deep"
                    >
                      {label(item)}
                    </a>
                  ))}
                </div>
              </details>
            ))}
            <div class:list={['mx-2 h-5 w-px', night ? 'bg-nacht-rule' : 'bg-rule']}></div>
            <a
              href={loginHref}
              data-anon-only
              class:list={['sign-label whitespace-nowrap px-3 py-2 text-[0.9375rem] transition-colors', night ? 'text-nacht-muted hover:text-nacht-text' : 'text-graphite hover:text-ink']}
            >
              {isArabic ? AR_CHROME.logIn : 'Log in'}
            </a>
            <a
              href={signupHref}
              data-anon-only
              class:list={['sign-label whitespace-nowrap px-3 py-2 text-[0.9375rem] underline decoration-2 underline-offset-4 transition-colors', night ? 'text-nacht-text decoration-nacht-rule hover:decoration-linie' : 'text-ink decoration-rule hover:decoration-siegel']}
            >
              {isArabic ? AR_CHROME.startTrial : <>Start {TRIAL_DAYS}-day trial</>}
            </a>
            <a
              href={freeHref}
              data-anon-only
              data-track="course_selected"
              data-track-level="a1.1"
              data-track-surface="nav"
              class:list={['dm-key ms-1 !min-h-10 !px-4 !py-2 !text-[0.9375rem]', night ? 'dm-key-linie' : 'dm-key-siegel']}
            >
              {isArabic ? AR_CHROME.startFree : 'Start A1.1 free'}
            </a>
            <a
              href="/dashboard"
              data-auth-only
              style="display:none"
              class:list={['dm-key ms-1 !min-h-10 !px-4 !py-2 !text-[0.9375rem]', night ? 'dm-key-linie' : 'dm-key-siegel']}
            >
              {isArabic ? AR_CHROME.continueLearning : 'Continue learning'}
            </a>
          </div>

          <!-- Mobile: the free first stop + the full menu (pure HTML disclosure, no client JS) -->
          <div class="lg:hidden flex items-center gap-2">
            <a href={freeHref} data-anon-only data-track="course_selected" data-track-level="a1.1" data-track-surface="nav_mobile" class:list={['dm-key !min-h-10 !px-3.5 !py-2 !text-[0.875rem]', night ? 'dm-key-linie' : 'dm-key-siegel']}>
              {isArabic ? AR_CHROME.startFree : 'Start A1.1 free'}
            </a>
            <a href="/dashboard" data-auth-only style="display:none" class:list={['dm-key !min-h-10 !px-3.5 !py-2 !text-[0.875rem]', night ? 'dm-key-linie' : 'dm-key-siegel']}>
              {isArabic ? AR_CHROME.dashboard : 'Dashboard'}
            </a>
            <details class="relative">
              <summary class:list={['flex min-h-11 cursor-pointer list-none items-center justify-center rounded-pill p-2.5 [&::-webkit-details-marker]:hidden', night ? 'hover:bg-nacht-raised' : 'hover:bg-paper-sunk']} aria-label={isArabic ? AR_CHROME.menu : 'Menu'}>
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h10" />
                </svg>
              </summary>
              <!-- The sheet: a timetable of every door, on the night ground. -->
              <div class="dm-sheet fixed inset-x-0 top-16 z-50 max-h-[calc(100svh-4rem)] overflow-y-auto border-t border-nacht-rule bg-nacht px-4 pb-[calc(1.5rem+env(safe-area-inset-bottom))] pt-4 text-nacht-text shadow-overlay" data-ground="nacht">
                <ol class="mb-4 grid grid-cols-4 gap-2" aria-label={isArabic ? AR_CHROME.coursesByLevel : 'Courses by level'}>
                  {STATIONS.map((st) => (
                    <li>
                      <a href={stationHref(st)} class="flex min-h-11 flex-col items-center justify-center rounded-xl border border-nacht-rule bg-nacht-raised px-1 py-2 text-center">
                        <span class="sign-code text-[1rem]">{st.code}</span>
                        <span class:list={['mt-0.5 font-data text-[0.625rem]', st.status === 'free' ? 'text-linie' : 'text-nacht-muted']}>{st.status === 'free' ? (isArabic ? AR_CHROME.free : 'free') : st.status === 'building' ? (isArabic ? AR_CHROME.building : 'Im Bau') : <bdi dir="ltr">{st.priceLabel}</bdi>}</span>
                      </a>
                    </li>
                  ))}
                </ol>
                {promoted.map((item) => (
                  <a href={hrefFor(item)} {...authAttrs(item)} class="sign-label flex min-h-11 items-center border-b border-nacht-rule text-[1.0625rem]">{label(item)}</a>
                ))}
                {navItems.filter((item) => !PROMOTED.includes(item.key)).map((item) => (
                  <a
                    href={hrefFor(item)}
                    {...authAttrs(item)}
                    class="flex min-h-11 items-center border-b border-nacht-rule text-[0.9375rem] font-semibold text-nacht-muted"
                  >
                    {label(item)}
                  </a>
                ))}
                {isArabic && <a href="/ar/help/" class="flex min-h-11 items-center border-b border-nacht-rule text-[0.9375rem] font-semibold text-nacht-muted">{AR_CHROME.help}</a>}
                <div class="mt-5 grid gap-3">
                  <a href={freeHref} data-anon-only class="dm-key dm-key-linie w-full">{isArabic ? AR_CHROME.startFreeNoAccount : 'Start A1.1 free — no account'}</a>
                  <a href={signupHref} data-anon-only class="dm-key dm-key-ghost-nacht w-full">{isArabic ? AR_CHROME.startTrial : <>Start {TRIAL_DAYS}-day trial</>}</a>
                  <a href={loginHref} data-anon-only class="dm-link-nacht py-2 text-center text-sm font-semibold">{isArabic ? AR_CHROME.logIn : 'Log in'}</a>
                </div>
              </div>
            </details>
          </div>
        </div>
      </div>
    </nav>

    <!-- Page content -->
    <main id="main" class="pt-[calc(4rem+env(safe-area-inset-top))]">
      {alternates && (
        <div class:list={['border-b', night ? 'border-nacht-rule bg-nacht text-nacht-text' : 'border-rule bg-paper']} data-ground={night ? 'nacht' : 'paper'}>
          <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-end px-2 sm:px-4 lg:px-6">
            <LanguageSwitch current={isArabic ? 'ar' : 'en'} en={alternates.en} ar={alternates.ar} variant={night ? 'sheet' : 'bar'} />
          </div>
        </div>
      )}
      <slot />
    </main>

    <!-- Footer — the end of the line: every station, then every door. -->
    <footer class="mt-20 bg-nacht text-nacht-muted" data-ground="nacht">
      <div class="mx-auto max-w-7xl px-4 pt-12 sm:px-6 lg:px-8">
        <!-- The line, flat: eight stations, each a link to its course page. -->
        <nav aria-label={isArabic ? AR_CHROME.coursesByLevel : 'Courses by level'} class="relative pb-10">
          <div class="absolute left-0 right-0 top-[1.0625rem] h-1.5 rounded-pill bg-linie" aria-hidden="true"></div>
          <ol class="relative grid grid-cols-4 gap-y-6 sm:grid-cols-8">
            {STATIONS.map((st) => (
              <li class="flex flex-col items-start sm:items-center">
                <a href={stationHref(st)} class="group flex flex-col items-start gap-2 sm:items-center">
                  <span class:list={['dm-station-dot block h-[2.375rem] w-[2.375rem] rounded-full border-[5px]', st.status === 'building' ? 'border-nacht-rule bg-nacht' : 'border-linie bg-nacht']} aria-hidden="true"></span>
                  <span class="sign-code text-[1.125rem] text-nacht-text">{st.code}</span>
                  <span class="font-data text-[0.6875rem]">{st.status === 'free' ? (isArabic ? AR_CHROME.free : 'Free') : st.status === 'building' ? (isArabic ? AR_CHROME.building : 'Im Bau') : <bdi dir="ltr">{st.priceLabel}</bdi>}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="grid gap-10 border-t border-nacht-rule py-10 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <div class="mb-3 flex items-center gap-2">
              <svg width="32" height="32" viewBox="0 0 64 64" role="img" aria-label="DeutschMeister">
                <defs>
                  <linearGradient id="dmSealFoot" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color={color.siegel} />
                    <stop offset="1" stop-color={color.siegelLift} />
                  </linearGradient>
                </defs>
                <circle cx="32" cy="32" r="30" fill="url(#dmSealFoot)" />
                <circle cx="32" cy="32" r="26" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1.2" stroke-dasharray="1.5 4" />
                <circle cx="32" cy="8.5" r="3.4" fill={color.gold} />
                <text x="32" y="45" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="700" font-size="34" fill={color.white}>M</text>
              </svg>
              <span class="sign-label text-[1.0625rem] text-nacht-text">Deutsch<span class="text-siegel-deep">Meister</span></span>
            </div>
            <p class="text-sm leading-relaxed">
              {isArabic ? AR_CHROME.footerBlurb : 'German from A1.1 to B2.2, one stop at a time: guided courses, grammar, listening, reading and AI speaking practice.'}
            </p>
            <p class="mt-4">
              <a href={signupHref} data-anon-only class="dm-link-nacht text-sm font-semibold">{isArabic ? AR_CHROME.createAccount : 'Create a free account'}</a>
            </p>
            <!-- Off-site channels. Same registry as the SPA footer. -->
            <ul class="mt-4 flex items-center gap-4 text-sm">
              {SOCIAL_LINKS.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-nacht-text"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
                    </svg>
                    {label(item)}
                  </a>
                </li>
              ))}
            </ul>
            <!-- The one way to reach a human (same registry entry as the SPA
                 footer). /support is an SPA route: signed in it opens the
                 ticket form, signed out it offers sign-in or the contact
                 address — so a static-page visitor is never a dead end. -->
            <p class="mt-1 text-sm">
              <a href={SUPPORT_LINK.href} class="inline-flex min-h-11 items-center gap-2 font-semibold text-nacht-text transition-colors hover:text-siegel-deep">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="4" />
                  <path d="m4.93 4.93 4.24 4.24M14.83 9.17l4.24-4.24M14.83 14.83l4.24 4.24M9.17 14.83l-4.24 4.24" />
                </svg>
                {label(SUPPORT_LINK)}
              </a>
            </p>
            {isArabic && (
              <p class="text-sm">
                <a href="/ar/help/" class="inline-flex min-h-11 items-center font-semibold text-nacht-text transition-colors hover:text-siegel-deep">{AR_CHROME.help}</a>
              </p>
            )}
          </div>
          {FOOTER_GROUPS.map((group) => (
            <div>
              <h2 class="text-nacht-text font-semibold sign-label mb-3 text-sm">{label(group)}</h2>
              <ul class="space-y-1 text-sm">
                {group.items.map((item) => (
                  <li><a href={hrefFor(item)} class="inline-flex min-h-9 items-center transition-colors hover:text-nacht-text">{label(item)}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="border-t border-nacht-rule py-6 pb-[calc(1.5rem+env(safe-area-inset-bottom))] text-center text-xs">
          <p class="mb-2">
            {LEGAL_LINKS.map((item, i) => (
              <>
                {i > 0 && <span class="mx-2">·</span>}
                <a href={item.href} class="transition-colors hover:text-nacht-text">{label(item)}</a>
              </>
            ))}
          </p>
          © <bdi dir="ltr">{new Date().getFullYear()} DeutschMeister</bdi> · {isArabic ? AR_CHROME.rights : 'All rights reserved'}
        </div>
      </div>
    </footer>
    <!-- Language: the SPA navbar's EN/DE toggle stores `dm_lang`, but these
         static pages are prerendered in German and used to ignore it entirely,
         so an English speaker following the "Grammar" nav link landed on an
         all-German page. German stays the default (it is what crawlers index
         and what these pages rank for); elements carrying data-en swap to
         English when the visitor has chosen it.
         Only then: a page with no [data-en] element has nothing English to
         show, and rewriting its <html lang> would mislabel it — an Arabic page
         or a German guide read aloud in an English voice (Arabic edition, G7). -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('dm_lang') !== 'en') return;
          if (!document.querySelector('[data-en]')) return;
          document.documentElement.lang = 'en';
          document.querySelectorAll('[data-en]').forEach(function (el) {
            el.textContent = el.getAttribute('data-en');
          });
        } catch (e) { /* storage blocked — keep the German default */ }
      })();
    </script>
    <!-- Auth-aware nav: these static pages used to greet a LOGGED-IN user with
         "Get started / Log in" — the app identity vanished on ~75 of ~93 pages.
         Same cheap sb-*-auth-token check as src/lib/grammarProgress.js: when a
         Supabase session token exists, reveal [data-auth-only] links (Speaking,
         Dashboard) and hide [data-anon-only] ones (Get started, Log in,
         Pricing). Crawlers and logged-out visitors see the logged-out nav. -->
    <script is:inline>
      (function () {
        try {
          var authed = false;
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && /^sb-.*-auth-token$/.test(k)) { authed = true; break; }
          }
          if (!authed) return;
          document.querySelectorAll('[data-auth-only]').forEach(function (el) {
            el.style.display = '';
          });
          document.querySelectorAll('[data-anon-only]').forEach(function (el) {
            el.style.display = 'none';
          });
        } catch (e) { /* storage blocked — keep the logged-out default */ }
      })();
    </script>
    <!-- Course return bar: when a lesson was opened from a guided course
         (/course/<level>/<item>, SPA), the lesson page stored a context in
         sessionStorage; render the same "Done → next" bar the SPA shows, so
         the learner never has to find the way back. Mirrors
         src/components/CourseReturnBar.jsx. -->
    <script is:inline>
      (function () {
        try {
          var raw = sessionStorage.getItem('dm_course_ctx');
          if (!raw) return;
          var ctx = JSON.parse(raw);
          if (!ctx || !ctx.level || !ctx.itemId) return;
          var bar = document.createElement('div');
          bar.setAttribute('data-course-return-bar', '');
          bar.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:40;background:rgba(255,255,255,.95);border-top:1px solid var(--dm-edge);backdrop-filter:blur(6px);padding-bottom:env(safe-area-inset-bottom);';
          var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
          bar.innerHTML =
            '<div style="max-width:48rem;margin:0 auto;display:flex;align-items:center;gap:.75rem;padding:.625rem 1rem;font-family:inherit">' +
            '<a href="/course/' + esc(ctx.level) + '" style="font-weight:700;color:var(--dm-siegel);text-decoration:none;font-size:.875rem;white-space:nowrap">&#8592; ' + esc(ctx.code || ctx.level.toUpperCase()) + '</a>' +
            '<p style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.8125rem;color:var(--dm-graphite);margin:0">' + esc(ctx.position) + '/' + esc(ctx.total) + ' &middot; ' + esc(ctx.title || '') + '</p>' +
            '<a href="/course/' + esc(ctx.level) + '/' + encodeURIComponent(ctx.itemId) + '?done=1" style="background:var(--dm-siegel);color:white;font-weight:700;font-size:.875rem;padding:.5rem 1rem;border-radius:.75rem;text-decoration:none;box-shadow:0 4px 0 0 var(--dm-siegel-edge);white-space:nowrap">&#10003; Done &#8594; next</a>' +
            '</div>';
          document.body.appendChild(bar);
          document.body.style.paddingBottom = '4rem';
        } catch (e) { /* storage blocked — no bar */ }
      })();
    </script>
    <Showtime />
    <script>
      // Funnel events for the static pages (src/data/events.js). Consent-gated
      // inside track(); before Accept every call is a no-op.
      import { autoTrack } from '../lib/track.js';
      autoTrack();
    </script>
  </body>
</html>
