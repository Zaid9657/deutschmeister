---
// The line, lying on the table behind the hero — "Die Linie"'s signature
// object. Decorative (aria-hidden): the same eight stations are real links in
// the line section and the footer. Desktop only: on a phone the hero is copy +
// the first-stop card, and a perspective plane at 360 px is noise.
//
// Motion: the track draws itself once (signature tier, 900 ms in-out), the
// free first stop pulses. Reduced motion: the track is simply there.
import { STATIONS } from '../../data/offers.js';

// Station positions along the path, as fractions of its length — kept in step
// with the path below (a gentle S from left to right).
const X = [150, 280, 410, 540, 670, 800, 930, 1060];
const Y = [150, 120, 128, 150, 140, 112, 118, 140];
const d = `M-40 ${Y[0] + 24} ` + X.map((x, i) => `L${x} ${Y[i]}`).join(' ') + ' L1240 128';
---

<div class="dm-plane pointer-events-none absolute inset-x-0 bottom-0 hidden h-[22rem] lg:block" aria-hidden="true">
  <div class="dm-plane-inner absolute inset-x-0 bottom-[-4rem] h-[26rem]">
    <svg viewBox="0 0 1200 260" class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
      <!-- the track bed -->
      <path d={d} fill="none" class="stroke-nacht-raised" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" />
      <!-- the line -->
      <path d={d} fill="none" class="dm-track-draw is-armed stroke-linie" pathLength="1" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" data-line-draw />
      {STATIONS.map((st, i) => (
        <g>
          <circle cx={X[i]} cy={Y[i]} r="20" class={st.status === 'building' ? 'fill-nacht stroke-nacht-rule' : 'fill-nacht stroke-linie'} stroke-width="7" />
          {st.status === 'free' && <circle cx={X[i]} cy={Y[i]} r="20" class="dm-pulse fill-none stroke-linie" stroke-width="3" style={`transform-origin:${X[i]}px ${Y[i]}px`} />}
        </g>
      ))}
    </svg>
    <!-- Station boards stand up off the plane (counter-rotated to face you). -->
    {STATIONS.map((st, i) => (
      <div
        class="absolute"
        style={`left:${(X[i] / 1200) * 100}%;top:${(Y[i] / 260) * 100}%;transform:translate(-50%,-100%) rotateX(-58deg) translateY(-1.25rem);transform-origin:50% 100%`}
      >
        <span class:list={['sign-code block rounded-md px-2 py-1 text-[1.125rem] leading-none', st.status === 'building' ? 'bg-nacht-raised text-nacht-muted' : 'bg-linie text-linie-ink']}>{st.code}</span>
      </div>
    ))}
  </div>
</div>

<script>
  // Draw the track once, after first paint. Reduced motion: leave it drawn.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-line-draw]').forEach((path) => {
    if (reduced) {
      path.classList.remove('is-armed');
      return;
    }
    requestAnimationFrame(() => requestAnimationFrame(() => path.classList.add('is-drawn')));
  });
</script>
