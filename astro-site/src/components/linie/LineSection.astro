---
// The line — the offer, laid out as what it is: eight stations, four of them
// open (A1.1 free, A1.2–A2.2 one-time tickets) and four "Im Bau". The live
// stops get wide station boards hanging from the track; the stops under
// construction share one board that routes B1/B2 visitors to what exists
// today. Desktop: a horizontal track over an 8-column grid (live stops 2fr,
// Im Bau 1fr). Phone: a vertical track down the left edge.
//
// The ride (scroll-craft, 2026-10-17, docs/scrollcraft/builds/home-line/BRIEF.md):
// with motion allowed, the script below arms data-ride="on" and the reader's
// scroll drives the train from A1.1 to the end of the built line, filling the
// track behind it, lighting each stop, and calling the next one in German on
// the station sign. Unarmed (no JS, reduced motion) the line renders fully
// drawn, exactly as before.
//
// Buy buttons render only when the level's checkout id is set
// (lib/courseVariants.js) — otherwise the board links to the course page.
import { STATIONS, EXAM_ROUTE, FREE_COURSE_HREF, planLine } from '../../data/offers.js';
import { LEVEL_COUNT } from '../../data/marketing.js';
import { levelCoursesWithVariants } from '../../lib/courseVariants.js';
import StationArt from './StationArt.astro';

const variants = Object.fromEntries(levelCoursesWithVariants().map((c) => [c.key, c.variantId]));
const live = STATIONS.filter((s) => s.status !== 'building');
const building = STATIONS.filter((s) => s.status === 'building');
// The ride's stops: every live station plus the first one under construction.
const rideStops = STATIONS.slice(0, live.length + 1).map((s) => ({ code: s.code, name: s.name, building: s.status === 'building' }));
const train = '<svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true"><rect x="1" y="1" width="18" height="9" rx="3" fill="currentColor" opacity=".9" /><circle cx="5.5" cy="12" r="1.6" fill="currentColor" /><circle cx="14.5" cy="12" r="1.6" fill="currentColor" /></svg>';
---

<section id="line" class="dm-defer relative overflow-x-clip bg-nacht text-nacht-text" data-ground="nacht" aria-labelledby="line-h" data-track-view="line" data-ride-root data-ride-stops={JSON.stringify(rideStops)}>
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">Die Linie · {LEVEL_COUNT} stations, A1.1 to B2.2</p>
    <h2 id="line-h" class="sign-head mt-3 text-[clamp(2.25rem,5.6vw,4rem)]">
      <span class="block">Every level is a stop.</span>
      <span class="block text-linie">Buy the one you’re at.</span>
    </h2>
    <p class="mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-nacht-muted">
      The first stop is free. Each next one is a single payment that stays yours, and every ticket carries the Pro tools for the first months of the ride.
    </p>

    <div class="relative mt-8 lg:mt-14">
      <!-- The station sign: shown only while the ride is armed. It repeats what the boards say, so it is hidden from assistive tech. -->
      <p class="dm-ride-sign sticky top-[calc(4.75rem+env(safe-area-inset-top))] z-20 mb-6 items-baseline gap-x-2.5 rounded-pill border border-nacht-rule bg-nacht px-4 py-2 lg:absolute lg:bottom-full lg:right-0 lg:top-auto lg:mb-5" aria-hidden="true" data-ride-sign>
        <span class="sign-label text-[1rem] leading-tight" lang="de" data-ride-de>Bitte einsteigen.</span>
        <span class="text-[0.8125rem] leading-tight text-nacht-muted" data-ride-en>All aboard · A1.1 is free</span>
      </p>

      <!-- Desktop: the track runs across the top of the station boards. -->
      <div class="relative hidden lg:block" aria-hidden="true" data-ride-track>
        <div class="grid grid-cols-[repeat(4,minmax(0,2fr))_repeat(4,minmax(0,1fr))] items-center">
          {STATIONS.map((st) => (
            <div class="relative flex h-10 items-center">
              <span class:list={['absolute inset-x-0 top-1/2 h-2 -translate-y-1/2', st.status === 'building' ? 'border-t-[3px] border-dashed border-nacht-rule bg-transparent' : 'dm-ride-seg overflow-hidden bg-linie', st.index === 0 && 'left-[1.1875rem] rounded-l-pill', st.index === STATIONS.length - 1 && 'right-1/2']} data-ride-seg={st.status === 'building' ? undefined : st.index}>
                {st.status !== 'building' && <span class="dm-ride-fill absolute inset-0 bg-linie"></span>}
              </span>
              <span class:list={['dm-station-dot relative z-10 ml-0 block h-[2.375rem] w-[2.375rem] rounded-full border-[6px]', st.status === 'building' ? 'border-nacht-rule bg-nacht' : 'border-linie bg-nacht', st.status === 'free' && '!bg-linie']} data-ride-dot={st.index < rideStops.length ? st.index : undefined}></span>
              {st.status === 'free' && <span class="dm-pulse absolute left-0 top-1/2 -mt-[1.1875rem] h-[2.375rem] w-[2.375rem] rounded-full border-2 border-linie"></span>}
            </div>
          ))}
        </div>
        <span class="dm-ride-train absolute left-[1.1875rem] top-1/2 z-20 -ml-[1.375rem] -mt-[0.875rem] h-7 w-11 items-center justify-center rounded-pill bg-linie text-linie-ink" data-ride-train set:html={train}></span>
      </div>

      <ol class="relative grid gap-0 lg:mt-6 lg:grid-cols-[repeat(4,minmax(0,2fr))_repeat(4,minmax(0,1fr))] lg:gap-0">
        <!-- Phone: the track runs down the left edge from the first dot's centre, centred under the dots. -->
        <span class="dm-ride-seg absolute bottom-6 left-[0.9375rem] top-[2.1875rem] w-2 overflow-hidden rounded-pill bg-linie lg:hidden" aria-hidden="true" data-ride-bar>
          <span class="dm-ride-fill dm-ride-fill-y absolute inset-0 bg-linie"></span>
        </span>
        <span class="absolute left-0 top-[2.1875rem] z-20 lg:hidden" aria-hidden="true">
          <span class="dm-ride-train -mt-[0.875rem] ml-[-0.1875rem] h-7 w-11 items-center justify-center rounded-pill bg-linie text-linie-ink" data-ride-train set:html={train}></span>
        </span>

        {live.map((st) => (
          <li class="relative pb-6 pl-14 lg:pb-0 lg:pl-0 lg:pr-4">
            <span class:list={['absolute left-0 top-4 h-[2.375rem] w-[2.375rem] rounded-full border-[6px] border-linie lg:hidden', st.status === 'free' ? 'bg-linie' : 'bg-nacht']} aria-hidden="true" data-ride-dot={st.index}></span>
            <article class="dm-lift flex h-full flex-col rounded-[1.25rem] border border-nacht-rule bg-nacht-raised p-5" aria-labelledby={`st-${st.level}`}>
              <StationArt level={st.level} class="-mx-5 -mt-5 mb-4 w-[calc(100%+2.5rem)] rounded-t-[1.25rem] border-b border-nacht-rule" />
              <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-nacht-muted">Stop {st.index + 1} · {st.band}</p>
              <h3 id={`st-${st.level}`} class="sign-code mt-1 text-[2.25rem] leading-none">{st.code}</h3>
              <p class="sign-label mt-1 text-[0.9375rem] text-nacht-muted">{st.name}</p>
              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed">{st.outcome}</p>
              {planLine(st) && <p class="mt-3 text-[0.8125rem] leading-relaxed text-nacht-muted">{planLine(st)}</p>}
              <p class="mt-4 flex items-baseline gap-2 border-t border-nacht-rule pt-4">
                <span class="sign-code text-[1.75rem] leading-none text-linie">{st.status === 'free' ? 'Free' : st.priceLabel}</span>
                <span class="text-[0.8125rem] text-nacht-muted">{st.status === 'free' ? 'no account' : 'once · yours to keep'}</span>
              </p>
              <div class="mt-4 flex flex-col gap-2">
                {st.status === 'free' ? (
                  <a href={FREE_COURSE_HREF} class="dm-key dm-key-linie w-full" data-track="course_selected" data-track-level={st.level} data-track-surface="line">Start A1.1 free</a>
                ) : variants[st.productKey] ? (
                  <div data-course-door={st.level} data-course-code={st.code} data-course-open-class="dm-key dm-key-linie w-full">
                    <button type="button" class="dm-key dm-key-linie w-full" data-course-variant={variants[st.productKey]} data-course-key={st.productKey} data-course-price={st.price} data-track-surface="line">
                      Buy {st.code} · {st.priceLabel}
                    </button>
                  </div>
                ) : null}
                <a href={st.coursePage} class="dm-link-nacht py-1 text-center text-[0.875rem] font-semibold">What’s inside {st.code}</a>
              </div>
            </article>
          </li>
        ))}

        <!-- Im Bau: B1.1–B2.2 share one board under their four stations. -->
        <li class="relative pl-14 lg:col-span-4 lg:pl-0">
          <span class="absolute left-0 top-4 h-[2.375rem] w-[2.375rem] rounded-full border-[6px] border-dashed border-nacht-rule bg-nacht lg:hidden" aria-hidden="true" data-ride-dot={live.length}></span>
          <article class="flex h-full flex-col rounded-[1.25rem] border border-dashed border-nacht-rule p-5" aria-labelledby="st-building">
            <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-nacht-muted">Stops 5–8 · Im Bau</p>
            <h3 id="st-building" class="sign-code mt-1 text-[1.75rem] leading-none">{building.map((s) => s.code).join(' · ')}</h3>
            <p class="sign-label mt-3 text-[1.0625rem]">{EXAM_ROUTE.title}</p>
            <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-nacht-muted">{EXAM_ROUTE.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {EXAM_ROUTE.links.map((l, i) => (
                <li><a href={l.href} class:list={['dm-key !text-[0.875rem]', i === 0 ? 'dm-key-linie' : 'dm-key-ghost-nacht']} hreflang={l.lang || undefined}>{l.label}</a></li>
              ))}
            </ul>
            <ul class="mt-5 grid grid-cols-4 gap-2 border-t border-nacht-rule pt-4">
              {building.map((st) => (
                <li><a href={st.coursePage} class="block text-center font-data text-[0.75rem] text-nacht-muted underline decoration-nacht-rule underline-offset-4"><StationArt level={st.level} class="mb-2 w-full rounded-lg border border-nacht-rule" />{st.code}</a></li>
              ))}
            </ul>
          </article>
        </li>
      </ol>
    </div>
  </div>
</section>

<script>
  // The ride. One progress value per frame, read from where the line sits in the
  // viewport: the fill scales and the train translates with no transition (the
  // scroll is the timeline), the dots light on the control tier, the sign swaps.
  const root = document.querySelector('[data-ride-root]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const wide = window.matchMedia('(min-width: 1024px)');
    const stops = JSON.parse(root.getAttribute('data-ride-stops'));
    const last = stops.length - 1;
    const sign = root.querySelector('[data-ride-sign]');
    const de = sign.querySelector('[data-ride-de]');
    const en = sign.querySelector('[data-ride-en]');
    const track = root.querySelector('[data-ride-track]');
    const segs = [...root.querySelectorAll('[data-ride-seg]')].map((el) => ({ el, fill: el.firstElementChild }));
    const bar = root.querySelector('[data-ride-bar]');
    const barFill = bar.firstElementChild;
    const [trainWide, trainPhone] = root.querySelectorAll('[data-ride-train]');
    const dotsFor = (inTrack) => [...root.querySelectorAll('[data-ride-dot]')].filter((d) => track.contains(d) === inTrack);
    const dotsWide = dotsFor(true);
    const dotsPhone = dotsFor(false);
    const clamp = (v) => Math.min(1, Math.max(0, v));
    let frame = 0;
    let said = '';

    const announce = (reached, moved) => {
      const next = stops[reached + 1];
      const [line, gloss] = reached >= last
        ? ['Vorerst Endstation.', 'End of the line, for now']
        : !moved
          ? ['Bitte einsteigen.', `All aboard · ${stops[0].code} is free`]
          : [`Nächster Halt: ${next.code}`, `Next stop · ${next.building ? 'under construction' : next.name}`];
      if (line === said) return;
      said = line;
      de.textContent = line;
      en.textContent = gloss;
      sign.classList.remove('is-new');
      void sign.offsetWidth; // restart the arrival fade
      sign.classList.add('is-new');
    };

    const update = () => {
      frame = 0;
      const vh = window.innerHeight;
      let reached = 0;
      let moved = false;
      if (wide.matches) {
        // The ride runs while the track climbs from 85 % to 35 % of the viewport.
        // The train runs dot centre to dot centre; the fill ends under it.
        const t = clamp((vh * 0.85 - track.getBoundingClientRect().top) / (vh * 0.5)) * last;
        const centres = dotsWide.map((d) => { const b = d.getBoundingClientRect(); return b.left + b.width / 2; });
        const i = Math.min(Math.floor(t), last - 1);
        const x = centres[i] + (centres[i + 1] - centres[i]) * clamp(t - i);
        segs.forEach((s) => { const b = s.el.getBoundingClientRect(); s.fill.style.transform = `scaleX(${clamp((x - b.left) / b.width)})`; });
        trainWide.style.transform = `translateX(${x - centres[0]}px)`;
        reached = Math.min(last, Math.floor(t + 1e-3));
        moved = t > 0.05;
        dotsWide.forEach((d) => d.classList.toggle('is-reached', Number(d.dataset.rideDot) <= reached));
      } else {
        // The train sits on the reading line, 60 % down the screen.
        const read = vh * 0.6;
        const r = bar.getBoundingClientRect();
        const d = Math.min(r.height, Math.max(0, read - r.top));
        barFill.style.transform = `scaleY(${r.height ? d / r.height : 1})`;
        trainPhone.style.transform = `translateY(${d}px)`;
        dotsPhone.forEach((dot) => {
          const box = dot.getBoundingClientRect();
          const on = Number(dot.dataset.rideDot) === 0 || box.top + box.height / 2 <= read;
          dot.classList.toggle('is-reached', on);
          if (on) reached = Math.max(reached, Number(dot.dataset.rideDot));
        });
        moved = d > 24;
      }
      announce(reached, moved);
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };

    // Listen only while the line is near the screen.
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        window.addEventListener('scroll', schedule, { passive: true });
        schedule();
      } else {
        window.removeEventListener('scroll', schedule);
      }
    }, { rootMargin: '200px 0px' }).observe(root);
    window.addEventListener('resize', schedule, { passive: true });
    wide.addEventListener('change', schedule);

    root.dataset.ride = 'on';
    update();
  }
</script>
