---
import { RECORDED_CORRECTION as example } from '../../data/recordedCorrection.js';
import { checkAnswer, checkOptionsFor } from '../../../../src/lib/lesson/check.js';
import { FREE_COURSE_HREF } from '../../data/offers.js';

// Fail the build if the recorded verdict stops matching the live course rule.
const check = (text) => checkAnswer(text, example.item.accepted, checkOptionsFor(example.item)).result;
if (check(example.draft) !== example.beforeResult || check(example.revision) !== example.afterResult) {
  throw new Error('Recorded correction no longer matches the course checker');
}
const explanation = example.explanation.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<section class="dm-scene dm-correction-scene" aria-labelledby="recorded-correction-h" data-recorded-correction>
  <div class="dm-section-grid">
    <div><p class="dm-kicker">Recorded example · A1.1</p>
      <h2 id="recorded-correction-h" class="dm-section-title mt-4">Write it. Check it.<br/><em>Try again.</em></h2>
      <p class="dm-hero-lead mt-5">One short greeting from our own course material. This records the course answer checker’s feedback, followed by the corrected version. It is not a customer text or an AI writing assessment.</p>
      <p class="mt-5 text-sm text-graphite">Recorded on <time datetime={example.recordedOn}>{example.recordedOn}</time> · DeutschMeister’s own exercise</p>
      <a href={FREE_COURSE_HREF} class="dm-key dm-key-siegel mt-6">Try the free A1.1 course</a>
    </div>
    <figure class="dm-correction-panel">
      <figcaption class="dm-window-bar"><span class="dm-window-mark">dm</span><span>Recorded course feedback · example</span><span class="dm-window-level">A1.1</span></figcaption>
      <ol>
        <li><span class="dm-correction-number" aria-hidden="true">01</span><div><h3 class="font-bold">First attempt</h3><p class="mt-3 text-2xl" lang="de">{example.draft}</p></div></li>
        <li><span class="dm-correction-number" aria-hidden="true">02</span><div><h3 class="font-bold">Course feedback</h3><p class="mt-3 font-semibold">Not correct yet.</p><p class="mt-2 leading-relaxed text-graphite" set:html={explanation} /></div></li>
        <li><span class="dm-correction-number" aria-hidden="true">03</span><div><h3 class="font-bold">Revised version</h3><p class="mt-3 text-2xl" lang="de">{example.revision}</p><p class="mt-2 text-sm font-bold text-siegel-deep">Correct — checked by the same course rule.</p></div></li>
      </ol>
    </figure>
  </div>
</section>
