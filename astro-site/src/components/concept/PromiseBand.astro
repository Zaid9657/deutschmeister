---
// The founder's promise (src/data/marketing.js PROMISE_*): the sanctioned wording, with its reason.
import { PROMISE_LABEL, PROMISE_LINE, PROMISE_REASON } from '../../data/marketing.js';
---
<section class="c4-promise" aria-labelledby="promise-h" data-c4-reveal>
  <div class="c4-wrap">
    <p class="c4-eyebrow">{PROMISE_LABEL}</p>
    <h2 id="promise-h">{PROMISE_LINE}</h2>
    <p>{PROMISE_REASON}</p>
  </div>
</section>
