---
import Scene from './Scene.astro';
import { ALL_LEVELS, COMING_SOON_LEVELS } from '../../data/pricing.js';
import { levelToSlug } from '../../data/courseContents.js';
const { comingOnly = false, hero = false } = Astro.props;
const levels = comingOnly ? COMING_SOON_LEVELS : ALL_LEVELS;
---
<div class="c4-route" data-c4-route>
  <Scene name="tram-route" alt="A yellow Berlin tram with the Brandenburg Gate and television tower" hero={hero} sizes="(max-width: 640px) 100vw, 1000px" />
  <div class="c4-route-track" aria-hidden="true"><span></span></div>
  <ol aria-label="Your German learning path">
    {levels.map((level) => <li><a href={`/courses/${levelToSlug(level)}/`} class:list={['c4-route-stop', level === 'a1.1' && 'is-start']}><strong>{level.toUpperCase()}</strong><span class="c4-route-dot" aria-hidden="true"></span><span class="sr-only">{level === 'a1.1' ? 'Free course' : COMING_SOON_LEVELS.includes(level) ? 'Coming next' : 'Available course'}</span></a></li>)}
  </ol>
</div>
