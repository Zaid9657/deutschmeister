---
import { SELLABLE_LEVELS, courseForLevel, OFFER_PRODUCTS, eur, PRICE_TAX_NOTE } from '../../data/pricing.js';
import PurchaseDoor from './PurchaseDoor.astro';
import ProductDoor from './ProductDoor.astro';
import CoursePrice from '../CoursePrice.astro';
import Scene from './Scene.astro';
const { illustrated = false } = Astro.props;
const pack = OFFER_PRODUCTS.a1_exam_pack;
---
<div class="c4-offers c4-ladder" aria-label="Courses and exam practice">
  {SELLABLE_LEVELS.map((level) => {
    const course = courseForLevel(level);
    return <article class="c4-offer" data-c4-reveal>
      {illustrated && <Scene name="scene-cafe" alt="An everyday German conversation" sizes="350px" />}
      <h2>{course.code} course</h2><p class="c4-price"><strong><CoursePrice level={level} /></strong><span>pay once</span></p>
      <ul class="c4-checks"><li>This course, yours to keep</li><li>Lessons, checkpoints, final test, review and certificate</li><li>{course.proDays} days of AI writing feedback, AI speaking practice and Sentence X-Ray included</li></ul>
      <PurchaseDoor level={level} surface="ladder_level" /><a href={`/courses/${level.replace('.', '-')}/`} class="c4-text-link">Explore {course.code} →</a>
    </article>;
  })}
  <article class="c4-offer" data-c4-reveal>
    {illustrated && <Scene name="offer-exam" alt="A learner preparing for the A1 exam" sizes="350px" />}
    <h2>{pack.name}</h2><p class="c4-price"><strong>{eur(pack.price)}</strong><span>pay once</span></p>
    <p>A1 exam plan, short practice test, writing and speaking tasks. {pack.proMonths} months of AI Practice included.</p>
    <ProductDoor productKey={pack.key} surface="ladder_exam" /><a href={`/courses/${pack.slug}/`} class="c4-text-link">Explore {pack.name} →</a>
  </article>
</div>
<p class="c4-small c4-tax-note">{PRICE_TAX_NOTE}</p>
