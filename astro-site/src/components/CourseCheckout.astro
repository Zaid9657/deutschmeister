---
// The course checkout script, shared by /pricing/ (inline there for historical
// reasons) and the /courses/ pages. Any element with data-course-variant opens
// that Lemon Squeezy checkout: overlay for signed-in visitors (so a purchase
// ends on OUR success page), same-tab navigation as the fallback, and the
// signup detour with dm_buy_intent for signed-out visitors — identical to the
// pricing page's behaviour, so the two entry points cannot drift.
//
// A lifetime course is never sold twice (ACC-16): for a signed-in visitor,
// Buy waits (aria-busy) until their entitlements are known, and the click
// checks ownership again: an owner goes to the course. When the lookup cannot
// answer, the app's resume path (/subscription?buy=) checks before any checkout.
// Every level-course Buy also sits in a data-course-door
// (tests/course-door-rule.test.mjs).
---
<script>
  import { track } from '../lib/track.js';

  function currentUser() {
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && /^sb-.*-auth-token$/.test(k)) {
          const v = JSON.parse(localStorage.getItem(k) || 'null');
          const u = (v && (v.user || (v.currentSession && v.currentSession.user))) || null;
          if (u && u.id) return { email: u.email || '', id: u.id };
        }
      }
    } catch (e) { /* private mode — treat as signed out */ }
    return null;
  }

  function checkoutUrl(variant, email, id) {
    const params = new URLSearchParams({ 'checkout[email]': email || '', 'checkout[custom][user_id]': id || '' });
    return 'https://deutsch-meister.lemonsqueezy.com/checkout/buy/' + variant + '?' + params.toString();
  }

  // One entitlement snapshot per page view (lib/levelAccess.js), loaded lazily
  // so the logged-out majority never fetches the Supabase chunk. Never rejects:
  // a failed lookup resolves to null.
  let entitlements = null;
  function loadEntitlements() {
    if (!entitlements) {
      entitlements = import('../lib/levelAccess.js')
        .then(async (lib) => ({ lib, snapshot: await lib.loadEntitlementSnapshot() }))
        .catch(() => null);
    }
    return entitlements;
  }

  async function open(variant, intentKey, amount, surface) {
    const u = currentUser();
    track('checkout_intent', { product: intentKey, surface, signed_in: Boolean(u) });
    if (!u) {
      try { localStorage.setItem('dm_buy_intent', intentKey); } catch (e) { /* private mode */ }
      window.location.href = 'https://deutsch-meister.de/signup';
      return;
    }
    // Ownership at click time: an owner continues in the course instead of
    // paying again. Unknown ownership (a failed or signed-out lookup) goes to
    // the app's resume path, which checks it before opening any checkout.
    const loaded = await loadEntitlements();
    const snapshot = loaded && loaded.snapshot;
    if (!snapshot || !snapshot.signedIn || !snapshot.verified) {
      window.location.href = 'https://deutsch-meister.de/subscription?buy=' + encodeURIComponent(intentKey);
      return;
    }
    const home = loaded.lib.ownedProductHome(snapshot, intentKey);
    if (home) {
      window.location.href = home;
      return;
    }
    // The SPA's checkout_completed observer (src/lib/funnelTracking.js) consumes
    // this same sessionStorage flag on /subscription/success, so a checkout that
    // starts on a static page is still seen finishing in the app.
    try { sessionStorage.setItem('dm_checkout_pending', JSON.stringify({ plan: intentKey, amount: amount || null })); } catch (e) { /* private mode */ }
    track('checkout_opened', { product: intentKey, surface, amount: amount || undefined });
    const url = checkoutUrl(variant, u.email, u.id);
    if (window.LemonSqueezy && window.LemonSqueezy.Url && window.LemonSqueezy.Url.Open) {
      window.LemonSqueezy.Url.Open(url);
    } else {
      window.location.href = url;
    }
  }

  // Owner door (ACC-17). Only a bought course swaps Buy for Open: a level that a
  // live trial or Pro opens for a while keeps its Buy button (the lifetime
  // course stays on sale) and gains a small way in beside it. A door with
  // nothing to buy (free, coming soon) simply opens when the level is open.
  function applyDoor(d, access, lib) {
    if (!access || !access.open) return;
    const level = d.getAttribute('data-course-door');
    const code = d.getAttribute('data-course-code') || level.toUpperCase();
    const href = lib.levelHref(level);
    const label = (lib.GUIDED_LEVELS.includes(level) ? 'Continue course ' : 'Open ') + code + ' →';
    if (access.owned || !d.querySelector('[data-course-variant]')) {
      d.innerHTML = '<a href="' + href + '" class="' + (d.getAttribute('data-course-open-class') || '') + '">' + label + '</a>';
      return;
    }
    // The ride-along bar on /courses/<level>/ has room for one key only.
    if (d.closest('[data-fahrschein-bar]') || d.querySelector('[data-course-continue]')) return;
    const link = document.createElement('a');
    link.href = href;
    link.className = d.closest('[data-ground="nacht"]') ? 'dm-link-nacht' : 'dm-link';
    link.setAttribute('data-course-continue', '');
    link.textContent = label;
    d.append(' ', link);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const signedIn = Boolean(currentUser());
    if (signedIn && !document.querySelector('script[src*="lemon.js"]')) {
      const s = document.createElement('script');
      s.src = 'https://app.lemonsqueezy.com/js/lemon.js';
      s.defer = true;
      s.onload = () => {
        try {
          window.createLemonSqueezy && window.createLemonSqueezy();
          window.LemonSqueezy && window.LemonSqueezy.Setup && window.LemonSqueezy.Setup({
            eventHandler: (evt) => {
              if (evt && evt.event === 'Checkout.Success') {
                window.location.href = 'https://deutsch-meister.de/subscription/success';
              }
            },
          });
        } catch (e) { /* overlay optional */ }
      };
      document.head.appendChild(s);
    }
    const buys = [...document.querySelectorAll('[data-course-variant]')];
    buys.forEach((btn) => {
      btn.addEventListener('click', () =>
        open(
          btn.getAttribute('data-course-variant'),
          btn.getAttribute('data-course-key'),
          Number(btn.getAttribute('data-course-price')) || null,
          btn.getAttribute('data-track-surface') || undefined,
        ),
      );
    });

    const doors = [...document.querySelectorAll('[data-course-door]')];
    if (!signedIn || (!buys.length && !doors.length)) return;
    // Until this visitor's entitlements are known, Buy waits: an owner who
    // clicks before the lookup lands must not reach a second checkout.
    const waiting = buys.filter((btn) => !btn.disabled);
    waiting.forEach((btn) => { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); });
    loadEntitlements()
      .then((loaded) => {
        if (!loaded || !loaded.snapshot || !loaded.snapshot.signedIn) return;
        doors.forEach((d) => applyDoor(d, loaded.lib.levelOpen(loaded.snapshot, d.getAttribute('data-course-door')), loaded.lib));
      })
      .catch(() => { /* door optional */ })
      .finally(() => waiting.forEach((btn) => { btn.disabled = false; btn.removeAttribute('aria-busy'); }));
  });
</script>
