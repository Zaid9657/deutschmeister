---
import { getTopicFull } from '../../lib/grammar.js';
const { level, topic, unfinished = false } = Astro.props;
const data = topic ? await getTopicFull(level, topic.slug) : null;
const example = data?.examples?.[0];
---
{topic && <figure class="dm-product-window dm-practice-window" data-practice-preview={level}>
  <figcaption class="dm-window-bar"><span class="dm-window-mark">dm</span><span>Example from the practice library</span><span class="dm-window-level">{level.toUpperCase()}</span></figcaption>
  <div class="dm-window-task">
    <p class="dm-kicker">Real grammar content · reference material</p>
    <h2 class="mt-3 font-display text-3xl">{topic.title_en}</h2>
    {example ? <><blockquote class="dm-window-answer" lang="de">{example.sentence_de}</blockquote><p class="mt-3 text-base text-graphite">{example.sentence_en}</p></> : <p class="mt-4 text-base text-graphite">{topic.description_en}</p>}
    <p class="mt-5 text-sm text-graphite">{unfinished ? 'The guided course is Im Bau and is not for sale. This is an example from the existing practice library.' : 'This is an example of the reference material, separate from a guided-lesson demonstration.'}</p>
  </div>
  <div class="dm-window-footer"><a href={`/grammar/${level}/${topic.slug}/`} class="dm-link">Read this grammar topic →</a></div>
</figure>}
