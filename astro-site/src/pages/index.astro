---
// Homepage — rebuilt 2026-08-22 on src/data/design-tokens.js.
//
// THE THESIS. The one thing DeutschMeister does that nothing else does is take
// a German sentence apart and colour each piece by its case. So the hero opens
// with exactly that — a real sentence, marked the way Sentence X-Ray marks it —
// instead of a claim about being fast. The product's own artifact is the
// argument, and it is static markup, so a crawler and a JS-less visitor both
// get it.
//
// What the previous version did that this one does not: an amber-to-rose
// gradient hero on the retired brand, blurred gradient blobs, emoji level cards
// in eight different palettes, a dark "your German won't improve by waiting"
// urgency block, a full-bleed rainbow CTA, and a stats band claiming figures
// with no source (see below).
//
// CLAIMS. The old stats band read "1,400+ Learners", "170+ New learners this
// month" and "2,488 AI speaking exercises". The first two trace to
// EVALUATION.md's 2026-08-16 database audit but "this month" is stale by
// construction; the third appears in NO audit and has no source at all. Per the
// counts rule in src/data/marketing.js, this page now shows only figures that
// are true by construction — what the product CONTAINS, counted against live
// tables. Nothing here can rot without the database changing.
//
// INVARIANTS (do not regress): every figure derives from ../data/*.js; one
// <h1>; the canonical; real server-rendered body text; case colours ONLY in the
// sentence demo (rule 1 in the tokens file); prerendered SPA routes linked WITH
// a trailing slash, /signup without one (CLAUDE.md's three-case rule).
import { ORGANIZATION_FULL } from '../data/organization.js';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { PLANS, eur } from '../data/pricing.js';
import {
  LEVELS,
  LEVEL_COUNT,
  GRAMMAR_TOPIC_COUNT,
  LISTENING_DIALOGUE_COUNT,
  PODCAST_EPISODE_COUNT,
  ANON_DAILY_LIMIT,
  PRO_DAILY_LIMIT,
  PRO_SPEAKING_SESSIONS_PER_MONTH,
  TRIAL_SPEAKING_SESSIONS,
  TRIAL_DAYS,
  FREE_LEVEL_LABEL,
  monthlyPriceLine,
} from '../data/marketing.js';

const title = 'Learn German Online — Free Lessons A1 to B2 | DeutschMeister';
const description = `Grammar explained in English, with every sentence broken down by case. ${GRAMMAR_TOPIC_COUNT} topics across ${LEVEL_COUNT} CEFR levels, A1.1 to B2.2. ${FREE_LEVEL_LABEL} is free, no account needed.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DeutschMeister',
    url: 'https://deutsch-meister.de/',
    description: 'German grammar, listening and speaking practice for English speakers, CEFR levels A1.1 to B2.2 — A1.1 free, no account needed.',
    inLanguage: ['de', 'en'],
  },
  { '@context': 'https://schema.org', ...ORGANIZATION_FULL },
];

// The hero sentence. Same wording and same case marking as the live analyser
// (src/pages/SentenceXRay.jsx). Rule 1: this is the ONLY place on the page
// where the case colours may appear.
const SENTENCE = [
  { text: 'Der Mann', kasus: 'nominativ', abbr: 'NOM', role: 'subject', gloss: 'the man' },
  { text: 'gibt', kasus: null, abbr: 'VERB', role: 'verb', gloss: 'gives' },
  { text: 'dem Kind', kasus: 'dativ', abbr: 'DAT', role: 'indirect object', gloss: 'to the child' },
  { text: 'einen Apfel', kasus: 'akkusativ', abbr: 'AKK', role: 'direct object', gloss: 'an apple' },
];
const KASUS_CLASS = {
  nominativ: 'border-kasus-nominativ bg-kasus-nominativ-wash text-kasus-nominativ-ink',
  dativ: 'border-kasus-dativ bg-kasus-dativ-wash text-kasus-dativ-ink',
  akkusativ: 'border-kasus-akkusativ bg-kasus-akkusativ-wash text-kasus-akkusativ-ink',
};

// What the product contains. Every figure is a marketing.js constant counted
// against a live table — see the claims note in the header.
const COUNTS = [
  { value: GRAMMAR_TOPIC_COUNT, label: 'Grammar topics' },
  { value: LISTENING_DIALOGUE_COUNT, label: 'Native-speaker dialogues' },
  { value: LEVEL_COUNT, label: 'CEFR levels, A1.1 to B2.2' },
  { value: PODCAST_EPISODE_COUNT, label: 'Podcast episodes' },
];

const TOOLS = [
  {
    name: 'Sentence X-Ray',
    href: '/analyze/',
    body: 'Paste any German sentence. It comes back split into cases, roles and parts of speech — the breakdown above, for your own sentences.',
    free: `${ANON_DAILY_LIMIT} a day free, no account`,
    pro: `${PRO_DAILY_LIMIT} a day with Pro`,
  },
  {
    name: 'AI speaking practice',
    href: '/speaking/',
    body: 'Hold a conversation at your level and get it back marked for grammar, vocabulary and pronunciation.',
    free: `${TRIAL_SPEAKING_SESSIONS} sessions free`,
    pro: `${PRO_SPEAKING_SESSIONS_PER_MONTH} a month with Pro`,
  },
  {
    name: 'Level test',
    href: '/level-test/',
    body: 'Twenty minutes of grammar, listening and speaking, and you know which of the eight levels to open.',
    free: 'Free, no account',
    pro: 'Retake whenever you like',
  },
];

// Comparison rows. Our own figures derive; the alternatives' are ranges, not
// somebody's advertised price, so they stay literal.
const CMP = [
  { feature: 'Cost per month', us: eur(PLANS.monthly.price), group: '€150+', tutor: '€50–100', apps: '€0–15' },
  { feature: 'Speaking practice', us: `${PRO_SPEAKING_SESSIONS_PER_MONTH} sessions a month`, group: 'Minutes per class', tutor: 'One-to-one', apps: 'None' },
  { feature: 'Available', us: 'Any hour', group: 'Fixed timetable', tutor: 'By appointment', apps: 'Any hour' },
  { feature: 'Grammar A1–B2', us: `${GRAMMAR_TOPIC_COUNT} topics`, group: 'Varies', tutor: 'Varies', apps: 'Varies' },
  { feature: 'Sentence analysis', us: 'Built in', group: '—', tutor: '—', apps: '—' },
  { feature: 'Level test', us: 'Free', group: '€50+', tutor: '€30+', apps: 'Basic quiz' },
];

const TOPICS = [
  { href: '/grammar/a1.1/nouns-gender/', level: 'A1.1', label: 'Noun genders: der, die, das', desc: 'Why every German noun has a gender, and how to stop guessing.' },
  { href: '/grammar/a1.2/accusative-intro/', level: 'A1.2', label: 'The accusative case', desc: 'When der becomes den, and what changes with it.' },
  { href: '/grammar/a2.1/prepositions-dative/', level: 'A2.1', label: 'Dative prepositions', desc: 'mit, nach, seit, von, zu, bei, aus, gegenüber.' },
  { href: '/grammar/b1.1/konjunktiv-ii-wurde/', level: 'B1.1', label: 'Konjunktiv II with würde', desc: 'Wishes, hypotheticals and polite requests.' },
];
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/" jsonLd={jsonLd}>
  <div class="bg-paper text-ink">

    <!-- Hero: the product's own artifact, not a claim about it -->
    <section class="mx-auto max-w-5xl px-5 pt-14 pb-12 sm:pt-20">
      <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">German · A1.1 to B2.2</p>
      <h1 class="mt-3 max-w-3xl font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.022em] sm:text-[3.25rem]">
        German grammar you can see.
      </h1>
      <p class="mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]">
        Every rule explained in English, and every sentence taken apart so you can watch the cases move.
        {FREE_LEVEL_LABEL} is free — no account, no card.
      </p>

      <!-- The sentence. Rule 1: the only case colour on this page. -->
      <figure class="mt-9">
        <div class="flex flex-wrap items-stretch gap-2">
          {SENTENCE.map((w) => (
            <span class={`rounded-md border px-3 py-2.5 ${w.kasus ? KASUS_CLASS[w.kasus] : 'border-rule bg-paper-sunk text-graphite'}`}>
              <span class="block text-[1.0625rem] font-semibold leading-none">{w.text}</span>
              <span class="mt-1.5 block font-data text-[0.6875rem] font-bold tracking-[0.13em]">{w.abbr}</span>
              <span class="mt-1 block text-[0.75rem] leading-tight opacity-80">{w.role}</span>
              <span class="mt-0.5 block text-[0.75rem] italic leading-tight opacity-70">{w.gloss}</span>
            </span>
          ))}
        </div>
        <figcaption class="mt-3 font-data text-[0.8125rem] text-graphite">
          One sentence, four jobs. Colour marks the case, here and in every lesson.
        </figcaption>
      </figure>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="/level-test/" class="inline-flex items-center justify-center rounded-md bg-siegel px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-siegel-lift">
          Find your level — free
        </a>
        <a href="/grammar/" class="inline-flex items-center justify-center rounded-md border border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-paper">
          Browse the grammar
        </a>
      </div>
      <p class="mt-4 font-data text-[0.8125rem] text-graphite">
        No card to start · {TRIAL_DAYS}-day Pro trial when you sign up · cancel anytime
      </p>
    </section>

    <!-- What is actually in it -->
    <section class="border-y border-rule bg-paper-sunk" aria-labelledby="counts-h">
      <div class="mx-auto max-w-5xl px-5 py-9">
        <h2 id="counts-h" class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">What is inside</h2>
        <dl class="mt-5 grid grid-cols-2 gap-6 sm:grid-cols-4">
          {COUNTS.map((c) => (
            <div>
              <dt class="sr-only">{c.label}</dt>
              <dd>
                <span class="block font-display text-[2rem] font-semibold leading-none tracking-[-0.015em]">{c.value}</span>
                <span class="mt-2 block text-[0.8125rem] leading-snug text-graphite">{c.label}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- The ladder -->
    <section class="mx-auto max-w-5xl px-5 py-14" aria-labelledby="ladder-h">
      <h2 id="ladder-h" class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[2rem]">
        Eight levels, in order
      </h2>
      <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
        Each level has {GRAMMAR_TOPIC_COUNT / LEVEL_COUNT} grammar topics with exercises, its own listening and reading, and
        speaking missions built on the same structures. Start at {FREE_LEVEL_LABEL} or test into the right one.
      </p>
      <ol class="mt-6 grid grid-cols-4 gap-px overflow-hidden rounded-lg border border-rule bg-rule sm:grid-cols-8">
        {LEVELS.map((lvl, i) => (
          <li>
            <a href={`/grammar/${lvl.code.toLowerCase()}/`} class="block bg-paper px-2 py-3 text-center transition-colors hover:bg-siegel-wash">
              <span class="block font-data text-[0.8125rem] font-semibold tracking-[0.02em] text-ink">{lvl.code}</span>
              <span class="mt-1 block text-[0.6875rem] leading-tight text-graphite">{lvl.subtitle}</span>
              {i === 0 && (
                <span class="mt-1.5 inline-block font-data text-[0.5625rem] font-bold uppercase tracking-[0.13em] text-siegel">Free</span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- The three tools -->
    <section class="border-t border-rule" aria-labelledby="tools-h">
      <div class="mx-auto max-w-5xl px-5 py-14">
        <h2 id="tools-h" class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[2rem]">
          Three things you can try right now
        </h2>
        <div class="mt-7 grid gap-px bg-rule sm:grid-cols-3">
          {TOOLS.map((t) => (
            <div class="flex flex-col bg-paper p-5">
              <h3 class="font-display text-[1.125rem] font-semibold">{t.name}</h3>
              <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-graphite">{t.body}</p>
              <dl class="mt-4 border-t border-rule pt-3 font-data text-[0.8125rem]">
                <div class="flex justify-between gap-3 py-0.5">
                  <dt class="text-graphite">Free</dt><dd class="text-right text-ink">{t.free}</dd>
                </div>
                <div class="flex justify-between gap-3 py-0.5">
                  <dt class="text-graphite">Pro</dt><dd class="text-right text-ink">{t.pro}</dd>
                </div>
              </dl>
              <a href={t.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-siegel transition-colors hover:text-siegel-deep">
                Open {t.name} <span aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How it compares -->
    <section class="border-t border-rule" aria-labelledby="cmp-h">
      <div class="mx-auto max-w-5xl px-5 py-14">
        <h2 id="cmp-h" class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[2rem]">
          Next to the alternatives
        </h2>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[38rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-ink">
                <th scope="col" class="py-3 pr-4 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">&nbsp;</th>
                <th scope="col" class="bg-siegel-wash px-4 py-3 font-display text-base font-semibold">DeutschMeister</th>
                <th scope="col" class="px-4 py-3 text-[0.9375rem] font-normal text-graphite">Group class</th>
                <th scope="col" class="px-4 py-3 text-[0.9375rem] font-normal text-graphite">Private tutor</th>
                <th scope="col" class="px-4 py-3 text-[0.9375rem] font-normal text-graphite">Grammar apps</th>
              </tr>
            </thead>
            <tbody>
              {CMP.map((row) => (
                <tr class="border-b border-rule">
                  <th scope="row" class="py-3.5 pr-4 text-sm font-normal text-graphite">{row.feature}</th>
                  <td class="bg-siegel-wash px-4 py-3.5 font-data text-[0.8125rem] font-semibold text-ink">{row.us}</td>
                  <td class="px-4 py-3.5 font-data text-[0.8125rem] text-graphite">{row.group}</td>
                  <td class="px-4 py-3.5 font-data text-[0.8125rem] text-graphite">{row.tutor}</td>
                  <td class="px-4 py-3.5 font-data text-[0.8125rem] text-graphite">{row.apps}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 font-data text-[0.8125rem] text-graphite">
          <a href="/vergleich/" class="text-siegel transition-colors hover:text-siegel-deep">Detailed comparisons against Babbel, Duolingo and Lingoda →</a>
        </p>
      </div>
    </section>

    <!-- Start here -->
    <section class="border-t border-rule" aria-labelledby="start-h">
      <div class="mx-auto max-w-5xl px-5 py-14">
        <h2 id="start-h" class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[2rem]">
          Start with these
        </h2>
        <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
          The four topics that unlock the most German for the least effort.
        </p>
        <ul class="mt-6 grid gap-px bg-rule sm:grid-cols-2">
          {TOPICS.map((t) => (
            <li>
              <a href={t.href} class="block h-full bg-paper p-5 transition-colors hover:bg-siegel-wash">
                <span class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">{t.level}</span>
                <span class="mt-1.5 block font-display text-[1.125rem] font-semibold">{t.label}</span>
                <span class="mt-1.5 block text-[0.9375rem] leading-relaxed text-graphite">{t.desc}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 font-data text-[0.8125rem]">
          <a href="/grammar/" class="text-siegel transition-colors hover:text-siegel-deep">All {GRAMMAR_TOPIC_COUNT} topics →</a>
        </p>
      </div>
    </section>

    <!-- Close -->
    <section class="border-t border-rule" aria-labelledby="close-h">
      <div class="mx-auto max-w-5xl px-5 py-16">
        <h2 id="close-h" class="max-w-2xl font-display text-[1.75rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.25rem]">
          Open {FREE_LEVEL_LABEL} and see whether it clicks.
        </h2>
        <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
          The whole first level is free and needs no account. If you want the other {LEVEL_COUNT - 1},
          Pro is {monthlyPriceLine()}.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/grammar/a1.1/" class="inline-flex items-center justify-center rounded-md bg-siegel px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-siegel-lift">
            Start {FREE_LEVEL_LABEL} free
          </a>
          <a href="/pricing/" class="inline-flex items-center justify-center rounded-md border border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-paper">
            See what Pro costs
          </a>
        </div>
        <p class="mt-8 border-t border-rule pt-6 text-[0.9375rem] text-graphite">
          There are German lessons on our
          <a href="https://www.youtube.com/@deutschmeister_de" target="_blank" rel="noopener noreferrer" class="font-semibold text-siegel transition-colors hover:text-siegel-deep">YouTube channel</a>
          too — grammar, vocabulary and real conversations.
        </p>
      </div>
    </section>

  </div>
</Layout>
