---
// Homepage v3 — rebuilt 2026-09-01 after the owner's "we can do a lot better"
// verdict on v2. Research pass over the open-source design landscape
// (react-bits, Magic UI, Aceternity patterns, Atropos) — the findings and the
// adopt/skip table live in docs/design-renovation-2026-09-01.md.
//
// WHAT v3 ADDS OVER v2 (same tokens, same copy voice, same IA):
//   - THE LIVING X-RAY HERO: German sentences type themselves out, then each
//     word's case chip pops in and colours it, cycling 3 real sentences. The
//     product's unique artifact, performing itself. Server renders sentence 1
//     fully coloured (SEO / no-JS / reduced-motion state); the script only
//     enhances.
//   - Atropos 3D parallax (MIT, ~10KB, vanilla) on the hero card and the four
//     exam cards — layered scenes that tilt toward the pointer.
//   - Aurora background, blur-fade scroll reveals, a case-chip marquee band,
//     count-up stats, a shimmer sweep on the primary CTA (Magic UI patterns,
//     ported to vanilla CSS/JS).
//   - A bento "what's inside" grid replacing the flat counts band + tools grid.
//
// MOTION DISCIPLINE: everything rides the global prefers-reduced-motion gate
// (global.css collapses animations/transitions); scripts additionally check
// the media query and leave the static SSR state alone.
//
// CLAIMS. Every figure derives from ../data/*.js (counts rule in marketing.js).
// Rule 1 (colour means case): case colours appear only on chips that NAME
// their case — the hero demo, the legend, the marquee phrases. INVARIANTS:
// one <h1>; canonical; real server-rendered body text; prerendered SPA routes
// linked WITH trailing slash, /signup and /modelltest without.
import { ORGANIZATION_FULL } from '../data/organization.js';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import 'atropos/css';
import { EXAM_TRACKS } from '../data/examTracks.js';
import { PLANS, eur } from '../data/pricing.js';
import {
  LEVEL_COUNT,
  GRAMMAR_TOPIC_COUNT,
  LISTENING_DIALOGUE_COUNT,
  READING_LESSON_COUNT,
  VOCAB_WORD_COUNT,
  ANON_DAILY_LIMIT,
  PRO_DAILY_LIMIT,
  PRO_SPEAKING_SESSIONS_PER_MONTH,
  PRO_WRITING_EVALUATIONS_PER_MONTH,
  TRIAL_DAYS,
  FREE_LEVEL_LABEL,
  monthlyPriceLine,
} from '../data/marketing.js';

// 54 chars — the built-HTML check warns above 60 (Google truncates).
const title = 'German Exam Prep — telc, Goethe & DTZ | DeutschMeister';
const description = `Your German exam has a date. Find your level in 20 minutes, train what the exam actually tests — grammar, listening, speaking, writing — and rehearse with a timed practice test. ${FREE_LEVEL_LABEL} free, no account.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DeutschMeister',
    url: 'https://deutsch-meister.de/',
    description:
      'German exam preparation for telc, Goethe and DTZ — grammar, listening, speaking and writing practice for English speakers, CEFR levels A1.1 to B2.2.',
    inLanguage: ['de', 'en'],
  },
  { '@context': 'https://schema.org', ...ORGANIZATION_FULL },
];

const BTN =
  'inline-flex items-center justify-center gap-2 rounded-clay text-base font-bold transition-all duration-100 ease-snap select-none';
const BTN_PRIMARY = `${BTN} btn-shimmer relative overflow-hidden bg-siegel px-7 py-3.5 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_SECONDARY = `${BTN} border border-rule bg-white px-7 py-3.5 text-ink shadow-raise hover:border-siegel hover:text-siegel-deep active:translate-y-1 active:shadow-none`;

// One English line per exam track — the stake, not the format.
const TRACK_LINES = {
  telc_b1: 'The B1 most people need for permanent residence — and the one with the partner speaking test.',
  goethe_b1: 'Four separate modules. Train the one that wobbles instead of re-taking all four.',
  dtz: 'The integration-course exam. Everyday German, two levels graded at once.',
  telc_b2: 'The jump from "getting by" to arguing a position — what employers ask for.',
};

// The plan steps. Accent badges rotate through the candy palette (rule 2:
// energy, never meaning).
const STEPS = [
  {
    n: '1',
    accent: 'bg-accent-himbeer',
    title: 'Find out where you actually stand',
    body: `A free 20-minute level test — written, listening and speaking — tells you which of the ${LEVEL_COUNT} levels to train at. No more studying B1 material with an A2 gap underneath it.`,
    href: '/level-test/',
    linkLabel: 'Take the level test',
  },
  {
    n: '2',
    accent: 'bg-accent-aprikose',
    title: 'Train at your level, not around it',
    body: `${GRAMMAR_TOPIC_COUNT} grammar topics with exercises, ${LISTENING_DIALOGUE_COUNT} native-speaker dialogues, ${READING_LESSON_COUNT} reading lessons and ${VOCAB_WORD_COUNT} words in a spaced-repetition trainer — organised by level, so every session lands where your exam needs it.`,
    href: '/grammar/',
    linkLabel: 'Browse the library',
  },
  {
    n: '3',
    accent: 'bg-accent-limette',
    title: 'Speak and write before it counts',
    body: `The speaking test is the part nobody can cram. Practise conversations with the AI coach (${PRO_SPEAKING_SESSIONS_PER_MONTH} sessions a month on Pro) and get exam letters marked against the publicly documented criteria (${PRO_WRITING_EVALUATIONS_PER_MONTH} a month on Pro).`,
    href: '/speaking/',
    linkLabel: 'Try a speaking session',
  },
  {
    n: '4',
    accent: 'bg-siegel',
    title: 'Rehearse the real thing',
    body: 'A timed practice test in the exam’s style (telc B1 today), scored against the documented pass mark — so your first run under exam conditions is not the exam.',
    href: '/modelltest',
    linkLabel: 'See the practice test',
  },
];

// The hero demo's first sentence, server-rendered fully coloured. The script
// cycles this and two more (see XR_SENTENCES in the script below — keep in
// sync). Same wording + case marking as the live analyser.
const SENTENCE = [
  { text: 'Der Mann', kasus: 'nominativ', abbr: 'NOM' },
  { text: 'gibt', kasus: null, abbr: 'VERB' },
  { text: 'dem Kind', kasus: 'dativ', abbr: 'DAT' },
  { text: 'einen Apfel', kasus: 'akkusativ', abbr: 'AKK' },
];
const KASUS_CLASS = {
  nominativ: 'border-kasus-nominativ bg-kasus-nominativ-wash text-kasus-nominativ-ink',
  akkusativ: 'border-kasus-akkusativ bg-kasus-akkusativ-wash text-kasus-akkusativ-ink',
  dativ: 'border-kasus-dativ bg-kasus-dativ-wash text-kasus-dativ-ink',
  genitiv: 'border-kasus-genitiv bg-kasus-genitiv-wash text-kasus-genitiv-ink',
};
const PLAIN_CHIP = 'border-rule bg-paper-sunk text-graphite';

// Marquee phrases — each names/demonstrates its case (rule 1) or is a verb.
const MARQUEE = [
  { t: 'der Termin', k: 'nominativ', a: 'NOM' },
  { t: 'für die Prüfung', k: 'akkusativ', a: 'AKK' },
  { t: 'mit dem Bus', k: 'dativ', a: 'DAT' },
  { t: 'wegen des Visums', k: 'genitiv', a: 'GEN' },
  { t: 'die Antwort', k: 'nominativ', a: 'NOM' },
  { t: 'ohne einen Fehler', k: 'akkusativ', a: 'AKK' },
  { t: 'aus dem Kurs', k: 'dativ', a: 'DAT' },
  { t: 'trotz des Regens', k: 'genitiv', a: 'GEN' },
];

// Bento tiles: counts + the try-now tools, one grid. Figures derive.
const nf = (n) => n.toLocaleString('en-US');
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/" jsonLd={jsonLd}>
  <!-- Stamped before first paint so the reveal-hidden state only ever exists
       when the observer that lifts it is also running. -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- ═══ HERO: the person, the pain — and the product performing itself ═══ -->
    <section class="relative" aria-labelledby="hero-h">
      <!-- Aurora: three drifting, blurred colour fields behind the hero -->
      <div class="aurora pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="aurora-blob aurora-a"></div>
        <div class="aurora-blob aurora-b"></div>
        <div class="aurora-blob aurora-c"></div>
      </div>

      <div class="relative mx-auto max-w-6xl px-5 pt-14 pb-16 sm:pt-20">
        <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
          <div>
            <p class="hero-line font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" style="--d:0ms">
              telc · Goethe · DTZ · A1–B2
            </p>
            <h1 id="hero-h" class="mt-3 font-display text-[2.375rem] font-semibold leading-[1.02] tracking-[-0.025em] sm:text-[3.5rem]">
              <span class="hero-line block" style="--d:60ms">Your exam has a date.</span>
              <span class="hero-line block" style="--d:180ms">Your German needs <span class="relative inline-block">a plan.<svg class="underline-swash absolute -bottom-2 left-0 w-full" viewBox="0 0 220 12" fill="none" aria-hidden="true"><path d="M3 9 C60 3, 160 3, 217 8" stroke="#0F766E" stroke-width="5" stroke-linecap="round"/></svg></span></span>
            </h1>
            <p class="hero-line mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" style="--d:320ms">
              You can study every evening and still walk in unsure — because working hard isn't the
              same as working on what the exam actually tests. DeutschMeister shows you where you
              stand, trains exactly what your exam wants, and lets you rehearse the real thing
              before it counts.
            </p>
            <div class="hero-line mt-8 flex flex-wrap items-center gap-4" style="--d:460ms">
              <a href="/level-test/" class={BTN_PRIMARY}><span class="relative z-10">Find your level — free</span></a>
              <a href="#exams" class={BTN_SECONDARY}>Pick your exam</a>
            </div>
            <p class="hero-line mt-5 font-data text-[0.8125rem] text-graphite" style="--d:560ms">
              {FREE_LEVEL_LABEL} free, no account · {TRIAL_DAYS}-day Pro trial · cancel anytime
            </p>
          </div>

          <!-- The living X-Ray. Atropos scene; SSR shows sentence 1 coloured. -->
          <div class="hero-line" style="--d:380ms">
            <div class="atropos" data-atropos-card>
              <div class="atropos-scale"><div class="atropos-rotate"><div class="atropos-inner !overflow-visible">
                <div class="rounded-clay border border-rule bg-white p-6 shadow-raise-lg sm:p-7">
                  <div class="flex items-center justify-between gap-3" data-atropos-offset="3">
                    <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Sentence X-Ray</p>
                    <span class="flex gap-1.5" aria-hidden="true">
                      <span class="h-2.5 w-2.5 rounded-full bg-accent-himbeer"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-accent-aprikose"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-accent-limette"></span>
                    </span>
                  </div>
                  <div id="xr-stage" class="mt-5 flex min-h-[8.5rem] flex-wrap content-start items-start gap-2" data-atropos-offset="6">
                    {SENTENCE.map((w) => (
                      <span class={`xr-chip rounded-md border px-3 py-2 ${w.kasus ? KASUS_CLASS[w.kasus] : PLAIN_CHIP}`}>
                        <span class="block text-[1.0625rem] font-semibold leading-none">{w.text}</span>
                        <span class="mt-1.5 block font-data text-[0.625rem] font-bold tracking-[0.13em]">{w.abbr}</span>
                      </span>
                    ))}
                  </div>
                  <p id="xr-gloss" class="mt-4 border-t border-rule pt-3 font-data text-[0.8125rem] text-graphite" data-atropos-offset="2">
                    “The man gives the child an apple.”
                  </p>
                </div>
                <!-- Floating legend, above the card plane -->
                <div class="absolute -bottom-4 -left-3 flex gap-1.5 rounded-pill border border-rule bg-white px-3 py-2 shadow-raise" data-atropos-offset="9" aria-hidden="true">
                  <span class="rounded-pill bg-kasus-nominativ-wash px-2 py-0.5 font-data text-[0.625rem] font-bold text-kasus-nominativ-ink">NOM</span>
                  <span class="rounded-pill bg-kasus-akkusativ-wash px-2 py-0.5 font-data text-[0.625rem] font-bold text-kasus-akkusativ-ink">AKK</span>
                  <span class="rounded-pill bg-kasus-dativ-wash px-2 py-0.5 font-data text-[0.625rem] font-bold text-kasus-dativ-ink">DAT</span>
                  <span class="rounded-pill bg-kasus-genitiv-wash px-2 py-0.5 font-data text-[0.625rem] font-bold text-kasus-genitiv-ink">GEN</span>
                </div>
              </div></div></div>
            </div>
            <p class="mt-7 text-center font-data text-[0.8125rem] text-graphite">
              Every sentence, in every lesson, taken apart like this —
              <a href="/analyze/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">try your own →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Marquee: the language, moving ═══ -->
    <div class="marquee border-y border-rule bg-white py-3.5" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center gap-3 pr-3">
            {MARQUEE.map((m) => (
              <span class={`flex items-center gap-2 whitespace-nowrap rounded-pill border px-3.5 py-1.5 text-[0.9375rem] font-semibold ${KASUS_CLASS[m.k]}`}>
                {m.t}
                <span class="font-data text-[0.625rem] font-bold tracking-[0.13em] opacity-70">{m.a}</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- ═══ Exam picker: four 3D cards ═══ -->
    <section id="exams" class="bg-paper-sunk" aria-labelledby="exams-h">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 id="exams-h" class="reveal font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
          Which exam is on your calendar?
        </h2>
        <p class="reveal mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base" style="--rd:80ms">
          Each one tests different things — so each one gets its own preparation path.
        </p>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {EXAM_TRACKS.map((track, i) => (
            <li class="reveal" style={`--rd:${i * 90}ms`}>
              <div class="atropos h-full" data-atropos-card>
                <div class="atropos-scale h-full"><div class="atropos-rotate h-full"><div class="atropos-inner h-full !overflow-visible">
                  <a href={`/pruefung/${track.slug}/`} class="flex h-full flex-col rounded-clay border border-rule bg-white p-6 shadow-raise transition-shadow hover:shadow-raise-lg">
                    <span class="self-start rounded-pill bg-siegel-wash px-2.5 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep" data-atropos-offset="8">{track.level}</span>
                    <span class="mt-3 block font-display text-[1.1875rem] font-semibold leading-snug" data-atropos-offset="4">{track.nameDe}</span>
                    <span class="mt-2 block flex-1 text-[0.9375rem] leading-relaxed text-graphite" data-atropos-offset="2">{TRACK_LINES[track.key]}</span>
                    <span class="mt-4 inline-block text-sm font-bold text-siegel" data-atropos-offset="6">See your path →</span>
                  </a>
                </div></div></div>
              </div>
            </li>
          ))}
        </ul>
        <p class="reveal mt-7 font-data text-[0.8125rem] text-graphite" style="--rd:200ms">
          No exam date? <a href="/grammar/a1.1/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">Start {FREE_LEVEL_LABEL} free</a> — no account needed.
        </p>
      </div>
    </section>

    <!-- ═══ The plan: four connected steps ═══ -->
    <section class="mx-auto max-w-6xl px-5 py-16" aria-labelledby="plan-h">
      <h2 id="plan-h" class="reveal font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
        Four steps between today and exam day
      </h2>
      <p class="reveal mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base" style="--rd:80ms">
        Not more studying — the right studying, in the right order.
      </p>
      <div class="relative mt-10">
        <!-- The connector: draws itself in when the section reveals -->
        <svg class="path-connector absolute -top-5 left-0 hidden w-full lg:block" viewBox="0 0 1200 40" fill="none" preserveAspectRatio="none" aria-hidden="true">
          <path d="M75 30 C 250 -10, 380 50, 525 22 S 850 0, 1125 26" stroke="#0F766E" stroke-opacity="0.35" stroke-width="3" stroke-dasharray="10 10" stroke-linecap="round" pathLength="100" />
        </svg>
        <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
          {STEPS.map((s, i) => (
            <li class="reveal relative rounded-clay border border-rule bg-white p-6 shadow-raise" style={`--rd:${i * 110}ms`}>
              <span class={`absolute -top-4 left-6 flex h-9 w-9 items-center justify-center rounded-pill ${s.accent} font-data text-sm font-bold text-white shadow-raise`} aria-hidden="true">{s.n}</span>
              <h3 class="mt-3 font-display text-[1.125rem] font-semibold">{s.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">{s.body}</p>
              <a href={s.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-siegel transition-colors hover:text-siegel-deep">
                {s.linkLabel} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ═══ Bento: what you train with ═══ -->
    <section class="border-t border-rule bg-paper-sunk" aria-labelledby="bento-h">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 id="bento-h" class="reveal font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
          What's waiting inside
        </h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

          <!-- Grammar: the big tile -->
          <a href="/grammar/" class="reveal group flex flex-col justify-between rounded-clay border border-rule bg-white p-6 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg sm:col-span-2 sm:row-span-2">
            <div>
              <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Grammar, made visible</p>
              <p class="mt-3 font-display text-[3.25rem] font-semibold leading-none tracking-[-0.02em]"><span class="countup" data-count={GRAMMAR_TOPIC_COUNT}>{GRAMMAR_TOPIC_COUNT}</span> topics</p>
              <p class="mt-3 max-w-md text-[0.9375rem] leading-relaxed text-graphite">
                Every topic from {FREE_LEVEL_LABEL} to B2.2 with explanations in English, examples
                taken apart by case, and exercises that check themselves.
              </p>
            </div>
            <div class="mt-6">
              <div class="grid max-w-xs grid-cols-4 gap-1.5" aria-hidden="true">
                <span class="rounded-md bg-kasus-nominativ-wash px-2 py-1.5 text-center font-data text-[0.625rem] font-bold text-kasus-nominativ-ink">NOM</span>
                <span class="rounded-md bg-kasus-akkusativ-wash px-2 py-1.5 text-center font-data text-[0.625rem] font-bold text-kasus-akkusativ-ink">AKK</span>
                <span class="rounded-md bg-kasus-dativ-wash px-2 py-1.5 text-center font-data text-[0.625rem] font-bold text-kasus-dativ-ink">DAT</span>
                <span class="rounded-md bg-kasus-genitiv-wash px-2 py-1.5 text-center font-data text-[0.625rem] font-bold text-kasus-genitiv-ink">GEN</span>
              </div>
              <span class="mt-5 inline-block text-sm font-bold text-siegel">Browse the library →</span>
            </div>
          </a>

          <!-- Listening -->
          <a href="/listening/" class="reveal flex flex-col rounded-clay border border-rule bg-white p-6 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg" style="--rd:90ms">
            <div class="equalizer flex h-8 items-end gap-1" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <p class="mt-4 font-display text-[1.75rem] font-semibold leading-none"><span class="countup" data-count={LISTENING_DIALOGUE_COUNT}>{nf(LISTENING_DIALOGUE_COUNT)}</span></p>
            <p class="mt-1.5 text-[0.875rem] leading-snug text-graphite">native-speaker dialogues, levelled {FREE_LEVEL_LABEL}–B2.2</p>
          </a>

          <!-- Vocab -->
          <a href="/dashboard" class="reveal flex flex-col rounded-clay border border-rule bg-white p-6 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg" style="--rd:180ms">
            <span class="inline-flex h-8 w-11 items-center justify-center self-start rounded-md bg-accent-limette-wash font-data text-[0.6875rem] font-bold text-accent-limette-ink" aria-hidden="true">SRS</span>
            <p class="mt-4 font-display text-[1.75rem] font-semibold leading-none"><span class="countup" data-count={VOCAB_WORD_COUNT}>{nf(VOCAB_WORD_COUNT)}</span></p>
            <p class="mt-1.5 text-[0.875rem] leading-snug text-graphite">words in the spaced-repetition trainer</p>
          </a>

          <!-- Reading -->
          <a href="/reading/" class="reveal flex flex-col rounded-clay border border-rule bg-white p-6 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg" style="--rd:270ms">
            <span class="inline-flex h-8 w-11 items-center justify-center self-start rounded-md bg-accent-aprikose-wash font-data text-[0.6875rem] font-bold text-accent-aprikose-ink" aria-hidden="true">Aa</span>
            <p class="mt-4 font-display text-[1.75rem] font-semibold leading-none"><span class="countup" data-count={READING_LESSON_COUNT}>{READING_LESSON_COUNT}</span></p>
            <p class="mt-1.5 text-[0.875rem] leading-snug text-graphite">reading lessons with comprehension checks</p>
          </a>

          <!-- Speaking coach -->
          <a href="/speaking/" class="reveal flex flex-col rounded-clay border border-rule bg-white p-6 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg" style="--rd:360ms">
            <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">AI speaking coach</p>
            <p class="mt-3 flex-1 text-[0.875rem] leading-relaxed text-graphite">Hold a conversation at your level; get it back marked for grammar, vocabulary and pronunciation.</p>
            <p class="mt-3 font-data text-[0.75rem] text-graphite">{PRO_SPEAKING_SESSIONS_PER_MONTH} sessions/month on Pro</p>
          </a>

          <!-- X-Ray: the wide bottom tile -->
          <a href="/analyze/" class="reveal flex flex-col gap-2 rounded-clay border border-rule bg-white p-6 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg sm:col-span-2 sm:flex-row sm:items-center sm:justify-between lg:col-span-4" style="--rd:450ms">
            <div>
              <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Sentence X-Ray</p>
