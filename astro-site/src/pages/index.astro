<style is:global>
  /* ── v3 homepage motion layer (docs/design-renovation-2026-09-01.md).
     Everything here collapses under the prefers-reduced-motion gate in
     global.css; the scripts below additionally no-op. ─────────────────── */

  /* Hero entrance: staggered rise-and-settle */
  .hero-line {
    animation: dmRise 0.7s cubic-bezier(0.2, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes dmRise {
    from { opacity: 0; transform: translateY(18px); filter: blur(4px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .underline-swash path {
    stroke-dasharray: 230;
    stroke-dashoffset: 230;
    animation: dmDraw 0.7s ease-out 0.9s forwards;
  }
  @keyframes dmDraw { to { stroke-dashoffset: 0; } }

  /* Aurora background */
  .aurora-blob {
    position: absolute;
    width: 34rem;
    height: 34rem;
    border-radius: 9999px;
    filter: blur(70px);
    opacity: 0.55;
    will-change: transform;
    animation: dmDrift 18s ease-in-out infinite alternate;
  }
  .aurora-a { left: -10%; top: -20%; background: #e6f2f0; } /* siegel wash */
  .aurora-b { right: -12%; top: -10%; background: #fdecf3; animation-delay: -6s; } /* himbeer wash */
  .aurora-c { left: 35%; bottom: -55%; background: #fff0e4; animation-delay: -12s; } /* aprikose wash */
  @keyframes dmDrift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(4rem, 2.5rem, 0) scale(1.15); }
  }

  /* Scroll reveals (Magic UI BlurFade pattern, vanilla). The hidden state
     exists ONLY once JS has stamped html.js — no-JS visitors and crawlers see
     everything; reduced-motion gets the same escape hatch. */
  html.js .reveal {
    opacity: 0;
    transform: translateY(22px);
    filter: blur(5px);
    transition:
      opacity 0.65s cubic-bezier(0.2, 1, 0.36, 1) var(--rd, 0ms),
      transform 0.65s cubic-bezier(0.2, 1, 0.36, 1) var(--rd, 0ms),
      filter 0.65s cubic-bezier(0.2, 1, 0.36, 1) var(--rd, 0ms);
  }
  html.js .reveal.is-visible { opacity: 1; transform: translateY(0); filter: blur(0); }
  @media (prefers-reduced-motion: reduce) {
    html.js .reveal { opacity: 1; transform: none; filter: none; }
  }

  /* Marquee */
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); }
  .marquee-track { display: flex; width: max-content; animation: dmMarquee 36s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @keyframes dmMarquee { to { transform: translateX(-50%); } }

  /* Shimmer sweep on the primary CTA */
  .btn-shimmer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.35) 50%, transparent 70%);
    transform: translateX(-100%);
    animation: dmShimmer 4.5s ease-in-out infinite;
  }
  @keyframes dmShimmer {
    0%, 60% { transform: translateX(-100%); }
    80%, 100% { transform: translateX(100%); }
  }

  /* Step connector draws in */
  .path-connector path { stroke-dashoffset: 100; transition: stroke-dashoffset 1.4s ease-out 0.3s; }
  .path-connector.is-visible path { stroke-dashoffset: 0; }

  /* Listening equalizer */
  .equalizer span {
    width: 5px;
    border-radius: 999px;
    background: #0d9488; /* siegel lift */
    animation: dmEq 1.1s ease-in-out infinite alternate;
  }
  .equalizer span:nth-child(1) { height: 40%; animation-delay: 0s; }
  .equalizer span:nth-child(2) { height: 75%; animation-delay: 0.12s; }
  .equalizer span:nth-child(3) { height: 55%; animation-delay: 0.24s; }
  .equalizer span:nth-child(4) { height: 95%; animation-delay: 0.36s; }
  .equalizer span:nth-child(5) { height: 60%; animation-delay: 0.48s; }
  .equalizer span:nth-child(6) { height: 85%; animation-delay: 0.6s; }
  .equalizer span:nth-child(7) { height: 45%; animation-delay: 0.72s; }
  @keyframes dmEq { to { transform: scaleY(0.45); } }

  /* X-Ray demo chip pop */
  .xr-chip { animation: dmPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  @keyframes dmPop {
    from { opacity: 0; transform: scale(0.7) translateY(6px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  #xr-gloss { transition: opacity 0.3s ease; }
</style>

<script>
  import Atropos from 'atropos';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Atropos 3D scenes ──────────────────────────────────────────────────
  document.querySelectorAll('[data-atropos-card]').forEach((el) => {
    Atropos({ el, activeOffset: 30, rotateXMax: 9, rotateYMax: 9, shadow: false, highlight: true, duration: 250 });
  });

  // ── Scroll reveals ─────────────────────────────────────────────────────
  // IntersectionObserver first; plus a throttled scroll/resize fallback that
  // reveals anything already in the viewport — IO callbacks can lag on weak
  // (software-rendered) devices during fast scrolling, and a card that stays
  // invisible is worse than one that skips its entrance.
  const revealables = new Set(document.querySelectorAll('.reveal, .path-connector'));
  const show = (el) => {
    el.classList.add('is-visible');
    revealables.delete(el);
    io.unobserve(el);
  };
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) show(e.target);
    },
    { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
  );
  revealables.forEach((el) => io.observe(el));
  // Track the deepest viewport-bottom the visitor has reached: on a starved
  // main thread the queued sweeps can all fire late, after the position has
  // changed again, so the sweep must judge against where the visitor HAS
  // been, not where they happen to be when the timer runs.
  let deepest = 0;
  let sweepQueued = false;
  const sweep = () => {
    sweepQueued = false;
    for (const el of [...revealables]) {
      const docTop = el.getBoundingClientRect().top + window.scrollY;
      if (docTop < deepest - window.innerHeight * 0.05) show(el);
    }
    if (revealables.size === 0) {
      window.removeEventListener('scroll', queueSweep);
      window.removeEventListener('resize', queueSweep);
    }
  };
  const queueSweep = () => {
    deepest = Math.max(deepest, window.scrollY + window.innerHeight);
    if (!sweepQueued) {
      sweepQueued = true;
      setTimeout(sweep, 150);
    }
  };
  window.addEventListener('scroll', queueSweep, { passive: true });
  window.addEventListener('resize', queueSweep);
  queueSweep();

  // ── Count-ups (Magic UI number-ticker pattern) ─────────────────────────
  if (!reduced) {
    const fmt = new Intl.NumberFormat('en-US');
    const cio = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          cio.unobserve(e.target);
          const el = e.target;
          const target = Number(el.dataset.count);
          const t0 = performance.now();
          const dur = 1100;
          const tick = (t) => {
            const p = Math.min(1, (t - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = fmt.format(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll('.countup').forEach((el) => cio.observe(el));
  }

  // ── The living X-Ray hero ──────────────────────────────────────────────
  // Cycle 3 sentences: words pop in plain, then get coloured one by one,
  // hold, fade, next. SSR already shows sentence 1 coloured — the script
  // waits a beat, then takes over. Skipped entirely under reduced motion.
  const stage = document.getElementById('xr-stage');
  const gloss = document.getElementById('xr-gloss');
  if (stage && gloss && !reduced) {
    const KASUS = {
      nominativ: 'border-kasus-nominativ bg-kasus-nominativ-wash text-kasus-nominativ-ink',
      akkusativ: 'border-kasus-akkusativ bg-kasus-akkusativ-wash text-kasus-akkusativ-ink',
      dativ: 'border-kasus-dativ bg-kasus-dativ-wash text-kasus-dativ-ink',
      genitiv: 'border-kasus-genitiv bg-kasus-genitiv-wash text-kasus-genitiv-ink',
    };
    const PLAIN = 'border-rule bg-paper-sunk text-graphite';
    const XR_SENTENCES = [
      {
        gloss: '“The man gives the child an apple.”',
        words: [
          { t: 'Der Mann', k: 'nominativ', a: 'NOM' },
          { t: 'gibt', k: null, a: 'VERB' },
          { t: 'dem Kind', k: 'dativ', a: 'DAT' },
          { t: 'einen Apfel', k: 'akkusativ', a: 'AKK' },
        ],
      },
      {
        gloss: '“I am sending the office a letter.”',
        words: [
          { t: 'Ich', k: 'nominativ', a: 'NOM' },
          { t: 'schicke', k: null, a: 'VERB' },
          { t: 'dem Amt', k: 'dativ', a: 'DAT' },
          { t: 'einen Brief', k: 'akkusativ', a: 'AKK' },
        ],
      },
      {
        gloss: '“Despite the stress, she passes the exam.”',
        words: [
          { t: 'Trotz des Stresses', k: 'genitiv', a: 'GEN' },
          { t: 'besteht', k: null, a: 'VERB' },
          { t: 'sie', k: 'nominativ', a: 'NOM' },
          { t: 'die Prüfung', k: 'akkusativ', a: 'AKK' },
        ],
      },
    ];
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const chip = (w) => {
      const s = document.createElement('span');
      s.className = `xr-chip rounded-md border px-3 py-2 ${PLAIN}`;
      s.innerHTML =
        `<span class="block text-[1.0625rem] font-semibold leading-none"></span>` +
        `<span class="mt-1.5 block font-data text-[0.625rem] font-bold tracking-[0.13em] opacity-0">${w.a}</span>`;
      s.firstChild.textContent = w.t;
      return s;
    };
    (async () => {
      await sleep(2600); // let the SSR state land first
      let i = 1; // SSR showed sentence 0
      // eslint-disable-next-line no-constant-condition
      while (true) {
        const s = XR_SENTENCES[i % XR_SENTENCES.length];
        gloss.style.opacity = '0';
        stage.style.transition = 'opacity 0.28s ease';
        stage.style.opacity = '0';
        await sleep(300);
        stage.replaceChildren();
        stage.style.opacity = '1';
        // 1. words pop in, plain
        const chips = s.words.map(chip);
        for (const c of chips) {
          stage.appendChild(c);
          await sleep(150);
        }
        await sleep(350);
        // 2. the x-ray: each word gets its case
        for (let j = 0; j < chips.length; j++) {
          const w = s.words[j];
          const c = chips[j];
          c.className = `xr-chip rounded-md border px-3 py-2 ${w.k ? KASUS[w.k] : PLAIN}`;
          c.style.animation = 'none';
          void c.offsetWidth;
          c.style.animation = '';
          c.lastChild.classList.remove('opacity-0');
          await sleep(260);
        }
        gloss.textContent = s.gloss;
        gloss.style.opacity = '1';
        await sleep(3000);
        i++;
      }
    })();
  }
</script>
