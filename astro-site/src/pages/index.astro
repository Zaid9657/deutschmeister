---
// Homepage — rebuilt 2026-09-01 on design-tokens v2 ("Playful Depth",
// docs/design-renovation-2026-09-01.md).
//
// THE PERSON. This page speaks to one reader: someone with a telc/Goethe/DTZ
// date on the calendar and visa, citizenship or job stakes behind it. Their
// pain is not "German is hard" — it is studying every evening WITHOUT KNOWING
// whether it is the right studying. The promise is the honest one the product
// can keep: know where you stand, train what the exam tests, rehearse before
// it counts. No pass guarantees — the OUTCOME ban in tests/exams.test.mjs is
// the line, and "walk in knowing how ready you are" stays on the right side
// of it.
//
// THE LOOK. Chunky pressable CTAs (hard bottom edge, depress on click), clay
// exam cards that float on hover, candy accent badges on the path steps
// (energy, never semantics — tokens rule 2), and the case colours ONLY inside
// the sentence demo (rule 1). Reference material (the comparison table) stays
// flat. A reserved hero art slot (data-art-slot="hero") holds a CSS clay
// composition until the Higgsfield artwork lands
// (docs/design/higgsfield-art-specs.md).
//
// CLAIMS. Every figure derives from ../data/*.js constants counted against
// live tables (the counts rule in src/data/marketing.js). No learner counts,
// no usage counts, no price literals. INVARIANTS (do not regress): one <h1>;
// the canonical; real server-rendered body text; prerendered SPA routes
// linked WITH a trailing slash, /signup and /modelltest without (CLAUDE.md's
// three-case rule).
import { ORGANIZATION_FULL } from '../data/organization.js';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { EXAM_TRACKS } from '../data/examTracks.js';
import { PLANS, eur } from '../data/pricing.js';
import {
  LEVEL_COUNT,
  GRAMMAR_TOPIC_COUNT,
  LISTENING_DIALOGUE_COUNT,
  READING_LESSON_COUNT,
  VOCAB_WORD_COUNT,
  ANON_DAILY_LIMIT,
  PRO_DAILY_LIMIT,
  PRO_SPEAKING_SESSIONS_PER_MONTH,
  PRO_WRITING_EVALUATIONS_PER_MONTH,
  TRIAL_SPEAKING_SESSIONS,
  TRIAL_DAYS,
  FREE_LEVEL_LABEL,
  monthlyPriceLine,
} from '../data/marketing.js';

// 54 chars — the built-HTML check warns above 60 (Google truncates).
const title = 'German Exam Prep — telc, Goethe & DTZ | DeutschMeister';
const description = `Your German exam has a date. Find your level in 20 minutes, train what the exam actually tests — grammar, listening, speaking, writing — and rehearse with a timed practice test. ${FREE_LEVEL_LABEL} free, no account.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DeutschMeister',
    url: 'https://deutsch-meister.de/',
    description:
      'German exam preparation for telc, Goethe and DTZ — grammar, listening, speaking and writing practice for English speakers, CEFR levels A1.1 to B2.2.',
    inLanguage: ['de', 'en'],
  },
  { '@context': 'https://schema.org', ...ORGANIZATION_FULL },
];

// The v2 depth grammar, as class strings (this is a static page; the SPA gets
// the same treatment from src/components/ui/Button.jsx).
const BTN =
  'inline-flex items-center justify-center gap-2 rounded-clay text-base font-bold transition-all duration-100 ease-snap select-none';
const BTN_PRIMARY = `${BTN} bg-siegel px-7 py-3.5 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_SECONDARY = `${BTN} border border-rule bg-white px-7 py-3.5 text-ink shadow-raise hover:border-siegel hover:text-siegel-deep active:translate-y-1 active:shadow-none`;
const CLAY_LINK =
  'block h-full rounded-clay border border-rule bg-white p-6 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg active:translate-y-1 active:shadow-none';

// One English line per exam track — the stake, not the format (the format
// lives on the hub). Authored here; identity derives from the registry.
const TRACK_LINES = {
  telc_b1: 'The B1 most people need for permanent residence — and the one with the partner speaking test.',
  goethe_b1: 'Four separate modules. Train the one that wobbles instead of re-taking all four.',
  dtz: 'The integration-course exam. Everyday German, two levels graded at once.',
  telc_b2: 'The jump from "getting by" to arguing a position — what employers ask for.',
};

// The plan: what stands between today and exam day. Accent badges rotate
// through the candy palette — energy, never meaning (tokens rule 2).
const STEPS = [
  {
    n: '1',
    accent: 'bg-accent-himbeer',
    title: 'Find out where you actually stand',
    body: `A free 20-minute level test — written, listening and speaking — tells you which of the ${LEVEL_COUNT} levels to train at. No more studying B1 material with an A2 gap underneath it.`,
    href: '/level-test/',
    linkLabel: 'Take the level test',
  },
  {
    n: '2',
    accent: 'bg-accent-aprikose',
    title: 'Train at your level, not around it',
    body: `${GRAMMAR_TOPIC_COUNT} grammar topics with exercises, ${LISTENING_DIALOGUE_COUNT} native-speaker dialogues, ${READING_LESSON_COUNT} reading lessons and ${VOCAB_WORD_COUNT} words in a spaced-repetition trainer — organised by level, so every session lands where your exam needs it.`,
    href: '/grammar/',
    linkLabel: 'Browse the library',
  },
  {
    n: '3',
    accent: 'bg-accent-limette',
    title: 'Speak and write before it counts',
    body: `The speaking test is the part nobody can cram. Practise conversations with the AI coach (${PRO_SPEAKING_SESSIONS_PER_MONTH} sessions a month on Pro) and get exam letters marked against the publicly documented criteria (${PRO_WRITING_EVALUATIONS_PER_MONTH} a month on Pro).`,
    href: '/speaking/',
    linkLabel: 'Try a speaking session',
  },
  {
    n: '4',
    accent: 'bg-siegel',
    title: 'Rehearse the real thing',
    body: 'A timed practice test in the exam’s style (telc B1 today), scored against the documented pass mark — so your first run under exam conditions is not the exam.',
    href: '/modelltest',
    linkLabel: 'See the practice test',
  },
];

// The hero sentence. Same wording and same case marking as the live analyser
// (src/pages/SentenceXRay.jsx). Rule 1: this is the ONLY place on the page
// where the case colours may appear.
const SENTENCE = [
  { text: 'Der Mann', kasus: 'nominativ', abbr: 'NOM', role: 'subject', gloss: 'the man' },
  { text: 'gibt', kasus: null, abbr: 'VERB', role: 'verb', gloss: 'gives' },
  { text: 'dem Kind', kasus: 'dativ', abbr: 'DAT', role: 'indirect object', gloss: 'to the child' },
  { text: 'einen Apfel', kasus: 'akkusativ', abbr: 'AKK', role: 'direct object', gloss: 'an apple' },
];
const KASUS_CLASS = {
  nominativ: 'border-kasus-nominativ bg-kasus-nominativ-wash text-kasus-nominativ-ink',
  dativ: 'border-kasus-dativ bg-kasus-dativ-wash text-kasus-dativ-ink',
  akkusativ: 'border-kasus-akkusativ bg-kasus-akkusativ-wash text-kasus-akkusativ-ink',
};

// What the product contains. Every figure is a marketing.js constant counted
// against a live table — see the claims note in the header.
const COUNTS = [
  { value: GRAMMAR_TOPIC_COUNT, label: 'Grammar topics with exercises' },
  { value: LISTENING_DIALOGUE_COUNT, label: 'Native-speaker dialogues' },
  { value: READING_LESSON_COUNT, label: 'Reading lessons' },
  { value: VOCAB_WORD_COUNT.toLocaleString('en-US'), label: 'Words in the vocab trainer' },
];

const TOOLS = [
  {
    name: 'Sentence X-Ray',
    href: '/analyze/',
    body: 'Paste any German sentence — from a textbook, a song, a letter from the Amt — and watch it come apart into cases and roles.',
    free: `${ANON_DAILY_LIMIT} a day free, no account`,
    pro: `${PRO_DAILY_LIMIT} a day with Pro`,
  },
  {
    name: 'AI speaking coach',
    href: '/speaking/',
    body: 'Hold a conversation at your level and get it back marked for grammar, vocabulary and pronunciation.',
    free: `${TRIAL_SPEAKING_SESSIONS} sessions free`,
    pro: `${PRO_SPEAKING_SESSIONS_PER_MONTH} a month with Pro`,
  },
  {
    name: 'Level test',
    href: '/level-test/',
    body: 'Twenty minutes of grammar, listening and speaking — and you know exactly which level to train at.',
    free: 'Free, no account',
    pro: 'Retake whenever you like',
  },
];

// Comparison rows. Our own figures derive; the alternatives' are ranges, not
// somebody's advertised price, so they stay literal.
const CMP = [
  { feature: 'Cost per month', us: eur(PLANS.monthly.price), group: '€150+', tutor: '€50–100', apps: '€0–15' },
  { feature: 'Speaking practice', us: `${PRO_SPEAKING_SESSIONS_PER_MONTH} sessions a month`, group: 'Minutes per class', tutor: 'One-to-one', apps: 'None' },
  { feature: 'Exam writing feedback', us: `${PRO_WRITING_EVALUATIONS_PER_MONTH} letters a month`, group: 'Teacher-dependent', tutor: 'By arrangement', apps: '—' },
  { feature: 'Timed practice test', us: 'Built in (telc B1)', group: 'Sometimes', tutor: 'Rarely', apps: '—' },
  { feature: 'Available', us: 'Any hour', group: 'Fixed timetable', tutor: 'By appointment', apps: 'Any hour' },
  { feature: 'Level test', us: 'Free', group: '€50+', tutor: '€30+', apps: 'Basic quiz' },
];
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/" jsonLd={jsonLd}>
  <div class="bg-paper text-ink">

    <!-- Hero: the person, the pain, the promise -->
    <section class="mx-auto max-w-5xl px-5 pt-14 pb-14 sm:pt-20">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_20rem]">
        <div>
          <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">
            telc · Goethe · DTZ · A1–B2
          </p>
          <h1 class="mt-3 max-w-3xl font-display text-[2.25rem] font-semibold leading-[1.02] tracking-[-0.025em] sm:text-[3.5rem]">
            Your exam has a date.<br />Your German needs a plan.
          </h1>
          <p class="mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]">
            You can study every evening and still walk in unsure — because working hard isn't the
            same as working on what the exam actually tests. DeutschMeister shows you where you
            stand, trains exactly what your exam wants, and lets you rehearse the real thing
            before it counts.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="/level-test/" class={BTN_PRIMARY}>Find your level — free</a>
            <a href="#exams" class={BTN_SECONDARY}>Pick your exam</a>
          </div>
          <p class="mt-5 font-data text-[0.8125rem] text-graphite">
            {FREE_LEVEL_LABEL} free, no account · {TRIAL_DAYS}-day Pro trial · cancel anytime
          </p>
        </div>

        <!-- Reserved hero art slot (docs/design/higgsfield-art-specs.md).
             Until the artwork lands: a clay composition from the system's own
             shapes — siegel + accents only, no case colours (rule 1). -->
        <div data-art-slot="hero" class="relative hidden h-72 lg:block" aria-hidden="true">
          <div class="absolute left-6 top-4 h-40 w-40 rounded-clay bg-siegel shadow-raise-siegel motion-safe:animate-float"></div>
          <div class="absolute right-2 top-16 h-24 w-24 rounded-clay bg-accent-himbeer shadow-raise-himbeer motion-safe:animate-float [animation-delay:0.8s]"></div>
          <div class="absolute bottom-2 left-0 h-20 w-20 rounded-clay bg-accent-aprikose shadow-raise-aprikose motion-safe:animate-float [animation-delay:1.6s]"></div>
          <div class="absolute bottom-8 right-10 h-14 w-14 rounded-full bg-gold shadow-raise motion-safe:animate-float [animation-delay:2.4s]"></div>
          <div class="absolute left-24 top-28 flex h-28 w-44 rotate-3 items-center justify-center rounded-clay border border-rule bg-white shadow-raise-lg">
            <span class="font-display text-4xl font-bold text-siegel">Aa</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Exam picker: the micro-commitment -->
    <section id="exams" class="border-t border-rule bg-paper-sunk" aria-labelledby="exams-h">
      <div class="mx-auto max-w-5xl px-5 py-14">
        <h2 id="exams-h" class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
          Which exam is on your calendar?
        </h2>
        <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
          Each one tests different things — so each one gets its own preparation path.
        </p>
        <ul class="mt-7 grid gap-5 sm:grid-cols-2">
          {EXAM_TRACKS.map((track) => (
            <li>
              <a href={`/pruefung/${track.slug}/`} class={CLAY_LINK}>
                <span class="inline-block rounded-pill bg-siegel-wash px-2.5 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">{track.level}</span>
                <span class="mt-3 block font-display text-[1.25rem] font-semibold leading-snug">{track.nameDe}</span>
                <span class="mt-2 block text-[0.9375rem] leading-relaxed text-graphite">{TRACK_LINES[track.key]}</span>
                <span class="mt-4 inline-block text-sm font-bold text-siegel">See your path →</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-6 font-data text-[0.8125rem] text-graphite">
          No exam date? <a href="/grammar/a1.1/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">Start {FREE_LEVEL_LABEL} free</a> — no account needed.
        </p>
      </div>
    </section>

    <!-- The plan: pain → path -->
    <section class="mx-auto max-w-5xl px-5 py-16" aria-labelledby="plan-h">
      <h2 id="plan-h" class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
        Four steps between today and exam day
      </h2>
      <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
        Not more studying — the right studying, in the right order.
      </p>
      <ol class="mt-8 grid gap-5 sm:grid-cols-2">
        {STEPS.map((s) => (
          <li class="relative rounded-clay border border-rule bg-white p-6 shadow-raise">
            <span class={`absolute -top-4 left-6 flex h-9 w-9 items-center justify-center rounded-pill ${s.accent} font-data text-sm font-bold text-white shadow-raise`} aria-hidden="true">{s.n}</span>
            <h3 class="mt-3 font-display text-[1.125rem] font-semibold">{s.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">{s.body}</p>
            <a href={s.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-siegel transition-colors hover:text-siegel-deep">
              {s.linkLabel} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- The unique weapon: grammar you can see -->
    <section class="border-t border-rule" aria-labelledby="xray-h">
      <div class="mx-auto max-w-5xl px-5 py-16">
        <h2 id="xray-h" class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
          The part everyone fails to memorise, you'll <em class="not-italic underline decoration-siegel decoration-4 underline-offset-4">see</em>
        </h2>
        <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
          German cases are the exam's favourite trap — and the hardest thing to learn from tables.
          So DeutschMeister colours them. Every sentence, in every lesson, taken apart like this:
        </p>
        <!-- Rule 1: the only case colour on this page. -->
        <figure class="mt-8">
          <div class="flex flex-wrap items-stretch gap-2.5">
            {SENTENCE.map((w) => (
              <span class={`rounded-md border px-3 py-2.5 ${w.kasus ? KASUS_CLASS[w.kasus] : 'border-rule bg-paper-sunk text-graphite'}`}>
                <span class="block text-[1.0625rem] font-semibold leading-none">{w.text}</span>
                <span class="mt-1.5 block font-data text-[0.6875rem] font-bold tracking-[0.13em]">{w.abbr}</span>
                <span class="mt-1 block text-[0.75rem] leading-tight opacity-80">{w.role}</span>
                <span class="mt-0.5 block text-[0.75rem] italic leading-tight opacity-70">{w.gloss}</span>
              </span>
            ))}
          </div>
          <figcaption class="mt-3 font-data text-[0.8125rem] text-graphite">
            One sentence, four jobs. Colour marks the case — here and in every lesson.
          </figcaption>
        </figure>
        <p class="mt-6">
          <a href="/analyze/" class="inline-flex items-center gap-1.5 text-sm font-bold text-siegel transition-colors hover:text-siegel-deep">
            Try it on your own sentence <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <!-- What is actually in it -->
    <section class="border-y border-rule bg-paper-sunk" aria-labelledby="counts-h">
      <div class="mx-auto max-w-5xl px-5 py-10">
        <h2 id="counts-h" class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">What you train with</h2>
        <dl class="mt-5 grid grid-cols-2 gap-6 sm:grid-cols-4">
          {COUNTS.map((c) => (
            <div>
              <dt class="sr-only">{c.label}</dt>
              <dd>
                <span class="block font-display text-[2.125rem] font-semibold leading-none tracking-[-0.018em]">{c.value}</span>
                <span class="mt-2 block text-[0.8125rem] leading-snug text-graphite">{c.label}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- The three tools you can press right now -->
    <section aria-labelledby="tools-h">
      <div class="mx-auto max-w-5xl px-5 py-16">
        <h2 id="tools-h" class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
          Three things you can try before signing up
        </h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-3">
          {TOOLS.map((t) => (
            <a href={t.href} class={`${CLAY_LINK} flex flex-col`}>
              <h3 class="font-display text-[1.125rem] font-semibold">{t.name}</h3>
              <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-graphite">{t.body}</p>
              <dl class="mt-4 border-t border-rule pt-3 font-data text-[0.8125rem]">
                <div class="flex justify-between gap-3 py-0.5">
                  <dt class="text-graphite">Free</dt><dd class="text-right text-ink">{t.free}</dd>
                </div>
                <div class="flex justify-between gap-3 py-0.5">
                  <dt class="text-graphite">Pro</dt><dd class="text-right text-ink">{t.pro}</dd>
                </div>
              </dl>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-siegel">
                Open it <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- How it compares — reference material, so it stays flat (rule 3) -->
    <section class="border-t border-rule" aria-labelledby="cmp-h">
      <div class="mx-auto max-w-5xl px-5 py-16">
        <h2 id="cmp-h" class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
          Next to the alternatives
        </h2>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[38rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-ink">
                <th scope="col" class="py-3 pr-4 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">&nbsp;</th>
                <th scope="col" class="bg-siegel-wash px-4 py-3 font-display text-base font-semibold">DeutschMeister</th>
                <th scope="col" class="px-4 py-3 text-[0.9375rem] font-normal text-graphite">Group class</th>
                <th scope="col" class="px-4 py-3 text-[0.9375rem] font-normal text-graphite">Private tutor</th>
                <th scope="col" class="px-4 py-3 text-[0.9375rem] font-normal text-graphite">Grammar apps</th>
              </tr>
            </thead>
            <tbody>
              {CMP.map((row) => (
                <tr class="border-b border-rule">
                  <th scope="row" class="py-3.5 pr-4 text-sm font-normal text-graphite">{row.feature}</th>
                  <td class="bg-siegel-wash px-4 py-3.5 font-data text-[0.8125rem] font-semibold text-ink">{row.us}</td>
                  <td class="px-4 py-3.5 font-data text-[0.8125rem] text-graphite">{row.group}</td>
                  <td class="px-4 py-3.5 font-data text-[0.8125rem] text-graphite">{row.tutor}</td>
                  <td class="px-4 py-3.5 font-data text-[0.8125rem] text-graphite">{row.apps}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 font-data text-[0.8125rem] text-graphite">
          <a href="/vergleich/" class="text-siegel transition-colors hover:text-siegel-deep">Detailed comparisons against Babbel, Duolingo and Lingoda →</a>
        </p>
      </div>
    </section>

    <!-- Close: the loss, then the door -->
    <section class="border-t border-rule bg-paper-sunk" aria-labelledby="close-h">
      <div class="mx-auto max-w-5xl px-5 py-16">
        <h2 id="close-h" class="max-w-2xl font-display text-[1.75rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.25rem]">
          The exam date doesn't move. The guessing can stop today.
        </h2>
        <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
          Twenty minutes from now you can know your level and your next lesson.
          {FREE_LEVEL_LABEL} is free with no account; the other {LEVEL_COUNT - 1} levels are
          {monthlyPriceLine()}.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/level-test/" class={BTN_PRIMARY}>Find your level — free</a>
          <a href="/pricing/" class={BTN_SECONDARY}>See what Pro costs</a>
        </div>
        <p class="mt-10 border-t border-rule pt-6 text-[0.9375rem] text-graphite">
          There are German lessons on our
          <a href="https://www.youtube.com/@deutschmeister_de" target="_blank" rel="noopener noreferrer" class="font-bold text-siegel transition-colors hover:text-siegel-deep">YouTube channel</a>
          too — grammar, vocabulary and real conversations.
        </p>
      </div>
    </section>

  </div>
</Layout>
