---
// Homepage v4 — "Die Linie · Deutsch, in Bewegung" (2026-10-04).
// docs/redesign-2026-10/ holds the strategy, the three art directions, the copy
// deck, the event map and the review guide.
//
// WHAT CHANGED AND WHY. v3 sold an exam ("Your exam has a date") with the level
// test as its main button and Pro in its closing line — but the owner decided
// on 2026-09-03 that one-time level courses are the product, and the exam
// levels most visitors name (B1) are not buyable yet. v4 sells what exists:
// the CEFR ladder as a transit line, A1.1 the free first stop, each buyable
// level a one-time ticket, B1/B2 honestly "Im Bau" with a route to what exists
// today. The visitor who knows their level buys in one click from the line; the
// unsure one answers one question; nobody has to take a test to buy.
//
// SECTION ORDER (question → belief → evidence → action):
//   hero        "What is this, is it for me?" → the line + a free first stop
//   first stop  "Does it work?" → three real Lektion 1 items, real checker
//   fit         "Which one is mine?" → one answer, one stop (CSS-only)
//   the line    "What does it cost?" → every station, price, Buy / Start free
//   ticket      "What exactly do I get?" → each line removes an obstacle
//   the ride    "What happens after I pay?" → checkout → access → day 1 → test
//   proof       "Why believe it?" → counted content, checker rules, sources
//   FAQ         "What could go wrong?" → access, Pro window, limits, cancel
//   final call  one more door, no pressure
//
// CLAIMS. Every figure derives from ../data/*.js (pricing, marketing, offers,
// courseContents). No testimonials, learner counts, scarcity or countdowns.
// Colour means case (rule 1) — this page names no case, so it shows none.
// INVARIANTS: one <h1>; canonical; real server-rendered text; prerendered SPA
// routes linked with a trailing slash, /signup and /course/* without.
import { ORGANIZATION_FULL } from '../data/organization.js';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import CourseCheckout from '../components/CourseCheckout.astro';
import HeroLine from '../components/linie/HeroLine.astro';
import FirstStop from '../components/linie/FirstStop.astro';
import FitChooser from '../components/linie/FitChooser.astro';
import LineSection from '../components/linie/LineSection.astro';
import Ticket from '../components/linie/Ticket.astro';
import Progression from '../components/linie/Progression.astro';
import Proof from '../components/linie/Proof.astro';
import OfferFaq from '../components/linie/OfferFaq.astro';
import { fontPreloads, signFontPreloads } from '../data/design-tokens.js';
import { COURSE_PRO_MONTHS, COURSE_FROM_PRICE_EUR, eur } from '../data/pricing.js';
import { LEVEL_COUNT } from '../data/marketing.js';
import { OFFER_FAQ, STATIONS } from '../data/offers.js';
import { HERO_VARIANTS, ACTIVE_HERO } from '../data/homepage.js';

const hero = HERO_VARIANTS[ACTIVE_HERO];
const lead = hero.lead.replace('{proMonths}', String(COURSE_PRO_MONTHS));

// 55 chars — the built-HTML check warns above 60 (Google truncates).
const title = 'Learn German A1–B2, One Stop at a Time | DeutschMeister';
const description = `German from A1.1 to B2.2 on one line: start A1.1 free with no account, then buy the level you’re at once (from ${eur(COURSE_FROM_PRICE_EUR)}) and keep it. Exam routes for telc, Goethe and DTZ.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DeutschMeister',
    url: 'https://deutsch-meister.de/',
    description: `German courses for English speakers on the CEFR ladder, A1.1 to B2.2: a free first level, then one-time level courses with guided plans, AI speaking and writing practice, and exam routes for telc, Goethe and DTZ.`,
    inLanguage: ['en', 'de'],
  },
  { '@context': 'https://schema.org', ...ORGANIZATION_FULL },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: OFFER_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

// The hero is the page's largest paint: the sign face (Archivo) and the body
// face (Nunito Sans) are preloaded; Fraunces is not used above the fold here.
const preloads = [...signFontPreloads, ...fontPreloads.filter((f) => f.includes('nunito'))];
const firstTicket = STATIONS.find((s) => s.status === 'ticket');
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/" jsonLd={jsonLd} tone="nacht" preloads={preloads}>
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- ═══ HERO: the line, and the first stop you can ride right now ═══ -->
    <section class="relative isolate overflow-hidden bg-nacht text-nacht-text" data-ground="nacht" aria-labelledby="hero-h" data-hero-variant={hero.id}>
      <HeroLine />
      <div class="relative mx-auto grid max-w-7xl items-start gap-12 px-4 pb-16 pt-10 sm:px-6 sm:pt-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:px-8 lg:pb-[19rem] lg:pt-16">
        <div class="min-w-0">
          <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-linie">{hero.eyebrow}</p>
          <h1 id="hero-h" class="sign-display mt-5 text-[clamp(2.75rem,11.4vw,5.75rem)]">
            {hero.lines.map((line) => (
              <span class="block whitespace-nowrap">
                {line.map((part) => (
                  part.de
                    ? <span lang="de" class:list={[part.mark && 'text-linie']}>{part.t}</span>
                    : part.t
                ))}
              </span>
            ))}
          </h1>
          <p class="mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-nacht-muted sm:text-[1.1875rem]">{lead}</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/course/a1.1" class="dm-key dm-key-linie" data-anon-only data-track="course_selected" data-track-level="a1.1" data-track-surface="hero">Start A1.1 free</a>
            <a href="/dashboard" class="dm-key dm-key-linie" data-auth-only style="display:none">Continue learning →</a>
            <a href="#line" class="dm-key dm-key-ghost-nacht" data-track="course_selected" data-track-surface="hero_line">I know my level</a>
          </div>
          <p class="mt-5 text-[0.875rem] leading-relaxed text-nacht-muted">
            A1.1 needs no account.
            Not sure where you are? <a href="#fit" class="dm-link-nacht font-semibold">Find your stop</a> or take the <a href="/level-test/" class="dm-link-nacht font-semibold">20-minute level test</a>.
          </p>
          <!-- Phone: the line, flat, under the copy (the 3D plane is desktop-only). -->
          <ol class="mt-10 flex items-center justify-between lg:hidden" aria-label={`The line: ${LEVEL_COUNT} levels`}>
            {STATIONS.map((st, i) => (
              <li class="relative flex flex-1 flex-col items-center">
                {i > 0 && <span class:list={['absolute right-1/2 top-[0.6875rem] h-1.5 w-full', st.status === 'building' ? 'bg-nacht-rule' : 'bg-linie']} aria-hidden="true"></span>}
                <span class:list={['relative z-10 block h-[1.375rem] w-[1.375rem] rounded-full border-4', st.status === 'building' ? 'border-nacht-rule bg-nacht' : 'border-linie', st.status === 'free' ? 'bg-linie' : 'bg-nacht']} aria-hidden="true"></span>
                <span class="sign-code mt-1.5 text-[0.75rem] text-nacht-text">{st.code}</span>
              </li>
            ))}
          </ol>
        </div>
        <FirstStop />
      </div>
    </section>

    <FitChooser />

    <LineSection />

    <!-- ═══ THE TICKET: what one payment carries ═══ -->
    <section id="ticket" class="dm-defer bg-paper" aria-labelledby="ticket-h">
      <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-14">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">One ticket, one payment</p>
            <h2 id="ticket-h" class="sign-head mt-3 text-[clamp(2.125rem,5.2vw,3.5rem)]">
              <span class="block">Pay once.</span>
              <span class="block">Keep the level.</span>
            </h2>
            <p class="mt-5 max-w-md text-[1.0625rem] leading-relaxed text-graphite">
              A level ticket is the whole stop: a guided plan from day one to the final test, the practice that goes with it, and {COURSE_PRO_MONTHS} months of Pro so you can speak and write from the start. Nothing renews.
            </p>
            <p class="mt-4 max-w-md text-[0.9375rem] leading-relaxed text-graphite">
              Would you rather rent the whole line month by month? <a href="/pricing/#pro" class="dm-link">See Pro</a>.
            </p>
          </div>
          <Ticket surface="ticket" defaultLevel={firstTicket ? firstTicket.level : 'a1.2'} headingLevel={3} />
        </div>
      </div>
    </section>

    <Progression />

    <Proof />

    <OfferFaq />

    <!-- ═══ FINAL CALL: one more door, no pressure ═══ -->
    <section class="dm-defer relative overflow-hidden bg-nacht text-nacht-text" data-ground="nacht" aria-labelledby="close-h">
      <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <h2 id="close-h" class="sign-display text-[clamp(2.5rem,8vw,5rem)]">
          <span class="block">Your next stop is</span>
          <span class="block text-linie">one click away.</span>
        </h2>
        <p class="mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-nacht-muted">
          Start with the free first stop, or go straight to the stop you’re at. Either way, your progress is saved from the first answer.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/course/a1.1" class="dm-key dm-key-linie" data-anon-only data-track="course_selected" data-track-level="a1.1" data-track-surface="close">Start A1.1 free</a>
          <a href="/dashboard" class="dm-key dm-key-linie" data-auth-only style="display:none">Continue learning →</a>
          <a href="#line" class="dm-key dm-key-ghost-nacht">Choose my stop</a>
        </div>
      </div>
    </section>

  </div>
  <CourseCheckout />
</Layout>
