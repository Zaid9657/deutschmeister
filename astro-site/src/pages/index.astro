---
import Layout from '../layouts/Layout.astro';
import { ORGANIZATION_FULL } from '../data/organization.js';
import Scene from '../components/concept/Scene.astro';
import Benefits from '../components/concept/Benefits.astro';
import ProofCounts from '../components/concept/ProofCounts.astro';
import RouteBand from '../components/concept/RouteBand.astro';
import Offers from '../components/concept/Offers.astro';
import FirstStop from '../components/linie/FirstStop.astro';
import CourseCheckout from '../components/CourseCheckout.astro';
import '../styles/global.css';
const HOME_SIGNUP_HREF = '/signup?ref=home&utm_medium=onsite&utm_content=hero';
const title = 'Learn German for Real Life | DeutschMeister';
const description = 'You want to learn German. Where do you start? Try the free A1.1 course, then build your German with practical lessons for everyday life in Germany.';
const scenes = [
  { name: 'scene-cafe', category: 'Everyday life', title: 'Order a coffee in German', body: 'Learn the key phrases to order drinks, ask about options, and pay with confidence.', href: '/course/a1.1', alt: 'A learner ordering a coffee from a barista' },
  { name: 'scene-work', category: 'At work', title: 'Ask for something at work', body: 'Learn to make polite requests, clarify details, and communicate in a professional setting.', href: '/courses/a1-2/', alt: 'A learner talking with a colleague at work' },
  { name: 'scene-doctor', category: 'Health & wellbeing', title: 'Explain what hurts at the doctor', body: 'Learn the essential phrases to describe your symptoms, answer questions, and understand what’s next.', href: '/courses/a1-2/#lesson-preview', alt: 'A learner explaining her symptoms to a doctor' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'DeutschMeister', url: 'https://deutsch-meister.de/', description, inLanguage: ['en', 'de'] },
  { '@context': 'https://schema.org', ...ORGANIZATION_FULL },
];
---
<Layout title={title} description={description} canonical="https://deutsch-meister.de/" jsonLd={jsonLd}>
  <div class="c4-home">
    <section class="c4-home-hero c4-wrap" aria-labelledby="hero-h">
      <div class="c4-home-art" data-c4-parallax><Scene name="hero" alt="A woman learning German at her laptop with a view of Berlin" hero sizes="(max-width: 640px) 100vw, 850px" /></div>
      <div class="c4-home-copy">
        <h1 id="hero-h">You want to learn German.<br /><span class="c4-underline">Where do you start?</span></h1>
        <p>Practical, real-life German for everyday situations — from your first conversation to work, health, and life in Germany.</p>
        <a href="/course/a1.1" class="c4-button c4-button-coral" data-anon-only data-track="course_selected" data-track-level="a1.1" data-track-surface="hero">Start A1.1 free <span aria-hidden="true">→</span></a>
        <a href="/course/a1.1" class="c4-button c4-button-coral" data-auth-only data-continue-course style="display:none">Continue learning →</a>
      </div>
      <FirstStop />
    </section>
    <Benefits />
    <section class="c4-wrap c4-scenes" id="how-it-works" aria-label="German for the situations you live" data-track-view="offer">
      {scenes.map((scene) => <article class="c4-scene-row" data-c4-reveal>
        <Scene name={scene.name} alt={scene.alt} sizes="(max-width: 640px) 48vw, 680px" />
        <div><p class="c4-eyebrow">{scene.category}</p><h2>{scene.title}</h2><p>{scene.body}</p><a href={scene.href} class="c4-text-link"><span class="c4-play" aria-hidden="true">▷</span> {scene.name === 'scene-cafe' ? 'Try the lesson' : 'Explore the lesson'} <span aria-hidden="true">→</span></a></div>
      </article>)}
    </section>
    <section class="c4-wrap c4-home-path" aria-labelledby="path-h">
      <div><h2 id="path-h">A clear path from<br /><span>A1.1 to B2.2</span></h2><p>Build your German step by step — from your first words (A1.1) to confident communication in everyday life, work, and study (B2.2).</p></div>
      <RouteBand />
    </section>
    <div class="c4-wrap"><ProofCounts /></div>
    <section class="c4-wrap c4-home-offers" aria-labelledby="goals-h">
      <div><h2 id="goals-h">Choose what<br />fits your goals</h2><p>High-quality German learning, with a simple and flexible setup.</p><a href={HOME_SIGNUP_HREF} class="c4-text-link" data-anon-only>Create a free account →</a></div>
      <Offers />
    </section>
    <CourseCheckout />
  </div>
</Layout>
