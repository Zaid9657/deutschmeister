---
// Pass 2 · real-life German. The hero uses an explicitly labelled curriculum
// preview; the working FirstStop exercise follows in its own section. Prices,
// account doors, checkout attributes and anonymous access retain their sources.
import { ORGANIZATION_FULL } from '../data/organization.js';
import Layout from '../layouts/Layout.astro';
// The hero's account door, attributed like the other on-site doors
// (lib/onsiteLinks.js): ref = the surface, utm_medium = onsite.
const HOME_SIGNUP_HREF = '/signup?ref=home&utm_medium=onsite&utm_content=hero';
import '../styles/global.css';
import CourseCheckout from '../components/CourseCheckout.astro';
import FirstStop from '../components/linie/FirstStop.astro';
import ProductWindow from '../components/proof/ProductWindow.astro';
import CourseProof from '../components/proof/CourseProof.astro';
import RecordedCorrection from '../components/linie/RecordedCorrection.astro';
import OfferFaq from '../components/linie/OfferFaq.astro';
import { curriculumFor } from '../data/curricula/index.js';
import { fontPreloads, signFontPreloads } from '../data/design-tokens.js';
import { COURSE_PRO_MONTHS, COURSE_FROM_PRICE_EUR, eur } from '../data/pricing.js';
import { OFFER_FAQ, STATIONS, FREE_COURSE_HREF } from '../data/offers.js';
import { HERO_VARIANTS, ACTIVE_HERO } from '../data/homepage.js';

const hero = HERO_VARIANTS[ACTIVE_HERO];
const lead = hero.lead.replace('{proMonths}', String(COURSE_PRO_MONTHS));

// 55 chars — the built-HTML check warns above 60 (Google truncates).
const title = 'German for Your Everyday Life | DeutschMeister';
const description = `German for everyday life: start A1.1 free with no account, then buy the level you’re at once (from ${eur(COURSE_FROM_PRICE_EUR)}) and keep it. Exam routes for telc, Goethe and DTZ.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DeutschMeister',
    url: 'https://deutsch-meister.de/',
    description: `German courses for English speakers across CEFR levels, A1.1 to B2.2: a free first level, then one-time level courses with guided plans, AI speaking and writing practice, and exam routes for telc, Goethe and DTZ.`,
    inLanguage: ['en', 'de'],
  },
  { '@context': 'https://schema.org', ...ORGANIZATION_FULL },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: OFFER_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

// The preview uses the editorial face too; preload all three visible faces.
const preloads = [...new Set([...signFontPreloads, ...fontPreloads])];

---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/" jsonLd={jsonLd} preloads={preloads}>
  <div class="dm-home overflow-x-clip bg-paper text-ink">
    <section class="dm-hero dm-home-hero" aria-labelledby="hero-h" data-hero-variant={hero.id}>
      <div class="dm-hero-grid">
        <div class="dm-hero-copy">
          <p class="dm-kicker">{hero.eyebrow}</p>
          <h1 id="hero-h" class="dm-hero-title mt-5">{hero.lines.map((line) => <span class="block">{line.map((part) => part.mark ? <em>{part.t}</em> : part.t)}</span>)}</h1>
          <p class="dm-hero-lead mt-6">{lead}</p>
          <div class="dm-hero-actions mt-7 flex flex-wrap items-center gap-3">
            <a href="/course/a1.1" class="dm-key dm-key-siegel" data-anon-only data-track="course_selected" data-track-level="a1.1" data-track-surface="hero">Start A1.1 free <span aria-hidden="true">↗</span></a>
            <a href={FREE_COURSE_HREF} class="dm-key dm-key-siegel" data-auth-only data-continue-course style="display:none">Continue learning →</a>
            <a href={HOME_SIGNUP_HREF} class="dm-key dm-key-ghost" data-anon-only>Create a free account</a>
          </div>
          <p class="dm-hero-reassurance mt-4">No account. No card. Just your first German lesson.</p>
          <a href="/level-test/" class="dm-link mt-6 inline-block text-sm">Already know some German? Find your level →</a>
        </div>
        <div class="dm-hero-product"><span class="dm-example-note">A little preview of what you’ll do <span aria-hidden="true">↘</span></span><ProductWindow level="a1.1" /></div>
      </div>
      <div class="dm-route-strip" aria-label="Choose your learning route">
        <a href="/courses/"><span class="dm-route-number">01</span><span><strong>Build your everyday German</strong><small>Browse courses and see what’s available.</small></span><span aria-hidden="true">↗</span></a>
        <a href="/pruefung/"><span class="dm-route-number">02</span><span><strong>Work towards your exam</strong><small>Find relevant practice and a sourced exam guide.</small></span><span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="dm-scene dm-scene-peach" aria-labelledby="try-h" id="try">
      <div class="dm-section-grid">
        <div><p class="dm-kicker">01 / From reading to doing</p><h2 id="try-h" class="dm-section-title mt-4">Your German starts<br/>with a <em>hello.</em></h2><p class="dm-hero-lead mt-5">No long introduction. Try a real task from the free first lesson. Write an answer, check it, and see why it works.</p><a href="/course/a1.1" class="dm-link mt-6 inline-block">Keep going in the free course →</a></div>
        <FirstStop />
      </div>
    </section>

    <CourseProof level="a1.2" mode="writing" />
    <CourseProof level="a1.1" mode="speaking" />
    <RecordedCorrection />

    <section class="dm-scene dm-course-story" id="fit" aria-labelledby="course-story-h">
      <div class="dm-section-grid">
        <div><p class="dm-kicker">04 / A plan you can follow</p><h2 id="course-story-h" class="dm-section-title mt-4">A new language.<br/><em>A place to begin.</em></h2><p class="dm-hero-lead mt-5">Start with A1.1, then explore A1.2. Learn in everyday situations, with practice and review along the way. Complete guided courses follow in level order.</p><a class="dm-key dm-key-siegel mt-7" href="/courses/">Explore the courses ↗</a></div>
        <div class="dm-course-pair">{STATIONS.filter((s) => ['a1.1', 'a1.2'].includes(s.level)).map((s) => <a href={s.coursePage} class="dm-course-book"><span class="dm-kicker">{s.status === 'free' ? 'Your free beginning' : 'Your next chapter'}</span><span class="dm-book-code">{s.code}</span><strong lang="de">{curriculumFor(s.level).lektionen[0].title}</strong><span>{s.status === 'free' ? 'Free · no account' : `${s.priceLabel} · one payment`} <span aria-hidden="true">↗</span></span></a>)}<p class="text-sm text-graphite">B1 and B2 guided courses are Im Bau. The separate telc package is not on sale.</p></div>
      </div>
    </section>

    <section class="dm-scene dm-scene-lilac" aria-labelledby="own-h"><div class="dm-section-grid"><div><p class="dm-kicker">Your learning, your choice</p><h2 id="own-h" class="dm-section-title mt-4">Keep a level.<br/><em>Make it yours.</em></h2><p class="dm-hero-lead mt-5">Buy an available level once, from {eur(COURSE_FROM_PRICE_EUR)}. That level stays open, with {COURSE_PRO_MONTHS} months of Pro included. Or choose Pro for ongoing access to the practice library and AI tools.</p><a class="dm-link mt-6 inline-block" href="/pricing/">See prices and exactly what’s included →</a></div><ProductWindow level="a1.2" compact /></div></section>
    <OfferFaq />
    <section class="dm-closing" aria-labelledby="close-h"><div class="dm-closing-inner"><p class="dm-kicker">Make room for German</p><h2 id="close-h">Your next conversation<br/>starts with <em>one lesson.</em></h2><div class="mt-7 flex flex-wrap gap-3"><a href="/course/a1.1" class="dm-key dm-key-siegel" data-anon-only data-track="course_selected" data-track-level="a1.1" data-track-surface="close">Start A1.1 free ↗</a><a href={FREE_COURSE_HREF} class="dm-key dm-key-siegel" data-auth-only data-continue-course style="display:none">Continue learning →</a><a href="/courses/" class="dm-key dm-key-ghost">Find your course</a></div><p class="mt-4 text-sm text-graphite">Our ambition: your best place to learn German. Try it for yourself.</p></div></section>
  </div>
  <CourseCheckout />
</Layout>
