---
// Sales page for the telc B1 Komplettvorbereitung — the one-time course from
// docs/revenue-plan-2026-08-31.md, Lane 2. Reskinned 2026-09-01 onto the
// Playful Depth system (docs/design/playbook.md): aurora hero, the four weeks
// as numbered accent steps, the price as a 3D card with the one shimmer CTA.
//
// CLAIMS DISCIPLINE (binding, same as the guides):
//   - every figure derives from ../data/pricing.js / ../data/marketing.js;
//     tests/claims.test.mjs bans the price literals from this file
//   - no outcome promise ("bestehst du garantiert"), no telc exam fee, no
//     invented learner counts or testimonials — there are none yet, so none
//     appear. Real specifics only.
//   - no fabricated scarcity: launch pricing is an expiring Lemon Squeezy
//     discount code shown at checkout, never a fake struck-through price here.
//   - the market-anchor sentence ("mehrere hundert Euro") is deliberately
//     vendor-less and order-of-magnitude only. Basis, checked 2026-08-31:
//     DeutschAkademie telc-B1 Vorbereitungskurse €89–249, Sprachschule Aktiv
//     München 4-Wochen-Intensiv €499 (their own public course pages, via
//     search). Never name a vendor price here — §6-UWG territory and the
//     vendor domains are unverifiable from agent sessions.
//
// CHECKOUT: the CTA opens the Lemon Squeezy hosted checkout (merchant of
// record) only when PUBLIC_LEMONSQUEEZY_TELC_B1_VARIANT_ID is set at build
// time. Until the owner creates the product, the CTA degrades to the free
// funnel instead of a dead checkout. Guest checkout is supported — the webhook
// resolves the buyer by e-mail — hence the "gleiche E-Mail" note by the button.
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';
import '../styles/global.css';
import { ORGANIZATION } from '../lib/siteMeta.js';
import { COURSES, CURRENCY, num, deEur } from '../data/pricing.js';
import { GRAMMAR_TOPIC_COUNT, LEVEL_COUNT, TRIAL_DAYS } from '../data/marketing.js';

const course = COURSES.telc_b1_komplett;
const TOPICS_PER_LEVEL = GRAMMAR_TOPIC_COUNT / LEVEL_COUNT;
// The plan covers both B1 sub-levels of the library.
const B1_TOPIC_COUNT = TOPICS_PER_LEVEL * 2;
const PLAN_DAYS = 20; // 4 weeks × 5 study days — mirrors src/data/programs/telcB1Komplett.js

const variantId = import.meta.env.PUBLIC_LEMONSQUEEZY_TELC_B1_VARIANT_ID || '';
const checkoutUrl = variantId
  ? `https://deutsch-meister.lemonsqueezy.com/checkout/buy/${variantId}`
  : '';

const title = `telc B1 Komplettvorbereitung: 4-Wochen-Plan | DeutschMeister`;
const description = `Ein fester ${PLAN_DAYS}-Tage-Plan bis zur telc B1-Prüfung: jeden Tag eine Aufgabe aus Grammatik, Hören, Lesen und KI-Sprechtraining — mit ${course.proMonths} Monaten Pro-Zugang inklusive.`;
const canonical = 'https://deutsch-meister.de/telc-b1-komplettvorbereitung/';

const FAQS = [
  {
    q: 'Was ist der Unterschied zum Pro-Abo?',
    a: `Pro ist die Bibliothek: alle ${LEVEL_COUNT} Niveaustufen, alle ${GRAMMAR_TOPIC_COUNT} Grammatikthemen, Hören, Lesen, Sprechen — plus der telc B1 Übungstest und das KI-Schreibtraining. Der Kurs ist der Plan darüber: eine feste Reihenfolge von ${PLAN_DAYS} Tagesaufgaben, die auf die telc B1-Prüfung zuläuft — und ${course.proMonths} Monate Pro sind schon enthalten.`,
  },
  {
    q: 'Brauche ich zusätzlich ein Abo?',
    a: `Nein. Im Kurs stecken ${course.proMonths} Monate voller Pro-Zugang. Danach bleibt dir der Kursbereich mit deinem Plan und deinem Fortschritt dauerhaft erhalten; nur die Pro-Inhalte brauchen dann wieder ein Abo.`,
  },
  {
    q: 'Wie lange habe ich Zugriff?',
    a: `Auf den Kursbereich: dauerhaft, ohne Verlängerung und ohne Abo. Der enthaltene Pro-Zugang läuft ${course.proMonths} Monate ab Kauf — genug für den Plan und die Wochen bis zu deinem Prüfungstermin.`,
  },
  {
    q: 'Für wen ist der Kurs nichts?',
    a: `Wenn du noch am Anfang stehst (unter A2), ist der Plan zu früh für dich. Mach zuerst den kostenlosen Einstufungstest — er sagt dir ehrlich, wo du stehst, und A1.1 ist bei uns komplett gratis.`,
  },
  {
    q: 'Meldet mich der Kurs zur Prüfung an?',
    a: 'Nein. Die Anmeldung läuft über ein telc-Prüfungszentrum in deiner Nähe. Was in der Prüfung drankommt, wie sie bewertet wird und wie du dich anmeldest, steht in unserem kostenlosen telc B1-Leitfaden.',
  },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `DeutschMeister ${course.name}`,
  description,
  brand: { '@type': 'Brand', name: 'DeutschMeister' },
  offers: {
    '@type': 'Offer',
    name: course.name,
    price: num(course.price),
    priceCurrency: CURRENCY,
    url: canonical,
    availability: 'https://schema.org/InStock',
    seller: ORGANIZATION,
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const jsonLd = [productSchema, faqSchema];

// The four weeks as numbered steps — accent badges rotate (energy, never
// meaning: tokens rule 2).
const WEEKS = [
  { n: '1', accent: 'bg-accent-himbeer', name: 'Woche 1', focus: 'Das B1.1-Fundament: ein Grammatikthema pro Tag, dazu Hören und der erste Satz im Satz-Röntgen.' },
  { n: '2', accent: 'bg-accent-aprikose', name: 'Woche 2', focus: 'Die schwere Hälfte von B1.1 — und dein erstes Sprechtraining mit der KI, gegen die Sprechangst vor dem Prüfungstag.' },
  { n: '3', accent: 'bg-accent-limette', name: 'Woche 3', focus: 'B1.2: die Strukturen, auf die Prüfer achten. Konjunktiv, Nebensätze, Verbindungswörter.' },
  { n: '4', accent: 'bg-siegel', name: 'Woche 4', focus: 'Prüfungswoche: Format und Bewertung verstehen, unter Zeitdruck sprechen, die schwächsten Themen gezielt schließen.' },
];

const BTN =
  'inline-flex items-center justify-center gap-2 rounded-clay text-[0.9375rem] font-bold transition-all duration-100 ease-snap select-none';
const BTN_PRIMARY = `${BTN} bg-siegel px-6 py-3.5 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_SECONDARY = `${BTN} border border-rule bg-white px-6 py-3.5 text-ink shadow-raise hover:border-siegel hover:text-siegel-deep active:translate-y-1 active:shadow-none`;
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd} lang="de" ogType="product">
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- Hero: the person three weeks out, the pain, the plan -->
    <section class="relative">
      <Aurora />
      <div class="relative mx-auto max-w-3xl px-5 pt-14 pb-12 sm:pt-20">
        <p class="hero-line font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" style="--d:0ms">telc B1 · Komplettvorbereitung</p>
        <h1 class="hero-line mt-3 font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.022em] sm:text-[3rem]" style="--d:80ms">
          Du weißt, dass du üben musst.<br />Der Plan sagt dir, was.
        </h1>
        <p class="hero-line mt-5 text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" style="--d:200ms">
          Die meisten fallen nicht durch, weil ihnen Grammatik fehlt. Sie fallen durch, weil sie drei
          Wochen vor der Prüfung irgendwas üben — und am Prüfungstag genau das fehlt, was drankommt.
          Die Komplettvorbereitung ist ein fester {PLAN_DAYS}-Tage-Plan: jeden Tag eine Aufgabe,
          in der Reihenfolge, die zur telc B1-Prüfung führt.
        </p>

        <div class="hero-line mt-8 flex flex-wrap items-center gap-4" style="--d:320ms">
          {checkoutUrl ? (
            <a href={checkoutUrl} class={`${BTN_PRIMARY} btn-shimmer relative overflow-hidden`} data-checkout="telc-b1-komplett">
              <span class="relative z-10">Ja, ich will den Plan — {deEur(course.price)} einmalig</span>
            </a>
          ) : (
            <a href="/signup" class={`${BTN_PRIMARY} btn-shimmer relative overflow-hidden`}>
              <span class="relative z-10">Der Kurs startet in Kürze — Gratis-Konto sichern</span>
            </a>
          )}
          <a href="/leitfaden/telc-b1/" class={BTN_SECONDARY}>
            Erst den kostenlosen Leitfaden lesen
          </a>
        </div>
        {checkoutUrl && (
          <p class="hero-line mt-4 font-data text-[0.75rem] text-graphite" style="--d:420ms">
            Einmalzahlung · kein Abo · {course.proMonths} Monate Pro-Zugang inklusive · beim Kauf die E-Mail deines
            DeutschMeister-Kontos verwenden (oder danach eins mit derselben E-Mail anlegen)
          </p>
        )}
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-5 pb-20">

      <!-- The four weeks -->
      <section class="border-t border-rule py-12">
        <h2 class="reveal font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2rem]">Vier Wochen, ein Weg</h2>
        <p class="reveal mt-3 leading-relaxed text-graphite" style="--rd:80ms">
          {PLAN_DAYS} Tagesaufgaben über die komplette DeutschMeister-Bibliothek: {B1_TOPIC_COUNT} Grammatik-Lektionen
          auf B1-Niveau, Hör- und Lesetraining mit Muttersprachler-Dialogen, Satz-Röntgen und KI-Sprechtraining —
          jede Aufgabe abhakbar, dein Fortschritt bleibt gespeichert.
        </p>
        <ol class="mt-10 grid gap-8 sm:grid-cols-2 sm:gap-5">
          {WEEKS.map((w, i) => (
            <li class="reveal relative rounded-clay border border-rule bg-white p-6 shadow-raise" style={`--rd:${i * 100}ms`}>
              <span class={`absolute -top-4 left-6 flex h-9 w-9 items-center justify-center rounded-pill ${w.accent} font-data text-sm font-bold text-white shadow-raise`} aria-hidden="true">{w.n}</span>
              <p class="mt-3 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">{w.name}</p>
              <p class="mt-2 leading-relaxed text-ink">{w.focus}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Who built it -->
      <section class="border-t border-rule py-12">
        <div class="reveal rounded-clay border border-rule bg-paper-sunk p-6 sm:p-8">
          <h2 class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2rem]">Von jemandem, der es selbst musste</h2>
          <p class="mt-3 leading-relaxed text-graphite">
            DeutschMeister wurde von einem Arzt in Deutschland gebaut, der selbst Sprachprüfungen bestehen
            musste. Die Plattform ist kein Spiel — sie ist ein Werkzeug für Leute, die eine Prüfung bestehen
            müssen. Der Kurs ist die Reihenfolge, die er sich damals selbst gewünscht hätte.
          </p>
        </div>
      </section>

      <!-- Price: the one 3D card on the page, with the one shimmer CTA -->
      <section class="border-t border-rule py-12">
        <h2 class="reveal font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2rem]">Was er kostet</h2>
        <p class="reveal mt-3 leading-relaxed text-graphite" style="--rd:80ms">
          Präsenz-Vorbereitungskurse kosten üblicherweise mehrere hundert Euro — und richten sich nach dem
          Stundenplan der Sprachschule, nicht nach deinem.
        </p>
        <div class="reveal mt-8" style="--rd:160ms">
          <div class="atropos" data-atropos-card>
            <div class="atropos-scale"><div class="atropos-rotate"><div class="atropos-inner !overflow-visible">
              <div class="rounded-clay border border-rule bg-white p-6 shadow-raise-siegel sm:p-8">
                <p class="font-display text-[2.5rem] font-semibold leading-none tracking-[-0.02em]" data-atropos-offset="5">{deEur(course.price)}</p>
                <p class="mt-2 font-data text-[0.75rem] uppercase tracking-[0.13em] text-graphite" data-atropos-offset="4">einmalig · kein Abo · keine Verlängerung</p>
                <ul class="mt-5 space-y-2.5 text-[0.9375rem] leading-relaxed" data-atropos-offset="2">
                  <li class="flex gap-2.5"><span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-pill bg-accent-limette-wash font-data text-[0.6875rem] font-bold text-accent-limette-ink" aria-hidden="true">✓</span><span>Der komplette {PLAN_DAYS}-Tage-Plan mit Fortschritts-Checkliste — dauerhaft deiner</span></li>
                  <li class="flex gap-2.5"><span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-pill bg-accent-limette-wash font-data text-[0.6875rem] font-bold text-accent-limette-ink" aria-hidden="true">✓</span><span>{course.proMonths} Monate voller Pro-Zugang: alle {GRAMMAR_TOPIC_COUNT} Grammatikthemen, Hören, Lesen, KI-Sprechen, Satz-Röntgen</span></li>
                  <li class="flex gap-2.5"><span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-pill bg-accent-limette-wash font-data text-[0.6875rem] font-bold text-accent-limette-ink" aria-hidden="true">✓</span><span>Der telc B1 Übungstest mit Zeitlimit und Auswertung — und das KI-Schreibtraining nach den Prüfungskriterien (im Pro-Zugang enthalten)</span></li>
                  <li class="flex gap-2.5"><span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-pill bg-accent-limette-wash font-data text-[0.6875rem] font-bold text-accent-limette-ink" aria-hidden="true">✓</span><span>Prüfungswoche mit Format, Bewertung und Selbsttest</span></li>
                </ul>
                {checkoutUrl && (
                  <a href={checkoutUrl} class={`${BTN_PRIMARY} mt-7`} data-checkout="telc-b1-komplett" data-atropos-offset="6">
                    Ja, ich will den Plan — {deEur(course.price)}
                  </a>
                )}
              </div>
            </div></div></div>
          </div>
        </div>
        <p class="reveal mt-5 text-[0.875rem] leading-relaxed text-graphite" style="--rd:220ms">
          Noch unsicher, wo du stehst? Der <a href="/level-test/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">Einstufungstest ist kostenlos</a> —
          und ein Konto bringt dir {TRIAL_DAYS} Tage Pro zum Ausprobieren, bevor du irgendetwas kaufst.
        </p>
      </section>

      <!-- FAQ -->
      <section class="border-t border-rule py-12">
        <h2 class="reveal font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2rem]">Ehrliche Antworten</h2>
        <dl class="mt-6 space-y-4">
          {FAQS.map(({ q, a }, i) => (
            <div class="reveal rounded-clay border border-rule bg-white p-5" style={`--rd:${i * 70}ms`}>
              <dt class="font-semibold text-ink">{q}</dt>
              <dd class="mt-2 leading-relaxed text-graphite">{a}</dd>
            </div>
          ))}
        </dl>
        <p class="reveal mt-8 text-[0.875rem] leading-relaxed text-graphite">
          Alles zur Prüfung selbst — Teile, Dauer, Bewertung, Anmeldung — steht im kostenlosen
          <a href="/leitfaden/telc-b1/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">telc B1-Leitfaden</a>.
        </p>
      </section>

    </div>
  </div>
</Layout>
