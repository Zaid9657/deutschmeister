---
// Course activities are read from the implemented programme, never a second syllabus.
// Owner-only release: keep telcPilotVariant() as the sole sale gate. Before opening,
// the owner must reconcile the catalogue price with checkout and approve the release.
import Layout from '../layouts/Layout.astro';
import LanguageNotice from '../components/LanguageNotice.astro';
import CourseCheckout from '../components/CourseCheckout.astro';
import TelcWritingExample from '../components/TelcWritingExample.astro';
import '../styles/global.css';
import { ORGANIZATION } from '../lib/siteMeta.js';
import { telcPilotVariant } from '../lib/courseVariants.js';
import { onsiteHref } from '../lib/onsiteLinks.js';
import { COURSES, CURRENCY, PLANS, num, deEur } from '../data/pricing.js';
import { TRIAL_DAYS, TRIAL_WRITING_EVALUATIONS, TRIAL_SPEAKING_SESSIONS, PRO_INCLUDED_SESSION_MINUTES } from '../data/marketing.js';
import { fontPreloads, signFontPreloads } from '../data/design-tokens.js';
import { PROGRAM, allDays, SHORT_TEST_MINUTES } from '../../../src/data/programs/telcB1Komplett.js';

const course = COURSES.telc_b1_komplett;
const days = allDays();
const items = days.flatMap((day) => day.items);
const count = (type) => items.filter((item) => item.type === type).length;
const variantId = telcPilotVariant();
const signupHref = onsiteHref('signup', 'telc-pilot', 'telc-b1');
const title = `telc B1 Komplettvorbereitung: ${PROGRAM.weeks.length}-Wochen-Plan | DeutschMeister`;
const description = `${days.length} Trainingseinheiten: Briefe schreiben und überarbeiten, Gespräche proben und zwei Kurztests bearbeiten. Lernen Sie den telc-B1-Plan kennen und probieren Sie Pro kostenlos aus.`;
const canonical = 'https://deutsch-meister.de/telc-b1-komplettvorbereitung/';
const preloads = [...signFontPreloads, ...fontPreloads.filter((font) => font.includes('nunito'))];
const FAQS = [
  {
    q: 'Für wen ist der Plan gedacht?',
    a: 'Für Lernende mit Deutschkenntnissen ab A2, die gezielt für telc B1 üben möchten. Unter A2 ist der Plan zu früh. Beginnen Sie dann mit dem kostenlosen A1.1-Kurs oder nutzen Sie den Einstufungstest.',
  },
  {
    q: 'Was ist der Unterschied zwischen Pro und dem Kurs?',
    a: `Pro gibt Ihnen Zugang zu Lernmaterialien und KI-Werkzeugen mit den jeweiligen Nutzungslimits. Der Kurs ordnet Übungen in ${days.length} Trainingseinheiten und enthält ${course.proMonths} Monate Pro. Der kostenlose Pro-Test enthält den Kursplan nicht.`,
  },
  {
    q: 'Wie lange bleibt der Kurs zugänglich?',
    a: `Nach einem Kauf bleiben Ihnen der Kursbereich, Ihr Plan und Ihr Fortschritt dauerhaft erhalten. Der enthaltene Pro-Zugang läuft ${course.proMonths} Monate ab Kauf. Für Pro-Inhalte benötigen Sie anschließend wieder Pro.`,
  },
  {
    q: 'Bekomme ich Rückmeldung von einer Lehrkraft?',
    a: 'Das Schreib- und Sprechtraining arbeitet mit KI. Persönliche Korrekturen durch eine Lehrkraft werden hier nicht angeboten. KI-Bewertungen dienen der Orientierung beim Üben und sind keine offizielle Prüfungsbewertung.',
  },
  {
    q: 'Was passiert nach dem kostenlosen Test?',
    a: `Der Pro-Test endet nach ${TRIAL_DAYS} Tagen ohne automatische Abbuchung. Sie entscheiden selbst, ob Sie ein Abo abschließen. Pro monatlich kostet ${deEur(PLANS.monthly.price)} pro Monat. Der kostenlose A1.1-Kurs bleibt zugänglich.`,
  },
  {
    q: 'Meldet mich der Kurs zur Prüfung an?',
    a: 'Nein. Sie melden sich selbst bei einem Prüfungszentrum an. DeutschMeister stellt eigene Übungsmaterialien bereit; dies ist kein offizielles telc-Angebot. Ein Übungsergebnis kann Ihr Prüfungsergebnis nicht vorhersagen.',
  },
];
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `DeutschMeister ${course.name}`,
  description,
  brand: { '@type': 'Brand', name: 'DeutschMeister' },
  offers: {
    '@type': 'Offer', name: course.name, price: num(course.price), priceCurrency: CURRENCY,
    url: canonical, availability: 'https://schema.org/InStock', seller: ORGANIZATION,
  },
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const jsonLd = variantId ? [productSchema, faqSchema] : [faqSchema];
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd} lang="de" preloads={preloads}>
  <div class="bg-paper text-ink">
    <section class="border-b border-rule bg-nacht text-nacht-text" data-ground="nacht" aria-labelledby="telc-h">
      <div class="mx-auto max-w-5xl px-5 py-12 sm:py-20">
        <p class="font-data text-xs font-bold uppercase tracking-[0.13em] text-siegel-deep">telc B1 · Komplettvorbereitung</p>
        <h1 id="telc-h" class="sign-display mt-4 text-[clamp(2.5rem,7vw,4.75rem)]">Ihre Prüfung im Blick.<br />Ihre nächste Übung steht.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-nacht-muted">
          Schreiben. Überarbeiten. Sprechen. Wiederholen. Der Plan führt Sie durch {days.length} Trainingseinheiten:
          mit eigenen Briefen, KI-Rückmeldung, Gesprächsproben und Kurztests.
        </p>
        {!variantId && <p class="mt-5 font-bold" data-telc-availability>Der Kurs ist derzeit nicht buchbar</p>}
        <div class="mt-6 flex flex-wrap gap-3">
          {variantId ? (
            <button type="button" class="dm-key dm-key-siegel" data-course-variant={variantId} data-course-key={course.key} data-course-price={course.price} data-track-surface="telc_page">
              Kurs buchen — {deEur(course.price)} einmalig
            </button>
          ) : (
            <a href={signupHref} class="dm-key dm-key-siegel">{TRIAL_DAYS} Tage Pro kostenlos testen</a>
          )}
          <a href="#schreibbeispiel" class="dm-key dm-key-ghost-nacht">Ein Schreibbeispiel ansehen</a>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-nacht-muted">
          {variantId
            ? `Einmalzahlung · ${course.proMonths} Monate Pro inklusive`
            : 'Keine Kreditkarte · keine automatische Abbuchung. Der Kursplan ist nicht im Pro-Test enthalten.'}
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-5xl px-5">
      <section id="schreibbeispiel" class="scroll-mt-24 py-12 sm:py-16" aria-labelledby="example-h">
        <p class="font-data text-xs font-bold uppercase tracking-[0.13em] text-siegel-deep">Vom Entwurf zur Überarbeitung</p>
        <h2 id="example-h" class="sign-head mt-3 text-3xl sm:text-4xl">Ein Brief. Ein Hinweis. Ein klarer nächster Schritt.</h2>
        <TelcWritingExample />
      </section>

      <section class="border-y border-rule py-12 sm:py-16" aria-labelledby="try-h">
        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <p class="font-data text-xs font-bold uppercase tracking-[0.13em] text-siegel-deep">Selbst ausprobieren</p>
            <h2 id="try-h" class="sign-head mt-3 text-3xl sm:text-4xl">Jetzt sind Sie dran.</h2>
            <p class="mt-4 leading-relaxed text-graphite">Schreiben Sie einen eigenen Text oder proben Sie ein Gespräch. Im kostenlosen Pro-Test lernen Sie die KI-Werkzeuge kennen.</p>
            <p class="mt-4 leading-relaxed text-graphite">Der Kurs verbindet {count('writing')} Briefe mit je einer Überarbeitung, {count('speaking')} Sprechproben und {count('exam')} Kurztests. Hinzu kommen gezielte Übungen zu Ihren Lücken und Satz-Röntgen.</p>
            {variantId ? (
              <div class="mt-6 border-t border-rule pt-5">
                <p class="mt-2 text-sm text-graphite">Einmalig · {course.proMonths} Monate Pro inklusive</p>
                <button type="button" class="dm-key dm-key-siegel mt-4" data-course-variant={variantId} data-course-key={course.key} data-course-price={course.price} data-track-surface="telc_page_card">Kurs buchen — {deEur(course.price)}</button>
              </div>
            ) : (
              <p class="mt-6 border-t border-rule pt-5 font-semibold">Der Kurs ist derzeit nicht buchbar. Sehen Sie sich unten den Plan an.</p>
            )}
          </div>
          <div class="rounded-2xl border border-rule bg-white p-6 sm:p-8">
            <h3 class="sign-head text-2xl">{TRIAL_DAYS} Tage Pro kostenlos testen</h3>
            <ul class="mt-5 space-y-3 leading-relaxed text-graphite">
              <li><strong class="text-ink">{TRIAL_WRITING_EVALUATIONS} KI-Schreibbewertungen</strong> insgesamt im Test</li>
              <li><strong class="text-ink">{TRIAL_SPEAKING_SESSIONS} KI-Sprechübungen à {PRO_INCLUDED_SESSION_MINUTES} Minuten</strong> insgesamt im Test</li>
              <li>Keine Kreditkarte. Keine automatische Abbuchung.</li>
            </ul>
            <a href={signupHref} class="dm-key dm-key-siegel mt-6 w-full">Pro kostenlos ausprobieren</a>
            <p class="mt-4 text-sm leading-relaxed text-graphite">Der telc-B1-Kursplan ist nicht im Test enthalten. Danach entscheiden Sie selbst: Pro monatlich kostet {deEur(PLANS.monthly.price)} pro Monat, wenn Sie ein Abo abschließen.</p>
          </div>
        </div>
      </section>

      <section id="plan" class="scroll-mt-24 py-12 sm:py-16" aria-labelledby="plan-h">
        <p class="font-data text-xs font-bold uppercase tracking-[0.13em] text-siegel-deep">Der Kurs im Detail</p>
        <h2 id="plan-h" class="sign-head mt-3 text-3xl sm:text-4xl">{PROGRAM.weeks.length} Wochen. {days.length} Trainingseinheiten. Ihr Tempo.</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-graphite">Die Wochen geben die Reihenfolge vor. Die Kurztests benötigen jeweils {SHORT_TEST_MINUTES} Minuten am Stück; die übrigen Zeitangaben dienen Ihrer Planung.</p>
        <div class="mt-8 divide-y divide-rule border-y border-rule">
          {PROGRAM.weeks.map((week, index) => (
            <details class="py-5" open={index === 0}>
              <summary class="cursor-pointer py-2 sign-label text-xl">{week.title}</summary>
              <p class="mt-3 leading-relaxed text-graphite">{week.intro}</p>
              <ol class="mt-5 space-y-4">
                {week.days.map((day) => (
                  <li class="grid gap-2 rounded-xl border border-rule bg-white p-4 sm:grid-cols-[4rem_1fr_auto]" data-program-day={day.id}>
                    <span class="font-data text-sm font-bold text-siegel-deep">{day.label}</span>
                    <div>{day.items.map((item) => <p class="leading-relaxed">{item.title}</p>)}</div>
                    <span class="font-data text-sm text-graphite">{day.items.reduce((sum, item) => sum + item.minutes, 0)} Min.</span>
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      </section>

      <section class="border-t border-rule py-12 sm:py-16" aria-labelledby="faq-h">
        <h2 id="faq-h" class="sign-head text-3xl sm:text-4xl">Fragen vor dem Start.</h2>
        <div class="mt-6 divide-y divide-rule">
          {FAQS.map(({ q, a }) => (
            <details class="py-4">
              <summary class="cursor-pointer py-2 font-semibold">{q}</summary>
              <p class="mt-2 max-w-prose leading-relaxed text-graphite">{a}</p>
            </details>
          ))}
        </div>
        <a href="/leitfaden/telc-b1/" class="dm-link mt-6 inline-block">Den kostenlosen telc-B1-Leitfaden lesen →</a>
        <div class="mt-8"><LanguageNotice noun="course page" /></div>
      </section>
    </div>
  </div>
  <CourseCheckout />
</Layout>
