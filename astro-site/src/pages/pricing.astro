---
// Pricing — v4 "Die Linie" (2026-10-04; docs/redesign-2026-10/).
//
// THE THESIS. There are exactly two ways to pay, and a visitor should see the
// fork before anything else: OWN a level (one payment, yours for good, with
// the Pro tools on board for the first months) or RENT the whole line (Pro,
// monthly or yearly). A1.1 costs nothing. Until v4 the page led with a
// three-column Pro table and put the one-time courses — the product, by the
// owner's decision of 2026-09-03 — below the fold.
//
// INVARIANTS CARRIED OVER (do not regress):
//   - every figure derives from ../data/pricing.js, marketing.js and offers.js;
//     tests/claims.test.mjs fails if a price literal reappears here
//   - the Pro button's words come from lib/proCta.js: signed out it starts the
//     account trial and leaves no buy intent; signed in it is the checkout it
//     names (tests/pro-cta.test.mjs)
//   - level-course buttons go through components/CourseCheckout.astro (intent
//     through signup, overlay, events); a course with no checkout id has no Buy
//   - checkout never opens a new tab — overlay, else same-tab navigation
//   - one <h1>, a canonical, real server-rendered text
import { ORGANIZATION } from '../lib/siteMeta.js';
import { getTopicsForLevel } from '../lib/grammar.js';
import { proCta } from '../lib/proCta.js';
import { BILLING_PORTAL_URL, BILLING_PORTAL_LABEL } from '../lib/billingPortal.js';
import { levelCoursesWithVariants } from '../lib/courseVariants.js';
import Layout from '../layouts/Layout.astro';
import CourseCheckout from '../components/CourseCheckout.astro';
import Ticket from '../components/linie/Ticket.astro';
import '../styles/global.css';
import { fontPreloads, signFontPreloads } from '../data/design-tokens.js';
import {
  PLANS,
  CURRENCY,
  num,
  eur,
  COURSE_TELC_B1_PRICE_EUR,
  COURSE_PRO_MONTHS,
  COURSE_FROM_PRICE_EUR,
  SUBLEVEL_PRICES_EUR,
} from '../data/pricing.js';
import {
  GRAMMAR_TOPIC_COUNT,
  LEVEL_COUNT,
  LEVELS,
  XRAY_LINE,
  TRIAL_DAYS,
  TRIAL_SPEAKING_SESSIONS,
  TRIAL_DAILY_LIMIT,
  ANON_DAILY_LIMIT,
  FREE_DAILY_LIMIT,
  PRO_DAILY_LIMIT,
  PRO_SPEAKING_SESSIONS_PER_MONTH,
  TRIAL_WRITING_EVALUATIONS,
  PRO_WRITING_EVALUATIONS_PER_MONTH,
  FREE_LEVEL_LABEL,
} from '../data/marketing.js';
import { STATIONS, TICKET_STATIONS, PRO_OFFER, EXAM_ROUTE } from '../data/offers.js';

const title = 'Pricing — Own a Level or Rent All 8 | DeutschMeister';
const description = `${FREE_LEVEL_LABEL} is free. Buy a German level once from ${eur(COURSE_FROM_PRICE_EUR)} and keep it, with ${COURSE_PRO_MONTHS} months of Pro included — or rent all ${LEVEL_COUNT} levels with Pro, monthly or yearly.`;

// Counted from the topics actually fetched for the free level rather than
// GRAMMAR_TOPIC_COUNT / LEVEL_COUNT (A1.1 has more topics than most levels).
const TOPICS_PER_LEVEL = (await getTopicsForLevel(FREE_LEVEL_LABEL.toLowerCase())).length;
const FREE_RUNGS = 1; // FREE_LEVEL_LABEL is the first rung of the ladder.

// Level courses with their build-time checkout ids ('' = not buyable here).
const levelCourses = levelCoursesWithVariants();
const showLevelCourses = levelCourses.some((c) => c.variantId);
const priceList = Object.entries(SUBLEVEL_PRICES_EUR).map(([l, p]) => `${l.toUpperCase()} ${eur(p)}`).join(', ');
const firstTicket = TICKET_STATIONS[0];

// Pro alone, for the same months a ticket carries — arithmetic on our own
// prices, shown beside the ticket so "own vs rent" is a sum, not a slogan.
const proForTicketWindow = PLANS.monthly.price * COURSE_PRO_MONTHS;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'DeutschMeister Pro',
  description: `Full access to all ${GRAMMAR_TOPIC_COUNT} German grammar topics across ${LEVEL_COUNT} CEFR levels, AI speaking practice, native-speaker listening exercises, podcasts, and ${XRAY_LINE}.`,
  brand: { '@type': 'Brand', name: 'DeutschMeister' },
  // UnitPriceSpecification says the price RECURS (per month / per year).
  // The one-time level courses carry their own Course + Offer on
  // /courses/<level>/ — not nested under Pro, which they are not.
  offers: [PLANS.monthly, PLANS.yearly].map((plan) => ({
    '@type': 'Offer',
    name: plan.name,
    price: num(plan.price),
    priceCurrency: CURRENCY,
    url: 'https://deutsch-meister.de/pricing/',
    availability: 'https://schema.org/InStock',
    seller: ORGANIZATION,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: num(plan.price),
      priceCurrency: CURRENCY,
      referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: plan.interval === 'year' ? 'ANN' : 'MON' },
    },
  })),
};

// The Pro comparison, as a table. `ladder` marks the one row that renders rungs.
const ROWS = [
  { label: 'Levels', ladder: true, anonymous: `${FREE_RUNGS} of ${LEVEL_COUNT}`, trial: `${LEVEL_COUNT} of ${LEVEL_COUNT}`, pro: `${LEVEL_COUNT} of ${LEVEL_COUNT}` },
  { label: 'Grammar topics', anonymous: String(TOPICS_PER_LEVEL), trial: String(GRAMMAR_TOPIC_COUNT), pro: String(GRAMMAR_TOPIC_COUNT) },
  { label: 'Sentence X-Ray', anonymous: `${ANON_DAILY_LIMIT} a day`, trial: `${TRIAL_DAILY_LIMIT} a day`, pro: `${PRO_DAILY_LIMIT} a day` },
  { label: 'AI speaking practice', anonymous: '—', trial: `${TRIAL_SPEAKING_SESSIONS} total`, pro: `${PRO_SPEAKING_SESSIONS_PER_MONTH} a month` },
  { label: 'AI writing feedback', anonymous: '—', trial: `${TRIAL_WRITING_EVALUATIONS} total`, pro: `${PRO_WRITING_EVALUATIONS_PER_MONTH} a month` },
  // The practice exam opens during the trial (SubscriptionGuard passes trial).
  { label: 'Timed practice exam', anonymous: '—', trial: 'Included', pro: 'telc B1' },
  { label: 'Vocabulary trainer (spaced repetition)', anonymous: '—', trial: 'Included', pro: 'Included' },
  { label: 'Listening & reading', anonymous: FREE_LEVEL_LABEL, trial: 'Every level', pro: 'Every level' },
  { label: 'Podcasts & video', anonymous: '—', trial: 'Included', pro: 'Included' },
];

// Own vs rent: the decision in five rows. Reference material — flat.
const OWN_RENT = [
  { label: 'You pay', own: `Once, from ${eur(COURSE_FROM_PRICE_EUR)}`, rent: `${eur(PLANS.monthly.price)} a month or ${eur(PLANS.yearly.price)} a year` },
  { label: 'You keep', own: 'That level, for good', rent: 'Every level, while you pay' },
  { label: 'AI speaking & writing', own: `Included for ${COURSE_PRO_MONTHS} months`, rent: 'Included while you pay' },
  { label: 'Renews', own: 'Never', rent: 'Until you cancel' },
  { label: 'Best when', own: 'You work through one level at your pace', rent: 'You move fast across levels or want the AI every month' },
];

const FAQS = [
  {
    q: 'What do I get without paying?',
    a: `${FREE_LEVEL_LABEL} in full — the course, ${TOPICS_PER_LEVEL} grammar topics with exercises, its listening and reading, and the level test. No account needed. Creating an account adds ${TRIAL_DAYS} days of Pro on top.`,
  },
  {
    q: 'What happens when the trial ends?',
    a: `You keep ${FREE_LEVEL_LABEL} and everything else that is free. Nothing is deleted, and your progress is still there if you buy a level or subscribe later.`,
  },
  {
    q: `What happens when a level's ${COURSE_PRO_MONTHS} months of Pro end?`,
    a: `The level stays open for good. The AI tools return to the free allowance (Sentence X-Ray: ${FREE_DAILY_LIMIT} a day). Nothing renews and nothing is charged.`,
  },
  // No account page can cancel: the subscription lives with Lemon Squeezy, and
  // its customer portal is where a subscriber cancels (lib/billingPortal.js,
  // tests/cancel-path.test.mjs). `link` renders under the answer.
  {
    q: 'Can I cancel anytime?',
    a: `Yes. You cancel in the Lemon Squeezy customer portal (${BILLING_PORTAL_LABEL}), where you sign in with the email address you subscribed with. You keep Pro until the end of the period you have already paid for.`,
    link: { href: BILLING_PORTAL_URL, text: 'Open the customer portal' },
  },
  {
    q: 'Is there a one-time option instead of a subscription?',
    a: showLevelCourses
      ? `Yes — that is what a level is. Each sub-level is its own one-time course (${priceList}) and stays yours, with ${COURSE_PRO_MONTHS} months of Pro included. B1 and B2 are being rebuilt and cannot be bought yet. The telc B1 Komplettvorbereitung (${eur(COURSE_TELC_B1_PRICE_EUR)}) is a separate 4-week plan for one job: your telc B1 date.`
      : `Yes — the telc B1 Komplettvorbereitung (${eur(COURSE_TELC_B1_PRICE_EUR)} one-time) is a fixed 4-week exam plan with ${COURSE_PRO_MONTHS} months of full Pro included and permanent access to the course area.`,
  },
  {
    q: 'Monthly or yearly?',
    a: `Yearly works out ${PLANS.yearly.savingPercent}% cheaper. Monthly is the right choice if you expect to be done inside a few months.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const jsonLd = [productSchema, faqSchema];

// Rule 1 in the tokens file: the case colours appear only where a case is
// named. This is that place — one worked sentence, marked exactly as Sentence
// X-Ray marks it.
const DEMO = [
  { text: 'Ich', kasus: 'nominativ', abbr: 'NOM', gloss: 'I' },
  { text: 'gebe', kasus: null, abbr: 'VERB', gloss: 'give' },
  { text: 'dir', kasus: 'dativ', abbr: 'DAT', gloss: 'to you' },
  { text: 'das Buch', kasus: 'akkusativ', abbr: 'AKK', gloss: 'the book' },
];
const KASUS_CLASS = {
  nominativ: 'border-kasus-nominativ bg-kasus-nominativ-wash text-kasus-nominativ-ink',
  dativ: 'border-kasus-dativ bg-kasus-dativ-wash text-kasus-dativ-ink',
  akkusativ: 'border-kasus-akkusativ bg-kasus-akkusativ-wash text-kasus-akkusativ-ink',
};
const preloads = [...signFontPreloads, ...fontPreloads.filter((f) => f.includes('nunito'))];
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/pricing/" jsonLd={jsonLd} tone="nacht" preloads={preloads}>
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- ═══ The fork: three ways to ride ═══ -->
    <section class="relative bg-nacht text-nacht-text" data-ground="nacht" aria-labelledby="pricing-h">
      <div class="mx-auto max-w-7xl px-4 pb-16 pt-12 sm:px-6 sm:pt-16 lg:px-8 lg:pb-20">
        <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-linie">Preise · Pricing</p>
        <h1 id="pricing-h" class="sign-display mt-4 text-[clamp(2.5rem,9vw,5rem)]">
          <span class="block whitespace-nowrap">Own a level,</span>
          <span class="block whitespace-nowrap">or rent the</span>
          <span class="block whitespace-nowrap">whole line.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-nacht-muted sm:text-[1.1875rem]">
          {FREE_LEVEL_LABEL} is free. Each next level is one payment you keep, with {COURSE_PRO_MONTHS} months of Pro on board. Or rent every level and the full AI allowance with Pro, by the month or the year. One-time or recurring: you choose, and the button always says which.
        </p>

        <ol class="mt-10 grid gap-4 lg:grid-cols-3">
          <li class="flex flex-col rounded-[1.25rem] border border-nacht-rule bg-nacht-raised p-6">
            <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-nacht-muted">The first stop</p>
            <p class="sign-head mt-2 text-[1.75rem]">{FREE_LEVEL_LABEL}, free</p>
            <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-nacht-muted">{STATIONS[0].outcome} No account, no card.</p>
            <p class="mt-4 sign-code text-[2rem] leading-none text-linie">Free</p>
            <a href="/course/a1.1" class="dm-key dm-key-ghost-nacht mt-5" data-track="course_selected" data-track-level="a1.1" data-track-surface="pricing_fork">Start A1.1 free</a>
          </li>
          <li class="flex flex-col rounded-[1.25rem] border-2 border-linie bg-nacht-raised p-6" data-track-view="pricing_own">
            <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-linie">Own a level · one payment</p>
            <p class="sign-head mt-2 text-[1.75rem]">Buy the stop you’re at</p>
            <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-nacht-muted">A guided plan from day one to the final test, yours for good, with {COURSE_PRO_MONTHS} months of Pro included. Nothing renews.</p>
            <p class="mt-4 flex items-baseline gap-2"><span class="text-[0.875rem] text-nacht-muted">from</span><span class="sign-code text-[2rem] leading-none text-linie">{eur(COURSE_FROM_PRICE_EUR)}</span><span class="text-[0.875rem] text-nacht-muted">once</span></p>
            <a href="#levels" class="dm-key dm-key-linie mt-5" data-track="course_selected" data-track-surface="pricing_fork">Choose your level</a>
          </li>
          <li class="flex flex-col rounded-[1.25rem] border border-nacht-rule bg-nacht-raised p-6" data-track-view="pricing_rent">
            <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-nacht-muted">Rent the line · Pro</p>
            <p class="sign-head mt-2 text-[1.75rem]">Every level, monthly</p>
            <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-nacht-muted">All {LEVEL_COUNT} levels, AI speaking ({PRO_SPEAKING_SESSIONS_PER_MONTH} a month), writing feedback ({PRO_WRITING_EVALUATIONS_PER_MONTH} a month) and the practice exams. Cancel anytime.</p>
            <p class="mt-4 flex items-baseline gap-2"><span class="sign-code text-[2rem] leading-none text-linie">{eur(PLANS.monthly.price)}</span><span class="text-[0.875rem] text-nacht-muted">a month</span></p>
            <a href="#pro" class="dm-key dm-key-ghost-nacht mt-5" data-track="course_selected" data-track-surface="pricing_fork" data-track-plan="monthly">Compare Pro</a>
          </li>
        </ol>
      </div>
    </section>

    <!-- ═══ OWN: the level tickets ═══ -->
    <section id="levels" class="scroll-mt-24 bg-paper" aria-labelledby="levels-h">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-14">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">Own a level</p>
            <h2 id="levels-h" class="sign-head mt-3 text-[clamp(2.125rem,5.2vw,3.5rem)]">
              <span class="block">Pay once.</span>
              <span class="block">Keep the level.</span>
            </h2>
            <p class="mt-5 max-w-md text-[1.0625rem] leading-relaxed text-graphite">
              One payment, no renewal. A level opens one sub-level for good and carries {COURSE_PRO_MONTHS} months of Pro, so the speaking coach, writing feedback and Sentence X-Ray run while you work through it.
            </p>
            <p class="mt-3 text-[0.9375rem] text-graphite"><a href="/courses/" class="dm-link">See what each course contains</a></p>

            <!-- Every paid level, one line each — Buy where a checkout id is set. -->
            <ul class="mt-8 border-t border-ink">
              {levelCourses.map((c) => (
                <li class="flex min-h-14 items-center justify-between gap-3 border-b border-rule py-2">
                  <span class="flex items-baseline gap-2">
                    <span class="sign-code text-[1.25rem] text-ink">{c.code}</span>
                    <span class="font-data text-[0.8125rem] text-graphite">{eur(c.price)} · one time</span>
                  </span>
                  {c.variantId ? (
                    <span data-course-door={c.levels[0]} data-course-code={c.code} data-course-open-class="dm-key dm-key-ghost !min-h-10 !px-4 !py-2 !text-[0.875rem]">
                      <button type="button" class="dm-key dm-key-siegel !min-h-10 !px-4 !py-2 !text-[0.875rem]" data-course-variant={c.variantId} data-course-key={c.key} data-course-price={c.price} data-track-surface="pricing_list">
                        Buy {c.code}
                      </button>
                    </span>
                  ) : (
                    <span class="font-data text-[0.75rem] text-graphite">{c.comingSoon ? 'Im Bau · coming soon' : 'Not on sale here yet'}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <Ticket surface="pricing_ticket" defaultLevel={firstTicket ? firstTicket.level : 'a1.2'} headingLevel={3} />
            <p class="mt-6 rounded-clay border border-dashed border-rule p-5 text-[0.9375rem] leading-relaxed text-graphite">
              <strong class="text-ink">{EXAM_ROUTE.title}</strong> {EXAM_ROUTE.body}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ OWN vs RENT: the decision, flat ═══ -->
    <section class="border-y border-rule bg-paper-sunk" aria-labelledby="own-rent-h">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="own-rent-h" class="sign-head text-[clamp(1.875rem,4.4vw,2.75rem)]">Own or rent — side by side</h2>
        <!-- A scrolling region on narrow screens: focusable so a keyboard user can scroll it. -->
        <div class="mt-8 overflow-x-auto" tabindex="0" role="region" aria-labelledby="own-rent-h">
          <table class="w-full min-w-[36rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-ink">
                <th scope="col" class="w-1/4 py-3 pr-4 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">&nbsp;</th>
                <th scope="col" class="px-4 py-3 sign-label text-[1.125rem]">Own a level</th>
                <th scope="col" class="px-4 py-3 sign-label text-[1.125rem]">Rent the line (Pro)</th>
              </tr>
            </thead>
            <tbody>
              {OWN_RENT.map((row) => (
                <tr class="border-b border-rule align-top">
                  <th scope="row" class="py-3.5 pr-4 text-sm font-normal text-graphite">{row.label}</th>
                  <td class="px-4 py-3.5 text-[0.9375rem] font-semibold text-ink">{row.own}</td>
                  <td class="px-4 py-3.5 text-[0.9375rem] text-ink">{row.rent}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 font-data text-[0.8125rem] text-graphite">
          Pro alone for {COURSE_PRO_MONTHS} months: {eur(proForTicketWindow)}. A level costs from {eur(COURSE_FROM_PRICE_EUR)}, carries the same {COURSE_PRO_MONTHS} months, and stays yours after them.
        </p>
      </div>
    </section>

    <!-- ═══ RENT: Pro, compared with the free options ═══ -->
    <section id="pro" class="scroll-mt-24 bg-paper" aria-labelledby="compare-h">
      <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:py-24">
        <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">Rent the line</p>
        <h2 id="compare-h" class="sign-head mt-3 text-[clamp(2.125rem,5.2vw,3.5rem)]">No account, free trial, or Pro</h2>

        <!-- Billing toggle: pressable -->
        <div class="mt-6 flex items-center gap-3">
          <span class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">Billing</span>
          <div class="inline-flex rounded-pill border border-rule bg-white p-1 shadow-raise" role="group" aria-label="Billing period">
            <button id="toggle-monthly" type="button" aria-pressed="true" class="rounded-pill bg-ink px-4 py-1.5 text-sm font-bold text-paper transition-colors">Monthly</button>
            <button id="toggle-yearly" type="button" aria-pressed="false" class="rounded-pill px-4 py-1.5 text-sm font-bold text-graphite transition-colors hover:text-ink">
              Yearly <span class="font-data text-[0.6875rem] tracking-[0.02em]">−{PLANS.yearly.savingPercent}%</span>
            </button>
          </div>
        </div>

        <!-- The comparison, as a declension table — flat, reference material -->
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[48rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-ink">
                <th scope="col" class="w-1/4 py-3 pr-4 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">What you get</th>
                <th scope="col" class="w-1/4 px-4 py-3 align-bottom">
                  <span class="block sign-label text-lg">Explore</span>
                  <span class="mt-1 block font-data text-[0.8125rem] text-graphite">Forever · no account</span>
                </th>
                <th scope="col" class="w-1/4 px-4 py-3 align-bottom">
                  <span class="block sign-label text-lg">Free trial</span>
                  <span class="mt-1 block font-data text-[0.8125rem] text-graphite">{TRIAL_DAYS} days · account required</span>
                </th>
                <th scope="col" class="w-1/4 bg-linie-wash py-3 pl-4 align-bottom">
                  <span class="block sign-label text-lg">Pro</span>
                  <span class="mt-1 block font-data text-[0.8125rem] text-graphite">
                    <span id="pro-price">{eur(PLANS.monthly.price)}</span> · per <span id="pro-period">{PLANS.monthly.interval}</span>
                  </span>
                </th>
              </tr>
            </thead>
            <tbody>
              {ROWS.map((row) => (
                <tr class="border-b border-rule align-top">
                  <th scope="row" class="py-3.5 pr-4 text-sm font-normal text-graphite">{row.label}</th>
                  <td class="px-4 py-3.5">
                    {row.ladder && (
                      <span class="flex items-center gap-1" aria-hidden="true">
                        {LEVELS.map((_, i) => (
                          <span class={`h-1.5 w-3 rounded-sm ${i < FREE_RUNGS ? 'bg-ink' : 'bg-rule'}`}></span>
                        ))}
                      </span>
                    )}
                    <span class={`font-data text-[0.8125rem] text-ink ${row.ladder ? 'mt-1.5 block' : ''}`}>{row.anonymous}</span>
                  </td>
                  <td class="px-4 py-3.5">
                    {row.ladder && (
                      <span class="flex items-center gap-1" aria-hidden="true">
                        {LEVELS.map(() => (<span class="h-1.5 w-3 rounded-sm bg-ink"></span>))}
                      </span>
                    )}
                    <span class={`font-data text-[0.8125rem] font-semibold text-ink ${row.ladder ? 'mt-1.5 block' : ''}`}>{row.trial}</span>
                  </td>
                  <td class="bg-linie-wash py-3.5 pl-4">
                    {row.ladder && (
                      <span class="flex items-center gap-1" aria-hidden="true">
                        {LEVELS.map(() => (<span class="h-1.5 w-3 rounded-sm bg-ink"></span>))}
                      </span>
                    )}
                    <span class={`font-data text-[0.8125rem] font-semibold text-ink ${row.ladder ? 'mt-1.5 block' : ''}`}>{row.pro}</span>
                  </td>
                </tr>
              ))}
              <tr>
                <td class="py-5 pr-4"></td>
                <td class="px-4 py-5">
                  <a href="/course/a1.1" class="dm-key dm-key-ghost w-full !text-[0.875rem]">
                    Start the free A1.1 course
                  </a>
                  <span class="mt-2 block font-data text-[0.6875rem] leading-snug text-graphite">No signup · no card</span>
                </td>
                <td class="px-4 py-5">
                  <a href="https://deutsch-meister.de/signup" class="dm-key dm-key-ghost w-full !text-[0.875rem]">
                    Create free account
                  </a>
                  <span class="mt-2 block font-data text-[0.6875rem] leading-snug text-graphite">Starts {TRIAL_DAYS}-day trial · no card</span>
                </td>
                <td class="bg-linie-wash py-5 pl-4 pr-3">
                  <!-- Label and note come from lib/proCta.js: signed out it starts the
                       account trial (no card); the script switches a signed-in
                       visitor to "Go Pro — <price>" and the checkout. -->
                  <button id="pro-btn" type="button" class="dm-key dm-key-siegel w-full !text-[0.875rem]" data-track-surface="pricing_pro">
                    <span id="pro-btn-label">{proCta().label}</span>
                  </button>
                  <span id="plan-note" class="mt-2 block font-data text-[0.6875rem] leading-snug text-graphite">
                    {proCta().note}
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <ul class="mt-6 grid gap-2 text-[0.9375rem] text-graphite sm:grid-cols-2">
          {PRO_OFFER.lines.map((l) => <li class="flex gap-2"><span class="text-ink" aria-hidden="true">—</span>{l}</li>)}
        </ul>
      </div>
    </section>

    <!-- ═══ The exam course ═══ -->
    <section class="border-t border-rule bg-paper" aria-labelledby="course-h">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <div class="dm-lift flex flex-col gap-6 rounded-[1.25rem] border border-ink bg-white p-6 shadow-raise sm:flex-row sm:items-center sm:justify-between sm:p-8">
          <div class="max-w-xl">
            <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">Preparing for telc B1?</p>
            <h2 id="course-h" class="sign-head mt-2 text-[1.625rem]" lang="de">telc B1 Komplettvorbereitung</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
              A fixed 4-week exam plan over the whole library — one task a day, in the order that leads to the exam. One-time purchase, {COURSE_PRO_MONTHS} months of full Pro included, the course area stays yours permanently.
            </p>
          </div>
          <div class="shrink-0 text-left sm:text-right">
            <p class="sign-code text-[2rem] leading-none text-ink">{eur(COURSE_TELC_B1_PRICE_EUR)}</p>
            <p class="mt-1 font-data text-[0.75rem] text-graphite">one-time · no subscription</p>
            <a href="/telc-b1-komplettvorbereitung/" class="dm-key dm-key-ghost mt-4" hreflang="de">See the 4-week plan · DE</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ What Pro and every level carry, in the product's own notation.
         The only place on this page where the case colours are allowed. ═══ -->
    <section class="border-t border-rule bg-paper" aria-labelledby="demo-h">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <h2 id="demo-h" class="sign-head text-[clamp(1.875rem,4.4vw,2.75rem)]">Grammar you can see</h2>
        <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
          Sentence X-Ray takes a German sentence apart and colours each piece by its case, so the pattern becomes visible instead of memorised. The same colours run through every lesson.
        </p>
        <div class="mt-6 flex flex-wrap items-stretch gap-2" lang="de">
          {DEMO.map((w) => (
            <span class={`rounded-md border px-3 py-2 ${w.kasus ? KASUS_CLASS[w.kasus] : 'border-rule bg-paper-sunk text-graphite'}`}>
              <span class="block text-base font-semibold">{w.text}</span>
              <span class="mt-0.5 block font-data text-[0.6875rem] font-bold tracking-[0.13em]">{w.abbr}</span>
              <span class="mt-0.5 block text-[0.75rem]" lang="en">{w.gloss}</span>
            </span>
          ))}
        </div>
        <p class="mt-3 font-data text-[0.8125rem] text-graphite">
          Free: {ANON_DAILY_LIMIT} sentence a day. Pro: {PRO_DAILY_LIMIT}.
        </p>
      </div>
    </section>

    <!-- ═══ FAQ ═══ -->
    <section class="border-t border-rule bg-paper" aria-labelledby="faq-h">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <h2 id="faq-h" class="sign-head text-[clamp(1.875rem,4.4vw,2.75rem)]">Before you decide</h2>
        <dl class="mt-6 max-w-prose">
          {FAQS.map((item) => (
            <div class="border-b border-rule py-5">
              <dt class="sign-label text-[1.0625rem]">{item.q}</dt>
              <dd class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
                {item.a}
                {item.link && (
                  <a href={item.link.href} class="dm-link mt-2 block">{item.link.text} →</a>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

  </div>
  <CourseCheckout />
</Layout>

<script>
  // Billing toggle + the auth-aware Pro checkout. Level-course buttons are
  // handled by components/CourseCheckout.astro (intent, overlay, events).
  //
  // Prices derive from ../data/pricing.js — the same module the server-rendered
  // table above reads, so the toggle cannot show a figure the static HTML
  // contradicts. Checkout ids come from lib/proVariants.js (env, with the
  // SPA's fallbacks).
  import { PLANS as DATA, eur as EUR } from '../data/pricing.js';
  import { proCta } from '../lib/proCta.js';
  import { PRO_VARIANTS as VARIANTS } from '../lib/proVariants.js';
  import { track } from '../lib/track.js';

  let cycle = 'monthly';
  const $ = (id) => document.getElementById(id);

  function applyCycle() {
    const plan = DATA[cycle];
    $('pro-price').textContent = EUR(plan.price);
    $('pro-period').textContent = plan.interval;
    const cta = proCta({ signedIn: Boolean(currentUser()), cycle });
    $('pro-btn-label').textContent = cta.label;
    $('plan-note').textContent = cta.note;

    const on = 'rounded-pill px-4 py-1.5 text-sm font-bold transition-colors bg-ink text-paper';
    const off = 'rounded-pill px-4 py-1.5 text-sm font-bold transition-colors text-graphite hover:text-ink';
    $('toggle-monthly').className = cycle === 'monthly' ? on : off;
    $('toggle-yearly').className = cycle === 'yearly' ? on : off;
    $('toggle-monthly').setAttribute('aria-pressed', String(cycle === 'monthly'));
    $('toggle-yearly').setAttribute('aria-pressed', String(cycle === 'yearly'));
  }

  function currentUser() {
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && /^sb-.*-auth-token$/.test(k)) {
          const v = JSON.parse(localStorage.getItem(k) || 'null');
          const u = (v && (v.user || (v.currentSession && v.currentSession.user))) || null;
          if (u && u.id) return { email: u.email || '', id: u.id };
        }
      }
    } catch (e) { /* private mode — treat as signed out */ }
    return null;
  }

  function checkoutUrl(variant, email, id) {
    const params = new URLSearchParams({ 'checkout[email]': email || '', 'checkout[custom][user_id]': id || '' });
    return 'https://deutsch-meister.lemonsqueezy.com/checkout/buy/' + variant + '?' + params.toString();
  }

  document.addEventListener('DOMContentLoaded', () => {
    applyCycle();
    $('toggle-monthly').addEventListener('click', () => { cycle = 'monthly'; applyCycle(); });
    $('toggle-yearly').addEventListener('click', () => { cycle = 'yearly'; applyCycle(); });

    // Never a new tab: iOS Safari blocks the popup and in-app browsers
    // swallow it, so the customer sees nothing happen. Prefer the
    // LemonSqueezy overlay, fall back to same-tab navigation. A signed-out
    // visitor never reaches this for Pro (the Pro button starts the trial
    // instead, below); the intent branch stays for any caller that sells.
    function open(variant, intentKey) {
      const u = currentUser();
      if (!u) {
        try { localStorage.setItem('dm_buy_intent', intentKey); } catch (e) { /* private mode */ }
        window.location.href = 'https://deutsch-meister.de/signup';
        return;
      }
      // Arm the app's checkout_completed observer (src/lib/funnelTracking.js).
      try { sessionStorage.setItem('dm_checkout_pending', JSON.stringify({ plan: intentKey, amount: DATA[intentKey] ? DATA[intentKey].price : null })); } catch (e) { /* private mode */ }
      track('checkout_opened', { product: intentKey, surface: 'pricing_pro' });
      const url = checkoutUrl(variant, u.email, u.id);
      if (window.LemonSqueezy && window.LemonSqueezy.Url && window.LemonSqueezy.Url.Open) {
        window.LemonSqueezy.Url.Open(url);
      } else {
        window.location.href = url;
      }
    }

    // The overlay script itself (lemon.js) and its 'Checkout.Success' →
    // /subscription/success handler are set up once, for every checkout on the
    // page, by components/CourseCheckout.astro when a session exists.

    // Signed out, this button starts the account trial and nothing else: no
    // buy intent, so signup is not followed by a paid checkout the label never
    // mentioned. Signed in, it is the checkout it says it is.
    $('pro-btn').addEventListener('click', () => {
      const cta = proCta({ signedIn: Boolean(currentUser()), cycle });
      track('checkout_intent', { product: cycle, surface: 'pricing_pro', signed_in: cta.action !== 'signup' });
      if (cta.action === 'signup') {
        window.location.href = cta.href;
        return;
      }
      open(VARIANTS[cycle], cycle);
    });
  });
</script>
