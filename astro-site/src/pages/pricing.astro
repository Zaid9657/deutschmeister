---
// Pricing — rebuilt 2026-08-22 on src/data/design-tokens.js; reskinned
// 2026-09-01 onto the Playful Depth system (docs/design/playbook.md) with the
// exam-deadline learner's voice.
//
// THE THESIS. A language learner's real question is not "which tier am I" but
// "how far does this get me". The product's own structure answers it: eight
// CEFR sub-levels, A1.1 to B2.2. Free lights one rung, Pro lights all eight —
// so the ladder IS the pricing argument, not an illustration of it. It is
// rendered as static markup with no interaction, because the comparison is
// true whether or not JavaScript runs.
//
// The plan comparison is a declension table — rows and aligned columns, the
// artifact this subject actually uses — and stays FLAT (reference material,
// tokens rule 3). The things you can press (the toggle, the CTAs, the course
// card) are the things that are raised.
//
// INVARIANTS CARRIED OVER (do not regress):
//   - every figure derives from ../data/pricing.js and ../data/marketing.js;
//     tests/claims.test.mjs fails if a price literal reappears here
//   - checkout never opens a new tab (iOS Safari blocks the popup and in-app
//     browsers swallow it) — LemonSqueezy overlay, else same-tab navigation
//   - one <h1>, a canonical, and real server-rendered body text, or
//     scripts/check-built-html.mjs fails
import { ORGANIZATION } from '../lib/siteMeta.js';
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';
import '../styles/global.css';
import {
  PLANS,
  CURRENCY,
  num,
  eur,
  COURSE_TELC_B1_PRICE_EUR,
  COURSE_PRO_MONTHS,
  COURSE_LEVEL_PRICE_EUR,
  COURSE_BUNDLE_PRICE_EUR,
  BUNDLE_SAVING_PERCENT,
  LEVEL_COURSES,
} from '../data/pricing.js';
import {
  GRAMMAR_TOPIC_COUNT,
  LEVEL_COUNT,
  LEVELS,
  XRAY_LINE,
  TRIAL_DAYS,
  TRIAL_SPEAKING_SESSIONS,
  ANON_DAILY_LIMIT,
  PRO_DAILY_LIMIT,
  PRO_SPEAKING_SESSIONS_PER_MONTH,
  TRIAL_WRITING_EVALUATIONS,
  PRO_WRITING_EVALUATIONS_PER_MONTH,
  FREE_LEVEL_LABEL,
} from '../data/marketing.js';

const title = 'Pricing — All 8 German Levels | DeutschMeister';
const description = `${FREE_LEVEL_LABEL} is free forever. Pro opens all ${LEVEL_COUNT} CEFR levels, ${GRAMMAR_TOPIC_COUNT} grammar topics, AI speaking practice and Sentence X-Ray.`;

const TOPICS_PER_LEVEL = GRAMMAR_TOPIC_COUNT / LEVEL_COUNT;
const FREE_RUNGS = 1; // FREE_LEVEL_LABEL is the first rung of the ladder.

// Level courses (the product since 2026-09-03, docs/monetization-2026-09-03.md).
// Checkout ids are build-time PUBLIC_ env, one per product; a course with no
// id renders no buy button, and if none is set the whole section stays out —
// the same "never open a dead checkout" rule the SPA follows.
const LEVEL_COURSE_VARIANTS = {
  course_a1: import.meta.env.PUBLIC_LEMONSQUEEZY_COURSE_A1_VARIANT_ID || '',
  course_a2: import.meta.env.PUBLIC_LEMONSQUEEZY_COURSE_A2_VARIANT_ID || '',
  course_b1: import.meta.env.PUBLIC_LEMONSQUEEZY_COURSE_B1_VARIANT_ID || '',
  course_b2: import.meta.env.PUBLIC_LEMONSQUEEZY_COURSE_B2_VARIANT_ID || '',
  course_alle: import.meta.env.PUBLIC_LEMONSQUEEZY_COURSE_ALLE_VARIANT_ID || '',
};
const levelCourses = Object.values(LEVEL_COURSES).map((c) => ({ ...c, variantId: LEVEL_COURSE_VARIANTS[c.key] }));
const showLevelCourses = levelCourses.some((c) => c.variantId);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'DeutschMeister Pro',
  description: `Full access to all ${GRAMMAR_TOPIC_COUNT} German grammar topics across ${LEVEL_COUNT} CEFR levels, AI speaking practice, native-speaker listening exercises, podcasts, and ${XRAY_LINE}.`,
  brand: { '@type': 'Brand', name: 'DeutschMeister' },
  // Everything derives from PLANS/CURRENCY — no literal enters the page source.
  // UnitPriceSpecification says the price RECURS (per month / per year); a bare
  // Offer read as a one-time €9.99 for a subscription. seller ties both offers
  // to the one Organization entity by @id.
  offers: [
    ...[PLANS.monthly, PLANS.yearly].map((plan) => ({
      '@type': 'Offer',
      name: plan.name,
      price: num(plan.price),
      priceCurrency: CURRENCY,
      url: 'https://deutsch-meister.de/pricing/',
      availability: 'https://schema.org/InStock',
      seller: ORGANIZATION,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: num(plan.price),
        priceCurrency: CURRENCY,
        referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: plan.interval === 'year' ? 'ANN' : 'MON' },
      },
    })),
    // One-time level courses: a bare Offer IS the right reading here.
    ...(showLevelCourses
      ? levelCourses.filter((c) => c.variantId).map((c) => ({
          '@type': 'Offer',
          name: c.name,
          price: num(c.price),
          priceCurrency: CURRENCY,
          url: 'https://deutsch-meister.de/pricing/',
          availability: 'https://schema.org/InStock',
          seller: ORGANIZATION,
        }))
      : []),
  ],
};

// The comparison, as a table. `ladder` marks the one row that renders rungs
// instead of text.
const ROWS = [
  { label: 'Levels', ladder: true, free: `${FREE_RUNGS} of ${LEVEL_COUNT}`, pro: `${LEVEL_COUNT} of ${LEVEL_COUNT}` },
  { label: 'Grammar topics', free: String(TOPICS_PER_LEVEL), pro: String(GRAMMAR_TOPIC_COUNT) },
  { label: 'Sentence X-Ray', free: `${ANON_DAILY_LIMIT} a day`, pro: `${PRO_DAILY_LIMIT} a day` },
  { label: 'AI speaking practice', free: `${TRIAL_SPEAKING_SESSIONS} sessions`, pro: `${PRO_SPEAKING_SESSIONS_PER_MONTH} a month` },
  // Renovation additions (2026-09-01): the two exam tools shipped with the
  // exam-first rebuild. Figures derive from marketing.js like every row here.
  { label: 'AI writing feedback', free: `${TRIAL_WRITING_EVALUATIONS} evaluations`, pro: `${PRO_WRITING_EVALUATIONS_PER_MONTH} a month` },
  // Free column: what you get without paying — the practice exam opens during
  // the trial (SubscriptionGuard passes trial), the SRS trainer needs only an
  // account. Claiming Pro-only here would overstate the paywall.
  { label: 'Timed practice exam', free: 'During trial', pro: 'telc B1' },
  { label: 'Vocabulary trainer (spaced repetition)', free: 'With account', pro: 'Included' },
  { label: 'Listening & reading', free: FREE_LEVEL_LABEL, pro: 'Every level' },
  { label: 'Podcasts & video', free: '—', pro: 'Included' },
];

const FAQS = [
  {
    q: 'What do I get without paying?',
    a: `${FREE_LEVEL_LABEL} in full — ${TOPICS_PER_LEVEL} grammar topics with exercises, its listening and reading, and the level test. No account needed. Creating an account adds ${TRIAL_DAYS} days of Pro on top.`,
  },
  {
    q: 'What happens when the trial ends?',
    a: `You keep ${FREE_LEVEL_LABEL} and everything else that is free. Nothing is deleted, and your progress is still there if you subscribe later.`,
  },
  { q: 'Can I cancel anytime?', a: 'Yes, from your account page. You keep Pro until the end of the period you have already paid for.' },
  {
    q: 'Is there a one-time option instead of a subscription?',
    a: showLevelCourses
      ? `Yes. Each level course (A1, A2, B1 or B2) is ${eur(COURSE_LEVEL_PRICE_EUR)} once and stays yours: both sub-levels, every grammar topic, reading, listening and vocabulary at that level, plus ${COURSE_PRO_MONTHS} months of Pro included. The complete course, all four levels, is ${eur(COURSE_BUNDLE_PRICE_EUR)} — ${BUNDLE_SAVING_PERCENT}% less than buying them one by one. The telc B1 Komplettvorbereitung (${eur(COURSE_TELC_B1_PRICE_EUR)}) is the fixed 4-week exam plan for one job: your telc B1 date.`
      : `Yes — the telc B1 Komplettvorbereitung (${eur(COURSE_TELC_B1_PRICE_EUR)} one-time) is a fixed 4-week exam plan with ${COURSE_PRO_MONTHS} months of full Pro included and permanent access to the course area. It exists for one job: your telc B1 date.`,
  },
  ...(showLevelCourses
    ? [{
        q: 'Course or subscription — which one is for me?',
        a: `Buy the level you are working towards if you want to own it: no renewal, no lock-out the month before the exam, and the AI tools for ${COURSE_PRO_MONTHS} months. Choose Pro if you use the AI speaking coach, writing feedback and Sentence X-Ray every week and want them to keep running — Pro is ${eur(PLANS.monthly.price)} a month and the level courses still work alongside it.`,
      }]
    : []),
  {
    q: 'Monthly or yearly?',
    a: `Yearly works out ${PLANS.yearly.savingPercent}% cheaper. Monthly is the right choice if you are working towards one specific level and expect to be done inside a few months.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const jsonLd = [productSchema, faqSchema];

// Rule 1 in the tokens file: the case colours appear only where a case is
// named. This is that place — one worked sentence, marked exactly as Sentence
// X-Ray marks it.
const DEMO = [
  { text: 'Ich', kasus: 'nominativ', abbr: 'NOM', gloss: 'I' },
  { text: 'gebe', kasus: null, abbr: 'VERB', gloss: 'give' },
  { text: 'dir', kasus: 'dativ', abbr: 'DAT', gloss: 'to you' },
  { text: 'das Buch', kasus: 'akkusativ', abbr: 'AKK', gloss: 'the book' },
];
const KASUS_CLASS = {
  nominativ: 'border-kasus-nominativ bg-kasus-nominativ-wash text-kasus-nominativ-ink',
  dativ: 'border-kasus-dativ bg-kasus-dativ-wash text-kasus-dativ-ink',
  akkusativ: 'border-kasus-akkusativ bg-kasus-akkusativ-wash text-kasus-akkusativ-ink',
};

// The depth grammar as class strings (playbook §1).
const BTN =
  'inline-flex items-center justify-center gap-2 rounded-clay text-sm font-bold transition-all duration-100 ease-snap select-none';
const BTN_PRIMARY = `${BTN} bg-siegel px-5 py-3 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_SECONDARY = `${BTN} border border-rule bg-white px-5 py-3 text-ink shadow-raise hover:border-siegel hover:text-siegel-deep active:translate-y-1 active:shadow-none`;
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/pricing/" jsonLd={jsonLd}>
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- Hero: the person with a date, the promise, the ladder that proves it -->
    <section class="relative">
      <Aurora />
      <div class="relative mx-auto max-w-5xl px-5 pt-14 pb-10 sm:pt-20">
        <header class="max-w-2xl">
          <p class="hero-line font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" style="--d:0ms">Preise · Pricing</p>
          <h1 class="hero-line mt-3 font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.022em] sm:text-[3.25rem]" style="--d:80ms">
            Everything the exam tests.<br />One price.
          </h1>
          <p class="hero-line mt-5 text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" style="--d:200ms">
            You have a date on the calendar and a level to reach — the month before it is not the
            month to be locked out of B1. {FREE_LEVEL_LABEL} is free forever. Pro opens the other
            {LEVEL_COUNT - FREE_RUNGS} levels, the speaking coach, the writing feedback and the timed
            practice test, for {eur(PLANS.monthly.perDay)} a day.{showLevelCourses && (
              <> Or buy the level you need once, from {eur(COURSE_LEVEL_PRICE_EUR)}, and keep it.</>
            )}
          </p>
        </header>

        <!-- The ladder. Static on purpose: the comparison is true with JS off. -->
        <section class="hero-line mt-10" style="--d:320ms" aria-labelledby="ladder-h">
          <h2 id="ladder-h" class="sr-only">The eight CEFR levels</h2>
          <ol class="grid grid-cols-4 gap-2 sm:grid-cols-8">
            {LEVELS.map((lvl, i) => (
              <li class={`rounded-clay border px-2 py-3 text-center ${i < FREE_RUNGS ? 'border-rule bg-white shadow-raise' : 'border-siegel/30 bg-siegel-wash'}`}>
                <span class="block font-data text-[0.8125rem] font-semibold tracking-[0.02em] text-ink">{lvl.code}</span>
                <span class="mt-1 block text-[0.6875rem] leading-tight text-graphite">{lvl.subtitle}</span>
                {i < FREE_RUNGS && (
                  <span class="mt-1.5 inline-block rounded-pill bg-accent-limette-wash px-1.5 py-0.5 font-data text-[0.5625rem] font-bold uppercase tracking-[0.13em] text-accent-limette-ink">Free</span>
                )}
              </li>
            ))}
          </ol>
          <p class="mt-3 font-data text-[0.8125rem] text-graphite">
            <span class="inline-block h-2 w-2 rounded-full border border-siegel bg-siegel-wash align-middle"></span>
            <span class="ml-2 align-middle">Opened by Pro</span>
          </p>
        </section>
      </div>
    </section>

    <div class="mx-auto max-w-5xl px-5 pb-20">

      <!-- Billing toggle: chunky, pressable -->
      <div class="reveal mt-4 flex items-center gap-3">
        <span class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">Billing</span>
        <div class="inline-flex rounded-pill border border-rule bg-white p-1 shadow-raise" role="group" aria-label="Billing period">
          <button id="toggle-monthly" type="button" aria-pressed="true" class="rounded-pill bg-ink px-4 py-1.5 text-sm font-bold text-paper transition-colors">Monthly</button>
          <button id="toggle-yearly" type="button" aria-pressed="false" class="rounded-pill px-4 py-1.5 text-sm font-bold text-graphite transition-colors hover:text-ink">
            Yearly <span class="font-data text-[0.6875rem] tracking-[0.02em]">−{PLANS.yearly.savingPercent}%</span>
          </button>
        </div>
      </div>

      <!-- The comparison, as a declension table — flat, reference material -->
      <section class="reveal mt-6 overflow-x-auto" style="--rd:80ms" aria-labelledby="compare-h">
        <h2 id="compare-h" class="sr-only">Free and Pro compared</h2>
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-ink">
              <th scope="col" class="w-1/3 py-3 pr-4 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">What you get</th>
              <th scope="col" class="w-1/3 px-4 py-3 align-bottom">
                <span class="block font-display text-lg font-semibold">Free</span>
                <span class="mt-1 block font-data text-[0.8125rem] text-graphite">Forever · no account</span>
              </th>
              <th scope="col" class="w-1/3 bg-siegel-wash py-3 pl-4 align-bottom">
                <span class="flex items-center gap-2">
                  <span class="font-display text-lg font-semibold">Pro</span>
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-gold" aria-hidden="true"></span>
                </span>
                <span class="mt-1 block font-data text-[0.8125rem] text-graphite">
                  <span id="pro-price">{eur(PLANS.monthly.price)}</span> · per <span id="pro-period">{PLANS.monthly.interval}</span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            {ROWS.map((row) => (
              <tr class="border-b border-rule align-top">
                <th scope="row" class="py-3.5 pr-4 text-sm font-normal text-graphite">{row.label}</th>
                <td class="px-4 py-3.5">
                  {row.ladder && (
                    <span class="flex items-center gap-1" aria-hidden="true">
                      {LEVELS.map((_, i) => (
                        <span class={`h-1.5 w-3 rounded-sm ${i < FREE_RUNGS ? 'bg-ink' : 'bg-rule'}`}></span>
                      ))}
                    </span>
                  )}
                  <span class={`font-data text-[0.8125rem] text-ink ${row.ladder ? 'mt-1.5 block' : ''}`}>{row.free}</span>
                </td>
                <td class="bg-siegel-wash py-3.5 pl-4">
                  {row.ladder && (
                    <span class="flex items-center gap-1" aria-hidden="true">
                      {LEVELS.map(() => (
                        <span class="h-1.5 w-3 rounded-sm bg-siegel"></span>
                      ))}
                    </span>
                  )}
                  <span class={`font-data text-[0.8125rem] font-semibold text-ink ${row.ladder ? 'mt-1.5 block' : ''}`}>{row.pro}</span>
                </td>
              </tr>
            ))}
            <tr>
              <td class="py-5 pr-4"></td>
              <td class="px-4 py-5">
                <a href="https://deutsch-meister.de/signup" class={`${BTN_SECONDARY} w-full`}>
                  Start free
                </a>
              </td>
              <td class="bg-siegel-wash py-5 pl-4">
                <button id="pro-btn" type="button" class={`${BTN_PRIMARY} btn-shimmer relative w-full overflow-hidden`}>
                  <span class="relative z-10">Get started</span>
                </button>
                <span id="plan-note" class="mt-2 block font-data text-[0.6875rem] leading-snug text-graphite">
                  {TRIAL_DAYS}-day free trial · cancel anytime
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Level courses: buy a band once, keep it. Prices derive from
           pricing.js; buttons carry their checkout id and the script below
           opens the overlay (signed-out visitors go to signup first). -->
      {showLevelCourses && (
        <section class="reveal mt-14" style="--rd:80ms" aria-labelledby="levels-h">
          <h2 id="levels-h" class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[2rem]">
            Or buy a level once, and keep it
          </h2>
          <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base">
            One payment, no renewal. A level course opens both sub-levels — every grammar topic,
            reading text, listening exercise and vocabulary list at that level — for good, and
            includes {COURSE_PRO_MONTHS} months of Pro so the speaking coach, writing feedback and
            Sentence X-Ray run while you work through it.
          </p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {levelCourses.map((c) => {
              const bundle = c.key === 'course_alle';
              return (
                <li class={`relative flex flex-col rounded-clay border bg-white p-5 ${bundle ? 'border-siegel shadow-raise-siegel sm:col-span-2 lg:col-span-1' : 'border-rule shadow-raise'}`}>
                  {bundle && (
                    <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center rounded-pill bg-gold px-3 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-ink shadow-raise">
                      Save {c.savingPercent}%
                    </span>
                  )}
                  <span class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">{c.code}</span>
                  <span class="mt-1 text-[1.0625rem] font-bold leading-tight text-ink">{c.name}</span>
                  <span class="mt-3 font-display text-[1.75rem] font-semibold leading-none tracking-[-0.02em] text-ink">
                    {eur(c.price)}
                    <span class="ml-1 font-body text-xs font-normal tracking-normal text-graphite">one time</span>
                  </span>
                  <span class="mt-2 text-xs text-graphite">
                    {bundle ? `All ${c.levels.length} levels, A1.1–B2.2` : `${c.levels[0].toUpperCase()} + ${c.levels[1].toUpperCase()} · lifetime`}
                  </span>
                  {c.variantId ? (
                    <button
                      type="button"
                      class={`${bundle ? BTN_PRIMARY : BTN_SECONDARY} mt-4 w-full`}
                      data-course-variant={c.variantId}
                      data-course-key={c.key}
                    >
                      Buy {c.code}
                    </button>
                  ) : (
                    <span class="mt-4 font-data text-[0.75rem] text-graphite">Coming soon</span>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <!-- The one-time course — the highest-ticket product, as a 3D card.
           Price derives from pricing.js (COURSE_TELC_B1_PRICE_EUR). -->
      <section class="reveal mt-14" style="--rd:80ms" aria-labelledby="course-h">
        <div class="atropos" data-atropos-card>
          <div class="atropos-scale"><div class="atropos-rotate"><div class="atropos-inner !overflow-visible">
            <div class="rounded-clay border border-rule bg-white p-6 shadow-raise-siegel sm:p-8">
              <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
                <div class="max-w-xl">
                  <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" data-atropos-offset="4">
                    Preparing for telc B1?
                  </p>
                  <h2 id="course-h" class="mt-2 font-display text-[1.375rem] font-semibold text-ink sm:text-[1.625rem]" data-atropos-offset="3">
                    telc B1 Komplettvorbereitung
                  </h2>
                  <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite" data-atropos-offset="2">
                    A fixed 4-week exam plan over the whole library — one task a day, in the order that
                    leads to the exam. One-time purchase, {COURSE_PRO_MONTHS} months of full Pro included,
                    the course area stays yours permanently.
                  </p>
                </div>
                <div class="shrink-0 text-left sm:text-right" data-atropos-offset="6">
                  <p class="font-display text-[2rem] font-semibold leading-none text-ink">{eur(COURSE_TELC_B1_PRICE_EUR)}</p>
                  <p class="mt-1 font-data text-[0.75rem] text-graphite">one-time · no subscription</p>
                  <a href="/telc-b1-komplettvorbereitung/" class={`${BTN_SECONDARY} mt-4`}>
                    See the 4-week plan
                  </a>
                </div>
              </div>
            </div>
          </div></div></div>
        </div>
      </section>

      <!-- What Pro actually buys, in the product's own notation.
           The only place on this page where the case colours are allowed. -->
      <section class="mt-16 border-t border-rule pt-10" aria-labelledby="demo-h">
        <h2 id="demo-h" class="reveal font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[2rem]">
          Grammar you can see
        </h2>
        <p class="reveal mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-graphite sm:text-base" style="--rd:80ms">
          Sentence X-Ray takes a German sentence apart and colours each piece by its case, so the pattern
          becomes visible instead of memorised. The same colours run through every lesson.
        </p>
        <div class="reveal mt-6 flex flex-wrap items-stretch gap-2" style="--rd:160ms">
          {DEMO.map((w) => (
            <span class={`rounded-md border px-3 py-2 ${w.kasus ? KASUS_CLASS[w.kasus] : 'border-rule bg-paper-sunk text-graphite'}`}>
              <span class="block text-base font-semibold">{w.text}</span>
              <span class="mt-0.5 block font-data text-[0.6875rem] font-bold tracking-[0.13em]">{w.abbr}</span>
              <span class="mt-0.5 block text-[0.75rem] opacity-80">{w.gloss}</span>
            </span>
          ))}
        </div>
        <p class="reveal mt-3 font-data text-[0.8125rem] text-graphite" style="--rd:220ms">
          Free: {ANON_DAILY_LIMIT} sentence a day. Pro: {PRO_DAILY_LIMIT}.
        </p>
      </section>

      <!-- FAQ -->
      <section class="mt-16 border-t border-rule pt-10" aria-labelledby="faq-h">
        <h2 id="faq-h" class="reveal font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[2rem]">
          Before you decide
        </h2>
        <dl class="mt-6 max-w-prose">
          {FAQS.map((item, i) => (
            <div class="reveal border-b border-rule py-5" style={`--rd:${i * 70}ms`}>
              <dt class="text-[0.9375rem] font-semibold">{item.q}</dt>
              <dd class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">{item.a}</dd>
            </div>
          ))}
        </dl>
      </section>

    </div>
  </div>
</Layout>

<script>
  // Billing toggle + auth-aware LemonSqueezy checkout.
  //
  // Prices derive from ../data/pricing.js — the same module the server-rendered
  // table above reads, so the toggle cannot show a figure the static HTML
  // contradicts. Variant IDs stay literal: checkout plumbing, not copy.
  import { PLANS as DATA, eur as EUR } from '../data/pricing.js';

  const VARIANTS = {
    monthly: 'dfc81ca3-78f5-4bab-9d62-dca75b3f7e21',
    yearly: 'd58c1838-d935-4c59-a0ac-0bfce8ec9c3b',
  };

  let cycle = 'monthly';
  const $ = (id) => document.getElementById(id);

  function applyCycle() {
    const plan = DATA[cycle];
    $('pro-price').textContent = EUR(plan.price);
    $('pro-period').textContent = plan.interval;
    $('plan-note').textContent =
      cycle === 'yearly'
        ? EUR(plan.asMonthly) + ' a month, billed yearly · cancel anytime'
        : EUR(plan.perDay) + ' a day · cancel anytime';

    const on = 'rounded-pill px-4 py-1.5 text-sm font-bold transition-colors bg-ink text-paper';
    const off = 'rounded-pill px-4 py-1.5 text-sm font-bold transition-colors text-graphite hover:text-ink';
    $('toggle-monthly').className = cycle === 'monthly' ? on : off;
    $('toggle-yearly').className = cycle === 'yearly' ? on : off;
    $('toggle-monthly').setAttribute('aria-pressed', String(cycle === 'monthly'));
    $('toggle-yearly').setAttribute('aria-pressed', String(cycle === 'yearly'));
  }

  function currentUser() {
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && /^sb-.*-auth-token$/.test(k)) {
          const v = JSON.parse(localStorage.getItem(k) || 'null');
          const u = (v && (v.user || (v.currentSession && v.currentSession.user))) || null;
          if (u && u.id) return { email: u.email || '', id: u.id };
        }
      }
    } catch (e) { /* private mode — treat as signed out */ }
    return null;
  }

  function checkoutUrl(variant, email, id) {
    const params = new URLSearchParams({ 'checkout[email]': email || '', 'checkout[custom][user_id]': id || '' });
    return 'https://deutsch-meister.lemonsqueezy.com/checkout/buy/' + variant + '?' + params.toString();
  }

  document.addEventListener('DOMContentLoaded', () => {
    applyCycle();
    $('toggle-monthly').addEventListener('click', () => { cycle = 'monthly'; applyCycle(); });
    $('toggle-yearly').addEventListener('click', () => { cycle = 'yearly'; applyCycle(); });

    // Never a new tab: iOS Safari blocks the popup and in-app browsers
    // swallow it, so the customer sees nothing happen. Prefer the
    // LemonSqueezy overlay, fall back to same-tab navigation.
    // Signed-out click: remember WHAT they wanted before the signup detour.
    // The SPA reads dm_buy_intent after email verification / login and lands
    // on /subscription?buy=<key>, which opens this exact checkout once.
    function open(variant, intentKey) {
      const u = currentUser();
      if (!u) {
        try { localStorage.setItem('dm_buy_intent', intentKey); } catch (e) { /* private mode */ }
        window.location.href = 'https://deutsch-meister.de/signup';
        return;
      }
      const url = checkoutUrl(variant, u.email, u.id);
      if (window.LemonSqueezy && window.LemonSqueezy.Url && window.LemonSqueezy.Url.Open) {
        window.LemonSqueezy.Url.Open(url);
      } else {
        window.location.href = url;
      }
    }

    // Overlay checkout for signed-in visitors, so a purchase ends on OUR
    // success page instead of Lemon Squeezy's receipt with no way back. Loaded
    // only when a session exists; if it has not loaded by click time the
    // same-tab fallback above still works (the product's redirect URL covers it).
    if (currentUser() && !document.querySelector('script[src*="lemon.js"]')) {
      const s = document.createElement('script');
      s.src = 'https://app.lemonsqueezy.com/js/lemon.js';
      s.defer = true;
      s.onload = () => {
        try {
          window.createLemonSqueezy && window.createLemonSqueezy();
          window.LemonSqueezy && window.LemonSqueezy.Setup && window.LemonSqueezy.Setup({
            eventHandler: (evt) => {
              if (evt && evt.event === 'Checkout.Success') {
                window.location.href = 'https://deutsch-meister.de/subscription/success';
              }
            },
          });
        } catch (e) { /* overlay optional */ }
      };
      document.head.appendChild(s);
    }

    $('pro-btn').addEventListener('click', () => open(VARIANTS[cycle], cycle));

    // Level-course buttons carry their own checkout id (build-time env).
    document.querySelectorAll('[data-course-variant]').forEach((btn) => {
      btn.addEventListener('click', () =>
        open(btn.getAttribute('data-course-variant'), btn.getAttribute('data-course-key')),
      );
    });
  });
</script>
