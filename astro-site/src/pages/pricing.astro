---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/concept/Scene.astro';
import Ladder from '../components/concept/Ladder.astro';
import PromiseBand from '../components/concept/PromiseBand.astro';
import CourseCheckout from '../components/CourseCheckout.astro';
import { OFFER_FAQ, FREE_COURSE_HREF } from '../data/offers.js';
import { COURSE_PRO_DAYS } from '../data/pricing.js';
import { BILLING_PORTAL_URL } from '../lib/billingPortal.js';
import '../styles/global.css';
const title = 'German Course Prices | DeutschMeister';
const description = `Buy each German course separately, with ${COURSE_PRO_DAYS} days of AI tools included. Lektion 1 of A1.1, the placement test and public library are free.`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: OFFER_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Layout title={title} description={description} canonical="https://deutsch-meister.de/pricing/" jsonLd={jsonLd}>
  <section class="c4-wrap c4-pricing-hero" aria-labelledby="pricing-h">
    <div><h1 id="pricing-h">Pay once for<br /><span class="c4-underline">your next course.</span></h1><p>Each purchase opens that course only: lessons, checkpoints, final test, review and certificate. AI tools are included for {COURSE_PRO_DAYS} days.</p></div>
    <Scene name="pricing-hero" alt="A learner planning her German course" hero sizes="600px" />
  </section>
  <PromiseBand />
  <div class="c4-wrap">
    <section class="c4-free-banner" aria-label="Start free"><p>Lektion 1 of A1.1 is free, with no account needed. The placement test and public library stay free.</p><a href={FREE_COURSE_HREF} class="c4-button c4-button-coral">Try Lektion 1 free →</a></section>
    <section aria-label="Course prices"><Ladder illustrated /></section>
    <section class="c4-faq" aria-labelledby="pricing-faq"><h2 id="pricing-faq">Questions about your course</h2><div>{OFFER_FAQ.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
    <p>Already subscribed? Your current access and renewals continue. <a href={BILLING_PORTAL_URL} class="c4-text-link">Manage or cancel your subscription →</a></p>
  </div>
  <CourseCheckout />
</Layout>
