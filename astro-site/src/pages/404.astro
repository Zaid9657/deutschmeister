---
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';
import '../styles/global.css';

// Astro always emits src/pages/404.astro as /404.html (even with
// build.format: 'directory'), which Netlify serves for the 404 fallback.
//
// No canonical: it used to point at the homepage, which contradicts the noindex
// on the same page and, if honoured, would consolidate every 404 onto '/'.
// The noindex alone is the correct and sufficient signal.
//
// Playful Depth: aurora ground, one big display heading, one pressable primary
// CTA home and a secondary into the grammar library.
const BTN =
  'inline-flex items-center justify-center gap-2 rounded-clay text-base font-bold transition-all duration-100 ease-snap select-none';
const BTN_PRIMARY = `${BTN} btn-shimmer relative overflow-hidden bg-siegel px-7 py-3.5 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_SECONDARY = `${BTN} border border-rule bg-white px-7 py-3.5 text-ink shadow-raise hover:border-siegel hover:text-siegel-deep active:translate-y-1 active:shadow-none`;
---

<Layout
  title="Page Not Found (404) | DeutschMeister"
  description="This page doesn't exist or has moved. Explore German grammar lessons from A1 to B2 on DeutschMeister."
  canonical={null}
  noindex={true}
>
  <section class="relative flex min-h-[60vh] items-center justify-center overflow-hidden bg-paper px-5 py-20 text-ink">
    <Aurora />
    <div class="relative w-full max-w-md text-center">
      <div class="hero-line mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-clay border border-rule bg-white shadow-raise" style="--d:0ms">
        <span class="font-display text-4xl font-bold text-siegel">?</span>
      </div>
      <h1 class="hero-line mb-2 font-display text-[5rem] font-semibold leading-none tracking-[-0.03em] text-ink sm:text-[6.5rem]" style="--d:80ms">404</h1>
      <h2 class="hero-line mb-4 font-display text-[1.25rem] font-semibold text-graphite" style="--d:180ms">Page Not Found</h2>
      <p class="hero-line mb-8 text-[0.9375rem] leading-relaxed text-graphite sm:text-base" style="--d:260ms">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="hero-line flex flex-col justify-center gap-4 sm:flex-row" style="--d:360ms">
        <a
          href="https://deutsch-meister.de/"
          class={BTN_PRIMARY}
        >
          <span class="relative z-10">Go home</span>
        </a>
        <a
          href="/grammar/"
          class={BTN_SECONDARY}
        >
          Browse grammar
        </a>
      </div>
    </div>
  </section>
</Layout>
