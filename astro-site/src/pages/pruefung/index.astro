---
// The exam hub index — "which exam are you preparing for?" as a page.
// Lists the four tracks from the shared registry; each card leads to its hub.
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { ORGANIZATION } from '../../lib/siteMeta.js';
import { EXAM_HUBS } from '../../data/exams/index.js';

const title = 'Deutschprüfungen: telc, Goethe & DTZ Vorbereitung | DeutschMeister';
const description =
  'Auf welche Deutschprüfung bereitest du dich vor? Vorbereitungswege für telc B1, Goethe-Zertifikat B1, DTZ und telc B2 — mit kostenlosem Einstufungstest.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Prüfungsvorbereitung',
  description,
  url: 'https://deutsch-meister.de/pruefung/',
  inLanguage: 'de',
  publisher: ORGANIZATION,
};
---

<Layout
  title={title}
  description={description}
  canonical="https://deutsch-meister.de/pruefung/"
  jsonLd={jsonLd}
  lang="de"
>
  <div class="bg-paper text-ink">
    <div class="mx-auto max-w-3xl px-5 pb-20 pt-12">
      <header class="border-b border-rule pb-8">
        <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Prüfungsvorbereitung</p>
        <h1 class="mt-3 font-display text-[2rem] font-semibold leading-[1.1] tracking-[-0.02em] sm:text-[2.75rem]">
          Auf welche Prüfung bereitest du dich vor?
        </h1>
        <p class="mt-5 text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.125rem]">
          Jede Prüfung hat ihr eigenes Format — und ihren eigenen Vorbereitungsweg durch die
          DeutschMeister-Bibliothek. Wähl deine Prüfung; wenn du dein Niveau noch nicht kennst,
          starte mit dem <a href="/level-test/" class="text-siegel underline-offset-2 hover:underline">kostenlosen Einstufungstest</a>.
        </p>
      </header>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {EXAM_HUBS.map((hub) => (
          <li>
            <a href={`/pruefung/${hub.slug}/`} class="block h-full rounded-lg border border-rule p-6 transition-colors hover:border-siegel">
              <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">{hub.level}</p>
              <h2 class="mt-2 font-display text-[1.25rem] font-semibold text-ink">{hub.nameDe}</h2>
              <p class="mt-2 text-[0.875rem] leading-relaxed text-graphite">{hub.focus}</p>
              <span class="mt-4 inline-block text-[0.875rem] font-semibold text-siegel">Vorbereitung ansehen →</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mt-10 text-[0.875rem] leading-relaxed text-graphite">
        Du lernst ohne Prüfungstermin? Dann führt dein Weg über die
        <a href="/grammar/" class="text-siegel underline-offset-2 hover:underline">Grammatik-Bibliothek</a> —
        A1.1 ist komplett kostenlos, ohne Konto.
      </p>
    </div>
  </div>
</Layout>
