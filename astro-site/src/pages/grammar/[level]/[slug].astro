---
import Layout from '../../../layouts/Layout.astro';
import ExercisePlayer from '../../../components/ExercisePlayer.jsx';
import RuleContent from '../../../components/RuleContent.astro';
import RichText from '../../../components/RichText.astro';
import Aurora from '../../../components/Aurora.astro';
import { getAllTopicPaths, getTopicFull, getAllTopics, SUB_LEVELS, LEVEL_META } from '../../../lib/grammar.js';
import { RELATED_TOPICS } from '../../../lib/relatedTopics.js';
import { TOPIC_SEO } from '../../../lib/topicSeo.js';
import { ORGANIZATION, SITE_PUBLISHED } from '../../../lib/siteMeta.js';
import '../../../styles/global.css';

// True when a rule's JSONB content (object, array, or plain string) holds
// anything worth rendering — used to skip the white body only when it would
// otherwise be empty.
const hasRenderable = (v) => {
  if (v == null || v === '') return false;
  if (Array.isArray(v)) return v.length > 0;
  if (typeof v === 'object') return Object.keys(v).length > 0;
  return true;
};

// word_breakdown is stored as a plain object whose key order does NOT follow the
// sentence (e.g. "Der Tisch ist groß." → {Der, ist, Tisch, groß}, or "Ich gebe
// dem Mann das Buch." → {Ich, gebe, das Buch, dem Mann}). Re-order the rows to
// match the actual word order of sentence_de. Keys may be multi-word phrase
// chunks ("dem Mann", "in Berlin"), so match by position within the sentence,
// not by single-token lookup. Chunks not found keep their relative order at the
// end (stable).
const orderBySentence = (rows, sentence) => {
  if (!sentence || !Array.isArray(rows)) return rows;
  // Lowercase, collapse anything non-letter/number to single spaces.
  const clean = (s) => String(s).toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
  const sNorm = clean(sentence);
  const padded = ` ${sNorm} `;
  const sTokens = sNorm ? sNorm.split(' ') : [];
  const BIG = Number.MAX_SAFE_INTEGER;
  const posOf = (chunk) => {
    const w = clean(chunk);
    if (!w) return BIG;
    // Whole word/phrase match on space boundaries (handles "dem mann").
    const idx = padded.indexOf(` ${w} `);
    if (idx !== -1) return idx;
    // Fallback: position of the chunk's first token, ranked after phrase matches.
    const ti = sTokens.indexOf(w.split(' ')[0]);
    return ti === -1 ? BIG : 1_000_000 + ti;
  };
  return rows
    .map((r, i) => ({ r, i, p: posOf(r.word) }))
    .sort((a, b) => (a.p - b.p) || (a.i - b.i))
    .map((x) => x.r);
};

export async function getStaticPaths() {
  const paths = await getAllTopicPaths();
  return paths.map(({ slug, sub_level }) => ({
    params: { level: sub_level, slug },
  }));
}

const { level, slug } = Astro.params;
const data = await getTopicFull(level, slug);

if (!data) {
  return Astro.redirect('/grammar', 302);
}

const { topic, rules, examples, exercises, prev, next } = data;
const meta = LEVEL_META[level] ?? LEVEL_META['a1.1'];

// Related topics: prefer the DB `related_slugs` column when populated, otherwise
// fall back to the static grammatical mapping. Resolve each slug to a full topic
// (for its title + level) and drop unknowns / self-references.
const allTopics = await getAllTopics();
const topicIndex = new Map(allTopics.map((t) => [t.slug, t]));

// Global next topic (bridges level boundaries — the last topic of a1.1 points to
// the first of a1.2). Used by the end-of-topic momentum block. getTopicFull's
// `next` is within-level only, so compute the cross-level order here.
const orderedAll = SUB_LEVELS.flatMap((l) => allTopics.filter((t) => t.sub_level === l));
const curIdx = orderedAll.findIndex((t) => t.sub_level === level && t.slug === slug);
const nextGlobal = (curIdx !== -1 && curIdx < orderedAll.length - 1) ? orderedAll[curIdx + 1] : null;
const relatedSlugs = (Array.isArray(topic.related_slugs) && topic.related_slugs.length > 0)
  ? topic.related_slugs
  : (RELATED_TOPICS[slug] ?? []);
const relatedTopics = relatedSlugs
  .filter((s) => s && s !== slug)
  .map((s) => topicIndex.get(s))
  .filter(Boolean)
  .slice(0, 5);

const topicTitle = topic?.title_en ?? slug;
const canonicalUrl = `https://deutsch-meister.de/grammar/${level}/${slug}`;
// Site is trailingSlash: 'always' — the no-slash URL 301-redirects to this.
// canonical/og:url must match the final URL (and the sitemap) exactly.
const canonicalUrlSlash = `${canonicalUrl}/`;

// Titles must stay under ~60 chars or Google truncates them; drop the brand
// suffix on long topic names rather than losing the level label.
const titleCore = `German ${topicTitle} — ${meta.label} Grammar`;
const pageTitle = titleCore.length <= 43
  ? `${titleCore} | DeutschMeister`
  : titleCore;

// Join the DB description (which has no trailing punctuation) into a real
// sentence, then clamp on a word boundary so descriptions never end mid-word.
function clamp(text, max = 155) {
  const t = text.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  return `${t.slice(0, t.lastIndexOf(' ', max - 1))}…`;
}
const descBase = topic?.description_en
  ? `${topic.description_en.replace(/[.\s]+$/, '')}. Clear rules, real examples, and practice exercises for ${meta.label} German learners.`
  : `Learn German ${topicTitle} explained in English, with clear rules, real examples, and interactive exercises at ${meta.label} level.`;
const pageDesc = clamp(descBase);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',      item: 'https://deutsch-meister.de/' },
    { '@type': 'ListItem', position: 2, name: 'Grammar', item: 'https://deutsch-meister.de/grammar/' },
    { '@type': 'ListItem', position: 3, name: meta.label,  item: `https://deutsch-meister.de/grammar/${level}/` },
    { '@type': 'ListItem', position: 4, name: topicTitle,  item: canonicalUrlSlash },
  ],
};

// Article + LearningResource: these pages are lessons, and the educational
// properties are what AI answer engines and Google's learning surfaces read.
// One entity, one @id — the local re-declaration is gone.
const publisher = ORGANIZATION;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'LearningResource'],
  headline: pageTitle,
  name: `German ${topicTitle}`,
  description: pageDesc,
  url: canonicalUrlSlash,
  image: 'https://deutsch-meister.de/og-image.png',
  inLanguage: 'en',
  publisher,
  author: publisher,
  datePublished: SITE_PUBLISHED,
  // The topic's own DB timestamp, not the build date: stamping every deploy
  // claims a freshness the content does not have (see sitemap-spa.xml's
  // lastmod argument). Falls back to launch for rows without one.
  dateModified: topic.updated_at?.slice(0, 10) ?? SITE_PUBLISHED,
  educationalLevel: `CEFR ${meta.label}`,
  learningResourceType: 'Lesson',
  educationalUse: 'self-study',
  typicalAgeRange: '16-',
  isAccessibleForFree: level === 'a1.1',
  teaches: topic?.title_de ? `${topicTitle} (${topic.title_de})` : topicTitle,
  about: { '@type': 'Thing', name: `German grammar: ${topicTitle}` },
  ...(exercises.length ? { hasPart: { '@type': 'Quiz', name: `${topicTitle} practice exercises`, educationalLevel: `CEFR ${meta.label}` } } : {}),
};

// Per-topic SEO enrichment (snippet intro + FAQ section + FAQPage schema).
const seoExtra = TOPIC_SEO[`${level}/${slug}`];
const jsonLdSchemas = [breadcrumbSchema, articleSchema];
if (seoExtra?.faqs?.length) {
  jsonLdSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: seoExtra.faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}

// Playful Depth vocabulary (docs/design/playbook.md). Rule 3 governs this page:
// the lesson — rules, tables, examples — is reference material and stays FLAT
// (hairline `border-rule`, no shadow); only things you can press are raised.
// The level code is data → `label` chip, never a level colour (rule 1).
const H2 = 'font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]';
const LEVEL_CHIP =
  'rounded-pill bg-siegel-wash px-2.5 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep';
const CARD_FLAT = 'rounded-clay border border-rule bg-white';
const CARD_INTERACTIVE =
  'rounded-clay border border-rule bg-white shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg active:translate-y-1 active:shadow-none';
const BTN_PRIMARY =
  'btn-shimmer relative inline-flex select-none items-center justify-center gap-2 overflow-hidden rounded-clay bg-siegel px-7 py-3.5 text-base font-bold text-white shadow-raise-siegel transition-all duration-100 ease-snap hover:bg-siegel-lift active:translate-y-1 active:shadow-none';
const CALLOUT_LABEL = 'font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em]';
---

<Layout title={pageTitle} description={pageDesc} canonical={canonicalUrlSlash} jsonLd={jsonLdSchemas} ogType="article">
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- ═══ Lesson header ═══ -->
    <header class="relative">
      <Aurora />
      <div class="relative mx-auto max-w-3xl px-5 pt-10 pb-8 sm:pt-14">
        <!-- Breadcrumb -->
        <nav class="hero-line mb-8 flex flex-wrap items-center gap-2 font-data text-[0.8125rem] text-graphite" aria-label="Breadcrumb" style="--d:0ms">
          <a href="https://deutsch-meister.de/" class="transition-colors hover:text-siegel-deep">Home</a>
          <span>/</span>
          <a href="/grammar/" class="transition-colors hover:text-siegel-deep">Grammar</a>
          <span>/</span>
          <a href={`/grammar/${level}/`} class="transition-colors hover:text-siegel-deep">{meta.label}</a>
          <span>/</span>
          <span class="font-semibold text-ink">{topic.title_en}</span>
        </nav>

        <!-- Level badge -->
        <div class="hero-line mb-4 inline-flex items-center gap-2" style="--d:60ms">
          <span class={LEVEL_CHIP}>{meta.label} · {meta.name}</span>
        </div>

        <!-- Title -->
        <h1 class="hero-line font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.025em] sm:text-[3rem]" style="--d:140ms">
          {topicTitle}
        </h1>
        {topic?.title_de && topic.title_de !== topicTitle && (
          <p class="hero-line mt-2 font-display text-xl text-graphite" lang="de" style="--d:220ms">{topic.title_de}</p>
        )}

        {seoExtra?.snippetIntro && (
          <p class="hero-line mt-6 text-[1.0625rem] leading-relaxed text-ink sm:text-[1.1875rem]" style="--d:300ms">
            {seoExtra.snippetIntro}
          </p>
        )}

        {topic?.description_en && (
          <p class="hero-line mt-5 border-l-4 border-siegel pl-4 text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" style="--d:380ms">
            {topic.description_en}
          </p>
        )}
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-5 pb-10">

    <!-- Introduction -->
    {topic?.introduction_en && (
      <section class="reveal mb-12">
        <h2 class={`${H2} mb-4`}>Introduction</h2>
        <div class="whitespace-pre-line text-[0.9375rem] leading-relaxed text-ink sm:text-base">{topic.introduction_en}</div>
      </section>
    )}

    <!-- Rules -->
    {rules.length > 0 && (
      <section class="mb-12">
        <h2 class={`reveal ${H2} mb-6`}>Rules & Explanations</h2>
        <div class="space-y-6">
          {rules.map((rule, ri) => {
            // content may be a plain string, a parsed object, an array, or null
            const raw = rule.content;
            const content = (raw && typeof raw === 'object' && !Array.isArray(raw)) ? raw : null;
            const isIntro = rule.rule_type === 'introduction';

            // common_mistakes: guard for null / non-array
            const mistakes = Array.isArray(rule.common_mistakes) ? rule.common_mistakes : [];

            // key_insight / memory_trick can live on their own columns OR nested
            // inside the content JSONB. The generic renderer surfaces the nested
            // ones, so the column callouts below fire only for the column values
            // (avoids double-rendering the same insight).
            const showColKeyInsight = !!rule.key_insight_en;
            const showColMemoryTrick = !!rule.memory_trick_en;

            // Only render the white body when it will actually contain something.
            const showBody = (isIntro && !!content)
              || (!isIntro && hasRenderable(raw))
              || showColKeyInsight || showColMemoryTrick || mistakes.length > 0;

            return (
              <div class={`reveal overflow-hidden ${CARD_FLAT}`} style={`--rd:${(ri % 3) * 90}ms`}>
                <div class="border-b border-rule bg-paper-sunk px-5 py-4">
                  <h3 class="font-display text-[1.125rem] font-semibold leading-snug"><RichText text={rule.title_en} /></h3>
                  {rule.title_de && rule.title_de !== rule.title_en && (
                    <p class="mt-0.5 text-sm text-graphite" lang="de"><RichText text={rule.title_de} /></p>
                  )}
                </div>

                {showBody && (
                <div class="bg-white px-5 py-4">
                  {/* Introduction rule type — custom rich content fields */}
                  {isIntro && content && (
                    <div class="space-y-4">
                      {content.hook_en && (
                        <p class="text-base font-semibold text-ink"><RichText text={content.hook_en} /></p>
                      )}
                      {content.german_difference_en && (
                        <p class="text-sm leading-relaxed text-ink"><RichText text={content.german_difference_en} /></p>
                      )}
                      {content.english_comparison_en && (
                        <p class="text-sm leading-relaxed text-graphite"><RichText text={content.english_comparison_en} /></p>
                      )}
                      {content.scenario_en && (
                        <div class="rounded-md border border-rule bg-paper-sunk p-3 text-sm text-ink">
                          <span class={`${CALLOUT_LABEL} mb-1 block text-graphite`}>Why you need this</span>
                          <RichText text={content.scenario_en} />
                        </div>
                      )}
                      {content.preview_example_de && (
                        <div class="rounded-md border border-rule bg-white p-3">
                          <p class="font-display text-lg font-semibold text-ink" lang="de">{content.preview_example_de}</p>
                          {content.preview_example_en && (
                            <p class="mt-0.5 text-sm italic text-graphite">{content.preview_example_en}</p>
                          )}
                          {content.preview_note_en && (
                            <p class="mt-2 rounded-md bg-accent-aprikose-wash px-2 py-1 text-xs text-accent-aprikose-ink"><RichText text={content.preview_note_en} /></p>
                          )}
                        </div>
                      )}
                      {content.why_it_matters_en && (
                        <div class="flex items-start gap-3 rounded-md border border-rule bg-accent-aprikose-wash p-3">
                          <span class="flex-shrink-0 text-lg" aria-hidden="true">💡</span>
                          <p class="text-sm text-accent-aprikose-ink"><RichText text={content.why_it_matters_en} /></p>
                        </div>
                      )}
                    </div>
                  )}

                  {/* All other rule types — recursive, shape-aware renderer that
                      handles bilingual prose, string lists, sections, steps,
                      mistakes, dialogue, nested tables and grouped objects. */}
                  {!isIntro && hasRenderable(raw) && (
                    <RuleContent node={raw} meta={meta} />
                  )}

                  {/* Key insight (column) */}
                  {showColKeyInsight && (
                    <div class="mt-4 flex items-start gap-3 rounded-md border border-rule bg-accent-aprikose-wash p-3">
                      <span class="flex-shrink-0 text-lg" aria-hidden="true">💡</span>
                      <p class="text-sm font-medium text-accent-aprikose-ink"><RichText text={rule.key_insight_en} /></p>
                    </div>
                  )}

                  {/* Memory trick (column) */}
                  {showColMemoryTrick && (
                    <div class="mt-3 flex items-start gap-3 rounded-md border border-rule bg-siegel-wash p-3">
                      <span class="flex-shrink-0 text-lg" aria-hidden="true">🧠</span>
                      <p class="text-sm text-siegel-deep"><RichText text={rule.memory_trick_en} /></p>
                    </div>
                  )}

                  {/* Common mistakes — shape: {wrong, correct, explanation_en} or plain string */}
                  {mistakes.length > 0 && (
                    <div class="mt-3 rounded-md border border-rule bg-accent-himbeer-wash p-3">
                      <p class={`${CALLOUT_LABEL} mb-2 text-accent-himbeer-ink`}>Common Mistakes</p>
                      <ul class="space-y-3">
                        {mistakes.map((m) => (
                          <li class="text-sm text-ink">
                            {typeof m === 'string' ? (
                              <span class="flex items-start gap-2">
                                <span class="mt-0.5 flex-shrink-0 font-bold text-accent-himbeer-ink">✗</span>
                                <span>{m}</span>
                              </span>
                            ) : (
                              <div class="space-y-0.5">
                                {m.wrong && (
                                  <p class="flex items-start gap-2">
                                    <span class="flex-shrink-0 font-bold text-accent-himbeer-ink">✗</span>
                                    <span class="text-accent-himbeer-ink line-through" lang="de">{m.wrong}</span>
                                  </p>
                                )}
                                {m.correct && (
                                  <p class="flex items-start gap-2">
                                    <span class="flex-shrink-0 font-bold text-accent-limette-ink">✓</span>
                                    <span class="font-medium text-accent-limette-ink" lang="de">{m.correct}</span>
                                  </p>
                                )}
                                {m.explanation_en && (
                                  <p class="pl-5 text-xs text-graphite"><RichText text={m.explanation_en} /></p>
                                )}
                              </div>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
                )}
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Examples -->
    {examples.length > 0 && (
      <section class="mb-12">
        <h2 class={`reveal ${H2} mb-6`}>Examples</h2>
        <div class="space-y-4">
          {examples.map((ex, ei) => {
            // word_breakdown can be:
            //   - null / undefined
            //   - a plain object: { "Wie": "how/what", "du": "you" }  ← actual shape
            //   - an array of { word, translation, role } objects
            const rawBreakdown = ex.word_breakdown;
            let breakdownRows = null;
            if (Array.isArray(rawBreakdown) && rawBreakdown.length > 0) {
              // Array of objects — already the expected shape
              breakdownRows = rawBreakdown.map((w) => ({
                word: w.word ?? w.de ?? String(w[0] ?? ''),
                meaning: w.translation ?? w.en ?? String(w[1] ?? ''),
                role: w.role ?? w.function ?? w[2] ?? null,
              }));
            } else if (rawBreakdown && typeof rawBreakdown === 'object') {
              // Plain object: keys are German words, values are meanings
              breakdownRows = Object.entries(rawBreakdown).map(([word, meaning]) => ({
                word,
                meaning: String(meaning),
                role: null,
              }));
            }

            // Present the words in the sentence's actual order, not the DB's.
            if (breakdownRows) breakdownRows = orderBySentence(breakdownRows, ex.sentence_de);

            return (
              <div class={`reveal overflow-hidden ${CARD_FLAT}`} style={`--rd:${(ei % 3) * 90}ms`}>
                <div class="px-5 py-4">
                  <p class="mb-1 font-display text-xl font-semibold text-ink" lang="de">{ex.sentence_de}</p>
                  <p class="mb-2 text-sm italic text-graphite">{ex.sentence_en}</p>

                  {ex.grammar_highlight && (
                    <span class={`inline-block ${LEVEL_CHIP}`}>
                      {ex.grammar_highlight}
                    </span>
                  )}

                  {ex.explanation_en && (
                    <p class="mt-3 text-sm leading-relaxed text-graphite">{ex.explanation_en}</p>
                  )}

                  {/* Word breakdown table — flat (rule 3) */}
                  {breakdownRows && breakdownRows.length > 0 && (
                    <div class="mt-4 overflow-x-auto">
                      <table class="w-full border-collapse text-left text-xs">
                        <thead>
                          <tr class="border-b border-ink bg-paper-sunk">
                            <th class={`px-3 py-2 ${CALLOUT_LABEL} text-graphite`}>Word</th>
                            <th class={`px-3 py-2 ${CALLOUT_LABEL} text-graphite`}>Meaning</th>
                            {breakdownRows.some((r) => r.role) && (
                              <th class={`px-3 py-2 ${CALLOUT_LABEL} text-graphite`}>Function</th>
                            )}
                          </tr>
                        </thead>
                        <tbody>
                          {breakdownRows.map((w) => (
                            <tr class="border-b border-rule">
                              <td class="px-3 py-2 font-accent font-medium text-ink" lang="de">{w.word}</td>
                              <td class="px-3 py-2 italic text-graphite">{w.meaning}</td>
                              {breakdownRows.some((r) => r.role) && (
                                <td class="px-3 py-2 text-graphite">{w.role ?? '—'}</td>
                              )}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Exercises (React island — lazy loaded on scroll into view) -->
    {exercises.length > 0 && (
      <section class="mb-12">
        <h2 class={`reveal ${H2} mb-2`}>Practice Exercises</h2>
        <p class="reveal mb-5 font-data text-[0.8125rem] text-graphite" style="--rd:80ms">{exercises.length} interactive {exercises.length === 1 ? 'exercise' : 'exercises'}</p>
        <div class={`reveal p-6 ${CARD_FLAT}`} style="--rd:160ms">
          <ExercisePlayer
            exercises={exercises}
            topicId={topic.id}
            nextHref={nextGlobal ? `/grammar/${nextGlobal.sub_level}/${nextGlobal.slug}/` : undefined}
            nextTitle={nextGlobal?.title_en}
            client:visible
          />
        </div>
      </section>
    )}

    <!-- Momentum block — keep learners moving to the next topic. The next-up card
         is static (order is known at build); the score line is filled client-side
         after the exercises are finished. -->
    <section class="mb-12">
      <!-- Score recap (revealed once the exercises are completed; the script adds
           the limette pass tone or the aprikose "keep going" tone — never colour alone) -->
      <div id="momentum-score" class="mb-4 hidden rounded-clay border border-rule bg-paper-sunk px-5 py-4 text-center">
        <p class="text-sm font-semibold">
          You got <span id="momentum-score-val" class="font-data font-bold"></span> on this topic's exercises.
        </p>
        <p id="momentum-score-note" class="mt-0.5 text-xs"></p>
      </div>

      {nextGlobal ? (
        <div class="reveal">
          <div class="atropos" data-atropos-card>
            <div class="atropos-scale"><div class="atropos-rotate"><div class="atropos-inner !overflow-visible">
              <a
                href={`/grammar/${nextGlobal.sub_level}/${nextGlobal.slug}/`}
                class={`group block p-6 ${CARD_INTERACTIVE}`}
              >
                <p class="mb-2 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" data-atropos-offset="3">Next up</p>
                <div class="flex items-center gap-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-display text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-siegel-deep sm:text-2xl" data-atropos-offset="5">
                      {nextGlobal.title_en}
                    </p>
                    {nextGlobal.description_en && (
                      <p class="mt-1 line-clamp-2 text-sm text-graphite" data-atropos-offset="2">{nextGlobal.description_en}</p>
                    )}
                    <span class={`mt-3 inline-block ${LEVEL_CHIP}`} data-atropos-offset="6">
                      {(LEVEL_META[nextGlobal.sub_level] ?? meta).label}
                    </span>
                  </div>
                  <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-pill bg-siegel text-xl text-white shadow-raise-siegel transition-all group-hover:bg-siegel-lift group-hover:translate-x-0.5" data-atropos-offset="9" aria-hidden="true">
                    →
                  </span>
                </div>
              </a>
            </div></div></div>
          </div>
        </div>
      ) : (
        <div class="reveal rounded-clay border border-rule bg-accent-limette-wash p-6 text-center">
          <p class="font-display text-xl font-semibold text-ink">🏆 That's the last topic — you've reached the end of the path.</p>
          <p class="mt-1 text-sm text-graphite">Revisit any topic to keep it sharp.</p>
        </div>
      )}

      <div class="mt-4 text-center">
        <a href={`/grammar/${level}/`} class="text-sm font-bold text-siegel transition-colors hover:text-siegel-deep">
          ← Back to {meta.label} overview
        </a>
      </div>
    </section>

    <!-- Upgrade CTA — the page's one primary (shimmer) action -->
    <section class="reveal relative mb-12 overflow-hidden rounded-clay border border-rule bg-paper-sunk p-6 text-center sm:p-8">
      <Aurora variant="close" />
      <div class="relative">
        <p class="font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[1.75rem]">
          Grammar is just the beginning
        </p>
        <p class="mx-auto mt-2 mb-6 max-w-md text-[0.9375rem] leading-relaxed text-graphite">
          Practice {topicTitle} in real conversations with your AI language partner.
        </p>
        <a href="https://deutsch-meister.de/signup" class={BTN_PRIMARY}>
          <span class="relative z-10">Get started free — 7 days of Pro included</span>
        </a>
      </div>
    </section>

    <!-- Related Topics -->
    {relatedTopics.length > 0 && (
      <section class="mb-12">
        <h2 class={`reveal ${H2} mb-6`}>Related Topics</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {relatedTopics.map((rt, i) => {
            const rmeta = LEVEL_META[rt.sub_level] ?? meta;
            return (
              <a
                href={`/grammar/${rt.sub_level}/${rt.slug}/`}
                class={`reveal group flex items-start gap-3 p-4 ${CARD_INTERACTIVE}`}
                style={`--rd:${(i % 4) * 80}ms`}
              >
                <span class={`mt-0.5 flex-shrink-0 ${LEVEL_CHIP}`}>
                  {rmeta.label}
                </span>
                <div class="min-w-0">
                  <p class="text-sm font-bold text-ink transition-colors group-hover:text-siegel-deep">{rt.title_en}</p>
                  {rt.description_en && (
                    <p class="mt-0.5 line-clamp-2 text-xs leading-snug text-graphite">{rt.description_en}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Per-topic FAQ (see src/lib/topicSeo.js) — reference, flat -->
    {seoExtra?.faqs?.length > 0 && (
      <section class="mb-12">
        <h2 class={`reveal ${H2} mb-6`}>{seoExtra.faqHeading ?? 'Common questions'}</h2>
        <div class="space-y-3">
          {seoExtra.faqs.map(({ q, a }, i) => (
            <details class={`reveal group overflow-hidden ${CARD_FLAT}`} style={`--rd:${(i % 4) * 70}ms`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 font-semibold text-ink transition-colors hover:bg-paper-sunk">
                <span>{q}</span>
                <span class="flex-shrink-0 text-siegel transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
              </summary>
              <p class="px-5 pb-5 pt-1 text-sm leading-relaxed text-graphite">{a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Prev / Next navigation — pressable -->
    <nav class="reveal flex items-center justify-between gap-4 border-t border-rule pt-6">
      {prev ? (
        <a
          href={`/grammar/${level}/${prev.slug}/`}
          class={`group flex max-w-[45%] items-center gap-2 px-4 py-3 ${CARD_INTERACTIVE}`}
        >
          <svg class="h-4 w-4 flex-shrink-0 text-siegel transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          <div class="min-w-0">
            <p class="mb-0.5 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">Previous</p>
            <p class="truncate text-sm font-bold text-ink">{prev?.title_en ?? prev?.slug}</p>
          </div>
        </a>
      ) : (
        <div />
      )}

      {next ? (
        <a
          href={`/grammar/${level}/${next.slug}/`}
          class={`group ml-auto flex max-w-[45%] items-center gap-2 px-4 py-3 text-right ${CARD_INTERACTIVE}`}
        >
          <div class="min-w-0">
            <p class="mb-0.5 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">Next</p>
            <p class="truncate text-sm font-bold text-ink">{next?.title_en ?? next?.slug}</p>
          </div>
          <svg class="h-4 w-4 flex-shrink-0 text-siegel transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ) : (
        <div />
      )}
    </nav>

    <!-- All topics in this level -->
    <div class="mt-8 border-t border-rule pt-6">
      <a href={`/grammar/${level}/`} class="text-sm font-bold text-siegel transition-colors hover:text-siegel-deep">
        ← All {meta.label} topics
      </a>
    </div>

    </div>
  </div>

  <!-- Fill the momentum score recap once the exercises are finished. The
       ExercisePlayer island dispatches `grammar:done` with the tally (and,
       for signed-in users, records progress to user_grammar_progress). -->
  <script is:inline>
    window.addEventListener('grammar:done', function (e) {
      var d = (e && e.detail) || {};
      var box = document.getElementById('momentum-score');
      var val = document.getElementById('momentum-score-val');
      var note = document.getElementById('momentum-score-note');
      if (!box || !val) return;
      val.textContent = d.score + '/' + d.total + ' (' + d.pct + '%)';
      var pass = d.pct >= 70;
      if (note) {
        note.textContent = pass
          ? "Nice — that's a pass. Keep the momentum going below."
          : 'Review the rules above, then try again anytime. Next topic is ready when you are.';
      }
      // Pass = limette, keep-going = aprikose (semantic tokens; the words above carry the meaning)
      box.classList.remove('bg-paper-sunk');
      box.classList.add(pass ? 'bg-accent-limette-wash' : 'bg-accent-aprikose-wash', pass ? 'text-accent-limette-ink' : 'text-accent-aprikose-ink');
      box.classList.remove('hidden');
    });
  </script>
</Layout>
