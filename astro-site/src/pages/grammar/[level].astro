---
import Layout from '../../layouts/Layout.astro';
import Aurora from '../../components/Aurora.astro';
import { getTopicsForLevel, SUB_LEVELS, LEVEL_META } from '../../lib/grammar.js';
import { ORGANIZATION, SITE_PUBLISHED } from '../../lib/siteMeta.js';
import '../../styles/global.css';

export async function getStaticPaths() {
  return SUB_LEVELS.map((level) => ({ params: { level } }));
}

const { level } = Astro.params;
const meta = LEVEL_META[level];
const topics = await getTopicsForLevel(level);

const levelPath = topics.map((t, i) => ({ id: t.id, slug: t.slug, n: i + 1 }));

const title = `${meta.label} Grammatik — ${topics.length} Themen | DeutschMeister`;
// Keep under 160 chars: list two topic titles, not four.
const description = `Alle ${topics.length} Grammatikthemen für ${meta.label}: ${topics.slice(0, 2).map(t => t.title_en).join(', ')} und mehr — mit Regeln, Beispielen und Übungen.`;

const levelUrl = `https://deutsch-meister.de/grammar/${level}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['CollectionPage', 'LearningResource'],
  name: title,
  description,
  url: levelUrl,
  inLanguage: 'de',
  educationalLevel: `CEFR ${meta.label}`,
  learningResourceType: 'Course module',
  isAccessibleForFree: level === 'a1.1',
  // Newest updated_at among the topics this hub lists — the page changes
  // when its content does, not when the site redeploys.
  dateModified: topics.reduce((acc, t) => {
    const d = t.updated_at?.slice(0, 10);
    return d && d > acc ? d : acc;
  }, SITE_PUBLISHED),
  publisher: ORGANIZATION,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: topics.length,
    itemListElement: topics.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.title_en,
      url: `https://deutsch-meister.de/grammar/${level}/${t.slug}/`,
    })),
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://deutsch-meister.de/' },
      { '@type': 'ListItem', position: 2, name: 'Grammatik', item: 'https://deutsch-meister.de/grammar/' },
      { '@type': 'ListItem', position: 3, name: meta.label, item: levelUrl },
    ],
  },
};

// Playful Depth vocabulary (docs/design/playbook.md). The level code is data →
// `label` chip; never a level colour (rule 1).
const LEVEL_CHIP =
  'rounded-pill bg-siegel-wash px-2.5 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep';
const CARD_INTERACTIVE =
  'rounded-clay border border-rule bg-white shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg active:translate-y-1 active:shadow-none';
const CHIP_PRESSABLE =
  'rounded-pill border border-rule bg-white px-3 py-1.5 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep shadow-raise transition-all duration-100 ease-snap hover:border-siegel active:translate-y-1 active:shadow-none';
---

<Layout title={title} description={description} canonical={`https://deutsch-meister.de/grammar/${level}/`} jsonLd={jsonLd} lang="de">
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- ═══ HERO ═══ -->
    <section class="relative" aria-labelledby="level-h">
      <Aurora />
      <div class="relative mx-auto max-w-4xl px-5 pt-10 pb-10 sm:pt-14">
        <!-- Breadcrumb -->
        <nav class="hero-line mb-8 flex items-center gap-2 font-data text-[0.8125rem] text-graphite" aria-label="Breadcrumb" style="--d:0ms">
          <a href="https://deutsch-meister.de/" class="transition-colors hover:text-siegel-deep">Home</a>
          <span>/</span>
          <a href="/grammar/" class="transition-colors hover:text-siegel-deep" lang="de">Grammatik</a>
          <span>/</span>
          <span class="font-semibold text-ink">{meta.label}</span>
        </nav>

        <!-- Header -->
        <div class="hero-line mb-4 inline-flex items-center gap-3" style="--d:60ms">
          <span class={LEVEL_CHIP}>{meta.label}</span>
          <span class="text-[0.9375rem] font-semibold text-graphite" lang="en">{meta.name}</span>
        </div>
        <h1 id="level-h" class="hero-line font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.025em] sm:text-[3rem]" style="--d:140ms">
          <span lang="de">{meta.label} Grammatik</span>
        </h1>
        <p class="hero-line mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" lang="de" style="--d:260ms">
          <span data-en={`${topics.length} topics with explanations, examples and interactive exercises.`}>{topics.length} Themen mit Erklärungen, Beispielen und interaktiven Übungen.</span>
        </p>
        <!-- Per-level progress — hidden until the client fills it for a signed-in user. -->
        <div data-level-bar class="mt-5 hidden max-w-sm items-center gap-3">
          <div class="h-2 flex-1 overflow-hidden rounded-pill bg-paper-sunk">
            <div data-level-bar-fill class="h-full rounded-pill bg-siegel transition-all" style="width:0%"></div>
          </div>
          <span data-level-bar-text class="whitespace-nowrap font-data text-[0.8125rem] font-semibold text-graphite">0/{topics.length}</span>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-4xl px-5 pb-14">
      <!-- Topic list: pressable clay cards -->
      <div class="space-y-4">
        {topics.map((topic, i) => (
          <a
            href={`/grammar/${level}/${topic.slug}/`}
            data-topic-card
            data-topic-id={topic.id}
            class={`reveal group flex items-center gap-4 p-5 ${CARD_INTERACTIVE}`}
            style={`--rd:${(i % 5) * 80}ms`}
          >
            <span data-topic-badge class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-pill bg-paper-sunk font-data text-[0.8125rem] font-bold text-ink">
              <span data-topic-num>{i + 1}</span>
            </span>
            <div class="min-w-0 flex-1">
              <!-- Heading, not styling: font-body + text-base reproduce the
                   previous paragraph rendering exactly, while the h2 removes the
                   h1-to-h3 skip in the outline. -->
              <h2 class="font-body text-base font-bold text-ink transition-colors group-hover:text-siegel-deep" lang="en">
                {topic.title_en}
              </h2>
              {topic.title_de && topic.title_de !== topic.title_en && (
                <p class="mt-0.5 text-sm text-graphite" lang="de">{topic.title_de}</p>
              )}
              {topic.description_en && (
                <p class="mt-1 line-clamp-1 text-sm text-graphite" lang="en">{topic.description_en}</p>
              )}
            </div>
            <svg class="h-5 w-5 flex-shrink-0 text-edge transition-all group-hover:translate-x-0.5 group-hover:text-siegel" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>

      <!-- Level navigation -->
      <div class="reveal mt-12 border-t border-rule pt-8">
        <p class="mb-4 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" lang="de">Andere Niveaus</p>
        <div class="flex flex-wrap gap-2.5">
          {SUB_LEVELS.filter(l => l !== level).map((l) => (
            <a href={`/grammar/${l}/`} class={CHIP_PRESSABLE}>
              {LEVEL_META[l].label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Path data for the client enhancer (this level, in order) -->
  <script id="gm-level-path" type="application/json" is:inline set:html={JSON.stringify(levelPath)}></script>
  <script>
    // Progressive enhancement: checks + current highlight + progress bar for the
    // signed-in user. Logged-out/SEO visitors stay JS-light (localStorage gate).
    (async function () {
      const el = document.getElementById('gm-level-path');
      if (!el) return;
      const path = JSON.parse(el.textContent);
      const hasSession = (() => {
        try {
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && /^sb-.*-auth-token$/.test(k)) return true;
          }
        } catch (e) { /* ignore */ }
        return false;
      })();
      if (!hasSession) return;

      try {
        const mod = await import('../../lib/grammarProgress.js');
        const { user, byTopic } = await mod.getProgress();
        if (!user) return;

        const completed = new Set(path.filter((t) => byTopic[t.id]?.is_completed).map((t) => t.id));
        const current = path.find((t) => !completed.has(t.id)) || null;

        // Progress bar
        const bar = document.querySelector('[data-level-bar]');
        if (bar) {
          bar.classList.remove('hidden');
          bar.classList.add('flex');
          const fill = bar.querySelector('[data-level-bar-fill]');
          const text = bar.querySelector('[data-level-bar-text]');
          if (fill) fill.style.width = `${Math.round((completed.size / path.length) * 100)}%`;
          if (text) text.textContent = `${completed.size}/${path.length}`;
        }

        // Rows — checks + current highlight (success = limette, selected = siegel)
        document.querySelectorAll('[data-topic-card]').forEach((card) => {
          const id = card.getAttribute('data-topic-id');
          const badge = card.querySelector('[data-topic-badge]');
          const num = card.querySelector('[data-topic-num]');
          if (completed.has(id)) {
            if (num) num.textContent = '✓';
            if (badge) { badge.classList.remove('bg-paper-sunk', 'text-ink'); badge.classList.add('bg-accent-limette', 'text-white'); }
            card.classList.add('ring-1', 'ring-accent-limette');
          } else if (current && id === current.id) {
            card.classList.add('ring-2', 'ring-siegel', 'shadow-raise-lg');
          }
        });
      } catch (e) {
        console.warn('[grammar] level enhancer failed', e);
      }
    })();
  </script>
</Layout>
