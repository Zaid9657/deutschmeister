---
import Layout from '../../layouts/Layout.astro';
import Aurora from '../../components/Aurora.astro';
import { getAllTopics, SUB_LEVELS, LEVEL_META } from '../../lib/grammar.js';
import { ORGANIZATION } from '../../lib/siteMeta.js';
import '../../styles/global.css';

const allTopics = await getAllTopics();

// Group by level
const byLevel = SUB_LEVELS.map((level) => ({
  level,
  meta: LEVEL_META[level],
  topics: allTopics.filter((t) => t.sub_level === level),
}));

// Flat, ordered path across all levels — the client uses this (plus the user's
// progress) to pick the "continue" target and highlight the current topic.
const orderedPath = byLevel.flatMap(({ level, topics }) =>
  topics.map((t, i) => ({ id: t.id, level, slug: t.slug, title: t.title_en, n: i + 1 }))
);
const firstTopic = orderedPath[0];
const totalTopics = orderedPath.length;

// The site's most-linked hub had a bare CollectionPage: no breadcrumb (the only
// Astro hub without one) and no ItemList, while rendering 8 level links and 64
// topic links. Both restate what the page already shows.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Deutsche Grammatik A1–B2 | DeutschMeister',
    description: 'Alle 64 Grammatikthemen von A1.1 bis B2.2 — kostenlos, mit Erklärungen, Beispielen und Übungen.',
    url: 'https://deutsch-meister.de/grammar/',
    inLanguage: 'de',
    provider: ORGANIZATION,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: byLevel.length,
      itemListElement: byLevel.map(({ level, meta }, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${meta.label} Grammatik`,
        item: `https://deutsch-meister.de/grammar/${level}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://deutsch-meister.de/' },
      { '@type': 'ListItem', position: 2, name: 'Grammatik', item: 'https://deutsch-meister.de/grammar/' },
    ],
  },
];

// Playful Depth vocabulary (docs/design/playbook.md). Level codes are data, so
// they wear the `label` chip — never a level colour (rule 1: colour means case).
const BTN =
  'inline-flex items-center justify-center gap-2 rounded-clay text-base font-bold transition-all duration-100 ease-snap select-none';
const BTN_PRIMARY = `${BTN} bg-siegel px-7 py-3.5 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const LEVEL_CHIP =
  'rounded-pill bg-siegel-wash px-2.5 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep';
const CARD_INTERACTIVE =
  'rounded-clay border border-rule bg-white shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg active:translate-y-1 active:shadow-none';
const H2 = 'font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]';
---

<Layout
  title="Deutsche Grammatik A1–B2 | DeutschMeister"
  description="64 Grammatikthemen von A1.1 bis B2.2. Artikel, Kasus, Konjunktiv und mehr — mit Erklärungen, Beispielen und interaktiven Übungen."
  canonical="https://deutsch-meister.de/grammar/"
  jsonLd={jsonLd}
  lang="de"
>
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- ═══ HERO ═══ -->
    <section class="relative" aria-labelledby="grammar-h">
      <Aurora />
      <div class="relative mx-auto max-w-6xl px-5 pt-14 pb-12 sm:pt-20">
        <div class="text-center">
          <h1 id="grammar-h" class="hero-line font-display text-[2.375rem] font-semibold leading-[1.02] tracking-[-0.025em] sm:text-[3.5rem]" style="--d:60ms">
            <span lang="de" data-en="German Grammar">Deutsche Grammatik</span>
          </h1>
          <p class="hero-line mx-auto mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" lang="de" style="--d:200ms">
            <span data-en="64 topics from A1.1 to B2.2 — with rules, examples and interactive exercises. Every topic explained on its own.">64 Themen von A1.1 bis B2.2 — mit Regeln, Beispielen und interaktiven Übungen. Jedes Thema einzeln erklärbar.</span>
          </p>
          <p class="hero-line mt-4 text-[0.9375rem] text-graphite" lang="en" style="--d:320ms">
            New to German? Start with <a href="/grammar/a1.1/nouns-gender/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">German noun genders (der, die, das)</a> — the first A1.1 topic.
          </p>
        </div>

        <!-- Level picker: the grid a visitor chooses from — clay, tilting -->
        <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4" aria-label="Niveaus">
          {byLevel.map(({ level, meta }, i) => (
            <li class="hero-line" style={`--d:${400 + i * 60}ms`}>
              <div class="atropos h-full" data-atropos-card>
                <div class="atropos-scale h-full"><div class="atropos-rotate h-full"><div class="atropos-inner h-full !overflow-visible">
                  <a href={`/grammar/${level}/`} class={`flex h-full flex-col gap-2 p-5 ${CARD_INTERACTIVE}`}>
                    <span class={`self-start ${LEVEL_CHIP}`} data-atropos-offset="8">{meta.label}</span>
                    <span class="font-display text-[1.0625rem] font-semibold leading-snug" data-atropos-offset="4" lang="en">{meta.name}</span>
                  </a>
                </div></div></div>
              </div>
            </li>
          ))}
        </ul>

        <!-- Continue / start hero. Server-rendered in the logged-out "start" state
             (SEO-safe, no JS); the client upgrades it to a resume card when a
             signed-in user with progress is detected. -->
        {firstTopic && (
          <div class="hero-line mt-10" style="--d:900ms">
            <div class="atropos" data-atropos-card>
              <div class="atropos-scale"><div class="atropos-rotate"><div class="atropos-inner !overflow-visible">
                <a
                  id="gm-hero"
                  href={`/grammar/${firstTopic.level}/${firstTopic.slug}/`}
                  class={`group block p-6 sm:p-7 ${CARD_INTERACTIVE} shadow-raise-lg`}
                >
                  <div class="flex items-center gap-5">
                    <div class="hidden h-14 w-14 flex-shrink-0 items-center justify-center rounded-clay border border-rule bg-paper-sunk sm:flex" data-atropos-offset="6">
                      <span id="gm-hero-icon" class="text-2xl">📖</span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p id="gm-hero-eyebrow" class="mb-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" data-atropos-offset="3">
                        New here? Start with the basics
                      </p>
                      <p id="gm-hero-title" class="font-display text-lg font-semibold leading-snug sm:text-xl" data-atropos-offset="4">
                        A1.1 · Topic 1: {firstTopic.title}
                      </p>
                      <p id="gm-hero-sub" class="mt-0.5 text-sm text-graphite" data-atropos-offset="2">
                        64 topics from complete beginner to upper-intermediate.
                      </p>
                    </div>
                    <span
                      id="gm-hero-btn"
                      class="btn-shimmer relative hidden flex-shrink-0 select-none items-center justify-center gap-2 overflow-hidden rounded-clay bg-siegel px-7 py-3.5 text-base font-bold text-white shadow-raise-siegel transition-all duration-100 ease-snap group-hover:bg-siegel-lift group-active:translate-y-1 group-active:shadow-none sm:inline-flex"
                      data-atropos-offset="8"
                    >
                      <span id="gm-hero-btn-label" class="relative z-10">Start learning</span>
                      <span aria-hidden="true" class="relative z-10 transition-transform group-hover:translate-x-0.5">→</span>
                    </span>
                  </div>
                </a>
              </div></div></div>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- ═══ Level sections ═══ -->
    <div class="mx-auto max-w-6xl space-y-14 px-5 py-14">
      {byLevel.map(({ level, meta, topics }) => (
        <section>
          <div class="reveal mb-5 flex flex-wrap items-center gap-3">
            <a href={`/grammar/${level}/`} class="group flex items-center gap-3">
              <span class={LEVEL_CHIP}>{meta.label}</span>
              <h2 class={`${H2} transition-colors group-hover:text-siegel-deep`} lang="en">
                {meta.label} — {meta.name}
              </h2>
            </a>
            <!-- Per-level progress — hidden until the client fills it for a signed-in user. -->
            <div data-level-bar={level} class="mt-2 hidden w-full items-center gap-2 sm:ml-auto sm:mt-0 sm:w-auto">
              <div class="h-2 flex-1 overflow-hidden rounded-pill bg-paper-sunk sm:w-32">
                <div data-level-bar-fill class="h-full rounded-pill bg-siegel transition-all" style="width:0%"></div>
              </div>
              <span data-level-bar-text class="whitespace-nowrap font-data text-[0.75rem] font-semibold text-graphite">0/{topics.length}</span>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {topics.map((topic, i) => (
              <a
                href={`/grammar/${level}/${topic.slug}/`}
                data-topic-card
                data-topic-id={topic.id}
                class={`reveal group relative block p-5 ${CARD_INTERACTIVE}`}
                style={`--rd:${(i % 4) * 80}ms`}
              >
                <span class="mb-1.5 flex items-center gap-1.5">
                  <span data-topic-num class="font-data text-[0.75rem] font-semibold text-graphite">#{i + 1}</span>
                  <span data-topic-check class="hidden h-4 w-4 items-center justify-center rounded-pill bg-accent-limette text-[10px] font-bold text-white" aria-label="Completed">✓</span>
                </span>
                <p class="text-[0.9375rem] font-bold leading-snug text-ink transition-colors group-hover:text-siegel-deep" lang="en">
                  {topic.title_en}
                </p>
                {topic.description_en && (
                  <p class="mt-1 line-clamp-2 text-[0.8125rem] leading-snug text-graphite" lang="en">{topic.description_en}</p>
                )}
              </a>
            ))}
          </div>

          <a href={`/grammar/${level}/`} class="reveal mt-4 inline-flex items-center gap-1 text-sm font-bold text-siegel transition-colors hover:text-siegel-deep" lang="de" style="--rd:160ms">
            <span data-en={`View all ${meta.label} topics →`}>Alle {meta.label}-Themen ansehen →</span>
          </a>
        </section>
      ))}
    </div>

    <!-- ═══ Close ═══ -->
    <section class="relative overflow-hidden border-t border-rule bg-paper-sunk">
      <Aurora variant="close" />
      <div class="relative mx-auto max-w-6xl px-5 py-16 text-center">
        <h2 class={`reveal ${H2}`} lang="de">Grammatik allein reicht nicht</h2>
        <p class="reveal mx-auto mt-3 max-w-md text-[0.9375rem] leading-relaxed text-graphite sm:text-base" lang="de" style="--rd:80ms">
          Übe das Gelernte mit KI-Sprechübungen, Lesestücken und interaktiven Aufgaben.
        </p>
        <div class="reveal mt-8" style="--rd:160ms">
          <a href="https://deutsch-meister.de/signup" class={BTN_PRIMARY}>
            <span lang="de">Kostenlos starten — 7 Tage Pro inklusive</span>
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- Ordered path for the client enhancer -->
  <script id="gm-ordered" type="application/json" is:inline set:html={JSON.stringify(orderedPath)}></script>
  <script>
    // Progressive enhancement: only runs for signed-in users. Logged-out/SEO
    // visitors never load the Supabase client (kept behind the localStorage gate).
    (async function () {
      const el = document.getElementById('gm-ordered');
      if (!el) return;
      const ordered = JSON.parse(el.textContent);
      const totalTopics = ordered.length;
      const hasSession = (() => {
        try {
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && /^sb-.*-auth-token$/.test(k)) return true;
          }
        } catch (e) { /* ignore */ }
        return false;
      })();
      if (!hasSession) return;

      try {
        const mod = await import('../../lib/grammarProgress.js');
        const { user, byTopic } = await mod.getProgress();
        if (!user) return;

        const completed = new Set(ordered.filter((t) => byTopic[t.id]?.is_completed).map((t) => t.id));
        const current = ordered.find((t) => !completed.has(t.id)) || null;
        const completedCount = completed.size;

        // 1. Continue hero
        const hero = document.getElementById('gm-hero');
        if (hero) {
          const eyebrow = document.getElementById('gm-hero-eyebrow');
          const title = document.getElementById('gm-hero-title');
          const sub = document.getElementById('gm-hero-sub');
          const icon = document.getElementById('gm-hero-icon');
          const btnLabel = document.getElementById('gm-hero-btn-label');
          if (current) {
            hero.setAttribute('href', `/grammar/${current.level}/${current.slug}/`);
            eyebrow.textContent = completedCount > 0 ? 'Continue where you left off' : 'Start with the basics';
            title.textContent = `${current.level.toUpperCase()} · Topic ${current.n}: ${current.title}`;
            sub.textContent = completedCount > 0
              ? `You've completed ${completedCount} of ${totalTopics} topics — keep the streak going.`
              : `64 topics from complete beginner to upper-intermediate.`;
            if (btnLabel) btnLabel.textContent = completedCount > 0 ? 'Resume' : 'Start learning';
            if (icon) icon.textContent = completedCount > 0 ? '▶️' : '📖';
          } else {
            // Everything completed.
            eyebrow.textContent = 'Every topic complete';
            title.textContent = `You've finished all ${totalTopics} grammar topics 🎉`;
            sub.textContent = 'Revisit any topic below to keep it sharp.';
            if (btnLabel) btnLabel.textContent = 'Review';
            if (icon) icon.textContent = '🏆';
            hero.setAttribute('href', `/grammar/${ordered[0].level}/${ordered[0].slug}/`);
          }
        }

        // 2. Per-level progress bars
        const perLevel = {};
        ordered.forEach((t) => {
          perLevel[t.level] = perLevel[t.level] || { total: 0, done: 0 };
          perLevel[t.level].total += 1;
          if (completed.has(t.id)) perLevel[t.level].done += 1;
        });
        document.querySelectorAll('[data-level-bar]').forEach((el) => {
          const lvl = el.getAttribute('data-level-bar');
          const s = perLevel[lvl];
          if (!s) return;
          el.classList.remove('hidden');
          el.classList.add('flex');
          const fill = el.querySelector('[data-level-bar-fill]');
          const text = el.querySelector('[data-level-bar-text]');
          if (fill) fill.style.width = `${Math.round((s.done / s.total) * 100)}%`;
          if (text) text.textContent = `${s.done}/${s.total}`;
        });

        // 3. Topic cards — checks + current highlight (success = limette,
        //    selected = siegel; tokens only)
        document.querySelectorAll('[data-topic-card]').forEach((card) => {
          const id = card.getAttribute('data-topic-id');
          if (completed.has(id)) {
            const num = card.querySelector('[data-topic-num]');
            const check = card.querySelector('[data-topic-check]');
            if (num) num.classList.add('hidden');
            if (check) { check.classList.remove('hidden'); check.classList.add('inline-flex'); }
            card.classList.add('ring-1', 'ring-accent-limette');
          } else if (current && id === current.id) {
            card.classList.add('ring-2', 'ring-siegel', 'shadow-raise-lg');
          }
        });
      } catch (e) {
        console.warn('[grammar] enhancer failed', e);
      }
    })();
  </script>
</Layout>
