---
// /ar/help/ — help in Arabic for the Arabic pilot (docs/arabic/README.md §5).
// No English twin: it answers the questions an Arabic-speaking beginner meets
// in the app (audio, typing German, saving progress, signing in, switching
// language), so it is self-canonical with no hreflang alternates.
//
// Every statement describes the product as built (the file it was checked
// against is named beside it); nothing promises a response time, a person, or
// an outcome. Copy is a DRAFT (data/i18n/ar.js header).
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { ORGANIZATION } from '../../lib/siteMeta.js';
import { AR_LINES } from '../../data/i18n/ar.js';
import { SUPPORT_LINK } from '../../data/navigation.js';

const title = 'المساعدة بالعربية: الصوت والكتابة والحساب | DeutschMeister';
const description = 'إجابات بالعربية: كيف تبدأ A1.1، وماذا تفعل إن لم تسمع الصوت، وكيف تكتب ä وö وü وß، وأين يُحفظ تقدّمك، وكيف تستعيد حسابك وتغيّر اللغة.';

const SECTIONS = [
  { id: 'start', title: 'البدء' },
  { id: 'audio', title: 'لا أسمع الصوت' },
  { id: 'typing', title: 'كتابة الحروف الألمانية' },
  { id: 'speaking', title: 'التحدّث والكتابة' },
  { id: 'progress', title: 'أين يُحفظ تقدّمي؟' },
  { id: 'login', title: 'الحساب وتسجيل الدخول' },
  { id: 'language', title: 'تغيير اللغة' },
  { id: 'contact', title: 'التواصل معنا' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: 'https://deutsch-meister.de/ar/help/',
  inLanguage: 'ar',
  publisher: ORGANIZATION,
};
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/ar/help/" jsonLd={jsonLd} lang="ar">
  <div class="overflow-x-clip bg-paper text-ink">
    <div class="mx-auto max-w-3xl px-4 pb-16 pt-10 sm:px-6 sm:pt-14">
      <h1 class="text-[clamp(2rem,6vw,2.75rem)] font-bold leading-tight">المساعدة بالعربية</h1>
      <p class="mt-4 leading-relaxed text-graphite">إجابات قصيرة عن الأسئلة التي تظهر عادةً في الدروس الأولى. اختر موضوعًا:</p>
      <nav aria-label="مواضيع المساعدة" class="mt-5">
        <ul class="flex flex-wrap gap-2">
          {SECTIONS.map((s) => (
            <li><a href={`#${s.id}`} class="inline-flex min-h-11 items-center rounded-pill border border-rule bg-white px-4 text-[0.9375rem] font-semibold text-ink hover:border-siegel">{s.title}</a></li>
          ))}
        </ul>
      </nav>

      <div class="mt-10 grid gap-10 leading-relaxed text-graphite [&_h2]:text-[1.5rem] [&_h2]:font-bold [&_h2]:text-ink [&_li]:mt-1.5">
        <section id="start" aria-labelledby="start-h">
          <h2 id="start-h">البدء</h2>
          <ol class="mt-3 list-decimal ps-6">
            <li>افتح الدورة: <a href="/course/a1.1?lang=ar" class="dm-link font-semibold" data-track="course_selected" data-track-level="a1.1" data-track-surface="ar_help">ابدأ A1.1 مجانًا</a>. لا تحتاج إلى حساب.</li>
            <li>اضغط زر الدرس 1. في بداية كل درس ترى ما ستتعلّمه، ثم تمرّ بخطوات قصيرة: حوار، وكلمات، وقاعدة، وتمارين.</li>
            <li>اكتب إجابتك واضغط «تحقّق من الإجابة». إن أخطأت، يظهر لك الصواب وشرح قصير، ويعود التمرين لاحقًا بشكل آخر.</li>
          </ol>
          <p class="mt-3">{AR_LINES.germanContent} الشرح العربي متوفر الآن في الدروس 1–3؛ من الدرس 4 يظهر الشرح بالإنجليزية مع وسم «بالإنجليزية».</p>
        </section>

        <section id="audio" aria-labelledby="audio-h">
          <h2 id="audio-h">لا أسمع الصوت</h2>
          <p class="mt-3">بعض الكلمات لها تسجيلات صوتية. أمّا سطور الحوار فينطقها صوت حاسوبي من متصفحك نفسه، ولذلك يعتمد على جهازك.</p>
          <ul class="mt-3 list-disc ps-6">
            <li>ارفع الصوت، وتأكّد أن الهاتف ليس في الوضع الصامت، ثم اضغط «تشغيل» مرة أخرى.</li>
            <li>جرّب متصفحًا آخر (مثل Chrome أو Safari) إن لم تسمع شيئًا.</li>
            <li>إن لم يكن في جهازك صوت ألماني، أضِفه من إعدادات الجهاز: إعدادات تحويل النص إلى كلام ← اللغة الألمانية <bdi lang="de" dir="ltr">(Deutsch)</bdi>.</li>
          </ul>
          <p class="mt-3">إن بقي الصوت لا يعمل، يعرض التمرين زر «اعرض النص». عندها تقرأ السطر بدلًا من الاستماع إليه، ويُحتسب التمرين قراءةً لا استماعًا — فلا يدخل في نتيجة الاستماع.</p>
        </section>

        <section id="typing" aria-labelledby="typing-h">
          <h2 id="typing-h">كتابة الحروف الألمانية <bdi lang="de" dir="ltr">ä ö ü ß</bdi></h2>
          <p class="mt-3">الإجابات تُكتب بالحروف الألمانية (اللاتينية)، ومن اليسار إلى اليمين، حتى لو كانت لوحة مفاتيحك عربية.</p>
          <ul class="mt-3 list-disc ps-6">
            <li>تحت كل خانة إجابة ألمانية أزرار <bdi lang="de" dir="ltr">ä ö ü ß Ä Ö Ü</bdi>: اضغط الحرف فيُضاف حيث يقف المؤشّر.</li>
            <li>يمكنك أيضًا كتابة <bdi dir="ltr">ae</bdi> بدل <bdi lang="de" dir="ltr">ä</bdi>، و<bdi dir="ltr">oe</bdi> بدل <bdi lang="de" dir="ltr">ö</bdi>، و<bdi dir="ltr">ue</bdi> بدل <bdi lang="de" dir="ltr">ü</bdi>، و<bdi dir="ltr">ss</bdi> بدل <bdi lang="de" dir="ltr">ß</bdi>، ويقبلها المصحّح.</li>
            <li>للتبديل بين العربية واللاتينية: في الهاتف اضغط زر الكرة الأرضية أو زر اللغة على لوحة المفاتيح. في Windows اضغط <bdi dir="ltr">Win + Space</bdi>، وفي Mac اضغط <bdi dir="ltr">Control + Space</bdi> (أو زر الكرة الأرضية).</li>
            <li>يمكنك إضافة لوحة مفاتيح ألمانية من إعدادات الجهاز (اللغة ← لوحات المفاتيح ← إضافة ← <bdi lang="de" dir="ltr">Deutsch</bdi>). وفي كثير من لوحات المفاتيح على الهاتف يكفي الضغط المطوّل على <bdi dir="ltr">a</bdi> لتظهر <bdi lang="de" dir="ltr">ä</bdi>.</li>
            <li>الحروف الكبيرة مهمّة في الألمانية: الأسماء تبدأ بحرف كبير <bdi lang="de" dir="ltr">(der Tisch)</bdi>. إن كان الخطأ في حرف كبير أو صغير فقط، يُعطيك التمرين عادةً محاولة أخرى.</li>
          </ul>
        </section>

        <section id="speaking" aria-labelledby="speaking-h">
          <h2 id="speaking-h">التحدّث والكتابة</h2>
          <ul class="mt-3 list-disc ps-6">
            <li>القراءة بصوت عالٍ تحتاج إلى إذن الميكروفون. إن رفضت الإذن أو لم يعمل الميكروفون، اضغط «تخطَّ الآن» وتابع الدرس.</li>
            <li>النتيجة تعدّ الكلمات التي تعرّف عليها نظام التعرّف على الكلام في تسجيلك. وهي لا تقيّم نطق الأصوات ولا النبرة.</li>
            <li>مهمة الكتابة لها قائمة تحقّق بالعربية (الطول، والتحية، والختام). أمّا تقييم الذكاء الاصطناعي لنصّك فيأتي بالألمانية.</li>
            <li>مدرّب المحادثة متاح بالإنجليزية والألمانية فقط، ويحتاج إلى حساب مجاني.</li>
          </ul>
        </section>

        <section id="progress" aria-labelledby="progress-h">
          <h2 id="progress-h">أين يُحفظ تقدّمي؟</h2>
          <ul class="mt-3 list-disc ps-6">
            <li><strong>دون حساب:</strong> تُحفظ الدروس التي أكملتها على هذا الجهاز وفي هذا المتصفح فقط. إذا مسحت بيانات المتصفح أو استخدمت التصفّح الخاص، قد يضيع هذا التقدّم.</li>
            <li><strong>بحساب مجاني:</strong> سجّل الدخول ثم افتح الدورة، فتُنقل الدروس التي أكملتها على هذا الجهاز إلى حسابك، وتتابع من أي جهاز.</li>
            <li>إن أغلقت الصفحة في منتصف الدرس، تعود عند فتحه إلى الخطوة نفسها لفترة قصيرة، دون تكرار إجاباتك.</li>
            <li>نتائج الاختبارات المرحلية دون حساب لا تُحفظ حاليًا. أنشئ حسابًا قبلها إن أردت الاحتفاظ بها.</li>
          </ul>
        </section>

        <section id="login" aria-labelledby="login-h">
          <h2 id="login-h">الحساب وتسجيل الدخول</h2>
          <ul class="mt-3 list-disc ps-6">
            <li>صفحات إنشاء الحساب وتسجيل الدخول واستعادة كلمة المرور بالعربية: <a href="/signup?lang=ar" class="dm-link font-semibold">إنشاء حساب</a> · <a href="/login?lang=ar" class="dm-link font-semibold">تسجيل الدخول</a>.</li>
            <li>بعد إنشاء الحساب تصلك رسالة تأكيد بالإنجليزية عنوانها <bdi lang="en" dir="ltr">“Confirm your DeutschMeister account”</bdi>. اضغط الرابط الذي فيها. إن لم تجدها، ابحث في مجلد الرسائل غير المرغوب فيها (Spam).</li>
            <li>نسيت كلمة المرور؟ افتح <a href="/reset-password?lang=ar" class="dm-link font-semibold">استعادة كلمة المرور</a> واكتب بريدك. تصلك رسالة بالإنجليزية فيها رابط يفتح صفحة تختار فيها كلمة مرور جديدة. افتح الرابط على الجهاز نفسه لتظهر لك الصفحة بالعربية.</li>
          </ul>
        </section>

        <section id="language" aria-labelledby="language-h">
          <h2 id="language-h">تغيير اللغة</h2>
          <ul class="mt-3 list-disc ps-6">
            <li>في أعلى الدورة والدرس أزرار <bdi dir="ltr">العربية · English · Deutsch</bdi>. يتغيّر الشرح والأزرار فورًا، وتبقى إجاباتك ومكانك في الدرس كما هي.</li>
            <li>اختيارك يُحفظ على هذا الجهاز، وفي حسابك إن كنت مسجّلًا، فيُفتح التطبيق به في المرة القادمة.</li>
            <li>صفحات التطبيق التي لم تُترجم بعد (مثل لوحة التحكم) تظهر بالإنجليزية، مع ملاحظة بالعربية في أعلاها.</li>
          </ul>
        </section>

        <section id="contact" aria-labelledby="contact-h">
          <h2 id="contact-h">التواصل معنا</h2>
          <p class="mt-3">صفحة الدعم بالإنجليزية: <a href={SUPPORT_LINK.href} hreflang="en" class="dm-link font-semibold"><span lang="en">Help &amp; feedback</span></a>. إن كنت مسجّلًا تجد فيها نموذج رسالة، وإن لم تكن تجد فيها عنوان البريد الإلكتروني.</p>
          <p class="mt-6 text-[0.8125rem]">{AR_LINES.draftNote}</p>
        </section>
      </div>
    </div>
  </div>
</Layout>

<script>
  // One help_opened per visit (src/data/events.js; consent-gated inside track()).
  import { track } from '../../lib/track.js';
  track('help_opened', { surface: 'ar_help' });
</script>
