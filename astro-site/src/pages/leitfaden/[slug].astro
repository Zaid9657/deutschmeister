---
// The guide renderer. One page for every Leitfaden — see
// ../../data/guides/index.js for why guides are data rather than pages.
//
// STYLE: design tokens only (src/data/design-tokens.js). The page this replaced
// used slate/amber and a local <style> block with raw hex, predating the token
// system. Rule 2 of the tokens file — siegel is the single interactive colour —
// is why every link and the CTA are teal here. No `kasus-*` colours appear:
// rule 1 reserves them for places where a grammatical case is actually named,
// and a guide about exam formats never names one.
//
// v3 (Playful Depth, docs/design/playbook.md): the header gets the aurora and a
// hero-line entrance; the table of contents, the CTA block and the "Weitere
// Leitfäden" links are the pressable things and rest raised (rule 3). THE BODY
// STAYS FLAT on purpose — exam facts, tables, steps, the FAQ and the provenance
// footer are reference material: hairlines, no shadow, one reveal per section
// and nothing more. Copy, ids/anchors, hrefs and the single <h1> are unchanged.
//
// `set:html` is used for paragraph text because guide copy carries inline <a>
// and <strong>. The content is authored in this repo, not user input.
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import Aurora from '../../components/Aurora.astro';
import { BUILD_DATE, ORGANIZATION } from '../../lib/siteMeta.js';
import { GUIDES, guideToc, guideJsonLd, guideReadingMinutes, guideUrl } from '../../data/guides/index.js';

export function getStaticPaths() {
  return GUIDES.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const toc = guideToc(guide);
const minutes = guideReadingMinutes(guide);
const jsonLd = guideJsonLd(guide, { organization: ORGANIZATION, buildDate: BUILD_DATE });

const de = (iso) => {
  const [y, m, d] = iso.split('-');
  return `${d}.${m}.${y}`;
};

// Other guides, for the cross-links at the foot of every page. Internal linking
// was 0/64 on the grammar side and one-directional here; this makes every guide
// a hub for the others.
const others = GUIDES.filter((g) => g.slug !== guide.slug);

// Playbook class strings (docs/design/playbook.md §1) — same treatment as the
// homepage, so both pages render one button.
const BTN =
  'inline-flex items-center justify-center gap-2 rounded-clay text-base font-bold transition-all duration-100 ease-snap select-none';
const BTN_PRIMARY = `${BTN} btn-shimmer relative overflow-hidden bg-siegel px-7 py-3.5 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_SECONDARY = `${BTN} border border-rule bg-white px-7 py-3.5 text-ink shadow-raise hover:border-siegel hover:text-siegel-deep active:translate-y-1 active:shadow-none`;
const CARD_INTERACTIVE =
  'group flex h-full flex-col rounded-clay border border-rule bg-white p-5 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg active:translate-y-1 active:shadow-none';
---

<Layout
  title={guide.title}
  description={guide.description}
  keywords={guide.keywords}
  canonical={guideUrl(guide)}
  jsonLd={jsonLd}
  lang="de"
  ogType="article"
>
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- ═══ Header: aurora + hero-line entrance ═══ -->
    <section class="relative" aria-labelledby="hero-h">
      <Aurora />
      <div class="relative mx-auto max-w-3xl px-5 pt-14 sm:pt-20">
        <header class="border-b border-rule pb-8">
          <p class="hero-line font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" style="--d:0ms">{guide.badge}</p>
          <h1 id="hero-h" class="hero-line mt-3 font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.025em] sm:text-[3rem]" style="--d:80ms">
            {guide.h1}
          </h1>
          <p class="hero-line mt-5 text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem] [&>a]:font-bold [&>a]:text-siegel hover:[&>a]:text-siegel-deep" style="--d:220ms" set:html={guide.lead} />
          {guide.answer && (
            <div class="hero-line mt-6 rounded-clay border border-rule bg-paper-sunk p-5" style="--d:340ms">
              <p class="text-[1.0625rem] leading-relaxed text-ink">{guide.answer}</p>
            </div>
          )}
          <p class="hero-line mt-5 font-data text-[0.75rem] text-graphite" style="--d:440ms">
            Lesezeit ca. {minutes} Minuten · Fakten geprüft am {de(guide.factsCheckedOn)}
          </p>
        </header>
      </div>
    </section>

    <article class="mx-auto max-w-3xl px-5 pb-20">

      <!-- Contents — a raised clay card: you press its links -->
      <nav class="reveal mt-10 rounded-clay border border-rule bg-white p-6 shadow-raise" aria-labelledby="toc-h">
        <p id="toc-h" class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Inhalt</p>
        <ol class="mt-3 space-y-2">
          {toc.map((item, i) => (
            <li class="flex items-baseline gap-3 text-[0.9375rem]">
              <span class="font-data text-[0.75rem] text-graphite">{String(i + 1).padStart(2, '0')}</span>
              <a href={item.href} class="font-bold text-siegel transition-colors hover:text-siegel-deep">{item.label}</a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- Sections — reference material, flat (rule 3); one reveal per section -->
      {guide.sections.map((section) => (
        <section id={section.id} class="reveal mt-14 scroll-mt-24">
          <h2 class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[1.875rem]">
            {section.heading}
          </h2>

          {section.blocks.map((block) => (
            <Fragment>
              {block.type === 'p' && (
                <p class="mt-4 text-[1rem] leading-[1.7] text-graphite [&>a]:font-bold [&>a]:text-siegel hover:[&>a]:text-siegel-deep [&>strong]:font-semibold [&>strong]:text-ink" set:html={block.text} />
              )}

              {block.type === 'h3' && (
                <h3 class="mt-8 font-display text-[1.1875rem] font-semibold text-ink">{block.text}</h3>
              )}

              {block.type === 'list' && (
                <ul class="mt-4 space-y-2">
                  {block.items.map((item) => (
                    <li class="flex gap-2.5 text-[1rem] leading-[1.7] text-graphite [&>span>a]:font-bold [&>span>a]:text-siegel">
                      <span class="mt-[0.6em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-siegel" aria-hidden="true"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              )}

              {block.type === 'callout' && (
                <p class="mt-6 rounded-clay border border-rule border-l-4 border-l-siegel bg-siegel-wash px-5 py-4 text-[0.9375rem] leading-relaxed text-ink">
                  {block.text}
                </p>
              )}

              {block.type === 'table' && (
                <div class="mt-6 overflow-x-auto">
                  <table class="w-full min-w-[32rem] border-collapse text-left">
                    <thead>
                      <tr class="border-b border-ink">
                        {block.head.map((h) => (
                          <th scope="col" class="py-3 pr-4 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {block.rows.map((row) => (
                        <tr class="border-b border-rule align-top">
                          {row.map((cell, ci) => (
                            <td class={`py-3 pr-4 text-[0.875rem] leading-relaxed ${ci === 0 ? 'font-semibold text-ink' : 'text-graphite'}`}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {block.type === 'steps' && (
                <ol class="mt-6 space-y-4">
                  {block.items.map((step) => (
                    <li class="rounded-clay border border-rule bg-white p-5">
                      <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">{step.label}</p>
                      <h3 class="mt-1 font-display text-[1.0625rem] font-semibold text-ink">{step.title}</h3>
                      <ul class="mt-3 space-y-1.5">
                        {step.tasks.map((task) => (
                          <li class="flex gap-2.5 text-[0.9375rem] leading-relaxed text-graphite">
                            <span class="mt-[0.55em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-siegel" aria-hidden="true"></span>
                            <span>{task}</span>
                          </li>
                        ))}
                      </ul>
                      {step.tip && (
                        <p class="mt-4 border-t border-rule pt-3 text-[0.875rem] leading-relaxed text-graphite">
                          <span class="font-semibold text-ink">Tipp:</span> {step.tip}
                        </p>
                      )}
                    </li>
                  ))}
                </ol>
              )}

              {block.type === 'warnings' && (
                <ol class="mt-6 space-y-6">
                  {block.items.map((item, i) => (
                    <li>
                      <h3 class="flex gap-3 font-display text-[1.0625rem] font-semibold text-ink">
                        <span class="font-data text-[0.875rem] text-siegel" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        <span>{item.title}</span>
                      </h3>
                      <p class="mt-2 pl-8 text-[0.9375rem] leading-[1.7] text-graphite">{item.body}</p>
                    </li>
                  ))}
                </ol>
              )}

              {block.type === 'cards' && (
                <div class="mt-6 grid gap-4 sm:grid-cols-2">
                  {block.items.map((card) => (
                    <div class="rounded-clay border border-rule bg-white p-5">
                      <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">{card.eyebrow}</p>
                      <p class="mt-1.5 font-semibold text-ink">{card.title}</p>
                      <p class="mt-2 text-[0.875rem] leading-relaxed text-graphite">{card.body}</p>
                    </div>
                  ))}
                </div>
              )}
            </Fragment>
          ))}
        </section>
      ))}

      <!-- FAQ — flat -->
      <section id="faq" class="reveal mt-14 scroll-mt-24">
        <h2 class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[1.875rem]">
          Häufige Fragen
        </h2>
        <dl class="mt-6">
          {guide.faq.map((item) => (
            <div class="border-b border-rule py-5">
              <dt class="text-[0.9375rem] font-semibold text-ink">{item.q}</dt>
              <dd class="mt-2 text-[0.9375rem] leading-[1.7] text-graphite">{item.a}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- CTA — raised clay card; the one shimmer on the page -->
      <section class="reveal mt-14 rounded-clay border border-rule bg-white p-8 text-center shadow-raise-lg sm:p-10">
        <h2 class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.018em] text-ink sm:text-[1.75rem]">{guide.cta.heading}</h2>
        <p class="mx-auto mt-3 max-w-md text-[0.9375rem] leading-relaxed text-graphite sm:text-base">{guide.cta.body}</p>
        <div class="mt-7 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/level-test/" class={BTN_PRIMARY}><span class="relative z-10">Einstufungstest starten</span></a>
          <a href="/pricing/" class={BTN_SECONDARY}>Preise ansehen</a>
        </div>
      </section>

      <!-- Other guides — clickable clay cards -->
      <nav class="reveal mt-14 border-t border-rule pt-8" aria-labelledby="more-h" style="--rd:80ms">
        <p id="more-h" class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Weitere Leitfäden</p>
        <ul class="mt-5 grid gap-4 sm:grid-cols-3">
          {others.map((g, i) => (
            <li class="reveal" style={`--rd:${120 + i * 90}ms`}>
              <a href={`/leitfaden/${g.slug}/`} class={CARD_INTERACTIVE}>
                <span class="self-start rounded-pill bg-siegel-wash px-2.5 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">{g.badge}</span>
                <span class="mt-3 block font-display text-[1.0625rem] font-semibold leading-snug text-ink transition-colors group-hover:text-siegel-deep">{g.h1}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Provenance. Rendered, not buried in a comment: a reader and an answer
           engine can both see when these facts were last checked and against
           whom. Reference material — flat. -->
      <footer class="reveal mt-10 border-t border-rule pt-6">
        <p class="font-data text-[0.75rem] leading-relaxed text-graphite">
          Angaben geprüft am {de(guide.factsCheckedOn)} ·
          Quellen: {guide.sources.map((s, i) => (
            <Fragment>
              {i > 0 && ', '}
              <a href={s.url} rel="nofollow noopener" target="_blank" class="text-siegel underline-offset-2 hover:underline">{s.label}</a>
            </Fragment>
          ))}
        </p>
        <p class="mt-3 text-[0.75rem] leading-relaxed text-graphite">
          Dieser Leitfaden dient der allgemeinen Information und ersetzt keine offizielle Prüfungsberatung.
          Prüfungsformate, Gebühren und Wiederholungsregeln legen die Prüfungszentren fest und können sich ändern —
          verbindliche Auskünfte bekommst du direkt beim Prüfungsanbieter.
        </p>
      </footer>

    </article>
  </div>
</Layout>
