---
// The Leitfaden hub. Did not exist before 2026-08-22: `/leitfaden/` fell
// through the netlify `/leitfaden/*` rewrite to the SPA and rendered
// NotFoundPage, so the one guide that existed had no parent and the footer
// linked it directly.
//
// Schema mirrors vergleich/index.astro, which had the richest JSON-LD in the
// repo: CollectionPage + ItemList + BreadcrumbList, with inLanguage and a real
// publisher object.
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { BUILD_DATE, ORGANIZATION } from '../../lib/siteMeta.js';
import { GUIDES, guideReadingMinutes, guideUrl } from '../../data/guides/index.js';

const title = 'Leitfäden für deutsche Sprachprüfungen | DeutschMeister';
const description =
  'Kostenlose Leitfäden zu telc, Goethe-Zertifikat und DTZ: Prüfungsaufbau, Punktegrenzen, Lernpläne und die häufigsten Fehler.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Leitfäden zu deutschen Sprachprüfungen',
    description,
    url: 'https://deutsch-meister.de/leitfaden/',
    inLanguage: 'de',
    publisher: ORGANIZATION,
    dateModified: BUILD_DATE,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: GUIDES.map((guide, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: guide.h1,
        url: guideUrl(guide),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://deutsch-meister.de/' },
      { '@type': 'ListItem', position: 2, name: 'Leitfäden', item: 'https://deutsch-meister.de/leitfaden/' },
    ],
  },
];
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/leitfaden/" jsonLd={jsonLd} lang="de">
  <div class="bg-paper text-ink">
    <div class="mx-auto max-w-3xl px-5 pb-20 pt-12">

      <header class="border-b border-rule pb-8">
        <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Leitfäden</p>
        <h1 class="mt-3 font-display text-[2rem] font-semibold leading-[1.1] tracking-[-0.02em] sm:text-[2.75rem]">
          Prüfungsleitfäden
        </h1>
        <p class="mt-5 text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.125rem]">
          Jede deutsche Sprachprüfung hat ihre eigene Logik — welche Teile einzeln zählen, wo die Punkte liegen,
          was zuerst geübt werden sollte. Diese Leitfäden erklären den Aufbau, geben einen Lernplan und benennen
          die Fehler, die am häufigsten Punkte kosten. Kostenlos und ohne Anmeldung.
        </p>
      </header>

      <ul class="mt-10 space-y-px overflow-hidden rounded-lg border border-rule bg-rule">
        {GUIDES.map((guide) => (
          <li class="bg-paper">
            <a href={`/leitfaden/${guide.slug}/`} class="group block p-6 transition-colors hover:bg-siegel-wash">
              <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">
                {guide.badge} · ca. {guideReadingMinutes(guide)} Min.
              </p>
              <h2 class="mt-2 font-display text-[1.1875rem] font-semibold text-ink group-hover:text-siegel-deep">
                {guide.h1}
              </h2>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">{guide.description}</p>
            </a>
          </li>
        ))}
      </ul>

      <section class="mt-12 border-t border-rule pt-8">
        <h2 class="font-display text-[1.25rem] font-semibold text-ink">Welche Prüfung ist die richtige?</h2>
        <p class="mt-3 text-[0.9375rem] leading-[1.7] text-graphite">
          Für den Nachweis von B1 kommen telc Deutsch B1, das Goethe-Zertifikat B1 und der DTZ in Frage — welcher
          Nachweis in deinem Fall verlangt wird, entscheidet die zuständige Behörde oder Stelle. Wenn du frei wählen
          kannst: Das Goethe-Zertifikat ist modular und lässt sich in Teilen ablegen, telc prüft in zwei Blöcken mit
          Sprachbausteinen als eigenem Teil, und der DTZ ist skaliert und auf den Alltag in Deutschland zugeschnitten.
        </p>
        <p class="mt-3 text-[0.9375rem] leading-[1.7] text-graphite">
          Unsicher, wo du gerade stehst? Der
          <a href="/level-test/" class="text-siegel underline-offset-2 hover:underline">kostenlose Einstufungstest</a>
          zeigt dir dein Niveau in wenigen Minuten.
        </p>
      </section>

    </div>
  </div>
</Layout>
