---
// The Leitfaden hub. Did not exist before 2026-08-22: `/leitfaden/` fell
// through the netlify `/leitfaden/*` rewrite to the SPA and rendered
// NotFoundPage, so the one guide that existed had no parent and the footer
// linked it directly.
//
// Schema mirrors vergleich/index.astro, which had the richest JSON-LD in the
// repo: CollectionPage + ItemList + BreadcrumbList, with inLanguage and a real
// publisher object.
//
// v3 (Playful Depth, docs/design/playbook.md): aurora hero with hero-line
// entrance; the guide list is a column of clickable clay cards (raised, lift
// on hover, depress on press — rule 3) with the guide's badge as a label chip.
// The "Welche Prüfung ist die richtige?" section is reference prose and stays
// flat. Copy, hrefs and the single <h1> are unchanged.
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import Aurora from '../../components/Aurora.astro';
import { BUILD_DATE, ORGANIZATION } from '../../lib/siteMeta.js';
import { GUIDES, guideReadingMinutes, guideUrl } from '../../data/guides/index.js';

const title = 'Leitfäden für deutsche Sprachprüfungen | DeutschMeister';
const description =
  'Kostenlose Leitfäden zu telc, Goethe-Zertifikat und DTZ: Prüfungsaufbau, Punktegrenzen, Lernpläne und die häufigsten Fehler.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Leitfäden zu deutschen Sprachprüfungen',
    description,
    url: 'https://deutsch-meister.de/leitfaden/',
    inLanguage: 'de',
    publisher: ORGANIZATION,
    dateModified: BUILD_DATE,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: GUIDES.map((guide, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: guide.h1,
        url: guideUrl(guide),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://deutsch-meister.de/' },
      { '@type': 'ListItem', position: 2, name: 'Leitfäden', item: 'https://deutsch-meister.de/leitfaden/' },
    ],
  },
];

const CARD_INTERACTIVE =
  'group flex h-full flex-col rounded-clay border border-rule bg-white p-6 shadow-raise transition-all duration-150 ease-snap hover:-translate-y-0.5 hover:shadow-raise-lg active:translate-y-1 active:shadow-none';
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/leitfaden/" jsonLd={jsonLd} lang="de">
  <div class="overflow-x-clip bg-paper text-ink">

    <!-- ═══ Hero ═══ -->
    <section class="relative" aria-labelledby="hero-h">
      <Aurora />
      <div class="relative mx-auto max-w-3xl px-5 pb-10 pt-14 sm:pt-20">
        <header>
          <p class="hero-line font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" style="--d:0ms">Leitfäden</p>
          <h1 id="hero-h" class="hero-line mt-3 font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.025em] sm:text-[3rem]" style="--d:80ms">
            Prüfungsleitfäden
          </h1>
          <p class="hero-line mt-5 text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" style="--d:220ms">
            Jede deutsche Sprachprüfung hat ihre eigene Logik — welche Teile einzeln zählen, wo die Punkte liegen,
            was zuerst geübt werden sollte. Diese Leitfäden erklären den Aufbau, geben einen Lernplan und benennen
            die Fehler, die am häufigsten Punkte kosten. Kostenlos und ohne Anmeldung.
          </p>
        </header>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-5 pb-20">

      <!-- ═══ The guides: clickable clay cards ═══ -->
      <ul class="grid gap-5">
        {GUIDES.map((guide, i) => (
          <li class="reveal" style={`--rd:${i * 90}ms`}>
            <a href={`/leitfaden/${guide.slug}/`} class={CARD_INTERACTIVE}>
              <p class="flex flex-wrap items-center gap-2.5">
                <span class="rounded-pill bg-siegel-wash px-2.5 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">{guide.badge}</span>
                <span class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">· ca. {guideReadingMinutes(guide)} Min.</span>
              </p>
              <h2 class="mt-3 font-display text-[1.25rem] font-semibold leading-snug text-ink transition-colors group-hover:text-siegel-deep">
                {guide.h1}
              </h2>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">{guide.description}</p>
            </a>
          </li>
        ))}
      </ul>

      <!-- ═══ Which exam — reference prose, flat (rule 3) ═══ -->
      <section class="reveal mt-14 border-t border-rule pt-8" style="--rd:80ms">
        <h2 class="font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] text-ink">Welche Prüfung ist die richtige?</h2>
        <p class="mt-3 text-[0.9375rem] leading-[1.7] text-graphite">
          Für den Nachweis von B1 kommen telc Deutsch B1, das Goethe-Zertifikat B1 und der DTZ in Frage — welcher
          Nachweis in deinem Fall verlangt wird, entscheidet die zuständige Behörde oder Stelle. Wenn du frei wählen
          kannst: Das Goethe-Zertifikat ist modular und lässt sich in Teilen ablegen, telc prüft in zwei Blöcken mit
          Sprachbausteinen als eigenem Teil, und der DTZ ist skaliert und auf den Alltag in Deutschland zugeschnitten.
        </p>
        <p class="mt-3 text-[0.9375rem] leading-[1.7] text-graphite">
          Unsicher, wo du gerade stehst? Der
          <a href="/level-test/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">kostenlose Einstufungstest</a>
          zeigt dir dein Niveau in wenigen Minuten.
        </p>
      </section>

    </div>
  </div>
</Layout>
