---
// The Courses hub — the level courses as a product with their own front door
// (decision 2026-09-08: the courses used to exist only as price cards). Eight
// rungs A1.1 → B2.2; A1.1 free, each paid sub-level its own one-time course,
// B1/B2 listed as coming soon. Every figure derives: prices from pricing.js,
// grammar counts from the content cache, the rest from data/courseContents.js.
import Layout from '../../layouts/Layout.astro';
import ProductWindow from '../../components/proof/ProductWindow.astro';
import '../../styles/global.css';
import CourseCheckout from '../../components/CourseCheckout.astro';
import { fontPreloads, signFontPreloads } from '../../data/design-tokens.js';
import { ORGANIZATION } from '../../lib/siteMeta.js';
import { getTopicsForLevel } from '../../lib/grammar.js';
import { levelCoursesWithVariants } from '../../lib/courseVariants.js';
import { ALL_LEVELS, COURSE_PRO_MONTHS, COURSE_FROM_PRICE_EUR, eur, productKeyForLevel } from '../../data/pricing.js';
import { FREE_LEVEL_LABEL } from '../../data/marketing.js';
import { COURSE_CONTENTS, LEVEL_OUTCOME_EN, levelToSlug } from '../../data/courseContents.js';
import { curriculumFor } from '../../data/curricula/index.js';
import { hasSyllabus } from '../../lib/syllabus.js';

// v4 "Die Linie" keys (styles/linie.css).
const BTN_PRIMARY = 'dm-key dm-key-siegel';
const BTN_SECONDARY = 'dm-key dm-key-ghost';
const preloads = [...new Set([...signFontPreloads, ...fontPreloads])];

const courses = levelCoursesWithVariants();
const byKey = Object.fromEntries(courses.map((c) => [c.key, c]));

const rungs = await Promise.all(ALL_LEVELS.map(async (level) => {
  const topics = await getTopicsForLevel(level);
  const c = byKey[productKeyForLevel(level)] || null; // null for the free level
  const content = COURSE_CONTENTS[level];
  const showSyllabus = hasSyllabus(curriculumFor(level));
  return { lesson: curriculumFor(level)?.lektionen?.[0], level, code: level.toUpperCase(), slug: levelToSlug(level), course: c, topics: topics.length, content, showSyllabus };
}));

const title = 'German Courses A1–B2, one level at a time | DeutschMeister';
const description = `Buy one German level and keep it for life. ${FREE_LEVEL_LABEL} is free; every paid sub-level from ${eur(COURSE_FROM_PRICE_EUR)} once, with ${COURSE_PRO_MONTHS} months of Pro included. B1 and B2 coming soon.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'German Courses',
  description,
  url: 'https://deutsch-meister.de/courses/',
  inLanguage: 'en',
  publisher: ORGANIZATION,
};
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/courses/" jsonLd={jsonLd} lang="en" preloads={preloads}>
  <div class="overflow-x-clip bg-paper text-ink">
    <section class="dm-hero text-ink" data-ground="nacht" aria-labelledby="hero-h">
      <div class="dm-hero-grid">
        <div>
        <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">Courses · A1.1 → B2.2</p>
        <h1 id="hero-h" class="dm-hero-title mt-4">Find your German.<br/><em>Start your chapter.</em></h1>
        <p class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-nacht-muted sm:text-[1.1875rem]">
          Start with {FREE_LEVEL_LABEL}, free. A1.2 is the next guided course. Later levels have practice materials; complete guided courses follow in order. Exam preparation comes at the end of each full level.
          Not sure where you stand? The <a href="/level-test/" class="dm-link-nacht font-semibold">level test is free</a> and takes about 20 minutes.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/course/a1.1" class="dm-key dm-key-siegel">Start A1.1 free</a>
          <a href="/courses/a1-2/" class="dm-key dm-key-ghost-nacht">Explore A1.2 →</a>
        </div>
        </div>
        <ProductWindow level="a1.2" />
      </div>
    </section>


    <section class="dm-course-catalogue mx-auto max-w-7xl px-5 pb-20 pt-12" aria-labelledby="inside-h">
      <h2 id="inside-h" class="sign-head text-[clamp(1.875rem,4.4vw,2.75rem)]">Choose your next level</h2>
      <ol class="mt-8 grid gap-5 sm:grid-cols-2">
        {rungs.filter((r) => r.showSyllabus).map((r, i) => (
          <li class="" style={`--rd:${i * 70}ms`}>
            <article class={`relative flex h-full flex-col rounded-clay border border-rule bg-white p-6 ${r.course?.comingSoon ? 'opacity-85' : ''}`}>
              {r.course?.comingSoon && (
                <span class="absolute -top-3 left-6 inline-flex items-center rounded-lg bg-paper-sunk px-3 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">Coming soon</span>
              )}
              {!r.course && (
                <span class="absolute -top-3 left-6 inline-flex items-center rounded-lg bg-siegel-wash px-3 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">Free</span>
              )}
              <div class="dm-catalogue-cover"><strong>{r.code}</strong><span><small>Example · first lesson</small><span lang="de">{r.lesson?.title}</span></span></div>
              <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep">Course {i + 1} · {r.code}</p>
              <h3 class="mt-2 sign-head text-[1.5rem] text-ink">
                <a href={`/courses/${r.slug}/`} class="transition-colors hover:text-siegel-deep">German {r.code} Course</a>
              </h3>
              <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-graphite">{LEVEL_OUTCOME_EN[r.level]}</p>
              <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 font-data text-[0.75rem] text-graphite">
                <li>{r.topics} grammar topics</li>
                <li>{r.content.reading.length} reading texts</li>
                <li>{r.content.listening.length} listening exercises</li>
                <li>{r.content.words} words</li>
              </ul>
              <div class="mt-5 flex items-end justify-between gap-3">
                <p class="sign-code text-[1.75rem] leading-none text-ink">
                  {r.course ? eur(r.course.price) : 'Free'}
                  {r.course && <span class="ml-1 font-body text-xs font-normal tracking-normal text-graphite">one time</span>}
                </p>
                <a href={`/courses/${r.slug}/`} class="text-sm font-bold text-siegel transition-colors hover:text-siegel-deep">What's inside →</a>
              </div>
              {r.showSyllabus && (
                <a href={`/courses/${r.slug}/#lehrplan-h`} class="mt-2 text-xs font-bold text-siegel transition-colors hover:text-siegel-deep">View the lesson plan →</a>
              )}
              <div data-course-door={r.level} data-course-code={r.code} data-course-open-class={`${BTN_PRIMARY} mt-4 w-full`}>
              {r.course ? (
                r.course.variantId ? (
                  <button type="button" class={`${BTN_PRIMARY} mt-4 w-full`} data-course-variant={r.course.variantId} data-course-key={r.course.key} data-course-price={r.course.price} data-track-surface="courses_hub">Buy {r.code}</button>
                ) : (
                  <span class={`${BTN_SECONDARY} mt-4 w-full cursor-not-allowed opacity-60`} aria-disabled="true">{r.course.comingSoon ? 'Im Bau · coming soon' : 'Checkout not open here'}</span>
                )
              ) : (
                <a href={`/course/${r.level}`} class={`${BTN_SECONDARY} mt-4 w-full`}>Start the free course</a>
              )}
              </div>
            </article>
          </li>
        ))}
      </ol>

      <section class="mt-10 border-t border-rule pt-8" aria-labelledby="next-levels-h">
        <h2 id="next-levels-h" class="sign-head text-2xl">Still taking shape</h2>
        <p class="mt-3 max-w-2xl text-graphite">These levels have practice libraries. Their complete guided courses are still being built; a library is not a finished course.</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {rungs.filter((r) => !r.showSyllabus).map((r) => (
            <li><a class="flex items-center justify-between gap-4 rounded-xl border border-rule p-4 dm-link" href={`/courses/${r.slug}/`}><strong>{r.code}</strong><span>Explore materials and availability →</span></a></li>
          ))}
        </ul>
      </section>

      <p class="mt-10 border-t border-rule pt-6 text-[0.9375rem] leading-relaxed text-graphite" style="--rd:200ms">
        Every paid course includes {COURSE_PRO_MONTHS} months of Pro (AI speaking coach, writing feedback,
        Sentence X-Ray). Prefer everything at once? <a href="/pricing/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">Pro opens all eight levels</a> for a monthly fee.
        Preparing for a specific exam? <a href="/pruefung/" class="font-bold text-siegel transition-colors hover:text-siegel-deep">See the exam tracks</a>.
      </p>
    </section>
  </div>
  <CourseCheckout />
</Layout>
