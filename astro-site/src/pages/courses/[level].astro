---
// One page per sub-level course: what is inside, what it costs, how to buy.
// Grammar topics from the content cache; everything else from
// data/courseContents.js; prices from pricing.js. The free level renders the
// same page with a "Start free" door instead of a checkout.
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import CourseCheckout from '../../components/CourseCheckout.astro';
import { fontPreloads, signFontPreloads } from '../../data/design-tokens.js';
import { STATIONS, stationFor, ticketLines, planLine } from '../../data/offers.js';
import { ORGANIZATION } from '../../lib/siteMeta.js';
import { getTopicsForLevel } from '../../lib/grammar.js';
import { levelCoursesWithVariants } from '../../lib/courseVariants.js';
import { ALL_LEVELS, COURSE_PRO_MONTHS, CURRENCY, PLANS, eur, productKeyForLevel } from '../../data/pricing.js';
import { FREE_LEVEL_LABEL } from '../../data/marketing.js';
import { COURSE_CONTENTS, LEVEL_OUTCOME_EN, levelToSlug } from '../../data/courseContents.js';
import { curriculumFor } from '../../data/curricula/index.js';
import { hasSyllabus, wortfeldRunningTotals, wortlisteTotalFor, checkpointAfter, primaryGrammarTitle, kannBeschreibungenCount, pruefungsteileCoverage, goetheRichtwertFor, courseTimeSplit, hoursDe, LEKTION_ANATOMY } from '../../lib/syllabus.js';
import CourseProof from '../../components/proof/CourseProof.astro';
import GrammarWindow from '../../components/proof/GrammarWindow.astro';
import ProductWindow from '../../components/proof/ProductWindow.astro';

export async function getStaticPaths() {
  return ALL_LEVELS.map((level) => ({ params: { level: levelToSlug(level) }, props: { level } }));
}

const { level } = Astro.props;
const code = level.toUpperCase();
const slug = levelToSlug(level);
const course = levelCoursesWithVariants().find((c) => c.key === productKeyForLevel(level)) || null;
const isFree = !course;
const buyable = Boolean(course?.variantId);
const content = COURSE_CONTENTS[level];
const topics = await getTopicsForLevel(level);
const idx = ALL_LEVELS.indexOf(level);
const next = ALL_LEVELS[idx + 1] || null;
const prev = ALL_LEVELS[idx - 1] || null;

// Public syllabus (docs/course-standard-2026-09-12.md §2.4). Renders only once
// the curriculum module has actual Lektionen — nothing for a placeholder.
const curriculum = curriculumFor(level);
const showSyllabus = hasSyllabus(curriculum);
const titlesBySlug = Object.fromEntries(topics.map((t) => [t.slug, t.title_de]));
const wortfeldRows = showSyllabus ? wortfeldRunningTotals(curriculum.lektionen) : [];
const wortlisteTotal = wortlisteTotalFor(level);
const kannCount = showSyllabus ? kannBeschreibungenCount(curriculum.lektionen) : 0;
const teileCoverage = showSyllabus ? pruefungsteileCoverage(curriculum.lektionen) : null;
const richtwert = goetheRichtwertFor(level);
const wortfeldTotal = wortfeldRows.at(-1)?.running ?? 0;
// `hoursTotal` is guided lesson time PLUS a budget for the practice material
// around each Lektion, and only the first half exists as content — the header of
// data/curricula/a11.js forbids selling the sum as „54 Stunden Kurs“. Both halves
// are derived from the curriculum's own minutes, never typed in here.
const time = showSyllabus ? courseTimeSplit(curriculum) : null;

// v4 "Die Linie" keys (styles/linie.css): ink on paper, linie on the night hero.
const BTN_PRIMARY = 'dm-key dm-key-siegel';
const BTN_SECONDARY = 'dm-key dm-key-ghost';
const BTN_HERO = 'dm-key dm-key-linie';
const station = stationFor(level);
const lines = ticketLines(level);
const preloads = [...new Set([...signFontPreloads, ...fontPreloads])];

// The Fahrschein (scroll-craft, docs/scrollcraft/builds/course-ticket/BRIEF.md): a level a visitor
// can start or buy carries a ticket beside its contents, stamped with each part as the reader
// passes it (a bottom bar below 1280px). Im Bau levels sell nothing, so they carry none. Every count
// below is one the page already renders. Beside the ticket the contents column is 704px at 1280px,
// which is why the syllabus table's min-width is 680px: keep it under that or it scrolls sideways.
const rides = !course?.comingSoon;
const stamps = [
  showSyllabus && { id: 'lehrplan', de: 'Lehrplan', en: `${curriculum.lektionen.length} lessons` },
  { id: 'grammatik', de: 'Grammatik', en: `${topics.length} topics` },
  { id: 'lesen', de: 'Lesen', en: `${content.reading.length} texts` },
  { id: 'hoeren', de: 'Hören', en: `${content.listening.length} exercises` },
  { id: 'wortschatz', de: 'Wortschatz', en: `${content.words} words with audio` },
  { id: 'sprechen', de: 'Sprechen', en: `${content.missions} missions` },
  content.finalTest && { id: 'test', de: 'Abschlusstest', en: `${content.finalTest.format} format` },
  content.finalTest && { id: 'plan', de: '28-Tage-Plan', en: 'to the final test' },
].filter(Boolean);

const priceLine = isFree ? 'Free' : `${eur(course.price)} once`;
const title = `German ${code} Course — ${isFree ? 'free' : course.comingSoon ? 'coming soon' : priceLine} | DeutschMeister`;
const description = `${LEVEL_OUTCOME_EN[level]} ${topics.length} grammar topics, ${content.reading.length} reading texts, ${content.listening.length} listening exercises, ${content.words} words${content.finalTest ? ', a final test and a 28-day plan' : ''}. ${isFree ? 'Free, no account needed.' : course.comingSoon ? 'Coming soon.' : `${priceLine}, lifetime access, ${COURSE_PRO_MONTHS} months of Pro included.`}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `German ${code} Course`,
  description,
  url: `https://deutsch-meister.de/courses/${slug}/`,
  inLanguage: 'en',
  educationalLevel: code,
  provider: ORGANIZATION,
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT28D' },
  ...(isFree
    ? { isAccessibleForFree: true }
    : course.comingSoon
      ? {}
      : { offers: { '@type': 'Offer', price: String(course.price), priceCurrency: CURRENCY, availability: 'https://schema.org/InStock', url: `https://deutsch-meister.de/courses/${slug}/` } }),
};
---

<Layout title={title} description={description} canonical={`https://deutsch-meister.de/courses/${slug}/`} jsonLd={jsonLd} lang="en" preloads={preloads}>
  <div class="overflow-x-clip bg-paper text-ink">
    <!-- The station: where this level sits on the line, what it costs, the door. -->
    <section class="dm-level-hero relative text-ink" data-ground="nacht" aria-labelledby="hero-h">
      <div class="mx-auto max-w-5xl px-4 pb-14 pt-10 sm:px-6 sm:pt-14">
        <nav class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep" aria-label="Breadcrumb">
          <a href="/courses/" class="underline decoration-nacht-rule underline-offset-4 hover:decoration-linie">Courses</a> · German {code}
        </nav>

        <div class="dm-level-opening mt-8">
          <div class="dm-level-heading">
            <h1 id="hero-h" class="dm-hero-title !text-[clamp(2.75rem,6vw,5rem)]">
              <span class="block whitespace-nowrap">German {code}</span>
              <span class="mt-3 block text-[clamp(1.25rem,4vw,2rem)] leading-tight text-nacht-muted">{station.name}</span>
            </h1>
            <p class="mt-5 max-w-xl text-[1.0625rem] leading-relaxed text-nacht-muted sm:text-[1.1875rem]">{LEVEL_OUTCOME_EN[level]}</p>
            {planLine(station) && <p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-nacht-muted">{planLine(station)}</p>}
          </div>
          <div class="dm-level-stage"><div class="border" data-hero-door>
            <p class="sign-code text-[2.5rem] leading-none text-linie">{isFree ? 'Free' : course.comingSoon ? 'Im Bau' : eur(course.price)}</p>
            <p class="mt-2 text-[0.875rem] text-nacht-muted">
              {isFree
                ? 'No account, no card. The whole level is open.'
                : course.comingSoon
                  ? 'Im Bau: being rebuilt to the A1/A2 standard. Not for sale yet, on purpose.'
                  : `One time · yours to keep · ${COURSE_PRO_MONTHS} months of Pro included · no subscription`}
            </p>
            <div class="mt-5 flex flex-col gap-3">
              <div data-course-door={level} data-course-code={code} data-course-open-class={`${BTN_HERO} w-full`}>
              {isFree ? (
                <a href={`/course/${level}`} class={`${BTN_HERO} w-full`}>Start the free {code} course</a>
              ) : buyable ? (
                <button type="button" class={`${BTN_HERO} w-full`} data-course-variant={course.variantId} data-course-key={course.key} data-course-price={course.price} data-track-surface="course_page">Buy {code} — {eur(course.price)}</button>
              ) : course.comingSoon ? (
                <a href="/pricing/#pro" class="dm-key dm-key-ghost-nacht w-full">Explore {code} practice with Pro</a>
              ) : (
                <a href="/pricing/" class="dm-key dm-key-ghost-nacht w-full">Checkout not open here — see pricing</a>
              )}
              </div>
              {!isFree && !course.comingSoon && (
                <a href="/pricing/#pro" class="dm-link-nacht text-center text-[0.8125rem] font-semibold">
                  or Pro for every level — {eur(PLANS.monthly.price)}/month
                </a>
              )}
            </div>
          </div>{showSyllabus ? <ProductWindow level={level} compact /> : <GrammarWindow level={level} topic={topics[0]} unfinished={course?.comingSoon} />}</div>
        </div>
        <nav class="dm-level-nav" aria-label="Course levels">{STATIONS.map((st) => <a href={st.coursePage} aria-current={st.level === level ? 'page' : undefined}>{st.code}</a>)}</nav>

      </div>
    </section>

    {showSyllabus && <CourseProof level={level} />}

    {lines.length > 0 && (
      <!-- What the ticket carries — the same lines as the homepage ticket. -->
      <section class="border-b border-rule bg-paper" aria-labelledby="ticket-h" data-track-view="course_ticket" data-track-level={level}>
        <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
          <h2 id="ticket-h" class="sign-head text-[clamp(1.875rem,4.4vw,2.75rem)]">Inside your {code} course</h2>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2">
            {lines.map((line) => (
              <li class="border-t border-ink pt-4">
                <p class="sign-label text-[1.125rem] text-ink">{line.title}</p>
                <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-graphite">{line.body}</p>
                <p class="mt-1 font-data text-[0.75rem] text-graphite">No more {line.removes}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <div class:list={['dm-level-body mx-auto px-5 pb-20 pt-12', rides ? 'max-w-7xl xl:grid xl:grid-cols-[minmax(0,1fr)_17rem] xl:gap-10' : 'max-w-3xl']} data-fahrschein-root={rides ? '' : undefined}>
      <div class="mx-auto min-w-0 max-w-3xl xl:mx-0 xl:max-w-none">
        {showSyllabus && (
          <!-- Lehrplan -->
          <section id="stamp-lehrplan" class="mt-4 scroll-mt-24" aria-labelledby="lehrplan-h" data-stamp="lehrplan">
            <h2 id="lehrplan-h" class="sign-head text-[1.75rem] sm:text-[2.125rem]">Lesson plan · {curriculum.lektionen.length} lessons</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
              Each lesson starts with an everyday situation. Inspect the learning goals, vocabulary, grammar and exam practice below. The original curriculum is in German.
            </p>

            <details class="mt-5"><summary class="dm-link cursor-pointer py-3 font-bold">View all lessons</summary>
            <div class="mt-3 overflow-x-auto rounded-xl border border-rule" tabindex="0" role="region" aria-label="Lehrplan">
              <table class="w-full min-w-[680px] border-collapse text-left text-[0.8125rem]">
                <thead>
                  <tr class="border-b border-rule bg-paper-sunk font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">
                    <th class="px-3 py-2">Nr</th>
                    <th class="px-3 py-2">Situation</th>
                    <th class="px-3 py-2">Kann-Beschreibungen</th>
                    <th class="px-3 py-2">Wortfeld</th>
                    <th class="px-3 py-2">Grammatik</th>
                    <th class="px-3 py-2">Prüfungsteil</th>
                  </tr>
                </thead>
                <tbody>
                  {curriculum.lektionen.map((l, i) => {
                    const row = wortfeldRows[i];
                    const cp = checkpointAfter(curriculum, l.nr);
                    return (
                      <>
                        <tr class="border-b border-rule/60 align-top">
                          <td class="px-3 py-3 font-data font-bold text-siegel">{String(l.nr).padStart(2, '0')}</td>
                          <td class="px-3 py-3 font-bold text-ink">{l.title}</td>
                          <td class="px-3 py-3 text-graphite">
                            <ul class="list-disc space-y-0.5 pl-4">
                              {(l.canDo ?? []).map((c) => <li>{c}</li>)}
                            </ul>
                          </td>
                          <td class="px-3 py-3 text-graphite">
                            +{row?.count ?? 0} → {row?.running ?? 0}{wortlisteTotal ? `/${wortlisteTotal}` : ''}
                          </td>
                          <td class="px-3 py-3 text-graphite">{primaryGrammarTitle(l, titlesBySlug)}</td>
                          <td class="px-3 py-3 text-graphite">{(l.examTeile ?? []).join(', ')}</td>
                        </tr>
                        {cp && (
                          <tr class="border-b border-rule/60 bg-siegel-wash">
                            <td class="px-3 py-2" colspan="6">
                              <span class="font-data text-[0.75rem] font-bold uppercase tracking-[0.08em] text-siegel-deep">{cp.title}</span>
                            </td>
                          </tr>
                        )}
                      </>
                    );
                  })}
                </tbody>
              </table>
            </div>

            </details>

            <!-- Lektion anatomy strip -->
            <h3 class="mt-8 sign-label text-[1.125rem] text-ink">So läuft eine Lektion ab</h3>
            <div class="mt-3 overflow-x-auto" tabindex="0" role="region" aria-label="So läuft eine Lektion ab">
              <ol class="flex min-w-max gap-2">
                {LEKTION_ANATOMY.map((step) => (
                  <li class="flex w-32 flex-none flex-col rounded-clay border border-rule bg-white p-3">
                    <span class="font-data text-[0.6875rem] font-bold text-siegel">{String(step.nr).padStart(2, '0')}</span>
                    <span class="mt-1 text-[0.8125rem] font-bold text-ink">{step.titleDe}</span>
                    <span class="mt-1 font-data text-[0.6875rem] text-graphite">{step.minutes} Min.</span>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Running counters -->
            <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
              <div class="rounded-clay border border-rule bg-white p-4">
                <dt class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">Wörter / Wortliste</dt>
                <dd class="mt-1 sign-code text-[1.5rem] text-ink">{wortfeldTotal}{wortlisteTotal ? `/${wortlisteTotal}` : ''}</dd>
              </div>
              <div class="rounded-clay border border-rule bg-white p-4">
                <dt class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">Geführte Lektionszeit</dt>
                <dd class="mt-1 sign-code text-[1.5rem] text-ink">{hoursDe(time.guidedHours)} h</dd>
                <dd class="mt-1 font-data text-[0.6875rem] leading-relaxed text-graphite">+ {hoursDe(time.practiceHours)} h Übungsmaterial</dd>
              </div>
              <div class="rounded-clay border border-rule bg-white p-4">
                <dt class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">Kann-Beschreibungen</dt>
                <dd class="mt-1 sign-code text-[1.5rem] text-ink">{kannCount}</dd>
              </div>
              <div class="rounded-clay border border-rule bg-white p-4">
                <dt class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">Prüfungsteile geübt</dt>
                <dd class="mt-1 sign-code text-[1.5rem] text-ink">{teileCoverage.covered} von {teileCoverage.of}</dd>
              </div>
            </dl>

            <p class="mt-6 text-[0.8125rem] leading-relaxed text-graphite">
              Die {hoursDe(time.guidedHours)} h sind geführte Lektionszeit, die als Inhalt existiert: {curriculum.lektionen.length} Lektionen,
              {' '}{curriculum.checkpoints?.length ?? 0} Checkpoints und die Wiederholungen dazwischen. Die weiteren
              {' '}{hoursDe(time.practiceHours)} h sind Übungsmaterial rund um die Lektionen — Hören, Lesen, Sprechen, Wortschatz und
              Schreiben; dieses Material ist noch nicht zu jeder Lektion vollständig.{richtwert ? ` Goethe-Richtwert für das ganze Niveau: ${richtwert[0]}–${richtwert[1]} Unterrichtseinheiten.` : ''}
            </p>

            <p class="mt-3 text-[0.8125rem] leading-relaxed text-graphite">
              Quelle: {curriculum.provenance?.canDo}. Wortliste: {curriculum.provenance?.wortliste}. Themen: {curriculum.provenance?.themen}.
            </p>

            <a href={`/course/${level}`} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-siegel transition-colors hover:text-siegel-deep">Open the course →</a>
          </section>
        )}

        <!-- Grammar -->
        <section id="stamp-grammatik" class="mt-4 scroll-mt-24" aria-labelledby="grammar-h" data-stamp="grammatik">
          <h2 id="grammar-h" class="sign-head text-[1.75rem] sm:text-[2.125rem]">{topics.length} grammar topics, in order</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
            Every topic: rules in plain language, worked examples, and exercises you answer by
            typing or choosing, each checked on the spot. The rules are free to read at every level; the practice is part of the course.
          </p>
          <ol class="mt-5 grid gap-2 sm:grid-cols-2">
            {topics.map((t, i) => (
              <li class="flex items-baseline gap-3 rounded-clay border border-rule bg-white px-4 py-3">
                <span class="font-data text-[0.6875rem] font-bold text-siegel">{String(i + 1).padStart(2, '0')}</span>
                <a href={`/grammar/${level}/${t.slug}/`} class="text-[0.9375rem] font-bold text-ink transition-colors hover:text-siegel-deep">{t.title_en}</a>
              </li>
            ))}
          </ol>
        </section>

        <!-- Reading + listening -->
        <section class="mt-12 grid gap-8 sm:grid-cols-2" style="--rd:80ms" aria-labelledby="skills-h">
          <div id="stamp-lesen" class="scroll-mt-24" data-stamp="lesen">
            <h2 id="skills-h" class="sign-head text-[1.5rem]">{content.reading.length} reading texts</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
              {content.finalTest ? 'Short, in-level texts with richtig/falsch checks and exam-style parts.' : 'Longer texts on the level\'s themes; checks arrive with the rebuild.'}
            </p>
            <ul class="mt-3 space-y-1 text-[0.875rem] text-ink">
              {content.reading.map((t) => <li class="border-b border-rule/60 py-1.5">{t}</li>)}
            </ul>
          </div>
          <div id="stamp-hoeren" class="scroll-mt-24" data-stamp="hoeren">
            <h2 class="sign-head text-[1.5rem]">{content.listening.length} listening exercises</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
              Native-speaker dialogues, {content.listeningQuestions} questions{content.dictation ? `, ${content.dictation} of them dictation` : ''}.
            </p>
            <ul class="mt-3 space-y-1 text-[0.875rem] text-ink">
              {content.listening.map((t) => <li class="border-b border-rule/60 py-1.5">{t}</li>)}
            </ul>
          </div>
        </section>

        <!-- Vocabulary, speaking, test, plan -->
        <section class="mt-12 grid gap-4 sm:grid-cols-2" style="--rd:120ms" aria-label="Also in this course">
          <div id="stamp-wortschatz" class="scroll-mt-24 rounded-clay border border-rule bg-white p-5" data-stamp="wortschatz">
            <h3 class="font-bold text-ink">{content.words} words with audio</h3>
            <p class="mt-1 text-[0.875rem] text-graphite">{content.wordCategories} themed lists, every word spoken by a native voice, spaced repetition built in.</p>
          </div>
          <div id="stamp-sprechen" class="scroll-mt-24 rounded-clay border border-rule bg-white p-5" data-stamp="sprechen">
            <h3 class="font-bold text-ink">{content.missions} speaking missions</h3>
            <p class="mt-1 text-[0.875rem] text-graphite">Role-play with the AI coach on this level's situations; feedback on grammar and expression.</p>
          </div>
          {content.finalTest ? (
            <>
              <div id="stamp-test" class="scroll-mt-24 rounded-clay border border-rule bg-white p-5" data-stamp="test">
                <h3 class="font-bold text-ink">Final test in the {content.finalTest.format} format</h3>
                <p class="mt-1 text-[0.875rem] text-graphite">Timed, half exam length: listening and reading are scored against the exam's pass line, writing is a self-check.</p>
              </div>
              <div id="stamp-plan" class="scroll-mt-24 rounded-clay border border-rule bg-white p-5" data-stamp="plan">
                <h3 class="font-bold text-ink">28-day plan</h3>
                <p class="mt-1 text-[0.875rem] text-graphite">A few short activities a day through the whole level, ending in the final test.</p>
              </div>
            </>
          ) : (
            <div class="rounded-clay border border-rule bg-paper-sunk p-5 sm:col-span-2">
              <h3 class="font-bold text-ink">Final test and 28-day plan: coming with the rebuild</h3>
              <p class="mt-1 text-[0.875rem] text-graphite">The A1 and A2 courses have them today; {code} gets them before it goes on sale.</p>
            </div>
          )}
        </section>

        <!-- Buy again + neighbours -->
        <section class="mt-12 rounded-clay border border-rule bg-white p-6 shadow-raise" style="--rd:160ms" data-fahrschein-close>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="sign-head text-[1.375rem] text-ink">{isFree ? `${code} is free — start now.` : course.comingSoon ? `${code} is Im Bau.` : `Own ${code} for ${eur(course.price)}.`}</p>
              <p class="mt-1 text-[0.875rem] text-graphite">
                {isFree ? `${FREE_LEVEL_LABEL} needs no account. A free account adds a trial of Pro on top.` : course.comingSoon ? 'Pro opens every level today, including this one.' : `Pay once. Nothing renews, nothing expires. ${COURSE_PRO_MONTHS} months of Pro included.`}
              </p>
            </div>
            <div data-course-door={level} data-course-code={code} data-course-open-class={BTN_PRIMARY}>
            {isFree ? (
              <a href={`/course/${level}`} class={BTN_PRIMARY}>Start the free {code} course</a>
            ) : buyable ? (
              <button type="button" class={BTN_PRIMARY} data-course-variant={course.variantId} data-course-key={course.key} data-course-price={course.price} data-track-surface="course_page_bottom">Buy {code} — {eur(course.price)}</button>
            ) : (
              <a href="/pricing/" class={BTN_SECONDARY}>See Pro</a>
            )}
            </div>
          </div>
        </section>

        <nav class="mt-8 flex justify-between font-data text-[0.75rem] text-graphite" aria-label="Neighbouring levels">
          {prev ? <a href={`/courses/${levelToSlug(prev)}/`} class="dm-link">← {prev.toUpperCase()}</a> : <span />}
          <a href="/courses/" class="dm-link">All courses</a>
          {next ? <a href={`/courses/${levelToSlug(next)}/`} class="dm-link">{next.toUpperCase()} →</a> : <span />}
        </nav>
      </div>

      {rides && (
        <!-- The Fahrschein: every part of the level, stamped as the reader passes it. -->
        <aside class="hidden xl:block" aria-labelledby="fahrschein-h">
          <div class="sticky top-24">
            <article class="max-h-[calc(100vh-7rem)] overflow-y-auto dm-course-contents rounded-window border border-rule bg-white">
              <div class="bg-linie px-5 py-4 text-linie-ink">
                <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em]" lang="de">Course at a glance</p>
                <p id="fahrschein-h" class="sign-code mt-1 text-[2rem] leading-none">{code}</p>
                <p class="mt-1.5 text-[0.8125rem]">{isFree ? 'Free · no account' : `${eur(course.price)} once · yours to keep`}</p>
              </div>
              <ol class="px-3 py-2">
                {stamps.map((s, i) => (
                  <li>
                    <a href={`#stamp-${s.id}`} class="flex items-center gap-3 rounded-xl px-2 py-1 transition-colors hover:bg-paper-sunk" data-stamp-slot={s.id}>
                      <span class="dm-content-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <span class="min-w-0">
                        <span class="block text-[0.9375rem] font-bold leading-tight text-ink" lang="de">{s.de}</span>
                        <span class="block text-[0.75rem] leading-snug text-graphite">{s.en}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
              <div class="border-t border-dashed border-rule px-5 pb-5 pt-4">
                <p class="mb-3 text-[0.8125rem] text-graphite" data-fahrschein-done><span class="font-bold text-siegel-deep" lang="de">Your course.</span> {isFree ? 'Your course, free.' : 'Your course, one payment.'}</p>
                <div data-course-door={level} data-course-code={code} data-course-open-class={`${BTN_PRIMARY} w-full`}>
                {isFree ? (
                  <a href={`/course/${level}`} class={`${BTN_PRIMARY} w-full`}>Start {code} free</a>
                ) : buyable ? (
                  <button type="button" class={`${BTN_PRIMARY} w-full`} data-course-variant={course.variantId} data-course-key={course.key} data-course-price={course.price} data-track-surface="course_fahrschein">Buy {code} — {eur(course.price)}</button>
                ) : (
                  <a href="/pricing/" class="dm-key dm-key-ghost w-full">See pricing</a>
                )}
                </div>
              </div>
            </article>
          </div>
        </aside>
      )}

      {rides && (
        <!-- Below 1280px: the ticket rides along as a bar once the hero's door has scrolled away. -->
        <aside class="dm-fahrschein-bar fixed inset-x-0 bottom-0 z-30 border-t border-rule bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md xl:hidden" aria-label={`${code} course`} data-fahrschein-bar>
          <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-2.5">
            <div class="min-w-0 flex-1">
              <p class="truncate"><span class="sign-code text-[1.125rem] text-ink">{code}</span> <span class="text-[0.8125rem] text-graphite">{isFree ? 'Free' : `${eur(course.price)} once`}</span></p>
              <p class="mt-1 text-xs text-graphite">{isFree ? 'Full first course · no account' : 'One payment · no renewal'}</p>
            </div>
            <div class="flex-none" data-course-door={level} data-course-code={code} data-course-open-class={`${BTN_PRIMARY} !min-h-10 !px-4 !py-2 !text-[0.875rem]`}>
            {isFree ? (
              <a href={`/course/${level}`} class={`${BTN_PRIMARY} !min-h-10 !px-4 !py-2 !text-[0.875rem]`}>Start free</a>
            ) : buyable ? (
              <button type="button" class={`${BTN_PRIMARY} !min-h-10 !px-4 !py-2 !text-[0.875rem]`} data-course-variant={course.variantId} data-course-key={course.key} data-course-price={course.price} data-track-surface="course_bar">Buy {code}</button>
            ) : (
              <a href="/pricing/" class="dm-key dm-key-ghost !min-h-10 !px-4 !py-2 !text-[0.875rem]">Pricing</a>
            )}
            </div>
          </div>
        </aside>
      )}
    </div>
  </div>
  <CourseCheckout />
</Layout>

<script>
  // Presentation only: keep the purchase bar clear of the hero, closing action
  // and existing course-return bar. Availability and all checkout attributes
  // remain server rendered; no action depends on this enhancement.
  const root = document.querySelector('[data-fahrschein-root]');
  if (root) {
    const bar = root.querySelector('[data-fahrschein-bar]');
    const hero = document.querySelector('[data-hero-door]');
    const closeDoor = root.querySelector('[data-fahrschein-close] [data-course-door]');
    let frame = 0;
    const update = () => {
      frame = 0;
      const show = hero.getBoundingClientRect().bottom < 80
        && closeDoor.getBoundingClientRect().top > window.innerHeight - bar.offsetHeight
        && !document.querySelector('[data-course-return-bar]');
      bar.classList.toggle('is-shown', show);
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
  }
</script>
