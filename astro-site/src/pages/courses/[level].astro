---
// One page per sub-level course: what is inside, what it costs, how to buy.
// Grammar topics from the content cache; everything else from
// data/courseContents.js; prices from pricing.js. The free level renders the
// same page with a "Start free" door instead of a checkout.
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import Aurora from '../../components/Aurora.astro';
import CourseCheckout from '../../components/CourseCheckout.astro';
import { ORGANIZATION } from '../../lib/siteMeta.js';
import { getTopicsForLevel } from '../../lib/grammar.js';
import { levelCoursesWithVariants } from '../../lib/courseVariants.js';
import { ALL_LEVELS, COURSE_PRO_MONTHS, CURRENCY, PLANS, eur, productKeyForLevel } from '../../data/pricing.js';
import { FREE_LEVEL_LABEL } from '../../data/marketing.js';
import { COURSE_CONTENTS, LEVEL_OUTCOME_EN, levelToSlug } from '../../data/courseContents.js';
import { curriculumFor } from '../../data/curricula/index.js';
import { hasSyllabus, wortfeldRunningTotals, wortlisteTotalFor, checkpointAfter, primaryGrammarTitle, kannBeschreibungenCount, pruefungsteileCoverage, goetheRichtwertFor, courseTimeSplit, hoursDe, LEKTION_ANATOMY } from '../../lib/syllabus.js';

export async function getStaticPaths() {
  return ALL_LEVELS.map((level) => ({ params: { level: levelToSlug(level) }, props: { level } }));
}

const { level } = Astro.props;
const code = level.toUpperCase();
const slug = levelToSlug(level);
const course = levelCoursesWithVariants().find((c) => c.key === productKeyForLevel(level)) || null;
const isFree = !course;
const buyable = Boolean(course?.variantId);
const content = COURSE_CONTENTS[level];
const topics = await getTopicsForLevel(level);
const idx = ALL_LEVELS.indexOf(level);
const next = ALL_LEVELS[idx + 1] || null;
const prev = ALL_LEVELS[idx - 1] || null;

// Public syllabus (docs/course-standard-2026-09-12.md §2.4). Renders only once
// the curriculum module has actual Lektionen — nothing for a placeholder.
const curriculum = curriculumFor(level);
const showSyllabus = hasSyllabus(curriculum);
const titlesBySlug = Object.fromEntries(topics.map((t) => [t.slug, t.title_de]));
const wortfeldRows = showSyllabus ? wortfeldRunningTotals(curriculum.lektionen) : [];
const wortlisteTotal = wortlisteTotalFor(level);
const kannCount = showSyllabus ? kannBeschreibungenCount(curriculum.lektionen) : 0;
const teileCoverage = showSyllabus ? pruefungsteileCoverage(curriculum.lektionen) : null;
const richtwert = goetheRichtwertFor(level);
const wortfeldTotal = wortfeldRows.at(-1)?.running ?? 0;
// `hoursTotal` is guided lesson time PLUS a budget for the practice material
// around each Lektion, and only the first half exists as content — the header of
// data/curricula/a11.js forbids selling the sum as „54 Stunden Kurs“. Both halves
// are derived from the curriculum's own minutes, never typed in here.
const time = showSyllabus ? courseTimeSplit(curriculum) : null;

const BTN = 'inline-flex items-center justify-center gap-2 rounded-clay text-sm font-bold transition-all duration-100 ease-snap select-none';
const BTN_PRIMARY = `${BTN} bg-siegel px-6 py-3 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_SECONDARY = `${BTN} border border-rule bg-white px-6 py-3 text-ink shadow-raise hover:border-siegel hover:text-siegel-deep active:translate-y-1 active:shadow-none`;

const priceLine = isFree ? 'Free' : `${eur(course.price)} once`;
const title = `German ${code} Course — ${isFree ? 'free' : course.comingSoon ? 'coming soon' : priceLine} | DeutschMeister`;
const description = `${LEVEL_OUTCOME_EN[level]} ${topics.length} grammar topics, ${content.reading.length} reading texts, ${content.listening.length} listening exercises, ${content.words} words${content.finalTest ? ', a final test and a 28-day plan' : ''}. ${isFree ? 'Free, no account needed.' : course.comingSoon ? 'Coming soon.' : `${priceLine}, lifetime access, ${COURSE_PRO_MONTHS} months of Pro included.`}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `German ${code} Course`,
  description,
  url: `https://deutsch-meister.de/courses/${slug}/`,
  inLanguage: 'en',
  educationalLevel: code,
  provider: ORGANIZATION,
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT28D' },
  ...(isFree
    ? { isAccessibleForFree: true }
    : course.comingSoon
      ? {}
      : { offers: { '@type': 'Offer', price: String(course.price), priceCurrency: CURRENCY, availability: 'https://schema.org/InStock', url: `https://deutsch-meister.de/courses/${slug}/` } }),
};
---

<Layout title={title} description={description} canonical={`https://deutsch-meister.de/courses/${slug}/`} jsonLd={jsonLd} lang="en">
  <div class="overflow-x-clip bg-paper text-ink">
    <section class="relative" aria-labelledby="hero-h">
      <Aurora />
      <div class="relative mx-auto max-w-3xl px-5 pb-10 pt-14 sm:pt-20">
        <nav class="hero-line font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel" style="--d:0ms" aria-label="Breadcrumb">
          <a href="/courses/" class="transition-colors hover:text-siegel-deep">Courses</a> · {code}
        </nav>
        <h1 id="hero-h" class="hero-line mt-3 font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.025em] sm:text-[3rem]" style="--d:80ms">
          German {code} Course
        </h1>
        <p class="hero-line mt-5 text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" style="--d:220ms">{LEVEL_OUTCOME_EN[level]}</p>

        <div class="hero-line mt-8 flex flex-col gap-4 rounded-clay border border-rule bg-white p-6 shadow-raise sm:flex-row sm:items-center sm:justify-between" style="--d:300ms">
          <div>
            <p class="font-display text-[2rem] font-semibold leading-none tracking-[-0.02em] text-ink">
              {isFree ? 'Free' : eur(course.price)}
              {!isFree && <span class="ml-1 font-body text-sm font-normal tracking-normal text-graphite">one time · lifetime</span>}
            </p>
            <p class="mt-2 font-data text-[0.75rem] text-graphite">
              {isFree
                ? 'No account, no card. The whole level is open.'
                : course.comingSoon
                  ? 'Being rebuilt to the A1/A2 standard. Not for sale yet, on purpose.'
                  : `${COURSE_PRO_MONTHS} months of Pro included · no subscription`}
            </p>
          </div>
          <div class="flex flex-col gap-2 sm:items-end">
            <div data-course-door={level} data-course-code={code} data-course-open-class={BTN_PRIMARY}>
            {isFree ? (
              <a href={`/grammar/${level}/`} class={BTN_PRIMARY}>Start {code} free</a>
            ) : buyable ? (
              <button type="button" class={BTN_PRIMARY} data-course-variant={course.variantId} data-course-key={course.key}>Buy {code} — {eur(course.price)}</button>
            ) : (
              <span class={`${BTN_SECONDARY} cursor-not-allowed opacity-60`} aria-disabled="true">Coming soon</span>
            )}
            </div>
            {!isFree && (
              <a href="/pricing/" class="text-xs font-bold text-siegel transition-colors hover:text-siegel-deep">
                or Pro for every level — {eur(PLANS.monthly.price)}/month →
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-5 pb-20">
      {showSyllabus && (
        <!-- Lehrplan -->
        <section class="reveal mt-4" aria-labelledby="lehrplan-h">
          <h2 id="lehrplan-h" class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[1.75rem]">Lehrplan: 12 Lektionen</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
            Jede Lektion ist eine Situation aus dem Alltag, keine Grammatikliste — mit Kann-Beschreibungen
            aus den Goethe-Prüfungszielen, dem geübten Prüfungsteil und einem Ausschnitt aus der
            offiziellen Wortliste.
          </p>

          <div class="mt-5 overflow-x-auto rounded-clay border border-rule">
            <table class="w-full min-w-[720px] border-collapse text-left text-[0.8125rem]">
              <thead>
                <tr class="border-b border-rule bg-paper-sunk font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">
                  <th class="px-3 py-2">Nr</th>
                  <th class="px-3 py-2">Situation</th>
                  <th class="px-3 py-2">Kann-Beschreibungen</th>
                  <th class="px-3 py-2">Wortfeld</th>
                  <th class="px-3 py-2">Grammatik</th>
                  <th class="px-3 py-2">Prüfungsteil</th>
                </tr>
              </thead>
              <tbody>
                {curriculum.lektionen.map((l, i) => {
                  const row = wortfeldRows[i];
                  const cp = checkpointAfter(curriculum, l.nr);
                  return (
                    <>
                      <tr class="border-b border-rule/60 align-top">
                        <td class="px-3 py-3 font-data font-bold text-siegel">{String(l.nr).padStart(2, '0')}</td>
                        <td class="px-3 py-3 font-bold text-ink">{l.title}</td>
                        <td class="px-3 py-3 text-graphite">
                          <ul class="list-disc space-y-0.5 pl-4">
                            {(l.canDo ?? []).map((c) => <li>{c}</li>)}
                          </ul>
                        </td>
                        <td class="px-3 py-3 text-graphite">
                          +{row?.count ?? 0} → {row?.running ?? 0}{wortlisteTotal ? `/${wortlisteTotal}` : ''}
                        </td>
                        <td class="px-3 py-3 text-graphite">{primaryGrammarTitle(l, titlesBySlug)}</td>
                        <td class="px-3 py-3 text-graphite">{(l.examTeile ?? []).join(', ')}</td>
                      </tr>
                      {cp && (
                        <tr class="border-b border-rule/60 bg-siegel-wash">
                          <td class="px-3 py-2" colspan="6">
                            <span class="font-data text-[0.75rem] font-bold uppercase tracking-[0.08em] text-siegel-deep">{cp.title}</span>
                          </td>
                        </tr>
                      )}
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>

          <!-- Lektion anatomy strip -->
          <h3 class="mt-8 font-display text-[1.125rem] font-semibold text-ink">So läuft eine Lektion ab</h3>
          <div class="mt-3 overflow-x-auto">
            <ol class="flex min-w-max gap-2">
              {LEKTION_ANATOMY.map((step) => (
                <li class="flex w-32 flex-none flex-col rounded-clay border border-rule bg-white p-3">
                  <span class="font-data text-[0.6875rem] font-bold text-siegel">{String(step.nr).padStart(2, '0')}</span>
                  <span class="mt-1 text-[0.8125rem] font-bold text-ink">{step.titleDe}</span>
                  <span class="mt-1 font-data text-[0.6875rem] text-graphite">{step.minutes} Min.</span>
                </li>
              ))}
            </ol>
          </div>

          <!-- Running counters -->
          <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div class="rounded-clay border border-rule bg-white p-4">
              <dt class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">Wörter / Wortliste</dt>
              <dd class="mt-1 font-display text-[1.375rem] font-semibold text-ink">{wortfeldTotal}{wortlisteTotal ? `/${wortlisteTotal}` : ''}</dd>
            </div>
            <div class="rounded-clay border border-rule bg-white p-4">
              <dt class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">Geführte Lektionszeit</dt>
              <dd class="mt-1 font-display text-[1.375rem] font-semibold text-ink">{hoursDe(time.guidedHours)} h</dd>
              <dd class="mt-1 font-data text-[0.6875rem] leading-relaxed text-graphite">+ {hoursDe(time.practiceHours)} h Übungsmaterial</dd>
            </div>
            <div class="rounded-clay border border-rule bg-white p-4">
              <dt class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">Kann-Beschreibungen</dt>
              <dd class="mt-1 font-display text-[1.375rem] font-semibold text-ink">{kannCount}</dd>
            </div>
            <div class="rounded-clay border border-rule bg-white p-4">
              <dt class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-graphite">Prüfungsteile geübt</dt>
              <dd class="mt-1 font-display text-[1.375rem] font-semibold text-ink">{teileCoverage.covered} von {teileCoverage.of}</dd>
            </div>
          </dl>

          <p class="mt-6 text-[0.8125rem] leading-relaxed text-graphite">
            Die {hoursDe(time.guidedHours)} h sind geführte Lektionszeit, die als Inhalt existiert: {curriculum.lektionen.length} Lektionen,
            {' '}{curriculum.checkpoints?.length ?? 0} Checkpoints und die Wiederholungen dazwischen. Die weiteren
            {' '}{hoursDe(time.practiceHours)} h sind Übungsmaterial rund um die Lektionen — Hören, Lesen, Sprechen, Wortschatz und
            Schreiben; dieses Material ist noch nicht zu jeder Lektion vollständig.{richtwert ? ` Goethe-Richtwert für das ganze Niveau: ${richtwert[0]}–${richtwert[1]} Unterrichtseinheiten.` : ''}
          </p>

          <p class="mt-3 text-[0.8125rem] leading-relaxed text-graphite">
            Quelle: {curriculum.provenance?.canDo}. Wortliste: {curriculum.provenance?.wortliste}. Themen: {curriculum.provenance?.themen}.
          </p>

          <a href={`/course/${level}/l/1`} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-siegel transition-colors hover:text-siegel-deep">Lektion 1 ansehen →</a>
        </section>
      )}

      <!-- Grammar -->
      <section class="reveal mt-4" aria-labelledby="grammar-h">
        <h2 id="grammar-h" class="font-display text-[1.5rem] font-semibold leading-tight tracking-[-0.015em] sm:text-[1.75rem]">{topics.length} grammar topics, in order</h2>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
          Every topic: rules in plain language, worked examples with audio, and exercises where you type
          the answer — not multiple choice. The rules are free to read at every level; the practice is part of the course.
        </p>
        <ol class="mt-5 grid gap-2 sm:grid-cols-2">
          {topics.map((t, i) => (
            <li class="flex items-baseline gap-3 rounded-clay border border-rule bg-white px-4 py-3">
              <span class="font-data text-[0.6875rem] font-bold text-siegel">{String(i + 1).padStart(2, '0')}</span>
              <a href={`/grammar/${level}/${t.slug}/`} class="text-[0.9375rem] font-bold text-ink transition-colors hover:text-siegel-deep">{t.title_en}</a>
            </li>
          ))}
        </ol>
      </section>

      <!-- Reading + listening -->
      <section class="reveal mt-12 grid gap-8 sm:grid-cols-2" style="--rd:80ms" aria-labelledby="skills-h">
        <div>
          <h2 id="skills-h" class="font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.015em]">{content.reading.length} reading texts</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
            {content.finalTest ? 'Short, in-level texts with richtig/falsch checks and exam-style parts.' : 'Longer texts on the level\'s themes; checks arrive with the rebuild.'}
          </p>
          <ul class="mt-3 space-y-1 text-[0.875rem] text-ink">
            {content.reading.map((t) => <li class="border-b border-rule/60 py-1.5">{t}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.015em]">{content.listening.length} listening exercises</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-graphite">
            Native-speaker dialogues, {content.listeningQuestions} questions{content.dictation ? `, ${content.dictation} of them dictation` : ''}.
          </p>
          <ul class="mt-3 space-y-1 text-[0.875rem] text-ink">
            {content.listening.map((t) => <li class="border-b border-rule/60 py-1.5">{t}</li>)}
          </ul>
        </div>
      </section>

      <!-- Vocabulary, speaking, test, plan -->
      <section class="reveal mt-12 grid gap-4 sm:grid-cols-2" style="--rd:120ms" aria-label="Also in this course">
        <div class="rounded-clay border border-rule bg-white p-5">
          <h3 class="font-bold text-ink">{content.words} words with audio</h3>
          <p class="mt-1 text-[0.875rem] text-graphite">{content.wordCategories} themed lists, every word spoken by a native voice, spaced repetition built in.</p>
        </div>
        <div class="rounded-clay border border-rule bg-white p-5">
          <h3 class="font-bold text-ink">{content.missions} speaking missions</h3>
          <p class="mt-1 text-[0.875rem] text-graphite">Role-play with the AI coach on this level's situations; feedback on grammar and expression.</p>
        </div>
        {content.finalTest ? (
          <>
            <div class="rounded-clay border border-rule bg-white p-5">
              <h3 class="font-bold text-ink">Final test in the {content.finalTest.format} format</h3>
              <p class="mt-1 text-[0.875rem] text-graphite">Timed, half exam length, scored against the real pass threshold — so you know you are done.</p>
            </div>
            <div class="rounded-clay border border-rule bg-white p-5">
              <h3 class="font-bold text-ink">28-day plan</h3>
              <p class="mt-1 text-[0.875rem] text-graphite">One task a day through the whole level, ending in the final test.</p>
            </div>
          </>
        ) : (
          <div class="rounded-clay border border-rule bg-paper-sunk p-5 sm:col-span-2">
            <h3 class="font-bold text-ink">Final test and 28-day plan: coming with the rebuild</h3>
            <p class="mt-1 text-[0.875rem] text-graphite">The A1 and A2 courses have them today; {code} gets them before it goes on sale.</p>
          </div>
        )}
      </section>

      <!-- Buy again + neighbours -->
      <section class="reveal mt-12 rounded-clay border border-rule bg-white p-6 shadow-raise" style="--rd:160ms">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-display text-[1.25rem] font-semibold text-ink">{isFree ? `${code} is free — start now.` : course.comingSoon ? `${code} is coming soon.` : `Own ${code} for ${eur(course.price)}.`}</p>
            <p class="mt-1 text-[0.875rem] text-graphite">
              {isFree ? `${FREE_LEVEL_LABEL} needs no account. A free account adds a trial of Pro on top.` : course.comingSoon ? 'Pro opens every level today, including this one.' : `Pay once. Nothing renews, nothing expires. ${COURSE_PRO_MONTHS} months of Pro included.`}
            </p>
          </div>
          <div data-course-door={level} data-course-code={code} data-course-open-class={BTN_PRIMARY}>
          {isFree ? (
            <a href={`/grammar/${level}/`} class={BTN_PRIMARY}>Start {code} free</a>
          ) : buyable ? (
            <button type="button" class={BTN_PRIMARY} data-course-variant={course.variantId} data-course-key={course.key}>Buy {code} — {eur(course.price)}</button>
          ) : (
            <a href="/pricing/" class={BTN_SECONDARY}>See Pro</a>
          )}
          </div>
        </div>
      </section>

      <nav class="mt-8 flex justify-between font-data text-[0.75rem] text-graphite" aria-label="Neighbouring levels">
        {prev ? <a href={`/courses/${levelToSlug(prev)}/`} class="font-bold text-siegel hover:text-siegel-deep">← {prev.toUpperCase()}</a> : <span />}
        <a href="/courses/" class="font-bold text-siegel hover:text-siegel-deep">All courses</a>
        {next ? <a href={`/courses/${levelToSlug(next)}/`} class="font-bold text-siegel hover:text-siegel-deep">{next.toUpperCase()} →</a> : <span />}
      </nav>
    </div>
  </div>
  <CourseCheckout />
</Layout>
