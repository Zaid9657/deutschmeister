---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/concept/Scene.astro';
import BetterTogether from '../../components/concept/BetterTogether.astro';
import Benefits from '../../components/concept/Benefits.astro';
import Icon from '../../components/concept/Icon.astro';
import RouteBand from '../../components/concept/RouteBand.astro';
import PurchaseDoor from '../../components/concept/PurchaseDoor.astro';
import CourseCheckout from '../../components/CourseCheckout.astro';
import { courseProof } from '../../data/productProof.js';
import { salesCurriculum } from '../../data/salesCurriculum.js';
import { curriculumFor } from '../../data/curricula/index.js';
import { ALL_LEVELS, courseForLevel, COURSE_PRO_MONTHS, CURRENCY, eur } from '../../data/pricing.js';
import { levelToSlug } from '../../data/courseContents.js';
import { ORGANIZATION } from '../../lib/siteMeta.js';
import { getTopicsForLevel } from '../../lib/grammar.js';
import '../../styles/global.css';
export async function getStaticPaths() {
  return ALL_LEVELS.map((level) => ({ params: { level: levelToSlug(level) }, props: { level } }));
}
const { level } = Astro.props;
const code = level.toUpperCase();
const slug = levelToSlug(level);
const course = courseForLevel(level);
const isFree = level === 'a1.1';
const coming = Boolean(course?.comingSoon);
const curriculum = curriculumFor(level);
const syllabus = salesCurriculum(level);
const proof = curriculum ? courseProof(level) : null;
const doctor = curriculum?.lektionen.find((l) => l.nr === 6);
const topics = await getTopicsForLevel(level);
const title = `German ${code} Course — ${isFree ? 'Start Free' : coming ? 'Coming Next' : 'Everyday Life'} | DeutschMeister`;
const description = isFree ? 'Your first German course: introduce yourself, understand everyday conversations, and practise step by step. A1.1 is free, with no account needed.' : coming ? `The German ${code} guided course is coming next. Start with A1.1 free or explore the ready A1.2 course. This course is not on sale.` : `You can introduce yourself. Now handle real everyday situations. Own the A1.2 course for ${eur(course.price)} once, with ${COURSE_PRO_MONTHS} months of AI Practice included.`;
const FAQS = [
  { q: `Who is the ${code} course for?`, a: isFree ? 'Adult beginners starting German from the beginning. Instructions and explanations help you follow the German conversations.' : 'Learners who can already introduce themselves and want to handle more everyday situations in German.' },
  { q: 'Do I need to complete A1.1 first?', a: 'You should be comfortable with simple introductions and everyday beginner phrases. Start A1.1 free if you would like to build that foundation first.' },
  { q: 'What is included in the course?', a: `Conversations, explanations, exercises checked as you answer, writing and speaking tasks, and checkpoints. ${isFree ? 'The A1.1 course is free.' : 'One payment keeps the A1.2 course in your account.'}` },
  { q: 'How does the AI practice work?', a: isFree ? 'A free account starts the account trial for AI tools. The free A1.1 course remains available afterwards.' : `${COURSE_PRO_MONTHS} months of AI Practice are included with your purchase. After that, keep your course and choose whether to renew AI Practice separately. Nothing renews automatically from a course purchase.` },
];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Course', name: `German ${code} Course`, description,
  url: `https://deutsch-meister.de/courses/${slug}/`, inLanguage: 'en', educationalLevel: code, provider: ORGANIZATION,
  ...(isFree ? { isAccessibleForFree: true } : coming ? {} : { offers: { '@type': 'Offer', price: String(course.price), priceCurrency: CURRENCY, availability: 'https://schema.org/InStock', url: `https://deutsch-meister.de/courses/${slug}/` } }),
};
---
<Layout title={title} description={description} canonical={`https://deutsch-meister.de/courses/${slug}/`} jsonLd={jsonLd}>
  {coming ? <div class="c4-wrap c4-unavailable"><p class="c4-level-badge">{code}</p><h1>More German for real life.<br /><span>Coming next.</span></h1><p>The {code} guided course is still being built. It is not on sale yet.</p><div class="c4-unavailable-actions"><a href="/course/a1.1" class="c4-button c4-button-coral">Start A1.1 free →</a><a href="/courses/a1-2/" class="c4-button c4-button-outline">Explore A1.2 →</a></div><RouteBand /><a href="/courses/" class="c4-text-link">← All courses</a></div>
  : <>
    <section class="c4-wrap c4-level-hero" aria-labelledby="level-h">
      <Scene name={isFree ? 'scene-cafe' : 'a12-reception'} alt={isFree ? 'A first conversation in a cafe' : 'A learner talking to a receptionist in a doctor’s practice'} hero sizes="(max-width: 640px) 100vw, 900px" />
      <div class="c4-level-copy"><p class="c4-level-badge">{code} · {isFree ? 'Beginner I' : 'Beginner II'}</p><h1 id="level-h">{isFree ? <>Your first words.<br /><span class="c4-underline">Your first conversations.</span></> : <>You can introduce yourself. Now handle<br /><span class="c4-underline">real everyday situations.</span></>}</h1><p>{isFree ? 'Start German with situations you recognise. Learn step by step, from your first greeting to everyday conversations.' : 'Continue your German journey at A1.2. Build on what you already know and gain the language for everyday life in Germany.'}</p></div>
      <aside class="c4-level-price" aria-label="Course purchase"><p class="c4-price"><strong>{isFree ? 'Free' : eur(course.price).replace('.00', '')}</strong></p><ul class="c4-checks">{isFree ? <><li>No account needed</li><li>Start at your own pace</li></> : <><li>Pay once</li><li>Yours to keep</li><li>{COURSE_PRO_MONTHS} months of AI Practice included</li></>}</ul><PurchaseDoor level={level} surface="level_hero" /></aside>
    </section>
    <Benefits course />
    <section class="c4-wrap c4-outcomes" aria-labelledby="cando-h"><div><h2 id="cando-h"><span class="c4-underline">What you will<br />be able to do</span></h2><p>Use German in more everyday situations and feel more confident and independent in daily life.</p></div><div class="c4-outcome-grid">{syllabus.outcomes.map((o) => <article data-c4-reveal><Scene name={o.image} alt={o.en} sizes="(max-width: 640px) 45vw, 250px" /><div><Icon name={o.icon} size={28} /><h3>{o.en}</h3></div><details><summary>From lesson {o.nr}</summary><p lang="de">{o.source}</p></details></article>)}</div></section>
    <section class="c4-wrap c4-previews" id="lesson-preview" aria-label="Preview the real course">
      <article data-c4-reveal><p class="c4-eyebrow">Lesson preview · a real chat</p><h2>{isFree ? proof.lesson.title : 'At the doctor: a real conversation'}</h2><div class="c4-dialogue">{(isFree ? proof.lesson : doctor).dialog.lines.slice(0, 2).map((line, i) => <blockquote class:list={[i % 2 && 'c4-dialogue-reply']}><p lang="de">{line.de}</p><p class="c4-small">{line.en}</p></blockquote>)}</div><div class="c4-explanation"><Icon name="sparkles" size={28} /><div><strong>Explanation</strong><p>{(isFree ? proof.lesson : doctor).notice.bodyEn.replace(/\*\*/g, '')}</p></div></div></article>
      <article data-c4-reveal><p class="c4-eyebrow">Practice preview · writing task</p><h2>{isFree ? 'Write your first short message' : 'Write a short message to a landlord'}</h2><p class="c4-small">{proof.writing.lesson.schreiben.taskEn}</p><div class="c4-writing-preview"><div><h3>Your text</h3><p lang="de">{proof.writing.draft}</p></div><span aria-hidden="true">→</span><div><h3>Revised model answer</h3><p lang="de">{proof.writing.revision}</p></div></div><div class="c4-writing-feedback"><strong>Course form check:</strong> {proof.writing.before.checks.find((c) => c.key === 'gruss')?.ok ? 'Sign-off present.' : 'Add a sign-off to close your message.'} <span>This preview checks the form of your message. AI writing feedback assesses your language separately.</span></div></article>
    </section>
    <section class="c4-wrap c4-syllabus" aria-labelledby="lessons-h"><div><h2 id="lessons-h"><span class="c4-underline">Lessons<br />by unit</span></h2><p>A clear and practical course with units built around everyday life in German.</p></div><div>{syllabus.units.map((unit, i) => <article class="c4-unit" data-c4-reveal><Scene name={['scene-cafe', 'scene-doctor', 'cando-chat', 'cando-market'][i]} alt={`Scenes from unit ${i + 1}`} sizes="(max-width: 640px) 100px, 250px" /><div><p class="c4-level-badge">Unit {unit.checkpoint.nr}</p><h3>{unit.lessons[0].titleEn}</h3><p>Lessons {unit.lessons[0].nr}–{unit.lessons.at(-1).nr} · checkpoint {unit.checkpoint.nr}</p></div><ol>{unit.lessons.map((l) => <li><span class="c4-unit-play" aria-hidden="true">▷</span><span class="c4-lesson-number">L{l.nr}</span><span>{l.titleEn}<small lang="de">{l.title}</small></span></li>)}</ol></article>)}
      <details class="c4-syllabus-details"><summary>View all lessons and course can-dos</summary>{syllabus.lessons.map((l) => <article><h3>{l.nr}. {l.titleEn}</h3><ul lang="de">{l.canDo.map((c) => <li>{c}</li>)}</ul></article>)}</details><a href={`/course/${level}`} class="c4-text-link">Open the course →</a></div></section>
    <section class="c4-wrap c4-faq" aria-labelledby="faq-h"><div><h2 id="faq-h"><span class="c4-underline">FAQ</span></h2><p>Common questions about the {code} course.</p></div><div>{FAQS.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
    <section class="c4-wrap c4-level-close" aria-label="Start your course"><div><h2>Take the next step:<br /><span class="c4-underline">Start {code} today.</span></h2></div><p>Build on your German, gain more independence in everyday life, and get closer to your next level.</p><PurchaseDoor level={level} surface="level_close" coral /><Scene name="tram-route" alt="A Berlin tram on the route ahead" sizes="400px" /></section>
    <section class="c4-wrap c4-course-grammar" aria-labelledby="grammar-h"><details><summary id="grammar-h">Explore the grammar in {code}</summary><ul>{topics.map((t) => <li><a href={`/grammar/${level}/${t.slug}/`}>{t.title_en}</a></li>)}</ul></details><a href="/courses/" class="c4-text-link">← All courses</a></section>
    {!isFree && <BetterTogether />}
    <CourseCheckout />
  </>}
</Layout>
