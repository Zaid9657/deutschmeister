---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---

<Layout
  title="Thank You for Your Feedback | DeutschMeister"
  description="Your Deutschmeister learner feedback was received."
  canonical="https://deutsch-meister.de/share-your-story/thanks/"
  noindex={true}
  lang="en"
>
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Submission received</p>
    <h1 class="mt-3 font-display text-[2.125rem] font-semibold text-ink sm:text-[3rem]">Thank you for being honest.</h1>
    <p class="mx-auto mt-5 max-w-lg text-[1.0625rem] leading-relaxed text-graphite">The team will review your experience. Nothing is published automatically, and your email address will never appear in a testimonial.</p>
    <a href="/grammar/" class="mt-8 inline-flex min-h-11 items-center justify-center rounded-clay bg-siegel px-6 py-3 text-sm font-bold text-white shadow-raise-siegel hover:bg-siegel-lift">Continue learning</a>
  </section>
</Layout>
