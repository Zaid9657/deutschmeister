---
import Layout from '../../layouts/Layout.astro';
import Aurora from '../../components/Aurora.astro';
import '../../styles/global.css';

const title = 'Share Your Deutschmeister Experience | DeutschMeister';
const description = 'Tell the Deutschmeister team what helped, what did not, and whether your words may be quoted publicly. Submissions are reviewed and never published automatically.';
---

<Layout title={title} description={description} canonical="https://deutsch-meister.de/share-your-story/" lang="en">
  <div class="min-h-screen overflow-x-clip bg-paper text-ink">
    <section class="relative">
      <Aurora />
      <div class="relative mx-auto max-w-2xl px-5 pb-10 pt-14 sm:pt-20">
        <p class="font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Real learner feedback</p>
        <h1 class="mt-3 font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.025em] sm:text-[3rem]">Share your experience</h1>
        <p class="mt-5 text-[1.0625rem] leading-relaxed text-graphite">
          Tell us what helped and what should improve. Your submission goes to the Deutschmeister team for review—it is never published automatically.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-2xl px-5 pb-20" aria-label="Learner feedback form">
      <form
        name="learner-story"
        method="POST"
        action="/share-your-story/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="rounded-clay border border-rule bg-white p-6 shadow-raise sm:p-8"
      >
        <input type="hidden" name="form-name" value="learner-story" />
        <input type="hidden" name="consent-version" value="2026-09-14" />
        <p class="hidden" aria-hidden="true"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <div class="grid gap-6 sm:grid-cols-2">
          <label class="block text-sm font-semibold text-ink">
            Name or preferred display name
            <input name="display-name" autocomplete="name" class="mt-2 w-full rounded-clay border border-rule bg-white px-4 py-3 font-normal text-ink focus:border-siegel" />
          </label>
          <label class="block text-sm font-semibold text-ink">
            Email <span class="text-accent-himbeer-ink" aria-hidden="true">*</span>
            <input name="email" type="email" autocomplete="email" required aria-describedby="email-note" class="mt-2 w-full rounded-clay border border-rule bg-white px-4 py-3 font-normal text-ink focus:border-siegel" />
            <span id="email-note" class="mt-1.5 block text-xs font-normal text-graphite">Used to verify and follow up; never shown in a testimonial.</span>
          </label>
        </div>

        <label class="mt-6 block text-sm font-semibold text-ink">
          Which part did you use?
          <select name="product-area" class="mt-2 w-full rounded-clay border border-rule bg-white px-4 py-3 font-normal text-ink focus:border-siegel">
            <option value="">Choose one (optional)</option>
            <option>Grammar lessons</option>
            <option>AI speaking practice</option>
            <option>Sentence X-Ray</option>
            <option>Exam preparation</option>
            <option>Listening or reading</option>
            <option>Other</option>
          </select>
        </label>

        <label class="mt-6 block text-sm font-semibold text-ink">
          Your experience <span class="text-accent-himbeer-ink" aria-hidden="true">*</span>
          <textarea name="story" rows="7" required minlength="30" aria-describedby="story-note" class="mt-2 w-full rounded-clay border border-rule bg-white px-4 py-3 font-normal leading-relaxed text-ink focus:border-siegel"></textarea>
          <span id="story-note" class="mt-1.5 block text-xs font-normal text-graphite">Specific details are most useful. Please do not include private information about other people.</span>
        </label>

        <fieldset class="mt-6 rounded-clay border border-rule bg-paper-sunk p-4">
          <legend class="px-1 text-sm font-semibold text-ink">Publication permission <span class="text-accent-himbeer-ink" aria-hidden="true">*</span></legend>
          <label class="mt-2 flex items-start gap-3 text-sm leading-relaxed text-graphite">
            <input type="checkbox" name="publication-consent" value="granted" required class="mt-1 h-4 w-4 accent-siegel" />
            <span>I give Deutschmeister permission to edit my story for length and clarity and publish it as a testimonial. The meaning must not be changed.</span>
          </label>
          <label class="mt-4 block text-sm font-semibold text-ink">
            How should we identify you?
            <select name="attribution" required class="mt-2 w-full rounded-clay border border-rule bg-white px-4 py-3 font-normal text-ink focus:border-siegel">
              <option value="">Choose one</option>
              <option value="anonymous">Anonymous learner</option>
              <option value="display-name">Use the display name above</option>
            </select>
          </label>
          <p class="mt-3 text-xs leading-relaxed text-graphite">The team may contact you before publishing. You can withdraw permission through the contact route in the Privacy Policy.</p>
        </fieldset>

        <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-clay bg-siegel px-6 py-3 text-sm font-bold text-white shadow-raise-siegel transition-all hover:bg-siegel-lift active:translate-y-1 active:shadow-none">Send my experience</button>
          <a href="/privacy/" class="text-sm font-bold text-siegel hover:text-siegel-deep">How we handle your data</a>
        </div>
      </form>
    </section>
  </div>
</Layout>
