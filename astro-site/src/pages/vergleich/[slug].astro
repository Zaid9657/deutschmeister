---
// Vergleich detail — reskinned onto the Playful Depth system (docs/design/playbook.md).
// The comparison table is REFERENCE material and stays flat (hairlines,
// bg-siegel-wash on the DeutschMeister column, like the homepage table). Every
// competitor figure and every "Stand:" stamp is rendered verbatim.
import Layout from '../../layouts/Layout.astro';
import Aurora from '../../components/Aurora.astro';
import competitorComparisons from '../../data/competitorComparisons.js';
import { BUILD_DATE, ORGANIZATION } from '../../lib/siteMeta.js';
import {
  FOUNDER_LINE_DE,
  GRAMMAR_TOPIC_COUNT,
  LISTENING_DIALOGUE_COUNT,
  LEVEL_COUNT,
  PODCAST_EPISODE_COUNT,
} from '../../data/marketing.js';
import '../../styles/global.css';

export function getStaticPaths() {
  return Object.keys(competitorComparisons).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const data = competitorComparisons[slug];

const title = `Deutschmeister vs ${data.displayName} — Vergleich | DeutschMeister`;
// Keep under 160 chars — the hero headline varies in length per competitor.
const descRaw = `${data.heroHeadline} Vergleich: Features, Preise und Sprechtraining von Deutschmeister und ${data.displayName} — ehrlich und fair.`;
const description = descRaw.length <= 158
  ? descRaw
  : `Deutschmeister vs ${data.displayName}: Features, Preise, KI-Sprechtraining und Prüfungsvorbereitung im ehrlichen Vergleich.`;
const keywords = `Deutschmeister vs ${data.displayName}, ${data.displayName} Alternative, Deutsch lernen Vergleich, ${data.displayName} Erfahrungen`;
const canonical = `https://deutsch-meister.de/vergleich/${data.slug}/`;

// Article + FAQPage + BreadcrumbList. The FAQ below was rendered on the page
// but emitted no schema, and there was no breadcrumb — the vergleich HUB had
// both. Same set the Leitfaden pages emit (see data/guides/index.js).
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `Deutschmeister vs ${data.displayName} — Vergleich`,
    description: data.heroSubheadline,
    inLanguage: 'de',
    image: 'https://deutsch-meister.de/og-image.png',
    author: ORGANIZATION,
    publisher: ORGANIZATION,
    datePublished: '2026-05-28',
    dateModified: BUILD_DATE,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://deutsch-meister.de/' },
      { '@type': 'ListItem', position: 2, name: 'Vergleich', item: 'https://deutsch-meister.de/vergleich/' },
      { '@type': 'ListItem', position: 3, name: `Deutschmeister vs ${data.displayName}`, item: canonical },
    ],
  },
];

const BTN =
  'inline-flex items-center justify-center gap-2 rounded-clay text-base font-bold transition-all duration-100 ease-snap select-none';
// The ONE shimmer on the page: the hero CTA. The close repeats the action raised, without shimmer.
const BTN_PRIMARY = `${BTN} btn-shimmer relative overflow-hidden bg-siegel px-7 py-3.5 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_PRIMARY_QUIET = `${BTN} bg-siegel px-7 py-3.5 text-white shadow-raise-siegel hover:bg-siegel-lift active:translate-y-1 active:shadow-none`;
const BTN_SECONDARY = `${BTN} border border-rule bg-white px-7 py-3.5 text-ink shadow-raise hover:border-siegel hover:text-siegel-deep active:translate-y-1 active:shadow-none`;

// ✓ / ✗ / ○ status prefixes → semantic token + stripped text (matches the SPA's
// StatusIcon). Success = limette, attention = aprikose, missing = himbeer ink —
// always next to the symbol, never colour alone.
const WHY_ICON = { Mic: '🎤', ScanSearch: '🔍', GraduationCap: '🎓', Brain: '🧠', Clock: '⏰', Wallet: '💰' };
const statusColor = (t) => (t.startsWith('✓') ? 'text-accent-limette-ink' : t.startsWith('✗') ? 'text-accent-himbeer-ink' : t.startsWith('○') ? 'text-accent-aprikose-ink' : 'text-graphite');
const statusSymbol = (t) => (t.startsWith('✓') ? '✓' : t.startsWith('✗') ? '✗' : t.startsWith('○') ? '○' : '');
const strip = (t) => t.replace(/^[✓✗○]\s*/, '');

// Accent tiles for the "why us" blocks rotate through the candy palette
// (rule 2: energy, never meaning).
const WHY_TILE = [
  'bg-accent-himbeer-wash text-accent-himbeer-ink',
  'bg-accent-aprikose-wash text-accent-aprikose-ink',
  'bg-accent-limette-wash text-accent-limette-ink',
];

// What the product CONTAINS, from src/data/marketing.js.
//
// This block used to carry usage figures — "959 Lernende", "2.488
// KI-Sprechübungen", "350 Neue Lernende diesen Monat", "154 Sätze
// röntgen-analysiert" — copied from the SPA StatsBar in May 2026 and never
// refreshed. By August the same site was claiming 1.400+ learners on the
// homepage: three surfaces, three different answers, none of them sourced.
// Counts of what the product contains are true by construction and cannot
// drift apart like that.
const STATS = [
  { value: String(GRAMMAR_TOPIC_COUNT), label: 'Grammatikthemen' },
  { value: String(LISTENING_DIALOGUE_COUNT), label: 'Dialoge mit Muttersprachlern' },
  { value: String(LEVEL_COUNT), label: 'Stufen, A1.1 bis B2.2' },
  { value: String(PODCAST_EPISODE_COUNT), label: 'Podcast-Folgen' },
];
---

<Layout title={title} description={description} keywords={keywords} canonical={canonical} jsonLd={jsonLd} lang="de" ogType="article">
  <div class="overflow-x-clip bg-paper text-ink">
    <!-- Hero -->
    <section class="relative overflow-hidden" aria-labelledby="cmp-hero-h">
      <Aurora />
      <div class="relative mx-auto max-w-4xl px-5 pt-14 pb-16 text-center sm:pt-20">
        <div class="hero-line inline-flex items-center gap-2 rounded-pill bg-siegel-wash px-2.5 py-1 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel-deep" style="--d:0ms">
          Vergleich
        </div>
        <h1 id="cmp-hero-h" class="hero-line mt-5 font-display text-[2.125rem] font-semibold leading-[1.05] tracking-[-0.025em] sm:text-[3rem]" style="--d:80ms">
          {data.heroHeadline}
        </h1>
        <p class="hero-line mx-auto mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-graphite sm:text-[1.1875rem]" style="--d:220ms">{data.heroSubheadline}</p>
        <div class="hero-line mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row" style="--d:360ms">
          <a href="https://deutsch-meister.de/signup" class={BTN_PRIMARY}>
            <span class="relative z-10 inline-flex items-center gap-2">Kostenlos testen <span aria-hidden="true">→</span></span>
          </a>
          <a href="https://deutsch-meister.de/pricing/" class={BTN_SECONDARY}>
            Preise ansehen
          </a>
        </div>
      </div>
    </section>

    <!-- Comparison Table — reference material, flat (rule 3) -->
    <section class="px-5 pb-16" aria-labelledby="cmp-table-h">
      <div class="mx-auto max-w-4xl">
        <h2 id="cmp-table-h" class="reveal mb-8 text-center font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">Feature-Vergleich</h2>

        <!-- Desktop table -->
        <div class="reveal hidden md:block" style="--rd:100ms">
          <div class="grid grid-cols-3 border-b border-ink">
            <div class="py-3 pr-4 font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-graphite">Feature</div>
            <div class="bg-siegel-wash px-4 py-3 font-display text-base font-semibold text-ink">DeutschMeister</div>
            <div class="px-4 py-3 text-[0.9375rem] font-normal text-graphite">{data.displayName}</div>
          </div>
          {data.comparisonTable.map((row) => (
            <div class="grid grid-cols-3 border-b border-rule">
              <div class="py-3.5 pr-4 text-sm font-normal text-graphite">{row.feature}</div>
              <div class="bg-siegel-wash px-4 py-3.5 text-sm font-semibold text-ink">
                <div class="flex items-start gap-2">
                  <span class={`${statusColor(row.us)} flex-shrink-0 font-data font-bold`}>{statusSymbol(row.us)}</span>
                  <span>{strip(row.us)}</span>
                </div>
              </div>
              <div class="px-4 py-3.5 text-sm text-graphite">
                <div class="flex items-start gap-2">
                  <span class={`${statusColor(row.them)} flex-shrink-0 font-data font-bold`}>{statusSymbol(row.them)}</span>
                  <span>{strip(row.them)}</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Mobile stacked cards (flat reference cards) -->
        <div class="reveal space-y-3 md:hidden" style="--rd:100ms">
          {data.comparisonTable.map((row) => (
            <div class="rounded-clay border border-rule bg-white p-4">
              <p class="mb-3 text-sm font-semibold text-ink">{row.feature}</p>
              <div class="space-y-2">
                <div class="flex items-start gap-2 rounded-md bg-siegel-wash px-2 py-1.5">
                  <span class="mt-0.5 min-w-[24px] font-data text-[0.6875rem] font-bold text-siegel-deep">DM</span>
                  <span class={`${statusColor(row.us)} flex-shrink-0 font-data font-bold`}>{statusSymbol(row.us)}</span>
                  <span class="text-sm font-semibold text-ink">{strip(row.us)}</span>
                </div>
                <div class="flex items-start gap-2 px-2 py-1.5">
                  <span class="mt-0.5 min-w-[24px] font-data text-[0.6875rem] font-bold text-graphite">{data.displayName.substring(0, 2).toUpperCase()}</span>
                  <span class={`${statusColor(row.them)} flex-shrink-0 font-data font-bold`}>{statusSymbol(row.them)}</span>
                  <span class="text-sm text-graphite">{strip(row.them)}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Us -->
    <section class="border-t border-rule bg-paper-sunk px-5 py-16" aria-labelledby="cmp-why-h">
      <div class="mx-auto max-w-4xl">
        <h2 id="cmp-why-h" class="reveal mb-10 text-center font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
          Warum Deutschmeister statt {data.displayName}
        </h2>
        <div class="grid gap-6 sm:grid-cols-3">
          {data.whyUsBlocks.map((block, i) => (
            <div class="reveal rounded-clay border border-rule bg-white p-6 shadow-raise" style={`--rd:${i * 90}ms`}>
              <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-clay text-2xl ${WHY_TILE[i % WHY_TILE.length]}`}>
                <span aria-hidden="true">{WHY_ICON[block.icon] ?? '🎓'}</span>
              </div>
              <h3 class="mb-2 font-display text-[1.125rem] font-semibold text-ink">{block.title}</h3>
              <p class="text-[0.9375rem] leading-relaxed text-graphite">{block.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="border-y border-rule bg-white py-14">
      <div class="mx-auto max-w-5xl px-5">
        <p class="reveal mb-8 text-center font-data text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-siegel">Was drin ist</p>
        <div class="grid grid-cols-2 gap-6 sm:gap-8 lg:grid-cols-4">
          {STATS.map((stat, i) => (
            <div class="reveal text-center" style={`--rd:${80 + i * 80}ms`}>
              <p class="mb-1 font-display text-[2.5rem] font-semibold leading-none tracking-[-0.02em] text-ink sm:text-[3rem]">{stat.value}</p>
              <p class="text-sm text-graphite">{stat.label}</p>
            </div>
          ))}
        </div>
        <p class="reveal mt-8 text-center font-data text-[0.75rem] text-graphite" style="--rd:400ms">Stand: Mai 2026</p>
      </div>
    </section>

    <!-- FAQ — reference material, flat -->
    <section class="px-5 py-16" aria-labelledby="cmp-faq-h">
      <div class="mx-auto max-w-3xl">
        <h2 id="cmp-faq-h" class="reveal mb-10 text-center font-display text-[1.5625rem] font-semibold leading-tight tracking-[-0.018em] sm:text-[2.125rem]">
          Häufige Fragen: Deutschmeister vs {data.displayName}
        </h2>
        <div class="space-y-3">
          {data.faq.map((item, i) => (
            <details class="reveal group overflow-hidden rounded-clay border border-rule bg-white" style={`--rd:${i * 60}ms`}>
              <summary class="flex w-full cursor-pointer list-none items-center justify-between px-5 py-4 text-left transition-colors hover:bg-paper-sunk">
                <span class="pr-4 font-semibold text-ink">{item.q}</span>
                <span class="flex-shrink-0 text-siegel transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
              </summary>
              <div class="border-t border-rule px-5 pb-5 pt-4 text-[0.9375rem] leading-relaxed text-graphite">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-5 pb-20">
      <div class="mx-auto max-w-3xl">
        <div class="reveal relative overflow-hidden rounded-clay border border-rule bg-paper-sunk p-8 text-center sm:p-12">
          <Aurora variant="close" />
          <div class="relative">
            <h2 class="mb-3 font-display text-[1.75rem] font-semibold leading-tight tracking-[-0.018em] text-ink sm:text-[2.25rem]">{data.ctaHeadline}</h2>
            <p class="mb-8 text-[0.9375rem] leading-relaxed text-graphite sm:text-base">{data.ctaSubtext}</p>
            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
              <a href="https://deutsch-meister.de/signup" class={BTN_PRIMARY_QUIET}>
                Kostenlos starten <span aria-hidden="true">→</span>
              </a>
              <a href="https://deutsch-meister.de/pricing/" class={BTN_SECONDARY}>
                Preise ansehen
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer -->
    <div class="mx-auto max-w-4xl px-5 pb-12 text-center">
      <p class="font-data text-[0.75rem] text-graphite">
        Vergleichsdaten Stand: Mai 2026. Wir vergleichen objektiv und nach UWG §6 zulässig.
      </p>
      <p class="mt-3 text-[0.75rem] leading-relaxed text-graphite">
        {FOUNDER_LINE_DE}{' '}
        <a href="/ueber-uns/" class="text-siegel underline-offset-2 hover:underline">Wer hinter DeutschMeister steht →</a>
      </p>
    </div>
  </div>
</Layout>
