# DeutschMeister environment variables (names only — set real values in
# Netlify → Site settings → Environment variables, and in a local .env for dev).
# See README.md for which part of the stack reads each variable.

# ---- Supabase ----
# Server-side (Netlify functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# SPA (Vite) — public, bundled into the client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Astro static site (build-time content fetch) — see astro-site/.env.example
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ---- AI providers (Netlify functions only) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Email (Resend) ----
RESEND_API_KEY=
# Shared secret for /api/send-campaign, live /api/daily-sentence triggers and
# arbitrary-recipient /api/send-daily-test (x-campaign-secret header / ?secret=)
CAMPAIGN_SECRET=
# HMAC secret for unsubscribe tokens (falls back to CAMPAIGN_SECRET if unset)
UNSUB_SECRET=
# Bearer secret for the Supabase → send-welcome-email webhook
WEBHOOK_SECRET=

# ---- Payments (Lemon Squeezy) ----
LEMONSQUEEZY_WEBHOOK_SECRET=
VITE_LEMONSQUEEZY_STORE_ID=
VITE_LEMONSQUEEZY_MONTHLY_VARIANT_ID=
VITE_LEMONSQUEEZY_YEARLY_VARIANT_ID=

# ---- Analytics (optional) ----
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ---- SEO tooling ----
INDEXNOW_KEY=
